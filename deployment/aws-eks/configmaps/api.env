# hope-api-config  →  consumed by: hope-api (NestJS gateway, port 8868)
# Source of truth: arca/hope-v2-deployment  deployment/k8s/base/config/api.env
# Effective dev values from live map hope-api-config-475c8d7676.
#
# Downstream URLs MUST be read through IConfigService (rule 05 §Configuration);
# direct process.env reads of these are lint-banned in apps/api/src/modules/**.

GUARDRAIL_URL=http://hope-guardrail:8863
HARNESS_URL=http://hope-harness:8866
NLP_URL=http://hope-nlp:8864
SMR_URL=http://hope-smr:8862
STT_V2_URL=http://hope-stt-v2:8861
TTS_URL=http://hope-tts:8865
MINIO_USE_SSL=true

# --- dev overlay overrides ---
ENABLE_PRISMA_STUDIO=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_LOGS_ENABLED=true
OTEL_LOG_BRIDGE=true
OTEL_METRICS_ENABLED=true
OTEL_TRACES_ENABLED=true
