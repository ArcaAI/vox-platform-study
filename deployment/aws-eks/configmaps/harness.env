# hope-harness-config  →  consumed by: hope-harness (8866), hope-harness-worker
# Source of truth: arca/hope-v2-deployment  deployment/k8s/base/config/harness.env
# Effective dev values from live map hope-harness-config-4d6895mgfh.
#
# TEMPORAL_ADDRESS points at the in-cluster hope-temporal Service (TASK-730,
# commit c4d13c21) — no longer the unmanaged VM at 10.10.1.10:7233.

HARNESS_API_BASE_URL=http://hope-api:8868
HARNESS_CLAIM_CHECK_ENABLED=true
HARNESS_CLAIM_CHECK_STORE=s3
HARNESS_RETRIEVAL_COLLECTION=knowledge_chunks
HARNESS_RETRIEVAL_QDRANT_TIMEOUT_S=10
HARNESS_RETRIEVAL_QDRANT_URL=http://hope-qdrant:6333
TEMPORAL_ADDRESS=hope-temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=harness-task-queue
