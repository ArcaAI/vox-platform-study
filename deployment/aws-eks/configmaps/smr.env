# hope-smr-config  →  consumed by: hope-smr (text/summarization service, 8862)
# Source of truth: arca/hope-v2-deployment  deployment/k8s/base/config/smr.env
# Effective dev values from live map hope-smr-config-9cbd97t66t.
#
# ⚠ SMR_OPENAI_COMPAT_DEFAULT_MODEL is a hardcoded model SELECTION living in env.
#   Rule 00 §Configuration Principles puts model choice in AiTaskDefault/AiModel
#   with failMode: closed. Flag for the AWS cutover, do not copy forward blindly.

SMR_EXTERNAL_GUARDRAIL_ENABLED=false
SMR_GATEWAY_URL=http://hope-api:8868/api/v1
SMR_OPENAI_COMPAT_BASE_URL=http://hope-lmstudio:1234/v1
SMR_OPENAI_COMPAT_DEFAULT_MODEL=gemma-4-e2b-it-qat
SMR_OPENAI_COMPAT_TIMEOUT_S=300

# --- dev overlay overrides ---
SMR_V2_METRICS_ENABLED=true
SMR_V2_OTEL_DEPLOYMENT_ENVIRONMENT=dev
SMR_V2_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
SMR_V2_OTEL_INSECURE=true
SMR_V2_OTEL_LOGS_ENABLED=true
SMR_V2_OTEL_SERVICE_NAME=hope-smr
SMR_V2_OTEL_SERVICE_NAMESPACE=hope
