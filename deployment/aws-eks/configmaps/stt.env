# hope-stt-config  →  consumed by: hope-stt-v2 (8861), hope-stt-v2-worker
# Source of truth: arca/hope-v2-deployment  deployment/k8s/base/config/stt.env
# Effective dev values from live map hope-stt-config-9h97mctg7b.
#
# NOTE: MINIO_* keys retire once S3 + TenantStorageConfig lands (aws-eks/03 §6).

API_GATEWAY_TIMEOUT=30
MINIO_AUDIO_BUCKET=hope-audio
MINIO_CHUNK_BUCKET=hope-audio-chunks
MODEL_CACHE_MAX_MODELS=2
MODEL_CACHE_TTL_SECONDS=3600
TRANSCRIPTION_CHUNK_LENGTH_S=30
TRANSCRIPTION_TIMEOUT_SECONDS=600
WORKER_CONCURRENCY=4
WORKER_MAX_RETRIES=3

# --- dev overlay overrides ---
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
