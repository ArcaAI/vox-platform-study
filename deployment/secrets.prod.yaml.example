# =============================================================================
# Kubernetes Secrets — Project HOPE PROD environment (TEMPLATE)
# =============================================================================
# ⚠️  Copy this file to secrets.prod.yaml and fill in all <REPLACE_*> values.
#     DO NOT commit the filled-in version to Git.
#
# Apply:
#   kubectl apply -f secrets.prod.yaml -n hope-v2-prod
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: hope-secrets
  namespace: hope-v2-prod
  labels:
    app.kubernetes.io/part-of: project-hope
type: Opaque
stringData:
  # -- Database --
  POSTGRES_DB: "hope_prod"
  POSTGRES_USER: "hope"
  POSTGRES_PASSWORD: "<PROD_DB_PASSWORD>"
  DATABASE_URL: "postgresql://hope:<PROD_DB_PASSWORD>@hope-postgres:5432/hope_prod"
  STT_V2_DATABASE_URL: "postgresql://hope:<PROD_DB_PASSWORD>@hope-postgres:5432/hope_prod"

  # -- Redis --
  REDIS_PASS: "<PROD_REDIS_PASSWORD>"

  # -- API --
  SESSION_SECRET_KEY: "<PROD_SESSION_SECRET>"

  # -- Admin Console (min 32 chars; encrypts the BFF session cookie) --
  ADMIN_SESSION_SECRET: "<PROD_ADMIN_SESSION_SECRET>"

  # -- MinIO --
  MINIO_ENDPOINT: "<MINIO_HOST>:9000"
  MINIO_ACCESS_KEY: "<PROD_MINIO_ACCESS_KEY>"
  MINIO_SECRET_KEY: "<PROD_MINIO_SECRET_KEY>"

  # -- Azure OpenAI (SMR) --
  AZURE_OPENAI_API_KEY: "<PROD_AZURE_OPENAI_API_KEY>"
  AZURE_OPENAI_ENDPOINT: "https://<AZURE_RESOURCE_NAME>.openai.azure.com"
  AZURE_OPENAI_DEPLOYMENT_NAME: "<AZURE_OPENAI_DEPLOYMENT_NAME>"
---
apiVersion: v1
kind: Secret
metadata:
  name: hope-registry-creds
  namespace: hope-v2-prod
  labels:
    app.kubernetes.io/part-of: project-hope
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "registry.taphuynh.dev": {
          "username": "<REGISTRY_USERNAME>",
          "password": "<REGISTRY_PASSWORD_OR_TOKEN>"
        }
      }
    }
