# =============================================================================
# HOPE Platform - Kubernetes Secrets Template
# =============================================================================
# USAGE:
#   1. Copy this file: cp secrets.yaml.template secrets.<env>.yaml
#      (e.g., secrets.dev.yaml, secrets.test.yaml, secrets.prod.yaml)
#   2. Fill in all values marked with <REPLACE_*>
#   3. Apply: kubectl apply -f secrets.<env>.yaml -n hope-<env>
#
# WARNING: Never commit secrets.*.yaml files to version control!
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: hope-secrets
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/part-of: project-hope
    environment: __ENV__
type: Opaque
stringData:
  # -- Database --
  POSTGRES_USER: <REPLACE_POSTGRES_USER>
  POSTGRES_PASSWORD: <REPLACE_POSTGRES_PASSWORD>
  POSTGRES_DB: hope
  DATABASE_URL: "postgresql://<REPLACE_POSTGRES_USER>:<REPLACE_POSTGRES_PASSWORD>@hope-postgres:5432/hope?connection_limit=10&connect_timeout=10"

  # -- STT-V2 Database (separate DB on same server) --
  STT_V2_DATABASE_URL: "postgresql+asyncpg://<REPLACE_POSTGRES_USER>:<REPLACE_POSTGRES_PASSWORD>@hope-postgres:5432/hope_stt_v2"

  # -- Redis --
  REDIS_PASS: <REPLACE_REDIS_PASSWORD>

  # -- MinIO (VM 402) --
  MINIO_ACCESS_KEY: <REPLACE_MINIO_ACCESS_KEY>
  MINIO_SECRET_KEY: <REPLACE_MINIO_SECRET_KEY>

  # -- Azure Speech --
  AZURE_SPEECH_KEY: <REPLACE_AZURE_SPEECH_KEY>
  AZURE_SPEECH_REGION: eastus

  # -- Azure OpenAI --
  AZURE_OPENAI_API_KEY: <REPLACE_AZURE_OPENAI_API_KEY>
  AZURE_OPENAI_ENDPOINT: <REPLACE_AZURE_OPENAI_ENDPOINT>
  AZURE_OPENAI_API_VERSION: <REPLACE_AZURE_OPENAI_API_VERSION>
  AZURE_OPENAI_DEPLOYMENT_NAME: <REPLACE_AZURE_OPENAI_DEPLOYMENT_NAME>

  # -- Security --
  JWT_SECRET: <REPLACE_JWT_SECRET>
  JWT_REFRESH_SECRET: <REPLACE_JWT_REFRESH_SECRET>
  SESSION_SECRET_KEY: <REPLACE_SESSION_SECRET_KEY>
  API_KEY_PEPPER: <REPLACE_API_KEY_PEPPER>

  # -- HuggingFace (for STT diarization models) --
  HUGGINGFACE_TOKEN: <REPLACE_HUGGINGFACE_TOKEN>
