# =============================================================================
# Kubernetes Secrets — Project HOPE DEV environment (TEMPLATE)
# =============================================================================
# ⚠️  Copy this file to secrets.dev.yaml and fill in all <REPLACE_*> values.
#     DO NOT commit the filled-in version to Git.
#
# Apply:
#   kubectl apply -f secrets.dev.yaml -n hope-v2-dev
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: hope-secrets
  namespace: hope-v2-dev
  labels:
    app.kubernetes.io/part-of: project-hope
type: Opaque
stringData:
  # -- Database --
  POSTGRES_DB: "hope_dev"
  POSTGRES_USER: "hope"
  POSTGRES_PASSWORD: "<DEV_DB_PASSWORD>"
  DATABASE_URL: "postgresql://hope:<DEV_DB_PASSWORD>@hope-postgres:5432/hope_dev"
  STT_V2_DATABASE_URL: "postgresql://hope:<DEV_DB_PASSWORD>@hope-postgres:5432/hope_dev"

  # -- Redis --
  REDIS_PASS: "<DEV_REDIS_PASSWORD>"

  # -- API --
  SESSION_SECRET_KEY: "<DEV_SESSION_SECRET>"
  API_GATEWAY_KEY: "<DEV_API_GATEWAY_KEY>"

  # -- Admin Console (min 32 chars; encrypts the BFF session cookie) --
  ADMIN_SESSION_SECRET: "<DEV_ADMIN_SESSION_SECRET>"

  # -- MinIO --
  MINIO_ENDPOINT: "<MINIO_HOST>:9000"
  MINIO_ACCESS_KEY: "<DEV_MINIO_ACCESS_KEY>"
  MINIO_SECRET_KEY: "<DEV_MINIO_SECRET_KEY>"

  # -- Azure OpenAI --
  AZURE_OPENAI_API_KEY: "<DEV_AZURE_OPENAI_API_KEY>"
  AZURE_OPENAI_ENDPOINT: "https://<AZURE_RESOURCE_NAME>.openai.azure.com"
  AZURE_OPENAI_DEPLOYMENT_NAME: "<DEV_AZURE_OPENAI_DEPLOYMENT_NAME>"
  AZURE_SPEECH_KEY: "<DEV_AZURE_SPEECH_KEY>"

  # -- SMR V2 --
  SMR_V2_SERVICE_TOKEN: "<DEV_SMR_SERVICE_TOKEN>"
---
apiVersion: v1
kind: Secret
metadata:
  name: hope-registry-creds
  namespace: hope-v2-dev
  labels:
    app.kubernetes.io/part-of: project-hope
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "registry.taphuynh.dev": {
          "username": "<REGISTRY_USERNAME>",
          "password": "<REGISTRY_PASSWORD_OR_TOKEN>"
        }
      }
    }
