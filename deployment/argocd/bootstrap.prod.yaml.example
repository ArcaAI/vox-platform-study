# =============================================================================
# ArgoCD Bootstrap — Project HOPE PROD environment (TEMPLATE)
# =============================================================================
# ⚠️  Copy this file to bootstrap.prod.yaml and fill in all <REPLACE_*> values.
#     DO NOT commit the filled-in version to Git.
#
# Apply once to bootstrap:
#
#   kubectl apply -f deployment/argocd/bootstrap.prod.yaml -n argocd
#
# Prerequisites:
#   1. ArgoCD installed on the K3s cluster
#   2. Secrets pre-created:
#        kubectl apply -f secrets.prod.yaml -n hope-v2-prod
#   3. Argo CD Image Updater v2 (CRD-based) installed + registry config mounted:
#        kubectl apply -n argocd \
#          -f https://raw.githubusercontent.com/argoproj-labs/argocd-image-updater/stable/manifests/install.yaml
#        kubectl -n argocd patch deployment argocd-image-updater-controller --type=strategic -p '
#          {"spec":{"template":{"spec":{
#            "volumes":[{"name":"registries-config","configMap":{"name":"argocd-image-updater-config","optional":true}}],
#            "containers":[{"name":"argocd-image-updater-controller","volumeMounts":[{"name":"registries-config","mountPath":"/app/config"}]}]
#          }}}}'
# =============================================================================

---
# -- Namespace --
apiVersion: v1
kind: Namespace
metadata:
  name: hope-v2-prod
  labels:
    app.kubernetes.io/part-of: project-hope

---
# -- Shared: Git repo credentials --
apiVersion: v1
kind: Secret
metadata:
  name: hope-v2-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: "https://git.taphuynh.dev/arca/hope-v2.git"
  username: "<GIT_USERNAME>"
  password: "<GIT_PASSWORD_OR_TOKEN>"

---
# -- Shared: Image Updater registry credentials --
apiVersion: v1
kind: Secret
metadata:
  name: gitlab-registry-creds
  namespace: argocd
type: Opaque
stringData:
  credentials: "<REGISTRY_USER>:<REGISTRY_TOKEN>"

---
# -- Shared: Image Updater registry configuration --
apiVersion: v1
kind: ConfigMap
metadata:
  name: argocd-image-updater-config
  namespace: argocd
data:
  registries.conf: |
    registries:
      - name: GitLab Registry
        api_url: https://registry.taphuynh.dev
        prefix: registry.taphuynh.dev
        credentials: secret:argocd/gitlab-registry-creds#credentials
        default: true

---
# -- Shared: AppProject scoping --
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: hope-v2
  namespace: argocd
spec:
  description: HOPE v2
  sourceRepos:
    - "https://git.taphuynh.dev/arca/hope-v2.git"
  destinations:
    - server: https://rancher.taphuynh.dev/k8s/clusters/<CLUSTER_ID>
      namespace: hope-v2-prod
  clusterResourceWhitelist:
    - group: ""
      kind: Namespace
  namespaceResourceWhitelist:
    - group: ""
      kind: "*"
    - group: apps
      kind: "*"
    - group: batch
      kind: "*"
    - group: networking.k8s.io
      kind: "*"
  namespaceResourceBlacklist:
    - group: ""
      kind: Secret

---
# -- Prod Application: manual sync only (no automated block) --
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: hope-v2-prod
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: hope-v2
    environment: prod
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: hope-v2
  source:
    repoURL: "https://git.taphuynh.dev/arca/hope-v2.git"
    targetRevision: prod
    path: "deployment/k3s/overlays/prod"
  destination:
    server: https://rancher.taphuynh.dev/k8s/clusters/c-nfhxq
    namespace: hope-v2-prod
  syncPolicy:
    syncOptions:
      - CreateNamespace=true
      - PruneLast=true
      - ApplyOutOfSyncOnly=true
      - ServerSideApply=true
    retry:
      limit: 3
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
  ignoreDifferences:
    - group: apps
      kind: Deployment
      jsonPointers:
        - /spec/replicas

---
# -- Prod Image Updater: semver strategy, tracks semantic version tags --
# This matches what CI actually pushes: on `v*` git tags the pipeline
# automatically builds and pushes `X.Y.Z`, `X.Y`, `X` and `sha-<sha8>` (never
# `latest` — see ".gitlab-ci.yml" → "Image versioning"). allowTags restricts the
# updater to the full X.Y.Z form so the truncated X.Y / X aliases cannot be
# chosen for write-back. New tags are committed to the `prod` branch; the
# hope-v2-prod Application above is MANUAL-sync, so an operator still triggers
# the actual deployment.
apiVersion: argocd-image-updater.argoproj.io/v1alpha1
kind: ImageUpdater
metadata:
  name: hope-v2-prod-image-updater
  namespace: argocd
spec:
  commonUpdateSettings:
    updateStrategy: "semver"
    allowTags: "regexp:^[0-9]+\\.[0-9]+\\.[0-9]+$"
  writeBackConfig:
    method: "git"
    gitConfig:
      branch: "prod"
  applicationRefs:
    - namePattern: "hope-v2-prod"
      images:
        - alias: "api"
          imageName: "registry.taphuynh.dev/arca/hope-v2/api"
          manifestTargets:
            kustomize:
              name: "hope-v2/api"
        - alias: "ui"
          imageName: "registry.taphuynh.dev/arca/hope-v2/ui-playground"
          manifestTargets:
            kustomize:
              name: "hope-v2/ui-playground"
        - alias: "nlp"
          imageName: "registry.taphuynh.dev/arca/hope-v2/nlp"
          manifestTargets:
            kustomize:
              name: "hope-v2/nlp"
        - alias: "smr"
          imageName: "registry.taphuynh.dev/arca/hope-v2/smr"
          manifestTargets:
            kustomize:
              name: "hope-v2/smr"
        - alias: "stt"
          imageName: "registry.taphuynh.dev/arca/hope-v2/stt-v2-ml-runtime"
          manifestTargets:
            kustomize:
              name: "hope-v2/stt-v2-ml-runtime"
        - alias: "stt-worker"
          imageName: "registry.taphuynh.dev/arca/hope-v2/stt-v2-worker"
          manifestTargets:
            kustomize:
              name: "hope-v2/stt-v2-worker"
        - alias: "db"
          imageName: "registry.taphuynh.dev/arca/hope-v2/database"
          manifestTargets:
            kustomize:
              name: "hope-v2/database"
