# ============================================================================
# HOPE Platform - Local Development Environment
# ============================================================================
# This file is loaded when NODE_ENV=development (or not set).
#
# ENVIRONMENT FILE CONVENTION:
#   - .env.dev        → Local development (this file)
#   - .env.test       → Local testing (isolated infrastructure)
#   - .env.production → Production template (uses host environment)
#   - .env            → Fallback for backwards compatibility (deprecated)
#
# USAGE:
#   This file is automatically loaded when running:
#   - pnpm dev:api
#   - pnpm seed
#   - prisma commands (db:push, migrate, etc.)
#
# LOADING PRIORITY:
#   - Host environment variables ALWAYS have highest priority
#   - This file is loaded only if NODE_ENV=development and not in CI
#
# ============================================================================

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================
NODE_ENV=development
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Development: postgres://postgres:postgres@localhost:5432/hope
# Docker: postgres://postgres:postgres@postgres:5432/hope
# HA TimescaleDB (VIP): postgresql://hope_app:<password>@10.10.1.250:5000/hope?schema=public&connect_timeout=10
# DATABASE_URL=postgres://postgres:v2r2VkzdjDEm7wvD+0Gm7IDYdOPpQJnS_superuser_password@localhost:15432/vox_staging
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hope

# Direct connection (bypasses connection pooler if used)
# DATABASE_URL_DIRECT=postgres://postgres:v2r2VkzdjDEm7wvD+0Gm7IDYdOPpQJnS_superuser_password@localhost:15432/vox_staging
# HA TimescaleDB Read-Only (VIP): postgresql://hope_reader:<password>@10.10.1.250:5001/hope?schema=public&connect_timeout=10
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/hope

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Application password (used by Node.js/Python services)
REDIS_PASS=
# Full Redis URL (alternative to host/port/pass)
REDIS_URL=redis://localhost:6379

# =============================================================================
# LOGGING CONFIGURATION (Shared across all services)
# =============================================================================
# Log levels: debug, info, warn, error (Node.js) / DEBUG, INFO, WARNING, ERROR (Python)
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=100
LOG_FILE_SEPARATE_ERROR=false

# =============================================================================
# OPENTELEMETRY CONFIGURATION (Shared across all services)
# =============================================================================
OTEL_SERVICE_NAMESPACE=hope
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true

# =============================================================================
# MINIO / S3 CONFIGURATION (Shared across services)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_admin
MINIO_USE_SSL=false

# =============================================================================
# API GATEWAY SERVICE (apps/api)
# =============================================================================
# Server
PORT=8868
API_PORT=8868
API_URL=http://localhost:8868

# Session & Security
SESSION_SECRET_KEY=<CHANGE_ME>-session-secret-key
JWT_SECRET=<CHANGE_ME>-jwt-secret-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=<CHANGE_ME>-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS (for production, set specific origins)
CORS_ALLOWED_ORIGINS=*

# MQTT (if used)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Sentry (optional)
SENTRY_DSN_API=

# Permit.io (optional - for authorization)
PERMIT_ENFORCEMENT_ENABLED=false
PERMIT_API_KEY=
PERMIT_PDP_URL=

# Prisma Studio (embedded database browser at /api/pstudio)
ENABLE_PRISMA_STUDIO=true

# API Key Security
# HMAC-SHA256 pepper for API key hashing (leave empty for plain SHA-256 in dev)
API_KEY_PEPPER=
# Allow query parameter API keys in development (convenient for testing)
API_KEY_ALLOW_QUERY_PARAM=true
# No lifetime enforcement in development
API_KEY_MAX_LIFETIME_DAYS=

# =============================================================================
# STT SERVICE (apps/stt-v2) - Speech-to-Text V2
# =============================================================================
# Azure Speech Service (used by STT-V2)
AZURE_SPEECH_KEY=<CHANGE_ME>-your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# STT-V2 service URL (apps/stt-v2)
STT_V2_URL=http://localhost:8861

# STT-specific MinIO bucket
STT_MINIO_BUCKET=recordings

# =============================================================================
# TTS SERVICE (apps/tts) - Text-to-Speech
# =============================================================================
TTS_HOST=0.0.0.0
TTS_PORT=8863
TTS_URL=http://localhost:8863

# Azure TTS Service
AZURE_TTS_API_KEY=<CHANGE_ME>-your-azure-tts-key
AZURE_TTS_REGION=eastus
AZURE_TTS_DEFAULT_VOICE=en-US-JennyNeural
AZURE_TTS_DEFAULT_LANGUAGE=en-US

# TTS-specific MinIO bucket
TTS_MINIO_BUCKET=generated-audio

# TTS Performance
TTS_AUDIO_CACHE_MAX_SIZE=1000
TTS_BATCH_JOBS_MAX_SIZE=100

# =============================================================================
# SMR SERVICE (apps/smr) - Summarization
# =============================================================================
SMR_HOST=0.0.0.0
SMR_PORT=8862
SMR_URL=http://localhost:8862

# LLM Provider: azure_openai, ollama, or langflow
SUMMARY_SERVICE_PROVIDER=azure_openai

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=
# ↑ Phase 0 Item 6 (TASK-302): set this in your local .env.dev.local override.
#   Old committed value was rotated and revoked in Azure portal — see
#   docs/implementation/TASK-302-System-Config-Implementation-Roadmap/_section-a-rotation-log.md
AZURE_OPENAI_ENDPOINT=https://alaas-openai.openai.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2025-01-01-preview
AZURE_OPENAI_API_VERSION="2024-02-01"
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_TEMPERATURE="0.1"
AZURE_OPENAI_MAX_TOKENS="8192"
AZURE_OPENAI_TOP_P="1.0"
AZURE_OPENAI_FREQUENCY_PENALTY="0.0"
AZURE_OPENAI_PRESENCE_PENALTY="0.0"

# SMR V2 Service (apps/smr) - Provider Configuration
SMR_V2_OLLAMA_ENABLED=true
SMR_V2_OLLAMA_BASE_URL=http://localhost:11434
SMR_V2_OLLAMA_DEFAULT_MODEL=gemma3:latest
SMR_V2_OLLAMA_TIMEOUT_S=300

# Langflow Configuration (alternative to Azure/Ollama)
LANGFLOW_BASE_URL=
LANGFLOW_API_KEY=
LANGFLOW_PRESUMMARY_FLOW_ID=
LANGFLOW_SUMMARY_FLOW_ID=

# Summary Agent Settings
SUMMARY_AGENT_HOST=0.0.0.0
SUMMARY_AGENT_PORT=8862
SUMMARY_AGENT_REDIS_URL=redis://localhost:6379
SUMMARY_AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope
SUMMARY_AGENT_MAX_CONVERSATION_LENGTH=50000
SUMMARY_AGENT_CHUNK_SIZE=10000

# =============================================================================
# NLP SERVICE (apps/nlp) - Natural Language Processing
# =============================================================================
NLP_HOST=0.0.0.0
NLP_PORT=8864
NLP_URL=http://localhost:8864

# Model Configuration
TEXT_CLASSIFIER_MODEL_NAME=michellejieli/emotion_text_classifier
TOKEN_CLASSIFIER_MODEL_NAME=blaze999/Medical-NER
MEDICAL_SUGGESTER_MODEL_NAME=shanover/symps_disease_bert_v3_c41

# =============================================================================
# MLFLOW SERVICE (apps/mlflow)
# =============================================================================
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5020
MLFLOW_TRACKING_URI=http://localhost:5020

# Qdrant (vector database for prompts)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PROMPTS=prompts
QDRANT_COLLECTION_DNA=dna_writing_style

# Langflow Integration
LANGFLOW_URL=
LANGFLOW_X_API_KEY=

# =============================================================================
# FEDL SERVICE (apps/fedl) - Federated Learning
# =============================================================================
FEDL_HOST=0.0.0.0
FEDL_PORT=8865
FEDL_URL=http://localhost:8865
FEDL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope

# Aggregation Settings
FEDL_MIN_UPDATES_FOR_AGGREGATION=3
FEDL_WEIGHT_CLIP_MIN=-10.0
FEDL_WEIGHT_CLIP_MAX=10.0

# LoRA Merge Settings
FEDL_LORA_ALPHA=16.0
FEDL_LORA_RANK=8

# FEDL MinIO bucket
FEDL_MINIO_BUCKET=fedl-weights

# =============================================================================
# CELERY CONFIGURATION (Shared by SMR, MLflow, FedL)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=true

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================
# These variables are used by infrastructure/docker/docker-compose.yml
# Docker Compose will automatically load this .env file when run from the
# monorepo root, or you can use --env-file flag.
#
# Usage from monorepo root:
#   docker compose -f infrastructure/docker/docker-compose.yml up -d
#
# Or with explicit env file:
#   docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hope
POSTGRES_PORT=5432

# Redis (Docker container password - leave empty for no auth in development)
# Note: If you set this, also update REDIS_PASS above for application access
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# HASHICORP VAULT (TASK-302 Stream B — Secrets / Transit / Database engines)
# =============================================================================
# This dev env SHIPS Vault on by default: SECRETS_PROVIDER=vault and
# PG_DYNAMIC_CREDS=true (below). One-shot bootstrap from a clean checkout:
#   pnpm dev:setup        # infra -> migrations -> creds -> Vault DB engine
# then `pnpm dev:api`. Dev uses a RAW, reusable VAULT_SECRET_ID (not a
# one-shot wrapped token) so `nest start --watch` reloads keep working; see
# infrastructure/docker/README.md for the raw-vs-wrapped rationale. To run
# WITHOUT Vault, set SECRETS_PROVIDER=env and PG_DYNAMIC_CREDS=false.
#
# Engines mounted by infrastructure/docker/configs/vault/dev-init.sh:
#   secret/    → kv-v2  (static secrets, seeded under secret/hope/*)
#   transit/   → transit (envelope-encryption of GlobalSetting rows, Phase 4)
#   database/  → database (short-lived Postgres credentials, Phase 5)

# --- Provider selection ----------------------------------------------------
# One of: env | vault | aws | azure | in-memory  (defaults to env)
SECRETS_PROVIDER=vault

# --- Vault server (used by both the container and the app client) ---------
VAULT_DEV_ROOT_TOKEN=root
VAULT_ADDR=http://localhost:8200
# VAULT_NAMESPACE=                 # Vault Enterprise only

# --- AppRole credentials (required when SECRETS_PROVIDER=vault) -----------
# TASK-312 A.3/A.7 — populate VAULT_ROLE_ID + VAULT_SECRET_ID in one step:
#   ./scripts/refresh-vault-creds.sh
#
# DEV USES THE *RAW* secret_id (VAULT_SECRET_ID), not the response-wrapped
# one. A wrapping token is single-use, but VaultSecretsProvider.boot() unwraps
# on every process start and `nest start --watch` restarts on every file save —
# so the wrapped path dies on the first code edit. The raw secret_id, with the
# dev AppRole's secret_id_num_uses=0 + secret_id_ttl=720h (A.1), is reusable
# across unlimited restarts for ~30 days. Re-run the script only after a Docker
# volume reset or once the 30-day TTL lapses. (role_id is regenerated on every
# infra bootstrap because dev-mode Vault state is in-memory.)
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# VAULT_WRAPPED_SECRET_ID is the PRODUCTION path (one-shot token injected per
# pod). Leave it blank in dev so the raw VAULT_SECRET_ID path above is taken;
# if both are set, the provider prefers the wrapped one.
VAULT_WRAPPED_SECRET_ID=

# --- Vault paths & timeouts (defaults match dev-init.sh) ------------------
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=hope
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=hope-globalsetting
VAULT_REQUEST_TIMEOUT_MS=5000

# --- Rotation worker audit-log tail (TASK-312 A.4) ------------------------
# Path the VaultRotationWorker tails to publish cache-invalidation events
# when an operator rotates a secret. Must be the HOST side of the bind-mount
# declared on the `vault` service in docker-compose.dev.yml; dev-init.sh
# points Vault's file audit device at the container side (/vault/audit).
# Leave empty to disable the worker (it logs and no-ops).
VAULT_AUDIT_LOG_PATH=/tmp/hope-vault-audit/vault-audit.log

# --- Dynamic PostgreSQL credentials (TASK-312 A.5 — ON by default in dev) --
# When true (and SECRETS_PROVIDER=vault) the API mints short-lived PG users
# via Vault's database engine instead of the static DATABASE_URL credentials.
# One-time setup (creates the vault_admin/hope_app_template PG roles and wires
# Vault's DB engine to this dev database):
#   pnpm dev:setup          # full: infra -> migrations -> vault-db bootstrap
# or, if infra + migrations are already up:
#   ./scripts/setup-dev-vault-db.sh
PG_DYNAMIC_CREDS=true
PG_VAULT_ROLE=hope-app-role
# Pool target for the Vault-backed client (VaultPrismaClient.resolveBaseConfig).
# These mirror DATABASE_URL's host/port/db so the dynamic path hits the SAME
# dev database (`hope`) the static path and migrations use.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hope

# --- vault-init sidecar (configures the database engine target) -----------
# VAULT_DB_NAME MUST match the real dev database (DATABASE_URL → /hope). The
# old `hope_main` default never matched any dev DB, so the engine silently
# failed its connection test until TASK-312 A.5.
VAULT_DB_HOST=host.docker.internal
VAULT_DB_PORT=5432
VAULT_DB_NAME=hope
VAULT_DB_ADMIN_USER=vault_admin
VAULT_DB_ADMIN_PASS=vault_admin_dev_pw

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333

# =============================================================================
# DEVELOPMENT & DEBUG
# =============================================================================
# Enable for verbose debugging (not for production)
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_PROFILING=false

# Prisma debugging
DEBUG_PRISMA=false
