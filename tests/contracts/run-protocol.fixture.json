  "sequencer": {
    "$comment": "F2 fix 2 — the ONE sequencer. Every producer (harness AND gateway) appends with EVAL/EVALSHA of `lua` over KEYS [seq, events, dedupe] and ARGV [maxLen, retentionSeconds|0, dedupeKey|\"\", ...field/value pairs after seq]. The script INCRs `seq` and XADDs `seq <n>` as the FIRST field, so stored seqs are contiguous. A terminal append sets the same EXPIRE on all three keys; an append to a stream whose events key already has an expiry is refused with `closedError`. `<runId>` in `keys` is a placeholder.",
    "keys": {
      "seq": "wf:run:<runId>:seq",
      "events": "wf:run:<runId>:events",
      "dedupe": "wf:run:<runId>:dedupe"
    },
    "fields": [
      "seq",
      "type",
      "ts",
      "nodeId",
      "vis",
      "body"
    ],
    "maxLen": 10000,
    "closedError": "RUN_STREAM_CLOSED",
    "terminalTypes": [
      "run.completed",
      "run.failed",
      "run.cancelled"
    ],
    "lua": "-- HOPE run protocol v2: the ONE run-event sequencer (TASK-1038).\n-- KEYS: [1] wf:run:<runId>:seq  [2] wf:run:<runId>:events  [3] wf:run:<runId>:dedupe\n-- ARGV: [1] maxLen  [2] retention seconds ('0' = not terminal)  [3] dedupe key ('' = none)\n--       [4..] field/value pairs after seq: type, ts, [nodeId], vis, body\nlocal dedupe = ARGV[3]\nif dedupe ~= '' then\n  local prior = redis.call('HGET', KEYS[3], dedupe)\n  if prior then\n    local s, id = string.match(prior, '^(%d+) (.+)$')\n    return {tonumber(s), id, 1}\n  end\nend\nif redis.call('PTTL', KEYS[2]) >= 0 then\n  return redis.error_reply('RUN_STREAM_CLOSED')\nend\nlocal seq = redis.call('INCR', KEYS[1])\nlocal xadd = {'XADD', KEYS[2], 'MAXLEN', '~', ARGV[1], '*', 'seq', tostring(seq)}\nfor i = 4, #ARGV do xadd[#xadd + 1] = ARGV[i] end\nlocal id = redis.call(unpack(xadd))\nif dedupe ~= '' then redis.call('HSET', KEYS[3], dedupe, seq .. ' ' .. id) end\nlocal ttl = tonumber(ARGV[2])\nif ttl > 0 then\n  for i = 1, 3 do redis.call('EXPIRE', KEYS[i], ttl) end\nend\nreturn {seq, id, 0}\n"
  },
