  "_contextEnvelopesComment": "J3-5 \u2014 the SCOPE rule the two renderers must share, as distinct from the grammar cases above. `payloadSchemaFromDefinition` keys a context declaration's payload under each declared KIND, so a schema with one kind keyed `context` yields the envelope {context: {...}} while every seeded template reads {{context.safe_age}} and the render scope aliases `context` to the envelope \u2014 the reference resolves to nothing and the only spelling that would work, {{context.context.safe_age}}, is the one the seed does not ship. So EXACTLY when a schema declares one kind whose key IS the namespace root `context`, the agent path unwraps. Each case gives the frozen `payloadSchema` and the supplied `payload`; `expectedContext` is the object `{{context.*}}` must resolve against. Asserted by unwrapSingleKindContextPayload (TypeScript, context-schema-definition.ts) and by _unwrap_single_kind_context (Python, temporal/interpreter/nodes/core.py). A multi-kind envelope is returned VERBATIM \u2014 there the key is the only thing saying which kind a value belongs to.",
  "contextEnvelopes": [
    {
      "name": "sole-context-kind-envelope-unwrapped",
      "payloadSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "safe_age": {
                "type": "string"
              }
            }
          }
        }
      },
      "payload": {
        "context": {
          "safe_age": "41"
        }
      },
      "expectedContext": {
        "safe_age": "41"
      }
    },
    {
      "name": "sole-context-kind-flat-payload-unchanged",
      "payloadSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "safe_age": {
                "type": "string"
              }
            }
          }
        }
      },
      "payload": {
        "safe_age": "41",
        "visit_type": "follow-up"
      },
      "expectedContext": {
        "safe_age": "41",
        "visit_type": "follow-up"
      }
    },
    {
      "name": "multi-kind-envelope-verbatim",
      "payloadSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "safe_age": {
                "type": "string"
              }
            }
          },
          "audio": {
            "type": "object"
          }
        }
      },
      "payload": {
        "context": {
          "safe_age": "41"
        },
        "audio": {
          "uri": "s3://x"
        }
      },
      "expectedContext": {
        "context": {
          "safe_age": "41"
        },
        "audio": {
          "uri": "s3://x"
        }
      }
    },
    {
      "name": "sole-kind-under-another-name-verbatim",
      "payloadSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "patient": {
            "type": "object",
            "properties": {
              "age": {
                "type": "string"
              }
            }
          }
        }
      },
      "payload": {
        "patient": {
          "age": "41"
        }
      },
      "expectedContext": {
        "patient": {
          "age": "41"
        }
      }
    },
    {
      "name": "no-bound-schema-verbatim",
      "payloadSchema": null,
      "payload": {
        "context": {
          "safe_age": "41"
        }
      },
      "expectedContext": {
        "context": {
          "safe_age": "41"
        }
      }
    },
    {
      "name": "ambiguous-flat-payload-with-a-context-field-is-not-unwrapped",
      "payloadSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "safe_age": {
                "type": "string"
              }
            }
          }
        }
      },
      "payload": {
        "context": "a value",
        "safe_age": "41"
      },
      "expectedContext": {
        "context": "a value",
        "safe_age": "41"
      }
    }
  ]
}
