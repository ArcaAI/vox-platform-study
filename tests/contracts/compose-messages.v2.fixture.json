            "value": "Malayalam"
          }
        },
        "variableDeclarations": [
          {
            "name": "lang",
            "required": false,
            "default": "English"
          }
        ]
      },
      "expected": {
        "lang": "Malayalam",
        "variables": {
          "lang": "Malayalam"
        }
      }
    },
    {
