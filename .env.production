# ============================================================================
# HOPE Platform - Production Environment Template
# ============================================================================
# This file serves as a REFERENCE for production environment variables.
#
# IMPORTANT: In production, environment variables should be set via:
#   - Kubernetes ConfigMaps and Secrets
#   - Docker environment variables
#   - Cloud provider environment configuration (Azure, AWS, etc.)
#   - CI/CD pipeline environment variables
#
# This file is NOT loaded in production. The application uses only host
# environment variables when NODE_ENV=production or CI=true.
#
# ============================================================================

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# These MUST be set in production:

NODE_ENV=production
DEBUG=false

# Database
DATABASE_URL=                      # PostgreSQL connection string (required)

# Redis
REDIS_HOST=                        # Redis host (required)
REDIS_PORT=6379                    # Redis port
REDIS_PASS=                        # Redis password (if authentication enabled)

# Security
JWT_SECRET=                        # Strong random secret for JWT signing (required)
JWT_EXPIRES_IN=1h                  # JWT token expiration
JWT_REFRESH_SECRET=                # Strong random secret for refresh tokens
JWT_REFRESH_EXPIRES_IN=7d          # Refresh token expiration
SESSION_SECRET_KEY=                # Strong random secret for session encryption

# API Key Security
API_KEY_PEPPER=                    # HMAC-SHA256 pepper for key hashing (required, generate with: openssl rand -hex 32)
API_KEY_ALLOW_QUERY_PARAM=false    # NEVER enable in production — keys in URLs leak via logs/history
API_KEY_MAX_LIFETIME_DAYS=365      # Maximum key lifetime; adjust per compliance requirements

# =============================================================================
# SERVICE URLS
# =============================================================================
# Internal service URLs (adjust based on your infrastructure):

PORT=8868                          # API Gateway port
API_URL=http://api:8868            # Internal API URL

TTS_PORT=8863
TTS_URL=http://tts:8863            # TTS service URL

SMR_PORT=8862
SMR_URL=http://smr:8862            # SMR service URL

NLP_PORT=8864
NLP_URL=http://nlp:8864            # NLP service URL

# =============================================================================
# EXTERNAL SERVICE CREDENTIALS
# =============================================================================
# Set these based on your cloud provider:

# Azure Speech Service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure TTS Service
AZURE_TTS_API_KEY=
AZURE_TTS_REGION=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_MODEL=

# =============================================================================
# OBSERVABILITY
# =============================================================================

LOG_LEVEL=info
LOG_FILE_ENABLED=false             # Use container logging instead of file logging

# OpenTelemetry
OTEL_SERVICE_NAMESPACE=hope
OTEL_SERVICE_VERSION=              # Set from CI/CD build version
OTEL_EXPORTER_OTLP_ENDPOINT=       # Your OTLP collector endpoint
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true

# Sentry (optional)
SENTRY_DSN_API=

# =============================================================================
# OBJECT STORAGE (MinIO/S3)
# =============================================================================

MINIO_ENDPOINT=                    # S3-compatible endpoint
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true                 # Always use SSL in production

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

CORS_ALLOWED_ORIGINS=              # Comma-separated list of allowed origins
                                   # e.g., https://app.example.com,https://admin.example.com

# =============================================================================
# GRACEFUL SHUTDOWN
# =============================================================================

SHUTDOWN_TIMEOUT_MS=30000          # Max time to wait for graceful shutdown
SHUTDOWN_DRAIN_DELAY_MS=5000       # Time to wait for load balancer to drain
