# TimescaleDB HA Cluster — Environment Variables
# Image: timescale/timescaledb-ha:pg18-all-amd64
# Copy to .env and fill in values on each node
# Generate passwords: openssl rand -base64 24

# ── Node Identity ──
# Set per node: pg-node1, pg-node2, pg-node3
NODE_NAME=pg-node1
NODE_IP=10.10.1.200

# ── PostgreSQL ──
PG_PASSWORD=CHANGE_ME_superuser_password
REPL_PASSWORD=CHANGE_ME_replicator_password

# ── Application Database ──
APP_DB=hope
APP_USER=hope_app
APP_PASSWORD=CHANGE_ME_app_password

# ── PgBouncer ──
PGBOUNCER_PASSWORD=CHANGE_ME_pgbouncer_password

# ── pgBackRest backup secrets ──
# Injected into the patroni container as PGBACKREST_* env overrides so they stay
# OUT of the committed pgbackrest.conf. In production these are sourced from
# Vault (secret/hope/PGBACKREST_*) at deploy time, not hand-edited here.
#
# MinIO/S3 service-account credentials for the `pgbackrest` bucket. The old
# committed pair was exposed and MUST be rotated in MinIO (deploy-vm402-minio.md
# §9b.3) before first use.
PGBACKREST_REPO1_S3_KEY=CHANGE_ME_pgbackrest_s3_access_key
PGBACKREST_REPO1_S3_KEY_SECRET=CHANGE_ME_pgbackrest_s3_secret_key
# AES-256-CBC repository passphrase — the root of trust for every backup. Without
# it no restore is possible; it cannot be rotated without re-encrypting the repo.
# Generate ONCE, store in Vault, distribute identically to all 3 nodes:
#   openssl rand -base64 48
PGBACKREST_REPO1_CIPHER_PASS=CHANGE_ME_pgbackrest_cipher_passphrase

# ── pgbouncer_exporter ──
# Password for the `hope_metrics` user that pgbouncer-exporter uses to
# read SHOW STATS / SHOW POOLS. Must match the entry in pgbouncer's
# stats_users and userlist.txt.
METRICS_PASSWORD=CHANGE_ME_metrics_password

# ── Cluster Peers ──
PEER1_IP=10.10.1.200
PEER2_IP=10.10.1.201
PEER3_IP=10.10.1.202

# ── VIP (Keepalived) ──
VIP=10.10.1.250
