{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcaai.dev/hope/workflow-nodes/output.deliver.schema.json",
  "title": "output.deliver node config (N-5, safety class: mandatory)",
  "description": "Binds the run result to the declared output shape. `outputs` reuses the `ContextOutputDeclaration` shape from context-schema-definition.ts. The only node with `external_write: true` in this palette — the interpreter suppresses it in sandbox mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["outputs"],
  "properties": {
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "primitive"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]{2,48}$" },
          "label": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 2000 },
          "primitive": { "type": "string", "enum": ["TEXT", "STRUCTURED"] }
        }
      }
    }
  }
}
