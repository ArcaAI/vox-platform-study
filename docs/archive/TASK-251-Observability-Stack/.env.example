###############################################################################
# HOPE Observability Stack — Environment Variables
#
# Copy this file to .env and fill in the values before deploying:
#   cp .env.example .env
#   nano .env
###############################################################################

# ── Grafana ──────────────────────────────────────────────────────────────────
# Admin password for the Grafana web UI (REQUIRED — change this!)
GRAFANA_ADMIN_PASSWORD=<set-a-strong-password>

# Optional: Install additional Grafana plugins (semicolon-separated)
# GRAFANA_PLUGINS=grafana-lokiexplore-app

# ── MinIO (Cold Storage — Phase 5) ──────────────────────────────────────────
# Uncomment these when configuring MinIO cold storage for Loki and Tempo
# MINIO_ENDPOINT=10.10.1.102:9000
# MINIO_ACCESS_KEY=<minio-access-key>
# MINIO_SECRET_KEY=<minio-secret-key>
