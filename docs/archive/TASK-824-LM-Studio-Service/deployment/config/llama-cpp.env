# TASK-824 — configMapGenerator input for `hope-llama-cpp-config`.
#
# Destination: deployment/k8s/base/config/llama-cpp.env in hope-v2-deployment.
#
# ============================================================================
# THIS FILE IS DELIBERATELY ALMOST EMPTY. That is the point.
# ============================================================================
# 00-project-context.md §Configuration Principles: "Never hardcode configuration;
# minimise env vars. An engine name, model id, endpoint, credential, threshold,
# prompt, taxonomy or label set is NOT a literal in code and is NOT an env var.
# Env is the bootstrap floor only."
#
# For this workload the bootstrap floor is: which port to bind. Everything a
# reader might expect to find here lives somewhere else on purpose:
#
#   * The MODEL SELECTION is `AiTaskDefault` -> `AiModel`, resolved tenant ->
#     SYSTEM, and is `failMode: closed`. It is NOT an env var. A
#     `TEXT_LLAMA_CPP_MODEL` here would be exactly the "pydantic-settings field
#     with a real default" anti-pattern §Configuration Principles names.
#   * The ENDPOINT is the `baseUrl` on the SYSTEM `AiProviderConnection` row.
#     `TEXT_LLAMA_CPP_BASE_URL` and `TEXT_VLLM_BASE_URL` were DELETED with the
#     engine sub-configs (TASK-736/799) and are BANNED BY NAME in
#     `test_task799_config_surface.py`. Setting one has no effect at all.
#   * The PER-MODEL RUNTIME FLAGS (ctx-size, parallel, mmproj, flash-attn) are
#     in the `hope-llama-presets` ConfigMap, because they are per-model and an
#     env var cannot express "per model".
#   * The API KEY is Secret `hope-llama-api-key`, read via `--api-key-file`.
#     Never an env var, never a ConfigMap (§Configuration Tiers: `vault-kv`).
#
# If you find yourself adding a model id or an endpoint to this file, the value
# belongs in the database and the addition is the bug.

# Bind port. Transport identity — genuinely bootstrap-floor.
LLAMA_ARG_PORT=8080
LLAMA_ARG_HOST=0.0.0.0

# Consumed by the entrypoint's boot assertion only (image/entrypoint.sh A-2/A-3):
# names the modalities we expect /props to report, so a projector that failed to
# load is visible in the pod log instead of surfacing as a request-time error in
# production. Not passed to llama-server.
HOPE_EXPECT_MODALITIES=vision,audio

# Refuse to start unless the sync Job has published a verified /models/.ready.
# Set to 0 ONLY for a deliberate local experiment against a hand-staged volume.
HOPE_REQUIRE_READY_SENTINEL=1
