  "cards": [
    {
      "dot": "cyan",
      "title": "Multi-Provider LLM Routing",
      "items": [
        "Gateway passes resolved model and provider without hardcoding defaults in env",
        "Egress supports LM Studio, Ollama, vLLM, Azure OpenAI, Bedrock, and Vertex",
        "UsageDetail passthrough accurately tracks engine tokens for multi-tenant billing"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-Closed Safety Interception",
      "items": [
        "ExternalGuardrailClient screens prompts and completions before final response",
        "Safety verification strictly enforces PII redaction and clinical truthfulness",
        "If Guardrail is unreachable, the request fails with 503 rather than leaking raw output"
      ]
    },
    {
      "dot": "emerald",
      "title": "Per-Provider Circuit Breakers",
      "items": [
        "Circuit breakers monitor consecutive failures and trigger OPEN state",
        "HALF-OPEN state conducts trial calls before safely restoring traffic",
        "Automatic fallback router shifts traffic to secondary provider on outage"
      ]
    }
  ]
