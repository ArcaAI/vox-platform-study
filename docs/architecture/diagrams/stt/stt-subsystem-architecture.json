  "cards": [
    {
      "dot": "cyan",
      "title": "Realtime Audio Pipeline",
      "items": [
        "Gateway writes 16kHz PCM audio to Redis Stream stt:audio:{id}",
        "STT Engine runs in-process Silero VAD to detect utterance boundaries",
        "Whisper / NeMo decodes active segments and writes stt:result:{id}"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dramatiq Batch Processing",
      "items": [
        "Dramatiq workers consume from stt_batch queue across worker threads",
        "Downloads multi-channel consultation audio directly from MinIO",
        "Executes PyAnnote speaker diarization and reports progress to Gateway"
      ]
    },
    {
      "dot": "rose",
      "title": "Zero-DB Stateless Inference",
      "items": [
        "Gateway resolves entire pipeline into immutable ResolvedAsrSpec",
        "Engine and Worker read zero PostgreSQL tables during inference",
        "Automatic one-way engine failover to Azure Speech on GPU/model fault"
      ]
    }
  ]
