# ============================================================================
# STT Orchestra - Development Environment Variables
# Copy this file to .env.stt-dev and update with your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# General Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# HashiCorp Vault Configuration
# ----------------------------------------------------------------------------
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN=root  # Development only! Use AppRole in production

# ----------------------------------------------------------------------------
# Azure Speech Service (will be stored in Vault)
# ----------------------------------------------------------------------------
AZURE_SPEECH_KEY=your-azure-speech-subscription-key-here
AZURE_SPEECH_REGION=eastus  # or your preferred region

# ----------------------------------------------------------------------------
# HuggingFace Configuration (will be stored in Vault)
# ----------------------------------------------------------------------------
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_huggingface_token_here

# ----------------------------------------------------------------------------
# Qdrant Configuration
# ----------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=  # Optional for development, leave empty

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# These should match your docker-compose.dev.yml values
DATABASE_URL=postgresql://core_user:core_password@postgres:5432/core
DB_VAULT_USER=vault_admin
DB_VAULT_PASSWORD=vault_admin_password

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_PASSWORD=  # Optional for development, leave empty

# ----------------------------------------------------------------------------
# MinIO Configuration
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# ----------------------------------------------------------------------------
# MLflow Configuration
# ----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=mlflow_password

# ----------------------------------------------------------------------------
# OpenTelemetry Configuration
# ----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# ----------------------------------------------------------------------------
# STT Model Configuration
# ----------------------------------------------------------------------------

# VAD Service
VAD_DEVICE=cpu  # cpu or cuda

# Transcription Service
WHISPER_MODEL_SIZE=large-v3  # tiny, base, small, medium, large-v3
WHISPER_DEVICE=cuda  # cpu or cuda
WHISPER_COMPUTE_TYPE=float16  # float16, int8, int8_float16

NEMO_MODEL_NAME=stt_en_fastconformer_transducer_large
NEMO_DEVICE=cuda  # cpu or cuda

# Recognition Service
RECOGNITION_DEVICE=cpu  # cpu or cuda

# ----------------------------------------------------------------------------
# Service Ports
# ----------------------------------------------------------------------------
STT_ORCHESTRATOR_PORT=5100
STT_VAD_PORT=5101
STT_TRANSCRIPTION_PORT=5102
STT_RECOGNITION_PORT=5103

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------

# Docker Compose replicas
REALTIME_WORKERS=2
BATCH_WORKERS=1

# Resource limits (adjust based on your system)
VAD_CPU=2.0
VAD_MEMORY=4G

TRANSCRIPTION_CPU=4.0
TRANSCRIPTION_MEMORY=12G

RECOGNITION_CPU=2.0
RECOGNITION_MEMORY=4G

ORCHESTRATOR_CPU=1.0
ORCHESTRATOR_MEMORY=2G

# ----------------------------------------------------------------------------
# GPU Configuration (uncomment if using GPU)
# ----------------------------------------------------------------------------
# GPU_ENABLED=true
# GPU_DEVICE_IDS=0  # Comma-separated list of GPU device IDs
# NVIDIA_VISIBLE_DEVICES=0

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
ENABLE_SPEAKER_RECOGNITION=true
ENABLE_REAL_TIME_PROCESSING=true
ENABLE_BATCH_PROCESSING=true

# ----------------------------------------------------------------------------
# Debugging & Development
# ----------------------------------------------------------------------------
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_PROFILING=false

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 1. Do not commit this file with real credentials
# 2. For production, use Vault AppRole authentication instead of VAULT_TOKEN
# 3. Update AZURE_SPEECH_KEY and HUGGINGFACE_TOKEN with your actual values
# 4. GPU configuration requires NVIDIA Docker runtime
# 5. Adjust CPU/Memory limits based on your hardware

