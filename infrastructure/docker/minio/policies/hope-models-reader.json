{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListModelsBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::hope-models"]
    },
    {
      "Sid": "ReadModelObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::hope-models/*"]
    }
  ]
}
