# TTS_OTEL_SERVICE_NAMESPACE=hope

# TTS_PORT=8865

#   This does NOT make tts stateful. The connection subscribes to one pub/sub channel and evicts a cache; it reads
#   no keys, writes none, and holds no tenant state. `apps/tts` stays the "genuine stateless, gateway-injected
#   service" the assessment records — adding Redis for invalidation must never become a route to local tenant
#   resolution.
