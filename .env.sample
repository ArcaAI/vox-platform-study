# ============================================================================
# GUARDRAIL — Safety Engine (apps/guardrail, :8863)
# Source: apps/guardrail/.env.sample
# Hand-maintained (pydantic-settings; too large for this generator to validate). Content audited TASK-582.
# ============================================================================

# Guardrail Service Environment Configuration

# Application Settings
# TASK-582: these carry the GUARDRAIL_V2_ prefix — the root Settings class
# (env_prefix="GUARDRAIL_V2_") is the only reader; a bare GUARDRAIL_ name here
# is silently ignored, same failure mode TASK-411 already fixed for OTel below.
GUARDRAIL_V2_HOST=0.0.0.0
GUARDRAIL_V2_PORT=8863
GUARDRAIL_V2_DEBUG=false
GUARDRAIL_V2_LOG_LEVEL=info
GUARDRAIL_V2_CORS_ENABLED=false
GUARDRAIL_V2_CORS_ORIGINS="[]"

# Inter-service Authentication (empty = auth disabled for local dev)
# [duplicate key, see API GATEWAY (apps/api) above] # GUARDRAIL_SERVICE_TOKEN=""

# --- CANONICAL internal service credential (owner decision D-D, TASK-737/738) --
# INTERNAL_ACCESS_TOKEN is THE one shared internal access token: identical across
# every HOPE service, set by the DevOps engineer, internal use only. It is what
# this service ACCEPTS as X-Service-Token inbound and what it PRESENTS as
# X-Service-Token on every outbound peer call. Unprefixed on purpose — it belongs
# to no single service.
# The per-service / per-pair *_SERVICE_TOKEN vars below are retained ONLY as a
# zero-cost backward-compatibility fallback (inbound accepts EITHER; outbound
# prefers this one and falls back). Set this and the legacy family can be dropped.
# Empty everywhere = auth disabled (local dev / hermetic CI), unchanged.
# [duplicate key, see API GATEWAY (apps/api) above] # INTERNAL_ACCESS_TOKEN=

# Where the control plane lives.
GUARDRAIL_V2_GATEWAY_URL=http://localhost:8868/api/v1

# Connection Pooling
GUARDRAIL_V2_HTTPX_MAX_CONNECTIONS=100
GUARDRAIL_V2_HTTPX_MAX_KEEPALIVE=50

# Observability
# TASK-411: OTel vars renamed to the GUARDRAIL_V2_ prefix — the root Settings
# reads env_prefix GUARDRAIL_V2_, so the old shorter names were silently ignored.
GUARDRAIL_V2_OTEL_ENABLED=false
GUARDRAIL_V2_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
GUARDRAIL_V2_OTEL_SERVICE_NAME=guardrail
GUARDRAIL_V2_METRICS_ENABLED=true

# GLiNER ONNX Configuration (content safety, adversarial detection, PII)
# Model downloads from HuggingFace on first boot and is cached locally.
GUARDRAIL_GLINER_ENABLED=true
GUARDRAIL_GLINER_MODEL_ID=hivetrace/gliner-guard-uniencoder-onnx
GUARDRAIL_GLINER_PRECISION=fp32
GUARDRAIL_GLINER_PROVIDERS=["CPUExecutionProvider"]
GUARDRAIL_GLINER_CLASSIFICATION_THRESHOLD=0.4
GUARDRAIL_GLINER_PII_THRESHOLD=0.5
GUARDRAIL_GLINER_MAX_WORKERS=2

# ──────────────────────────────────────────────────────────────────────────────
# LLM judgement — DELEGATED, so guardrail declares no engine at all (TASK-735).
# Guardrail owns policy (criteria, thresholds, verdict shape, fail-closed posture)
# and posts the actual judgement to apps/text's isolated judge lane
# (POST /api/v1/generate/internal/judge) at TEXT_URL. Provider + model come from
# core."AiTaskDefault" (taskKey guardrail.validate), tenant row over SYSTEM row;
# the tenant's credential comes from its own `llm` AiProviderConnection and is
# forwarded as an opaque provider_overrides blob. There is therefore no
# GUARDRAIL_V2_PROVIDER, no GUARDRAIL_OPENAI_COMPAT_/VLLM/LLAMA_CPP/AZURE/BEDROCK
# block and no GUARDRAIL_*_API_KEY — a guardrail vendor key is a leak, not config.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Per-tenant engine config from DB (TASK-338; DEFAULT-ON since TASK-506).
# When enabled (the default) the guardian provider/model are resolved per tenant
# at request time from core."AiTaskDefault" (taskKey guardrail.validate) joined
# to core."AiModel" (provider / sourceUri / metaData.azureDeployment), tenant
# row over SYSTEM row, via the X-Tenant-Id header, with a short TTL cache.
# FAIL-CLOSED: a DB error, an empty result or a DISABLED tenant row answers 503.
# There is no env engine left to fall back to, so setting this false does not
# produce an env-only mode — it makes medical validation 503 outright.
# ──────────────────────────────────────────────────────────────────────────────
GUARDRAIL_DB_CONFIG_ENABLED=true
# Read-only connection to the shared HOPE core DB (postgres:// auto-normalized to asyncpg).
# In-transit TLS (TASK-369 Phase 2): local dev runs without TLS. In production
# append `?ssl=require` (asyncpg's TLS param — NOT libpq's `sslmode`, which
# asyncpg rejects); verify-full requires an ssl.SSLContext with the CA via
# connect_args (app-side). Prod example:
#   GUARDRAIL_DATABASE_URL=postgresql+asyncpg://guardrail_reader:****@10.10.1.250:5001/hope?ssl=require
GUARDRAIL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope
# NOTE: there is deliberately no GUARDRAIL_DEFAULT_TENANT_ID. The runtime cascade
# is exactly request tenant -> SYSTEM (00000000-...), and a request with no
# X-Tenant-Id resolves SYSTEM only. The retired knob defaulted to 50000000-...,
# which is the "Global" CUSTOMER tenant, not a config tier.
# Resolved per-tenant config cache TTL (seconds).
GUARDRAIL_CONFIG_CACHE_TTL_S=60

# Redis Configuration
GUARDRAIL_REDIS_REDIS_URL=redis://localhost:6379/0
GUARDRAIL_REDIS_TASK_TTL_SECONDS=3600
GUARDRAIL_REDIS_STREAM_MAX_LEN=10000
GUARDRAIL_REDIS_CACHE_TTL_SECONDS=1800

# Job Queue Configuration
GUARDRAIL_V2_QUEUE_MAX_WAIT_S=60.0
GUARDRAIL_V2_QUEUE_MAX_RETRIES=3
GUARDRAIL_V2_QUEUE_RETRY_BACKOFF_S=1.0
GUARDRAIL_V2_QUEUE_BATCH_SIZE=10

# ──────────────────────────────────────────────────────────────────────────────
# Live OUTPUT groundedness gate (TASK-479 · SOTA D2) — POST /guardrail/ground
# Self-hosted NLI entailment of each summary segment against the source transcript,
# behind X-Service-Token like every other route. ENABLED=false (default) is the
# dev/CI bypass: the endpoint answers honestly with `unverified` verdicts and never
# loads a model. Clinical/production sets it true (ops rollout) AND stages the
# self-hosted MiniCheck-class model on the host — track guardrail: no cloud PHI.
# Fail posture is FAIL-CLOSED: a disabled gate, an un-staged model, or a scoring
# error all degrade to `unverified` — no path ever answers `grounded` unchecked.
# ──────────────────────────────────────────────────────────────────────────────
# [duplicate key, see API GATEWAY (apps/api) above] # GUARDRAIL_V2_GROUNDEDNESS_ENABLED=false
GUARDRAIL_V2_GROUNDEDNESS_MODEL_ID=lytang/MiniCheck-Flan-T5-Large
GUARDRAIL_V2_GROUNDEDNESS_ENTAILMENT_THRESHOLD=0.5
GUARDRAIL_V2_GROUNDEDNESS_BATCH_SIZE=16
GUARDRAIL_V2_GROUNDEDNESS_MAX_SEGMENTS=200


# ============================================================================
# HARNESS — Clinical Documentation (apps/harness, :8866)
# Source: apps/harness/.env.sample
# Hand-maintained. Content audited TASK-582.
# ============================================================================

# =============================================================================
# Harness — Clinical Documentation Harness (TASK-330) — Environment Variables
# =============================================================================
# Copy this file to .env and adjust as needed. Application variables use the
# HARNESS_ prefix; the Temporal substrate uses the shared TEMPORAL_ prefix.

# -----------------------------------------------------------------------------
# Application (HARNESS_)
# -----------------------------------------------------------------------------

# Bind host (default: 0.0.0.0)
HARNESS_HOST=0.0.0.0

# Service port (default: 8866)
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_PORT=8866

# Enable debug mode (default: false)
HARNESS_DEBUG=false

# Deployment environment: development (default) | test | staging | prod | production.
# NOT a duplicate of HARNESS_DEBUG — that defaults false, so it cannot tell a real
# deploy from unconfigured local dev. Setting this to a deployed value activates the
# claim-check guard (TASK-533 D-28): HARNESS_CLAIM_CHECK_STORE=memory then refuses to
# boot, because the in-memory store is per-process and loses blobs on cross-worker retry.
HARNESS_ENVIRONMENT=development

# Log level: debug, info, warning, error (default: info)
HARNESS_LOG_LEVEL=info

# CORS allowed origins as JSON array, e.g. ["http://localhost:8868/api/v1"]
HARNESS_CORS_ORIGINS=[]

# Enable CORS middleware (default: false)
HARNESS_CORS_ENABLED=false

# Service token for inter-service auth. Empty = auth disabled (local dev)
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_SERVICE_TOKEN=

# --- CANONICAL internal service credential (owner decision D-D, TASK-737/738) --
# INTERNAL_ACCESS_TOKEN is THE one shared internal access token: identical across
# every HOPE service, set by the DevOps engineer, internal use only. It is what
# this service ACCEPTS as X-Service-Token inbound and what it PRESENTS as
# X-Service-Token on every outbound peer call. Unprefixed on purpose — it belongs
# to no single service.
# The per-service / per-pair *_SERVICE_TOKEN vars below are retained ONLY as a
# zero-cost backward-compatibility fallback (inbound accepts EITHER; outbound
# prefers this one and falls back). Set this and the legacy family can be dropped.
# Empty everywhere = auth disabled (local dev / hermetic CI), unchanged.
# [duplicate key, see API GATEWAY (apps/api) above] # INTERNAL_ACCESS_TOKEN=

# Dedicated token for the Phase-3 institutional-knowledge ingest endpoint
# (POST /api/v1/internal/knowledge/ingest). The ingest guard accepts an
# X-Service-Token matching THIS secret OR the shared HARNESS_SERVICE_TOKEN;
# empty (with an empty shared token) disables the guard for local dev.
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_INTERNAL_SERVICE_TOKEN=

# HTTP client pool sizing (used by the loop's httpx tool clients)
HARNESS_HTTPX_MAX_CONNECTIONS=200
HARNESS_HTTPX_MAX_KEEPALIVE=100

# -----------------------------------------------------------------------------
# Durable loop / gate-adapter (TASK-330 Phase 1, Lane I)
# -----------------------------------------------------------------------------

# Tool-service base URLs the durable loop calls out to.
HARNESS_TEXT_BASE_URL=http://localhost:8862
HARNESS_NLP_BASE_URL=http://localhost:8864
HARNESS_API_BASE_URL=http://localhost:8868
# Summarization palette's guardrail.check node (TASK-720) — direct peer call to apps/guardrail.
HARNESS_GUARDRAIL_BASE_URL=http://localhost:8863

# Peer-service auth for the two clients above: harness's own copy of apps/text's
# TEXT_SERVICE_TOKEN and apps/nlp's NLP_SERVICE_TOKEN, sent as X-Service-Token.
# Each target validates against exactly one configured secret with no OR-fallback,
# so these must match that target's own value — NOT HARNESS_SERVICE_TOKEN. Empty =
# auth disabled (local dev-bypass), same as HARNESS_SERVICE_TOKEN above.
HARNESS_TEXT_SERVICE_TOKEN=
HARNESS_NLP_SERVICE_TOKEN=

# TEXT generation provider/model. Empty/unset => the TEXT service's own default;
# set e.g. provider=lm-studio + a local model id to force on-box generation in dev.
HARNESS_TEXT_PROVIDER=
HARNESS_TEXT_MODEL=

# apps/api internal-harness mount. Lane G's controller sits under the global
# `/api/v1` prefix, so the live default is `/api/v1/internal/harness`.
HARNESS_API_INTERNAL_PREFIX=/api/v1/internal/harness

# Bounded-regen budget + clinician-gate timing (durable, deterministic).
HARNESS_MAX_REGEN=2
HARNESS_GATE_SLA_SECONDS=86400
HARNESS_GATE_ESCALATION_SECONDS=43200

# -----------------------------------------------------------------------------
# Claim-check payload store (TASK-483) — protect the Temporal history budget
# -----------------------------------------------------------------------------
# Large clinical blobs (transcript / assembled prompt / generated note / RAG chunks) are
# moved OUT of the workflow history and replaced with a small content-addressed reference.
# SELF-HOSTED store only (MinIO, S3-compatible) — never a cloud bucket. ENABLED on with the
# byte threshold set (small payloads stay inline). STORE=memory is the process-local fake
# for single-worker dev/test; a MULTI-worker deploy MUST set STORE=s3 + endpoint/creds (a
# cross-worker retry against the in-memory fake fails LOUD). Creds are secrets — real values
# via host env, not this file.
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_CLAIM_CHECK_ENABLED=true
HARNESS_CLAIM_CHECK_STORE=memory
HARNESS_CLAIM_CHECK_MIN_BYTES=65536
HARNESS_CLAIM_CHECK_BUCKET=harness-claim-check
HARNESS_CLAIM_CHECK_ENDPOINT_URL=http://localhost:9000
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_CLAIM_CHECK_ACCESS_KEY=
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_CLAIM_CHECK_SECRET_KEY=
HARNESS_CLAIM_CHECK_REGION=us-east-1
HARNESS_CLAIM_CHECK_SECURE=false
HARNESS_CLAIM_CHECK_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# Eval LLM-as-judge (HARNESS_JUDGE_) — offline PDSQI-9 release-gate judge
# -----------------------------------------------------------------------------
# Model-agnostic judge. provider: openai_compat (LM Studio/vLLM, default) | azure | bedrock.
# Default is a small (<=20B) local model on LM Studio's OpenAI-compatible endpoint.
HARNESS_JUDGE_PROVIDER=openai_compat
# This is the LM Studio model id put on the wire as `model` — it must be an id
# the endpoint actually serves. gemma-4-e2b-it-qat is the owner-standardized
# single model resident in LM Studio (verified served by the live dev instance,
# 2026-08-16), applied everywhere including harness.judge.
HARNESS_JUDGE_MODEL=gemma-4-e2b-it-qat
HARNESS_JUDGE_OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_JUDGE_OPENAI_COMPAT_API_KEY=lm-studio
# Response-format control for the OpenAI-compatible endpoint. Some LM Studio builds
# reject response_format={"type":"json_object"} (400: must be 'json_schema' or 'text');
# set "text" so the judge OMITS the constraint and relies on the "Return ONLY JSON"
# prompt + tolerant parsing (harness.eval.jsonio). Default: json_object. Required as
# "text" for the citation_verify judge on those LM Studio builds.
HARNESS_JUDGE_OPENAI_COMPAT_JSON_RESPONSE_FORMAT=text
# Deterministic judge. max_tokens must be large: reasoning models emit many
# "thinking" tokens before the JSON, and too small a budget truncates mid-reasoning.
HARNESS_JUDGE_TEMPERATURE=0.0
HARNESS_JUDGE_MAX_TOKENS=8192
# reasoning_mode: auto (neutral, default) | think (elicit reasoning) | none (forbid).
HARNESS_JUDGE_REASONING_MODE=auto
# Optional OpenAI-compatible passthrough as a JSON string (e.g. vLLM/Azure knobs):
# HARNESS_JUDGE_EXTRA_BODY={"reasoning_effort":"low"}

# -----------------------------------------------------------------------------
# LLM provider concurrency governor + rate-limit retry (HARNESS_LLM_)
# -----------------------------------------------------------------------------
# Cross-cutting guard shared by EVERY harness LLM client (the runtime judge —
# groundedness/citation_verify — the safety guardian, the embeddings client, the
# reranker, and TEXT generation). A bounded semaphore is kept PER provider endpoint
# (keyed by scheme://host:port, so a base_url with or without /v1 collapses to one
# limiter): all callers hitting the same box collectively respect one cap, so the
# inferential pass's asyncio.gather can fan out without bursting a small local
# server (LM Studio terminates/unloads the model engine under a burst -> 400
# 'terminated'/5xx -> DEGRADED citation_verify/safety). Retries are rate-limit-aware
# (exponential backoff + jitter, honors HTTP 429 Retry-After, retries 5xx /
# connection / 'terminated'); only after the bounded budget is spent does the
# caller's existing fail-safe degrade take over.

# Max in-flight requests PER provider endpoint. Applies independently to each
# endpoint (LM Studio, reranker, TEXT), so distinct boxes still run in parallel.
# TASK-355 tuned this to 6: Phase A (R-2) first raised it 1 -> 2, then Phase B
# (R-4 + per-claim asyncio.gather) made the inferential pass issue REAL concurrent
# work — groundedness fans its claim batches out and Granite fires its 7 criteria
# at once — so 6 is the tuned optimum against LM Studio >=0.4.0 (Max Concurrent
# Predictions = 10 leaves headroom for the embeddings/STT clients on the same box).
# Lower to 1-2 only for a provider that cannot serve parallel slots.
HARNESS_LLM_MAX_CONCURRENCY=6
# Total attempts per call (1 initial + retries) before the caller degrades.
HARNESS_LLM_MAX_ATTEMPTS=5
# Exponential backoff base / ceiling (seconds) and added uniform jitter.
HARNESS_LLM_BACKOFF_BASE_S=0.5
HARNESS_LLM_BACKOFF_MAX_S=20.0
HARNESS_LLM_BACKOFF_JITTER_S=0.25
# Per-CALL wall-clock timeout in seconds (TASK-354 Defect A). Bounds EACH individual
# model call (judge / citation_verify / Granite Guardian) so one hung LM Studio request
# can't burn the whole 900s run_inferential_sensors budget before Temporal retries. A
# timed-out call is transient -> retried within HARNESS_LLM_MAX_ATTEMPTS, then the owning
# sensor self-degrades (reduced assurance, never a silent auto-PASS). <=0 disables it.
# This is the safety net that makes HARNESS_LLM_MAX_CONCURRENCY>1 safe (a hung call now
# ties up a real slot). Default 120 sits well under a healthy ~344s pass (per-call, not
# per-pass), so healthy runs are unaffected.
HARNESS_LLM_REQUEST_TIMEOUT_S=120.0

# -----------------------------------------------------------------------------
# TASK-355 Phase C/D feature flags (default OFF)
# -----------------------------------------------------------------------------
# HARNESS_WARM_START_ENABLED (Phase C, R-6 warm-start) is documented here for
# discoverability, but is NOT read by THIS Python service's Settings — setting it in this
# file has no effect. It is read by the apps/api layer (@arcaai/applications
# HarnessInternalService + PromptAssemblyService via NestJS ConfigService); set it in the
# apps/api environment (root .env.dev / host env), NOT here. Flag OFF restores exact
# pre-Phase-C behavior.
#
# HARNESS_OPTIMISTIC_DELIVERY_ENABLED (Phase D, R-7 optimistic delivery) IS read by this
# service's Settings and snapshotted into the Temporal workflow's HarnessGateConfig
# (temporal/models.py) at workflow start — document:start, then carried over the policy
# merge — so it stays deterministic across replay (never read from env inside the
# workflow). FIRST key of a two-key gate: the optimistic path ALSO requires the durable
# task-355-optimistic-delivery patch marker (permanent in code). Default OFF ⇒ the legacy
# single-phase path, byte-identical to pre-Phase-D history.
HARNESS_OPTIMISTIC_DELIVERY_ENABLED=false

# HARNESS_NER_PRIORS_ENABLED (TASK-480 Half-B, NER-priors reuse) IS read by THIS Python
# service's Settings. When ON, the transcript extract_entities activity reuses
# already-persisted CODED NamedEntity rows (TASK-476) as the NER priors instead of
# re-running the cold NLP pass — killing the redundant second transcript-NER pass. Read at
# runtime inside the (non-deterministic) activity, so it needs no snapshot/patch marker;
# when OFF (or when no persisted prior carries an ontology code) the activity falls back to
# the cold extraction, so it is inert until TASK-476 populates the codes. Default OFF ⇒
# enabling it is an explicit ops rollout, never a silent default flip.
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_NER_PRIORS_ENABLED=false

# HARNESS_ATOMIC_FACT_ENABLED (TASK-481 E2, reference-free atomic-fact verifier) IS read by
# THIS Python service's Settings. When ON, the run_inferential_sensors activity runs a
# DETERMINISTIC self-hosted-NLI atomic-fact groundedness verifier ALONGSIDE the LLM-judge
# groundedness sensor (defense-in-depth; a second, model-cheap gate — NEVER the LLM judge,
# no cloud egress). Read at runtime inside the (non-deterministic) activity, so it adds no
# workflow command / patch marker (the sensor result flows through the activity output; the
# workflow command sequence is byte-identical, replay-safe). A degraded NLI backend degrades
# (never auto-PASS). Default OFF ⇒ an explicit ops rollout once a self-hosted NLI model
# (MiniCheck / AlignScore / HHEM-class) is provisioned; the hermetic default overlap entailer
# needs no model. Pass threshold: HARNESS_SENSOR_ATOMIC_FACT_THRESHOLD (default 0.8).
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_ATOMIC_FACT_ENABLED=false

# -----------------------------------------------------------------------------
# Phase-2 inferential sensors + guardrails (TASK-330 Phase 2)
# -----------------------------------------------------------------------------
# Runtime groundedness/reasoning judge: REUSED from the eval judge above — the
# same HARNESS_JUDGE_* config drives both the offline gate and the runtime loop
# (no separate prefix). Tune the judge via the HARNESS_JUDGE_* block.

# Groundedness sensor threshold: fraction of provenance claims that must be
# entailed by the transcript/evidence (graded, not exact-match). Default: 0.8.
HARNESS_SENSOR_GROUNDEDNESS_THRESHOLD=0.8

# Groundedness claim-batching size (TASK-355 Phase B R-5; uses the HARNESS_JUDGE_ prefix).
# DEFAULT 1 (per-claim, SAFE): the per-claim path is now CONCURRENT (asyncio.gather), so it
# gets the latency win WITHOUT changing the judge's framing. Batching (>=2) states the
# transcript once + labels N claims per call (faster) BUT a live verdict-parity gate showed
# batch >=2 LOOSENED a borderline verdict (an LLM judge's verdict is framing-dependent) —
# keep at 1 unless you re-run that parity gate on YOUR judge model and prove zero loosening.
HARNESS_JUDGE_ENTAILMENT_BATCH_SIZE=1

# -- Safety: IBM Granite Guardian over LM Studio (HARNESS_SAFETY_) -------------
# Enable the safety sensor (default: true).
HARNESS_SAFETY_ENABLED=true
# Engine: lm-studio (default, OpenAI-compatible) | azure | bedrock.
# azure/bedrock require a guardian-capable model hosted on that engine.
HARNESS_SAFETY_PROVIDER=lm-studio
# LM Studio OpenAI-compatible root (already includes /v1; the client posts to
# {base_url}/chat/completions).
HARNESS_SAFETY_BASE_URL=http://localhost:1234/v1
# Model id the engine exposes for the loaded Granite Guardian 4.1 8B build (e.g.
# lmstudio-community/granite-guardian-4.1-8b-GGUF resolving to this id).
HARNESS_SAFETY_MODEL=granite-guardian-4.1-8b
# No-think mode: fast, deterministic yes/no per criterion (default: true).
HARNESS_SAFETY_NO_THINK=true
# Per-call timeout in seconds (default: 60).
HARNESS_SAFETY_TIMEOUT_S=60
# BYOC risk dimensions screened on the generated note (JSON array).
HARNESS_SAFETY_HARM_CRITERIA=["harm","social_bias","jailbreak","violence","profanity","sexual_content","unethical_behavior"]

# -- PHI: fail-closed pre-cloud-egress redaction (HARNESS_PHI_) ----------------
# Enable PHI redaction guard (default: true).
HARNESS_PHI_ENABLED=true
# Fail CLOSED: block cloud egress when PHI removal cannot be confirmed (default: true).
HARNESS_PHI_FAIL_CLOSED=true
# Provider identifiers treated as LOCAL (non-egress, no redaction). Everything
# else — including a provider not listed here — defaults to cloud egress and
# must pass redaction first (default-deny; see PhiConfig in core/config.py).
HARNESS_PHI_LOCAL_PROVIDERS=["lm-studio","openai_compat","vllm","llama-cpp"]

# -----------------------------------------------------------------------------
# Phase-3 institutional RAG — hybrid JIT retriever (HARNESS_RETRIEVAL_)
# -----------------------------------------------------------------------------
# Flag-gated OFF by default: the whole retrieval feature is additive and
# degrade-safe, so Phase 1/2 behaviour is unchanged until you opt in here.
HARNESS_RETRIEVAL_ENABLED=false
# Qdrant base URL (the dedicated knowledge_chunks collection lives here).
HARNESS_RETRIEVAL_QDRANT_URL=http://localhost:6333
# Qdrant API key for authentication (optional; may be empty for local dev).
HARNESS_RETRIEVAL_QDRANT_API_KEY=
# Dedicated collection (NOT the consultation-scoped context_items).
HARNESS_RETRIEVAL_COLLECTION=knowledge_chunks
# Qdrant request timeout in seconds.
HARNESS_RETRIEVAL_QDRANT_TIMEOUT_S=10
# Dense embeddings stay self-hosted (the query can contain PHI). LM Studio
# OpenAI-compatible root (already includes /v1); the client posts to
# {base_url}/embeddings. The model id must match the loaded embedding build
# (plan reference: BAAI/bge-m3, 1024-dim).
HARNESS_RETRIEVAL_EMBEDDINGS_BASE_URL=http://localhost:1234/v1
HARNESS_RETRIEVAL_EMBEDDINGS_MODEL=text-embedding-bge-m3
# Dense vector dim — MUST match the loaded model AND the Qdrant collection
# (1024 for BAAI/bge-m3; set 1536 + recreate the collection for a 1536-dim model).
HARNESS_RETRIEVAL_EMBEDDINGS_DIM=1024
# HF Text-Embeddings-Inference reranker (cross-encoder /rerank). In dev this is
# the hope-reranker container serving BAAI/bge-reranker-v2-m3.
HARNESS_RETRIEVAL_RERANKER_BASE_URL=http://localhost:8870
# Hybrid knobs: dense+sparse prefetch limit -> RRF(rrf_k) fusion -> rerank to top-k.
HARNESS_RETRIEVAL_TOP_K_RETRIEVAL=20
HARNESS_RETRIEVAL_TOP_K_RERANK=5
HARNESS_RETRIEVAL_RRF_K=60

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# TASK-582: no HARNESS_OTEL_* prefix exists anywhere on this service's Settings —
# this app has no OpenTelemetry integration (unlike stt/text, which read bare
# OTEL_* vars). A previously-declared HARNESS_OTEL_* block here configured
# nothing; removed rather than left as dead documentation.

# Enable Prometheus metrics endpoint (default: true)
HARNESS_METRICS_ENABLED=true

# OpenTelemetry tracing (TASK-636 OBS-14) — FastAPI app AND the Temporal
# client/worker (via the SDK's TracingInterceptor). Default OFF and requires
# BOTH the flag and an endpoint (TASK-411 invariant).
HARNESS_OTEL_ENABLED=false
HARNESS_OTEL_EXPORTER_ENDPOINT=
HARNESS_OTEL_SERVICE_NAME=harness
HARNESS_OTEL_SERVICE_NAMESPACE=hope
# Resolved from DEPLOYMENT_ENVIRONMENT -> NODE_ENV -> development when unset.
# NEVER default this to "production" (TASK-636 OBS-18).
HARNESS_OTEL_DEPLOYMENT_ENVIRONMENT=
HARNESS_OTEL_INSECURE=true

# TASK-636 OBS-06 — Temporal SDK metrics in the WORKER process.
# The worker (`pnpm worker:dev`) is separate from the FastAPI app, so :8866
# /metrics says nothing about task-queue latency, workflow-task timeouts or
# activity failures. Loopback by default (PHI posture); containers set 0.0.0.0.
HARNESS_TEMPORAL_METRICS_HOST=127.0.0.1
HARNESS_TEMPORAL_METRICS_PORT=9464

# -----------------------------------------------------------------------------
# Temporal durable-workflow substrate (TEMPORAL_)
# -----------------------------------------------------------------------------
# The Temporal dev stack is opt-in via the docker compose `temporal` profile:
#   docker compose -f infrastructure/docker/docker-compose.yml \
#                  -f infrastructure/docker/docker-compose.dev.yml \
#                  --profile temporal up -d
# Web UI: http://localhost:8233   gRPC frontend: localhost:7233
#
# Image pins live in docker-compose.dev.yml (server/admin-tools 1.31.2, UI 2.53.1).
# If hope-temporal fails on a leftover auto-setup 1.29.x DB, hop — do not wipe:
#   TEMPORAL_VERSION=1.30.4 TEMPORAL_ADMINTOOLS_VERSION=1.30.4 pnpm infra:dev:up
#   # wait healthy, then  pnpm infra:dev:up
# admin-tools:1.29.7 does not exist; last auto-setup is 1.29.7.
# Print-only helper: pnpm infra:dev:temporal-hop
# Runbook: docs/implementation/TASK-702-Dependency-Blocker-Resolutions

# Temporal frontend (gRPC) address. Local dev: localhost:7233; in-container: temporal:7233
TEMPORAL_ADDRESS=localhost:7233

# Temporal namespace (compose create-namespace job creates "default")
TEMPORAL_NAMESPACE=default

# Task queue the worker polls and workflows are dispatched to
TEMPORAL_TASK_QUEUE=harness-task-queue

# Client connect timeout in seconds (FastAPI lifespan best-effort connect)
TEMPORAL_CONNECT_TIMEOUT_S=5.0


# ============================================================================
# NLP — Medical NLP (apps/nlp, :8864)
# Source: apps/nlp/.env.sample
# Hand-maintained. Content audited TASK-582.
# ============================================================================

# App
# HOST/PORT/WORKERS are bare (not NLP_-prefixed) — read directly via
# os.getenv() in NLPServiceConfig.__init__, not through the NLP_ env_prefix.
HOST=0.0.0.0
# [duplicate key, see ROOT BOOTSTRAP FLOOR above] # PORT=8864
WORKERS=1
# [duplicate key, see API GATEWAY (apps/api) above] # LOG_LEVEL=info
# Gates /docs and /redoc exposure (utils.py is_production()) and the
# deployment.environment resource attribute on exported telemetry.
NLP_ENVIRONMENT=development  # development, staging, production

# Inter-service Authentication (TASK-465): the gateway sends X-Service-Token on
# every hop; the NLP middleware enforces it on non-exempt HTTP + WS surfaces.
# Empty = auth disabled (local dev / hermetic CI). Must match the value
# provisioned for the gateway (same secret both sides).
# [duplicate key, see API GATEWAY (apps/api) above] # NLP_SERVICE_TOKEN=""

# --- CANONICAL internal service credential (owner decision D-D, TASK-737/738) --
# INTERNAL_ACCESS_TOKEN is THE one shared internal access token: identical across
# every HOPE service, set by the DevOps engineer, internal use only. It is what
# this service ACCEPTS as X-Service-Token inbound and what it PRESENTS as
# X-Service-Token on every outbound peer call. Unprefixed on purpose — it belongs
# to no single service.
# The per-service / per-pair *_SERVICE_TOKEN vars below are retained ONLY as a
# zero-cost backward-compatibility fallback (inbound accepts EITHER; outbound
# prefers this one and falls back). Set this and the legacy family can be dropped.
# Empty everywhere = auth disabled (local dev / hermetic CI), unchanged.
# [duplicate key, see API GATEWAY (apps/api) above] # INTERNAL_ACCESS_TOKEN=

# Model selection (which model to run) is NOT configured via env.
# The classify/diagnosis endpoints require a `model_name` injected by the gateway
# from the DB AiModel registry, and fail closed with HTTP 503 when it is missing
# or the model cannot be loaded. `*_MODEL_NAME` / `*_TOKENIZER_NAME` env vars are
# ignored for selection; only tuning env (thresholds, GPU flags, tokenizer
# behavior, dictionary paths) below still applies.
#
# Document-type text classifier (/classify/text): OPEN DECISION (TASK-330 §3.4) —
# the intended clinical doc-type model + label taxonomy is undecided, so the
# capability stays fail-closed (HTTP 503) until a real doc-type model is configured
# in the DB and injected as `model_name`.

# Clinical ontology linker (TASK-476 C1). Token classification links recognized
# spans to UMLS/SNOMED/RxNorm/ICD-10/LOINC via a bundled self-hosted vocabulary
# (no cloud PHI). Both optional — defaults baked in.
NLP_LINKER_ENABLED=true
NLP_LINKER_CONFIDENCE_FLOOR=0.0

# Log file
# [duplicate key, see API GATEWAY (apps/api) above] # LOG_FILE_ENABLED=true
# [duplicate key, see API GATEWAY (apps/api) above] # LOG_FILE_PATH=./logs
# [duplicate key, see API GATEWAY (apps/api) above] # LOG_FILE_MAX_SIZE=10m
# [duplicate key, see API GATEWAY (apps/api) above] # LOG_FILE_MAX_FILES=1000
# [duplicate key, see API GATEWAY (apps/api) above] # LOG_FILE_SEPARATE_ERROR=false
LOG_CONSOLE_JSON_FORMAT=false

# Prometheus /metrics endpoint (pull, not push — independent of OTel export).
# Fleet convention: each service owns its own switch, matching
# TEXT_METRICS_ENABLED / TTS_METRICS_ENABLED / GUARDRAIL_V2_METRICS_ENABLED /
# HARNESS_METRICS_ENABLED / METRICS_ENABLED (STT). NLP previously inherited the
# gateway-scoped OTEL_METRICS_ENABLED below, which is false — so its /metrics
# endpoint returned 404 in every environment (TASK-636 OBS-02).
NLP_METRICS_ENABLED=true

# OpenTelemetry
# Master switch (new in TASK-411): gates traces + metrics + logs. OTel export
# stays fully OFF unless this is true AND the endpoint below is set.
NLP_OTEL_ENABLED=false
# [duplicate key, see API GATEWAY (apps/api) above] # OTEL_SERVICE_NAME=hope-nlp
# [duplicate key, see API GATEWAY (apps/api) above] # OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=hope
# Telemetry export is OPT-IN: leave empty unless an OTLP collector is running
# (dev has none by default — see infrastructure/docker/README.md,
# "Observability" section). Example: http://localhost:4317
# [duplicate key, see API GATEWAY (apps/api) above] # OTEL_EXPORTER_OTLP_ENDPOINT=
# [duplicate key, see API GATEWAY (apps/api) above] # OTEL_TRACES_ENABLED=false
# [duplicate key, see API GATEWAY (apps/api) above] # OTEL_METRICS_ENABLED=false
OTEL_RESOURCE_ATTRIBUTES=service.name=hope-nlp,service.namespace=hope,deployment.environment=development
# --- Model weight cache root (TASK-778) --------------------------------------
# WHERE weights are cached, never WHICH checkpoint runs — selection stays in
# `AiTaskDefault` x `AiModel` and arrives per request. Read by huggingface_hub /
# gliner2 out of os.environ, which `hope_env.load_env()` populates from this file.
#
# It MUST be declared here rather than inherited from an operator's login shell:
# a `~/.zshrc` export does NOT reach the non-interactive shells that services,
# CI and coding agents run in, so an undeclared value silently redirects every
# download to ~/.cache/huggingface. That is exactly how TASK-778's first
# "validated against real weights" claim came to be unsubstantiated.
#
# Unset = the huggingface default (~/.cache/huggingface).
HF_HOME=/Volumes/aillusion/huggingface

# --- Guard-plane inference placement + service classes (TASK-782) ------------
# WHERE the guard tensors execute. Transport/topology, never model identity —
# selection stays `AiTaskDefault` x `AiModel` and arrives per request.
#   cpu   safe on every host, and the only correct value on a Linux/k3s node
#         without a GPU (MPS is Apple-silicon only, so it is a developer-machine
#         placement, not a deployment one)
#   auto  the best device actually present; the ONLY form allowed to land on CPU
#         silently
#   mps / cuda  explicit — RAISES at load when absent, because a latency SLO
#         built on an accelerator that is not there is a false promise
NLP_INFERENCE_DEVICE=cpu
# Submodules kept on CPU when the device is an accelerator. A runtime-COMPAT
# fact about the installed gliner2/torch build, not policy: `count_embed.gru`
# trips an MPSNDArray assertion that ABORTS the process (SIGABRT, not an
# exception), so on MPS the relocation is mandatory rather than an optimisation.
# A torch release that fixes it is answered by emptying this list.
NLP_INFERENCE_DEVICE_CPU_ONLY_MODULES=count_embed.gru
# The INTERACTIVE lane — a synchronous inline gate on a clinician's turn. It has
# its own queue geometry because it has its own latency budget; the bulk
# (per-utterance redaction) lane keeps NLP_INFERENCE_BATCH_* above.
# The wait ceiling IS the declared gate SLO: past it the verdict is too late to
# gate anything, so a 503 the caller fails closed on beats a stale 200.
NLP_INFERENCE_INTERACTIVE_BATCH_MAX_SIZE=2
NLP_INFERENCE_INTERACTIVE_BATCH_LINGER_MS=2
NLP_INFERENCE_INTERACTIVE_QUEUE_MAX_DEPTH=64
NLP_INFERENCE_INTERACTIVE_QUEUE_MAX_WAIT_SECONDS=2


# ============================================================================
# Text — LLM Summarization (apps/text, :8862)
# Source: apps/text/.env.sample
# Hand-maintained. Content audited TASK-582.
# ============================================================================

# =============================================================================
# TEXT — Environment Variables
# =============================================================================
# Copy this file to .env and fill in secrets. Used by docker-compose and local dev.
# All variables use the TEXT_ prefix (or provider-specific prefixes).

# -----------------------------------------------------------------------------
# Application (TEXT_)
# -----------------------------------------------------------------------------

# Bind host (default: 0.0.0.0)
TEXT_HOST=0.0.0.0

# Service port (default: 8862)
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_PORT=8862

# Enable debug mode (default: false)
TEXT_DEBUG=false

# Log level: debug, info, warning, error (default: info)
TEXT_LOG_LEVEL=info

# CORS allowed origins as JSON array, e.g. ["http://localhost:8868/api/v1"]
TEXT_CORS_ORIGINS=[]

# Enable CORS middleware (default: false)
TEXT_CORS_ENABLED=false

# Service token for inter-service auth. Empty = auth disabled (local dev)
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_SERVICE_TOKEN=

# --- CANONICAL internal service credential (owner decision D-D, TASK-737/738) --
# INTERNAL_ACCESS_TOKEN is THE one shared internal access token: identical across
# every HOPE service, set by the DevOps engineer, internal use only. It is what
# this service ACCEPTS as X-Service-Token inbound and what it PRESENTS as
# X-Service-Token on every outbound peer call. Unprefixed on purpose — it belongs
# to no single service.
# The per-service / per-pair *_SERVICE_TOKEN vars below are retained ONLY as a
# zero-cost backward-compatibility fallback (inbound accepts EITHER; outbound
# prefers this one and falls back). Set this and the legacy family can be dropped.
# Empty everywhere = auth disabled (local dev / hermetic CI), unchanged.
# [duplicate key, see API GATEWAY (apps/api) above] # INTERNAL_ACCESS_TOKEN=

# Where the control plane lives (bootstrap transport, not config authority).
TEXT_GATEWAY_URL=http://localhost:8868/api/v1

# HTTP client pool: max connections (default: 200)
TEXT_HTTPX_MAX_CONNECTIONS=200

# HTTP client pool: max keepalive connections (default: 100)
TEXT_HTTPX_MAX_KEEPALIVE=100

# External Guardrail service integration (default: disabled).
# Fail posture is degrade-safe -> fail-CLOSED (TASK-478): a transient blip is
# absorbed by a bounded retry (MAX_RETRIES / RETRY_BACKOFF_MS), a sustained outage
# rejects (retryable 503), and an errored guardrail NEVER allows. ENABLED=false is
# the dev/CI bypass; clinical/production must enable it (ops rollout step).
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_EXTERNAL_GUARDRAIL_ENABLED=false
TEXT_EXTERNAL_GUARDRAIL_BASE_URL=http://localhost:8863
TEXT_EXTERNAL_GUARDRAIL_TIMEOUT_S=10
TEXT_EXTERNAL_GUARDRAIL_MAX_RETRIES=2
TEXT_EXTERNAL_GUARDRAIL_RETRY_BACKOFF_MS=100
TEXT_EXTERNAL_GUARDRAIL_REQUIRE_MEDICAL=true
TEXT_EXTERNAL_GUARDRAIL_INCLUDE_REASONING=false
TEXT_EXTERNAL_GUARDRAIL_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# OpenTelemetry (TEXT_OTEL_)
# -----------------------------------------------------------------------------

# Enable OpenTelemetry tracing (default: false)
TEXT_OTEL_ENABLED=false

# OTLP exporter endpoint (default: http://localhost:4317)
TEXT_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# Service name for traces (default: text)
TEXT_OTEL_SERVICE_NAME=text

# Service namespace for trace grouping (default: hope)
TEXT_OTEL_SERVICE_NAMESPACE=hope

# Deployment environment for trace filtering (default: production)
TEXT_OTEL_DEPLOYMENT_ENVIRONMENT=production

# Use insecure (non-TLS) gRPC connection to OTLP collector (default: true)
TEXT_OTEL_INSECURE=true

# Enable OTLP log export to Loki via OTel Collector (default: true when otel_enabled)
TEXT_OTEL_LOGS_ENABLED=true

# Enable Prometheus metrics endpoint (default: true)
TEXT_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# PHI-safe telemetry (bare — no TEXT_ prefix; shared cross-process convention,
# TASK-615 WS-G, docs/operations/telemetry-phi-guardrails.md)
# -----------------------------------------------------------------------------

# Pins the OTel GenAI instrumentation-library content-capture switch off so
# prompt/completion text (PHI) never lands on spans. Read identically by
# apps/api (Node) and every Python service via the SAME bare name — see
# `TelemetryPhiGuardConfig` in core/config.py. Boot refuses to start when
# NODE_ENV=production and this is unset or not exactly NO_CONTENT.
# [duplicate key, see API GATEWAY (apps/api) above] # OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# -----------------------------------------------------------------------------
# Redis (TEXT_)
# -----------------------------------------------------------------------------

# Redis URL for task management (default: redis://localhost:6379/0)
TEXT_REDIS_URL=redis://localhost:6379/0

# Task TTL in seconds (default: 3600)
TEXT_TASK_TTL_SECONDS=3600

# Stream max length for Redis Streams (default: 10000)
TEXT_STREAM_MAX_LEN=10000

# -----------------------------------------------------------------------------
# Circuit Breaker (TEXT_CB_)
# -----------------------------------------------------------------------------

# Failures before opening circuit (default: 5)
TEXT_CB_FAILURE_THRESHOLD=5

# Seconds before half-open attempt (default: 30.0)
TEXT_CB_RECOVERY_TIMEOUT_S=30.0

# Max calls in half-open state (default: 3)
TEXT_CB_HALF_OPEN_MAX_CALLS=3

# Seconds before full reset (default: 120.0)
TEXT_CB_RESET_TIMEOUT_S=120.0

# Count rate limits as failures (default: true)
TEXT_CB_COUNT_RATE_LIMITS=true

# -----------------------------------------------------------------------------
# Request Queue (TEXT_QUEUE_)
# -----------------------------------------------------------------------------

# Max queue size per provider (default: 200)
TEXT_QUEUE_MAX_SIZE=200

# Max wait time in seconds before rejecting (default: 60.0)
TEXT_QUEUE_MAX_WAIT_S=60.0

# -----------------------------------------------------------------------------
# Ollama Provider (TEXT_OLLAMA_) — self-host tier (OPTIONAL).
# The provider logic is supported (owner decision 2026-08-17, TASK-736) but the
# platform seeds NO Ollama model catalog, so there is deliberately no
# TEXT_OLLAMA_DEFAULT_MODEL here: the model id is DB-tier config that arrives
# with the request (tenant AiModel / AiTaskDefault), never an env var.
# NOTE: no TEXT_OLLAMA_ENABLED — gated by base_url presence, same as vLLM.
# -----------------------------------------------------------------------------
# TEXT_OLLAMA_BASE_URL=http://localhost:11434
# TEXT_OLLAMA_TIMEOUT_S=300
# TEXT_OLLAMA_MAX_CONCURRENT=4
# TEXT_OLLAMA_QUEUE_BACKOFF_S=2.0

# -----------------------------------------------------------------------------
# vLLM Provider (TEXT_VLLM_) — production self-host tier (OPTIONAL).
# Root .env.production already configures this engine (hope-vllm in-cluster
# Service); commented here since it's not part of the local dev default stack.
# NOTE: no TEXT_VLLM_ENABLED — gated by base_url presence, same as Azure.
# -----------------------------------------------------------------------------
# TEXT_VLLM_BASE_URL=http://localhost:8000/v1
# TEXT_VLLM_TIMEOUT_S=300
# TEXT_VLLM_MAX_CONCURRENT=8
# TEXT_VLLM_USE_GUIDED_JSON=false

# -----------------------------------------------------------------------------
# llama.cpp Provider (TEXT_LLAMA_CPP_) — production self-host tier (OPTIONAL).
# Root .env.production already configures this engine (hope-llama-cpp
# in-cluster Service). NOTE: no TEXT_LLAMA_CPP_ENABLED, same reason as above.
# -----------------------------------------------------------------------------
# TEXT_LLAMA_CPP_BASE_URL=http://localhost:8080
# TEXT_LLAMA_CPP_TIMEOUT_S=300
# TEXT_LLAMA_CPP_MAX_CONCURRENT=4

# -----------------------------------------------------------------------------
# Azure OpenAI Provider (TEXT_AZURE_)
# -----------------------------------------------------------------------------

# NOTE: there is deliberately NO `TEXT_AZURE_ENABLED`. TEXT gates a provider by
# the PRESENCE of its connection config, not by an `enabled` flag —
# `AzureOpenAIConfig` has no such field (verified 2026-07-28, TASK-582).

# TASK-602: Azure OpenAI is BYOK-only — the api_key is NEVER an env var. It
# arrives per request via the DB/Vault provider-connection plane (tenant→SYSTEM).
# Only the non-secret ENDPOINT is configured here; a keyless request fails closed
# (503). TEXT_AZURE_API_KEY has been removed.

# Azure endpoint URL (e.g. https://your-resource.openai.azure.com/)
TEXT_AZURE_ENDPOINT=

# API version (default: 2024-12-01-preview)
TEXT_AZURE_API_VERSION=2024-12-01-preview

# Deployment name
TEXT_AZURE_DEPLOYMENT_NAME=

# Default model. Empty by design (TASK-579): provider/model SELECTION is
# fail-closed — an unresolved model raises rather than substituting a vendor
# default. This is informational only (providers listing), never substituted.
TEXT_AZURE_DEFAULT_MODEL=

# Request timeout in seconds (default: 120)
TEXT_AZURE_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_AZURE_MAX_CONCURRENT=10

# Tokens per minute limit (default: 80000)
TEXT_AZURE_TPM_LIMIT=80000

# Requests per minute limit (default: 480)
TEXT_AZURE_RPM_LIMIT=480

# Use adaptive limits from provider headers (default: true)
TEXT_AZURE_ADAPTIVE_LIMITS=true

# Content filter severity: low, medium, high (default: medium)
TEXT_AZURE_CONTENT_FILTER_SEVERITY=medium

# -----------------------------------------------------------------------------
# AWS Bedrock Provider (TEXT_BEDROCK_)
# -----------------------------------------------------------------------------

# AWS region (default: us-east-1)
TEXT_BEDROCK_REGION=us-east-1

# Default model. Empty by design (TASK-579) — see TEXT_AZURE_DEFAULT_MODEL note.
TEXT_BEDROCK_DEFAULT_MODEL=

# Request timeout in seconds (default: 120)
TEXT_BEDROCK_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_BEDROCK_MAX_CONCURRENT=10

# Max pool connections for httpx (default: 150)
TEXT_BEDROCK_MAX_POOL_CONNECTIONS=150

# Tokens per minute limit (default: 100000)
TEXT_BEDROCK_TPM_LIMIT=100000

# Requests per minute limit (default: 100)
TEXT_BEDROCK_RPM_LIMIT=100

# Backoff after throttle in seconds (default: 30.0)
TEXT_BEDROCK_THROTTLE_BACKOFF_S=30.0

# Bedrock guardrail ID (optional)
TEXT_BEDROCK_GUARDRAIL_ID=

# Guardrail version: DRAFT or version number (default: DRAFT)
TEXT_BEDROCK_GUARDRAIL_VERSION=DRAFT

# -----------------------------------------------------------------------------
# OpenAI Provider (TEXT_OPENAI_) — BYO/tenant-first
# The values below are the PLATFORM FALLBACK, used only when a request carries
# no tenant BYO credential. Tenant keys flow through the DB/Vault provider plane,
# never through env. An empty API key means no platform fallback is configured.
# -----------------------------------------------------------------------------

# TASK-602: OpenAI is BYOK-only — the api_key is NEVER an env var (arrives per
# request via the provider-connection plane). TEXT_OPENAI_API_KEY has been removed.

# Base URL (default: https://api.openai.com/v1)
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_OPENAI_BASE_URL=https://api.openai.com/v1

# Default model. Empty by design (TASK-579) — see TEXT_AZURE_DEFAULT_MODEL note.
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_OPENAI_DEFAULT_MODEL=

# Organization id (optional)
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_OPENAI_ORGANIZATION=

# Request timeout in seconds (default: 120)
TEXT_OPENAI_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_OPENAI_MAX_CONCURRENT=10

# Tokens per minute limit, 0 = disabled (default: 0)
TEXT_OPENAI_TPM_LIMIT=0

# Requests per minute limit, 0 = disabled (default: 0)
TEXT_OPENAI_RPM_LIMIT=0

# -----------------------------------------------------------------------------
# Anthropic Provider (TEXT_ANTHROPIC_) — BYO/tenant-first
# Platform fallback only; tenant keys flow through the DB/Vault provider plane.
# -----------------------------------------------------------------------------

# TASK-602: Anthropic is BYOK-only — the api_key is NEVER an env var (arrives per
# request via the provider-connection plane). TEXT_ANTHROPIC_API_KEY has been removed.

# Base URL override (optional; empty uses the SDK default)
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_ANTHROPIC_BASE_URL=

# Default model. Empty by design (TASK-579) — see TEXT_AZURE_DEFAULT_MODEL note.
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_ANTHROPIC_DEFAULT_MODEL=

# Request timeout in seconds (default: 120)
TEXT_ANTHROPIC_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_ANTHROPIC_MAX_CONCURRENT=10

# Tokens per minute limit, 0 = disabled (default: 0)
TEXT_ANTHROPIC_TPM_LIMIT=0

# Requests per minute limit, 0 = disabled (default: 0)
TEXT_ANTHROPIC_RPM_LIMIT=0

# -----------------------------------------------------------------------------
# Google Vertex AI Provider (TEXT_VERTEX_) — BYO/tenant-first
# Platform fallback is ADC-authenticated; a tenant BYO credential carries a
# service-account JSON + its own project/location. Empty project = no fallback.
# -----------------------------------------------------------------------------

# GCP project id (platform fallback; empty for BYO-only)
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_VERTEX_PROJECT=

# Location / region (default: us-central1)
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_VERTEX_LOCATION=us-central1

# Default model. Empty by design (TASK-579) — see TEXT_AZURE_DEFAULT_MODEL note.
# [duplicate key, see API GATEWAY (apps/api) above] # TEXT_VERTEX_DEFAULT_MODEL=

# Request timeout in seconds (default: 120)
TEXT_VERTEX_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_VERTEX_MAX_CONCURRENT=10

# Tokens per minute limit, 0 = disabled (default: 0)
TEXT_VERTEX_TPM_LIMIT=0

# Requests per minute limit, 0 = disabled (default: 0)
TEXT_VERTEX_RPM_LIMIT=0

# -----------------------------------------------------------------------------
# Sarvam Translation Provider (TEXT_SARVAM_) — BYOK-ONLY
# Powers the `translate` capability (POST /api/v1/translate). Sarvam is
# BYOK-only: the api_key is NEVER an env var — it arrives per request via
# provider_overrides (the gateway resolves it from the provider-connection). A
# request with no override key fails closed -> 503. Only NON-secret operational
# settings live here.
# -----------------------------------------------------------------------------

# REST base URL (default: https://api.sarvam.ai)
TEXT_SARVAM_BASE_URL=https://api.sarvam.ai

# Translate model override, optional (empty = Sarvam default)
TEXT_SARVAM_MODEL=

# -----------------------------------------------------------------------------
# OpenAI-Compatible Provider (TEXT_OPENAI_COMPAT_)
# -----------------------------------------------------------------------------

# NOTE: there is deliberately NO `TEXT_OPENAI_COMPAT_ENABLED`. TEXT gates a
# provider by the PRESENCE of its connection config, not by an `enabled` flag —
# `OpenAICompatConfig` has no such field, so the variable configured nothing
# (verified 2026-07-25, TASK-558 lane D D7).

# Base URL (e.g. http://localhost:1234/v1)
TEXT_OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1

# API key (use "not-needed" for local models without auth)
TEXT_OPENAI_COMPAT_API_KEY=not-needed

# Default model (default: local-model)
TEXT_OPENAI_COMPAT_DEFAULT_MODEL=local-model

# Request timeout in seconds (default: 300)
TEXT_OPENAI_COMPAT_TIMEOUT_S=300

# Max concurrent requests (default: 4)
TEXT_OPENAI_COMPAT_MAX_CONCURRENT=4

# Organization header (optional)
# TEXT_OPENAI_COMPAT_ORGANIZATION=

# -----------------------------------------------------------------------------
# Docker Compose Overrides (optional)
# -----------------------------------------------------------------------------

# TEXT port mapping (default: 8862)
# TEXT_PORT=8862

# Redis port mapping (default: 6379)
# REDIS_PORT=6379

# Grafana admin password when using monitoring profile (default: admin)
# GRAFANA_PASSWORD=admin


# ============================================================================
# STT — Speech-to-Text (apps/stt, :8861)
# Source: apps/stt/.env.sample
# Hand-maintained. Content audited TASK-582.
# ============================================================================

# =============================================================================
# STT Service — Environment Configuration
# =============================================================================
#
# Copy this file to .env and update values for your environment:
#   cp .env.example .env
#
# LEGEND:
#   [REQUIRED]  — Must be set before running (no safe default)
#   [SECRET]    — Contains credentials; never commit real values
#   [OPTIONAL]  — Has a sensible default; override only if needed
#   [DEV-ONLY]  — Default is for local development; MUST change in production
#   [PROD]      — Production-recommended value shown in comment
#
# All variables map to the Settings class in:
#   src/stt/core/config/settings.py
#
# Pydantic-settings loads these automatically (case-insensitive).
# Priority: env vars > .env file > default in Settings class.
# =============================================================================


# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=stt
APP_VERSION=2.0.0
# [duplicate key, see API GATEWAY (apps/api) above] # LOG_LEVEL=INFO                                # [OPTIONAL] DEBUG | INFO | WARNING | ERROR
                                              # [PROD] INFO or WARNING
# [duplicate key, see NLP — Medical NLP (apps/nlp, :8864) above] # HOST=0.0.0.0                                  # [OPTIONAL] Bind address
# [duplicate key, see ROOT BOOTSTRAP FLOOR above] # PORT=8861                                     # [OPTIONAL] HTTP port
# [duplicate key, see API GATEWAY (apps/api) above] # DEBUG=false                                   # [OPTIONAL] Enable debug mode
                                              # [PROD] MUST be false

# CORS — JSON array of allowed origins. EMPTY by default: stt handles PHI audio
# and is gateway-fronted, so no browser origin talks to :8861 directly. Set it
# only if you genuinely need direct browser access; never back to ["*"].
CORS_ORIGINS=[]                               # [OPTIONAL]
                                              # [PROD] [] (or ["https://your-domain.com"])


# =============================================================================
# Inter-service Authentication
# =============================================================================
# INTERNAL_ACCESS_TOKEN is THE one shared internal access token (owner decision
# D-D): identical across every HOPE service, set by the DevOps engineer, internal
# use only. stt ACCEPTS it as X-Service-Token on every non-exempt route
# (health/docs/metrics are exempt). There is deliberately no STT_SERVICE_TOKEN —
# stt authenticates OUTBOUND to the gateway with X-Internal-Service-Key +
# API_GATEWAY_KEY instead.
# Empty = inbound auth bypassed, and ONLY in a local/dev environment: with
# NODE_ENV/DEPLOYMENT_ENVIRONMENT naming a deployed environment, an unset token
# rejects everything rather than silently opening the service.
# [duplicate key, see API GATEWAY (apps/api) above] # INTERNAL_ACCESS_TOKEN=                        # [SECRET]
                                              # [PROD] REQUIRED — delivered from Vault


# =============================================================================
# Database (Read-only access to shared HOPE database)
# =============================================================================
# [duplicate key, see ROOT BOOTSTRAP FLOOR above] # DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope
                                              # [DEV-ONLY] [SECRET]
                                              # [PROD] postgresql+asyncpg://stt_reader:<password>@<db-host>:5432/hope
DATABASE_POOL_SIZE=5                          # [OPTIONAL] Connection pool size
                                              # [PROD] 10–20 depending on load
DATABASE_MAX_OVERFLOW=10                      # [OPTIONAL] Max connections beyond pool
                                              # [PROD] 20


# =============================================================================
# Redis (Dramatiq Broker for async job queue)
# =============================================================================
# [duplicate key, see ROOT BOOTSTRAP FLOOR above] # REDIS_URL=redis://localhost:6379/0            # [DEV-ONLY]
                                              # [PROD] redis://<redis-host>:6379/0


# =============================================================================
# MinIO (S3-compatible Object Storage)
# =============================================================================
# [duplicate key, see API GATEWAY (apps/api) above] # MINIO_ENDPOINT=localhost:9000                 # [DEV-ONLY]
                                              # [PROD] minio.internal:9000 or S3 endpoint
# [duplicate key, see API GATEWAY (apps/api) above] # MINIO_ACCESS_KEY=minioadmin                   # [DEV-ONLY] [SECRET]
                                              # [PROD] Use a dedicated service account key
# [duplicate key, see API GATEWAY (apps/api) above] # MINIO_SECRET_KEY=minioadmin                   # [DEV-ONLY] [SECRET]
                                              # [PROD] Use a dedicated service account secret
MINIO_SECURE=false                            # [DEV-ONLY]
                                              # [PROD] true (TLS required)
MINIO_AUDIO_BUCKET=hope-audio                 # [OPTIONAL] Bucket for audio files & transcripts
MINIO_CHUNK_BUCKET=hope-audio-chunks          # [OPTIONAL] Bucket for streaming audio chunks


# =============================================================================
# API Gateway (Internal service-to-service communication)
# =============================================================================
API_GATEWAY_URL=http://localhost:8868/api/v1   # [DEV-ONLY] NestJS API Gateway URL
                                               # [PROD] http://api-gateway.internal:8868/api/v1
# [duplicate key, see API GATEWAY (apps/api) above] # API_GATEWAY_KEY=                               # [REQUIRED in PROD] [SECRET]
                                               # Internal service authentication key
API_GATEWAY_TIMEOUT=30                         # [OPTIONAL] Request timeout in seconds


# =============================================================================
# Model Cache (LRU cache for loaded ML models)
# =============================================================================
MODEL_CACHE_MAX_MODELS=5                      # [OPTIONAL] Max models in memory
                                              # [PROD] Tune based on available RAM
MODEL_CACHE_TTL_SECONDS=3600                  # [OPTIONAL] Cache TTL (1 hour)


# =============================================================================
# HuggingFace (Model downloads and caching)
# =============================================================================
# HUGGINGFACE_CACHE_DIR=/models/hf-cache      # [OPTIONAL] Local model cache directory
                                              # [DEV macOS] e.g. /Volumes/external/huggingface
                                              # NOTE: In Docker, HF_HOME and TRANSFORMERS_CACHE
                                              #   are also set to this path in the Dockerfile.
                                              #   Keep them aligned if overriding.
# HUGGINGFACE_TOKEN=hf_xxx                    # [OPTIONAL] [SECRET] Required for private/gated models


# =============================================================================
# ONNX Quantization (Pipeline YAML — inline model configuration)
# =============================================================================
# When using inline ONNX models in pipeline YAML, you can select a quantized
# variant to reduce memory usage and improve inference speed.
#
# Example pipeline YAML:
#   models:
#     asr:
#       hf_model_id: "onnx-community/whisper-large-v3-turbo_timestamped"
#       engine: "onnx"
#       quantization: "q4"        # Select a quantized variant
#       subfolder: "onnx"         # Auto-detected for onnx-community repos
#
# Available quantization values:
#   (none)      — Default fp32, largest but highest quality
#   "fp16"      — Float16: ~50% size, minimal quality loss
#   "int8"      — INT8 dynamic quantization: ~35% size
#   "uint8"     — UINT8 dynamic quantization: same as int8
#   "q4"        — 4-bit quantization: ~25% size
#   "q4f16"     — 4-bit weights + fp16 activations: smallest (~18%)
#   "bnb4"      — bitsandbytes 4-bit
#   "quantized" — Default quantized (typically int8)
#
# Approximate sizes for whisper-large-v3-turbo_timestamped (encoder + decoder):
#   fp32:     ~3.2 GB  |  fp16:  ~1.6 GB  |  int8:  ~1.1 GB
#   q4:       ~760 MB  |  q4f16: ~564 MB   |  bnb4:  ~713 MB
#
# NOTE: Models must be pre-downloaded to the HuggingFace cache.
#       The subfolder is auto-detected as "onnx" for onnx-community repos.


# =============================================================================
# Azure Speech (Cloud ASR Engine — optional)
# =============================================================================
# TASK-602: Azure Speech / Sarvam / OpenAI ASR are BYOK-only. Their SUBSCRIPTION
# KEYS are NOT env vars — configure them per tenant, or as the platform default,
# in the provider-connection plane (SYSTEM-tenant AiProviderConnection row). Only
# the non-secret REGION remains env-set.
# AZURE_SPEECH_REGION=eastus                   # Azure region (eastus, westeurope, etc.)

# Azure AI Foundry MAI-Transcribe (TASK-505 P3 — decision D4: PREVIEW, batch-only, OFF by default)
# AZURE_FOUNDRY_ENABLED=false                  # Explicit opt-in (no SLA/diarization; no PHI until GA sign-off)
# AZURE_FOUNDRY_ENDPOINT=                      # [SECRET] https://<resource>.cognitiveservices.azure.com
# AZURE_FOUNDRY_API_KEY=                       # [SECRET] Foundry API key
# AZURE_FOUNDRY_MODEL=mai-transcribe-1.5       # enhancedMode model name

# parakeet.cpp ggml runtime (TASK-505 P3 — nemotron-3.5-asr-streaming; no upstream Python bindings)
# PARAKEET_CPP_LIBRARY_PATH=                   # Path to libparakeet when using the ctypes fallback
# PARAKEET_CPP_NUM_THREADS=4                   # CPU inference threads

# WHISPER_CPP_NUM_THREADS=4                    # CPU inference threads


# =============================================================================
# VAD — Silero VAD v6 ONNX (Voice Activity Detection)
# =============================================================================
# VAD_MODEL_PATH=                             # [OPTIONAL] Path to local ONNX model file
                                              #   If unset, model is auto-downloaded from HuggingFace
                                              #   Source: onnx-community/silero-vad
                                              #   GitHub: https://github.com/snakers4/silero-vad
VAD_THRESHOLD=0.5                             # [OPTIONAL] Speech detection threshold (0.0–1.0)
                                              #   Lower = more sensitive, higher = fewer false positives
VAD_MIN_SPEECH_DURATION_MS=100                # [OPTIONAL] Min speech segment length in ms (TASK-505)
VAD_MIN_SILENCE_DURATION_MS=500               # [OPTIONAL] Min silence to end a speech segment in ms
VAD_SPEECH_PAD_MS=200                         # [OPTIONAL] Segment padding both ends in ms (TASK-505)


# =============================================================================
# Diarization — Speaker Embeddings
# =============================================================================
DIARIZATION_HF_MODEL_ID=pyannote/wespeaker-voxceleb-resnet34-LM  # [OPTIONAL] HuggingFace model ID for embeddings
                                              #   Default: pyannote/wespeaker-voxceleb-resnet34-LM (CC-BY-4.0, no token needed)
                                              #   ONNX alternative: deepghs/pyannote-embedding-onnx (no token needed)
                                              #   The ONNX variant is configured per-pipeline in YAML, not here.
DIARIZATION_DEVICE=auto                       # [OPTIONAL] Inference device: auto | cuda | cpu
                                              # [PROD GPU] cuda


# =============================================================================
# Voice Profile Enrollment
# =============================================================================
VOICE_PROFILE_MIN_SIMILARITY=0.6              # [OPTIONAL] Minimum pairwise cosine similarity required
                                              # between voice profile samples during enrollment (0.0–1.0).
                                              # Lower (~0.3) for dev with consumer-grade microphones.
                                              # Production default is 0.6. Single-sample enrollment
                                              # skips this check entirely.
                                              # Note: the embedding dimension is NOT configurable here;
                                              # it MUST match the DB column ``vector(N)`` and is hardcoded
                                              # to 256 in extraction_service.py + voiceProfile.service.ts.


# =============================================================================
# Worker Settings (Dramatiq task workers)
# =============================================================================
WORKER_THREADS=4                              # [OPTIONAL] Dramatiq worker threads per process
WORKER_POLL_TIMEOUT_MS=1000                  # [OPTIONAL] Dramatiq consumer poll max-backoff in ms
                                              # Controls how often idle workers check for new messages
WORKER_MAX_RETRIES=3                          # [OPTIONAL] Max retry attempts on failure
ONNX_NUM_THREADS=0                            # [OPTIONAL] ONNX Runtime intra_op_num_threads
                                              #   0 = auto (recommended): ONNX Runtime auto-sizes to
                                              #     physical CPU core count with proper thread affinity.
                                              #     This is the official ONNX Runtime best practice.
                                              # [DEV Apple Silicon] 0 works best (adapts to P/E cores)
                                              # [PROD GPU] Keep at 0 or low (2-4), GPU handles heavy ops
                                              # [ADVANCED] Set explicitly only if profiling shows benefit


# =============================================================================
# Transcription Settings
# =============================================================================
TRANSCRIPTION_TIMEOUT_SECONDS=600             # [OPTIONAL] Max transcription job timeout (10 min)
                                              # [PROD] 600 for long consultations
TRANSCRIPTION_CHUNK_LENGTH_S=15               # [OPTIONAL] Whisper audio chunk length (seconds)
                                              #   Audio longer than this is split into overlapping
                                              #   chunks with configurable stride.
                                              #   15 = recommended (good accuracy, low TTFW latency)
                                              #   30 = maximum accuracy (full Whisper context window)
                                              #   10 = ultra-low latency (minimal quality loss)
TRANSCRIPTION_STRIDE_LENGTH_S=4,2             # [OPTIONAL] Left,right overlap between chunks (seconds)
                                              #   Default "4,2" means 4s left overlap, 2s right overlap.
                                              #   Prevents cutting words at chunk boundaries.


# =============================================================================
# Punctuation Restoration (Cadence) — global kill-switch
# =============================================================================
# Default false (recommended):
#   - The production Whisper ASR pipelines already emit punctuation and
#     casing, so Cadence is redundant for them.
#   - cadence-punctuation 1.1.0 cannot load under the pinned transformers
#     5.x (its tied-weights finalization raises "Sequential has no attribute
#     weight"); with the flag off the model is never touched and the boot log
#     stays free of Cadence's FATAL traceback.
#   - Enable only with a transformers/cadence combination known to load the
#     model (e.g. an Indic ASR path whose engine does not self-punctuate,
#     running transformers <5 in a dedicated environment).
#
# PRECEDENCE: this global flag wins over per-pipeline YAML
#   `postprocessing.punctuation.enabled: true`. When false (or when the model
#   fails to load), pipelines that request punctuation receive their text
#   passed through unchanged, and a one-time warning is logged at the first
#   suppressed call.
#
# PUNCTUATION_ENABLED=false                   # [OPTIONAL] Global kill-switch (default false)
# PUNCTUATION_MODEL_NAME=Cadence              # [OPTIONAL] 'Cadence' (1B) or 'Cadence-Fast' (270M)
# PUNCTUATION_MODEL_CACHE_DIR=                # [OPTIONAL] Weights cache dir (empty = HF default)
# PUNCTUATION_DEVICE=auto                     # [OPTIONAL] cpu | cuda | auto
# PUNCTUATION_MAX_LENGTH=300                  # [OPTIONAL] Max seq length / sliding window width


# =============================================================================
# Streaming — real-time partial cadence (TASK-471 A1)
# =============================================================================
# Minimum wall-clock interval (seconds) between successive PARTIAL emissions for
# a live utterance. Lowered from the legacy hardcoded 1.0 s so newly-spoken words
# surface in near-real-time as a tentative tail; the LocalAgreement-2 commit
# policy still governs when a word is COMMITTED. The 0.5 s minimum-buffered-audio
# floor and the partial tail window are unaffected. Bare env name (the Settings
# class has NO env_prefix).
# STREAMING_PARTIAL_INTERVAL_S=0.4            # [OPTIONAL] Partial cadence, seconds (default 0.4)


# =============================================================================
# Observability (OpenTelemetry + Prometheus)
# =============================================================================
OTEL_ENABLED=false                           # [OPTIONAL] Enable OpenTelemetry distributed tracing
                                              # [PROD] true
OTEL_EXPORTER_ENDPOINT=http://localhost:4317  # [DEV-ONLY] OTLP gRPC collector endpoint
                                              # [PROD] http://10.10.1.100:4317
# [duplicate key, see API GATEWAY (apps/api) above] # OTEL_SERVICE_NAME=stt                     # [OPTIONAL] Service name in traces
METRICS_ENABLED=true                         # [OPTIONAL] Enable Prometheus /metrics endpoint

# TASK-636 OBS-05 — Prometheus exposition for the Dramatiq BATCH WORKER.
# A separate process from the API, so :8861/metrics says nothing about batch
# throughput, job duration, retries or failures. dramatiq reads these LOWERCASE
# names at import time. Loopback by default (PHI posture); containers set
# dramatiq_prom_host=0.0.0.0.
dramatiq_prom_host=127.0.0.1
dramatiq_prom_port=9191


# ============================================================================
# TTS — Text-to-Speech (apps/tts, :8865)
# Source: apps/tts/.env.sample
# Hand-maintained. Created TASK-582 (previously the only Python service with no example file).
# ============================================================================

# TTS Service Environment Configuration
# TASK-582: this file did not exist before — apps/tts was the only Python
# service missing one; ~40+ real config vars previously lived only in a
# developer's local, gitignored .env.dev. Kept right-sized (not exhaustive):
# app/runtime + auth + synthesis limits + one local engine + BYO cloud
# placeholders. Deep provider tunables (timeouts, concurrency, sample rates
# per provider) all have safe code defaults in core/config.py and are left
# undocumented here by design.

# Application Settings
TTS_HOST=0.0.0.0
# [duplicate key, see API GATEWAY (apps/api) above] # TTS_PORT=8865
TTS_DEBUG=false
TTS_LOG_LEVEL=info
TTS_CORS_ENABLED=false
TTS_CORS_ORIGINS=[]
TTS_METRICS_ENABLED=true

# OpenTelemetry tracing (TASK-636 OBS-13). Default OFF and requires BOTH the
# flag and an endpoint — a bare TTS_OTEL_ENABLED=true with no collector must
# not change startup behaviour (TASK-411 invariant).
TTS_OTEL_ENABLED=false
TTS_OTEL_EXPORTER_ENDPOINT=
TTS_OTEL_SERVICE_NAME=tts
TTS_OTEL_SERVICE_NAMESPACE=hope
# Resolved from DEPLOYMENT_ENVIRONMENT -> NODE_ENV -> development when unset.
# NEVER default this to "production" (TASK-636 OBS-18).
TTS_OTEL_DEPLOYMENT_ENVIRONMENT=
TTS_OTEL_INSECURE=true
TTS_OTEL_LOGS_ENABLED=true

# Inter-service Authentication (empty = auth disabled for local dev)
# [duplicate key, see API GATEWAY (apps/api) above] # TTS_SERVICE_TOKEN=""

# --- CANONICAL internal service credential (owner decision D-D, TASK-737/738) --
# INTERNAL_ACCESS_TOKEN is THE one shared internal access token: identical across
# every HOPE service, set by the DevOps engineer, internal use only. It is what
# this service ACCEPTS as X-Service-Token inbound and what it PRESENTS as
# X-Service-Token on every outbound peer call. Unprefixed on purpose — it belongs
# to no single service.
# The per-service / per-pair *_SERVICE_TOKEN vars below are retained ONLY as a
# zero-cost backward-compatibility fallback (inbound accepts EITHER; outbound
# prefers this one and falls back). Set this and the legacy family can be dropped.
# Empty everywhere = auth disabled, and ONLY in a local/dev environment: with
# NODE_ENV/DEPLOYMENT_ENVIRONMENT naming a deployed environment, an unset token
# rejects everything (HTTP 401, WebSocket close 4401) rather than silently opening
# the service. This applies to /api/v1/audio/stream too — that socket now uses the
# same accepted-token set as HTTP, which it did not before.
# [duplicate key, see API GATEWAY (apps/api) above] # INTERNAL_ACCESS_TOKEN=

# Where the control plane lives.
TTS_GATEWAY_URL=http://localhost:8868/api/v1

# Synthesis limits / defaults
TTS_MAX_INPUT_CHARS=4096
TTS_DEFAULT_FORMAT=pcm
TTS_SAMPLE_RATE=24000

# ──────────────────────────────────────────────────────────────────────────────
# Provider SELECTION is DB-sourced (TASK-577), NOT env. There is no
# TTS_ROUTING_EN / TTS_ROUTING_ML — the SYSTEM TenantTtsConfig default is
# resolved by the gateway and injected per request; the router fails CLOSED
# (503) when no chain is injected. Enabling an engine below only makes it
# AVAILABLE for the DB-driven router to pick — it never selects a default.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Local engines (self-hosted, no cloud egress). Kokoro (English) enabled by
# default — built-in-first per OD-2 of the provider-plane program.
# ──────────────────────────────────────────────────────────────────────────────
TTS_KOKORO_ENABLED=true
TTS_KOKORO_VOICE=af_heart
TTS_KOKORO_DEVICE=cpu

# Indic Parler-TTS (Malayalam) — off by default; enable if the model weights
# are staged locally.
# TTS_PARLER_ENABLED=false
# TTS_PARLER_DEVICE=cpu

# ──────────────────────────────────────────────────────────────────────────────
# BYO cloud engines (OPTIONAL — tenant-configured, never a platform default).
# ──────────────────────────────────────────────────────────────────────────────
# TASK-602: Azure Speech / Sarvam are BYOK-only. Their API KEYS are NOT env vars —
# configure them per tenant, or as the platform default, in the provider-connection
# plane (SYSTEM-tenant AiProviderConnection row). The gateway injects the resolved
# key per request. `TTS_*_ENABLED` is an ops kill-switch (registers the engine);
# an enabled-but-unconfigured cloud engine is excluded from routing (fail closed).
# Only the non-secret Azure REGION remains env-set.
# TTS_AZURE_ENABLED=false
# TTS_AZURE_REGION=eastus

# Sarvam AI Bulbul TTS (best code-switched Malayalam). Public API is NOT
# PHI-safe (no HIPAA/BAA) — point base_url at an enterprise/on-prem host
# before enabling for real patient data.
# TTS_SARVAM_ENABLED=false


