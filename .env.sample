# `# also:` lists the other names pydantic accepts for the same field, in
# precedence order after the canonical one.

# ── AzureJudgeConfig ────────────────────────────────────────────────────

# HARNESS_JUDGE_AZURE_API_VERSION=2024-12-01-preview

# HARNESS_JUDGE_AZURE_DEPLOYMENT=

# HARNESS_JUDGE_AZURE_ENDPOINT=

# ── BedrockJudgeConfig ──────────────────────────────────────────────────

# HARNESS_JUDGE_BEDROCK_REGION=us-east-1

# ── ClaimCheckConfig ────────────────────────────────────────────────────

# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_CLAIM_CHECK_ACCESS_KEY=CHANGE_ME

#   Tenant-scoped, access-controlled PHI bucket (NOT a public bucket).
# HARNESS_CLAIM_CHECK_BUCKET=harness-claim-check

#   Offload ON by default (protect the history budget); the threshold keeps small payloads inline so tiny
#   prompts/notes never pay a store round-trip.
# HARNESS_CLAIM_CHECK_ENABLED=true

#   Self-hosted MinIO S3 endpoint (host under platform control — no cloud egress).
# HARNESS_CLAIM_CHECK_ENDPOINT_URL=http://localhost:9000

#   Blobs at/above this many utf-8 BYTES are offloaded; below it they stay inline.
# HARNESS_CLAIM_CHECK_MIN_BYTES=65536

# HARNESS_CLAIM_CHECK_REGION=us-east-1

# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_CLAIM_CHECK_SECRET_KEY=CHANGE_ME

# HARNESS_CLAIM_CHECK_SECURE=false

#   Backend selector: ``memory`` (process-local fake — dev/test) | ``s3`` (self-hosted MinIO).
# HARNESS_CLAIM_CHECK_STORE=memory

# ── EvalConfig ──────────────────────────────────────────────────────────

#   TASK-713: how many golden-set cases GoldenSetRunner scores concurrently. ``1`` (default) is the original
#   strictly-sequential behaviour — safe for any backend, including a single-slot local server. CI raises this (see
#   ``HARNESS_EVAL_CASE_CONCURRENCY`` in ``harness-eval-gate``) to match the judge service container's parallel slot
#   count; actual in-flight network concurrency to the judge endpoint is still bounded by the separate
#   ``HARNESS_LLM_MAX_CONCURRENCY`` governor (``harness.core.llm_concurrency``), so raising this alone can never
#   burst past what the endpoint allows.
# HARNESS_EVAL_CASE_CONCURRENCY=1

# HARNESS_EVAL_FAITHFULNESS_THRESHOLD=0.85

#   Pinned golden-set version the gate runs against (CI overrides via env).
# HARNESS_EVAL_GOLDEN_SET_VERSION=synthetic-v0.1.0

#   TASK-713: whether the judge↔clinician ICC calibration check gates the run at all. Default True (unchanged
#   behaviour for every existing caller/test). A small non-reasoning CI judge can be prone to a ceiling effect —
#   scoring every quality dimension near-identically across cases — which drives ICC(2,1) to ~0 regardless of
#   whether its underlying agreement (Gwet AC2, computed and reported alongside it) is actually strong;
#   `icc_threshold` is validated to [0, 1] (see `_unit_interval` below), so a near-zero-but-technically-negative ICC
#   reading from that ceiling effect can never be recalibrated into passing by lowering the threshold alone. CI sets
#   `HARNESS_EVAL_ICC_GATE_ENABLED=false` for its specific small judge rather than silently widening `icc_threshold`
#   outside its valid range or forcing a pass on a statistic that is structurally uninformative for that model — see
#   harness-eval-gate's env-var comment in `.gitlab/ci/test.yml` for the measured numbers.
# HARNESS_EVAL_ICC_GATE_ENABLED=true

#   Release-gate thresholds. OWNER RULING 2026-08-20 (TASK-713): lowered 0.80 -> 0.73 to the MEASURED baseline
#   (icc=0.7306, Gwet AC2=0.9196, n=288, golden set curated-v2.0.0, reproduced 2026-08-18). This is a recorded
#   baseline, not a target: the shortfall against the 0.80 literature bar is accepted as debt and tracked in
#   TASK-780, which restores 0.80 once a clinician-authored golden set or a higher-dynamic-range judge is available.
#   Do not raise this value without re-measuring; do not lower it further without a new owner ruling.
# HARNESS_EVAL_ICC_THRESHOLD=0.73

#   Hard cap on cases the SYNCHRONOUS internal ``/eval/run`` endpoint will score in one request (apps/api promotion
#   gate + admin run-now). Larger sets belong on the future Temporal lane; the endpoint rejects an over-cap request
#   (413) rather than blocking a promotion for minutes.
# HARNESS_EVAL_MAX_CASES_PER_RUN=50

# HARNESS_EVAL_PDSQI_ACCURATE_THRESHOLD=4

# HARNESS_EVAL_PDSQI_MEAN_THRESHOLD=4

# HARNESS_EVAL_PDSQI_THOROUGH_THRESHOLD=4

# ── JudgeConfig ─────────────────────────────────────────────────────────

#   Calibration levers Opt-in anchored rubric prompt: appends rubric-faithful per-score guidance + balanced
#   exemplars so a small local judge applies the Epic grade descriptors consistently (raises judge↔reference
#   agreement). The verbatim instrument is preserved; this is purely additive. Default off to keep CI prompts
#   pristine.
# HARNESS_JUDGE_ANCHORED=false

#   Groundedness batching: claims verified per judge call. ``1`` keeps the legacy one-call-per-claim path
#   byte-for-byte; ``>= 2`` states the shared transcript premise ONCE and labels that many claims in a single
#   JSON-array call (``ceil(N / size)`` long-prefill calls instead of N), the dominant latency lever for the
#   inferential pass. Conservative parser: any ambiguous array item degrades to ungrounded, so a larger batch can
#   never loosen a verdict.
# HARNESS_JUDGE_ENTAILMENT_BATCH_SIZE=1

#   Reasoning-control levers (cross-family robustness) Forwarded verbatim into the OpenAI-compatible / Azure
#   ``create(...)`` call (ignored by Bedrock's converse API) when set. This is the passthrough for server-specific
#   reasoning knobs that DO take effect on vLLM/Azure — e.g. ``{"reasoning_effort": "low"}`` or
#   ``{"chat_template_kwargs": {"enable_thinking": false}}``. Empirically these had NO effect on LM Studio (where a
#   large ``max_tokens`` + reading reasoning text is the only reliable lever), so this stays off by default. Accepts
#   a JSON string from the environment (``HARNESS_JUDGE_EXTRA_BODY='{"reasoning_effort":"low"}'``).
# HARNESS_JUDGE_EXTRA_BODY=

# HARNESS_JUDGE_MAX_RETRIES=2

#   Large budget (NOT ~2k): reasoning model families (qwen3.5, gemma-4, medgemma) can spend thousands of tokens
#   "thinking" before emitting the JSON answer; a small cap truncates mid-reasoning (finish_reason=length → empty
#   ``content``, the answer stranded in ``reasoning_content``). 8192 leaves room for the reasoning trace *and* the
#   final JSON across both reasoning/non-reasoning models.
# HARNESS_JUDGE_MAX_TOKENS=8192

# HARNESS_JUDGE_MODEL=gemma-4-e2b-it-qat

#   Judge output format: "with_explanation" (default; richer per-dimension rationale) or "score" (compact score-only
#   JSON). SCORE is markedly more reliable for small (≤~7B) judge models, which can otherwise emit a long un-tagged
#   prose preamble that exhausts ``max_tokens`` before any JSON appears.
# HARNESS_JUDGE_OUTPUT_MODE=with_explanation

#   Priority/default = a small ≤20B model on a local OpenAI-compatible endpoint. gemma-4-e2b-it-qat is the
#   owner-standardized default (2026-08-16): the one model resident in LM Studio, verified served by the live dev
#   instance.
# HARNESS_JUDGE_PROVIDER=openai_compat

#   Selects how the prompt asks the model to reason (consumed by the judge prompts): "auto" (let the model decide),
#   "think" (encourage an explicit reasoning pass), or "none" (instruct it to answer directly). Distinct from
#   ``suppress_reasoning`` so prompt phrasing and the hard ``/no_think`` suffix can be tuned independently.
# HARNESS_JUDGE_REASONING_MODE=auto

#   Temperature used for the >1 self-consistency samples (needs > 0 for diversity). Kept low (0.2) so samples stay
#   near the greedy mode while still varying enough for the per-dimension median to reduce variance without drifting
#   off-rubric.
# HARNESS_JUDGE_SC_TEMPERATURE=0.2

#   Deterministic decoding seed (passed to OpenAI-compatible / Azure backends).
# HARNESS_JUDGE_SEED=

#   Self-consistency: sample the judge ``self_consistency`` times and take the per-dimension median (variance
#   reduction). ``1`` == single deterministic pass.
# HARNESS_JUDGE_SELF_CONSISTENCY=1

#   Append a "/no_think" + JSON-only directive to the judge system prompt. Needed for small local judges (e.g.
#   gemma-4-e4b on LM Studio) that otherwise emit a long ``<think>`` block and may end the turn before the JSON
#   (premature stop). Off by default so larger judges (gpt-oss, Azure) keep their pristine prompt.
# HARNESS_JUDGE_SUPPRESS_REASONING=false

# HARNESS_JUDGE_TEMPERATURE=0

#   Generous default: a slow local reasoning judge can take minutes for a single call (observed ~90s on gemma-4-e4b,
#   ~340s on qwen3.5-9b via LM Studio), so the old 120s default killed legitimate calls mid-generation.
# HARNESS_JUDGE_TIMEOUT_S=300

#   Bounded app-level retry for *transient* backend failures (distinct from the SDK's ``max_retries``, which does
#   NOT retry HTTP 400s). A small local server (e.g. LM Studio serving gemma-4-e4b) can terminate/unload the model
#   engine under sustained sequential load — surfacing as ``400 {'error':'terminated'}`` or a dropped connection —
#   then JIT-reload it on the next call. We retry such transient failures (with linear backoff to let the model
#   reload) so a long run survives a mid-run engine crash; a genuinely-down backend still aborts once the retries
#   are exhausted (never a silent green gate).
# HARNESS_JUDGE_TRANSIENT_RETRIES=3

# HARNESS_JUDGE_TRANSIENT_RETRY_BACKOFF_S=12

# ── McpConfig ───────────────────────────────────────────────────────────

#   Bounded transport retries inside the client for a transient/5xx error before the activity degrades (never
#   crashes the loop).
# HARNESS_MCP_MAX_ATTEMPTS=2

#   Result size cap (utf-8 BYTES). A tool result above this is claim-checked (offloaded, keeping the blob OUT of
#   Temporal history) when claim-check is enabled, else truncated to the cap. Mirrors the claim-check threshold.
# HARNESS_MCP_MAX_RESULT_BYTES=65536

#   Per-call wall-clock timeout for a single MCP tool invocation.
# HARNESS_MCP_TIMEOUT_S=20

# ── OpenAICompatJudgeConfig ─────────────────────────────────────────────

# HARNESS_JUDGE_OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1

#   ``response_format.type`` sent on json_mode calls (claim extraction / verify). "json_object" works on
#   Ollama/vLLM; LM Studio rejects it ("must be json_schema or text") and small models emit empty output under a
#   strict json_schema grammar, so set this to "text" for LM Studio to omit the constraint and rely on the "Return
#   ONLY JSON" prompt + tolerant parsing (harness.eval.jsonio.loads_json).
#   local-dev value; the code default is `json_object`
HARNESS_JUDGE_OPENAI_COMPAT_JSON_RESPONSE_FORMAT=text

# HARNESS_JUDGE_OPENAI_COMPAT_ORGANIZATION=

# ── PhiConfig ───────────────────────────────────────────────────────────

# HARNESS_PHI_ENABLED=true

# HARNESS_PHI_FAIL_CLOSED=true

# HARNESS_PHI_LOCAL_PROVIDERS=["lm-studio", "openai_compat", "ollama", "vllm", "llama-cpp"]

# ── RetrievalConfig ─────────────────────────────────────────────────────

# HARNESS_RETRIEVAL_COLLECTION=knowledge_chunks

#   LM Studio OpenAI-compatible root (already includes ``/v1``); the embeddings client posts to
#   ``{base_url}/embeddings``.
# HARNESS_RETRIEVAL_EMBEDDINGS_BASE_URL=http://localhost:1234/v1

#   Dense vector dimension — MUST match the loaded model AND the Qdrant collection.
# HARNESS_RETRIEVAL_EMBEDDINGS_DIM=1024

#   Model id the engine exposes for the loaded dense embedding model. Operators override to match the loaded build
#   (the plan's reference model is BAAI/bge-m3).
# HARNESS_RETRIEVAL_EMBEDDINGS_MODEL=text-embedding-bge-m3

# HARNESS_RETRIEVAL_EMBEDDINGS_TIMEOUT_S=30

#   The landmine A.2 cited is still live and still worth heeding: a KEYLESS row injects on NEITHER tier. That is now
#   a DEFINED outcome (`absent` ⇒ call the endpoint unauthenticated) rather than a silent no-op.
# HARNESS_RETRIEVAL_ENABLED=false

# HARNESS_RETRIEVAL_QDRANT_TIMEOUT_S=10

# HARNESS_RETRIEVAL_QDRANT_URL=http://localhost:6333

#   HF Text-Embeddings-Inference reranker root (cross-encoder ``/rerank``).
# HARNESS_RETRIEVAL_RERANKER_BASE_URL=http://localhost:8870

# HARNESS_RETRIEVAL_RERANKER_TIMEOUT_S=30

# HARNESS_RETRIEVAL_TOP_K_RERANK=5

#   Hybrid knobs: dense+sparse prefetch limit -> RRF fusion -> cross-encoder rerank.
# HARNESS_RETRIEVAL_TOP_K_RETRIEVAL=20

# ── SensorThresholds ────────────────────────────────────────────────────

#   Reference-free atomic-fact verifier: >= 80% of the note's atomic claims must be entailed by the transcript per
#   the DETERMINISTIC self-hosted NLI (a second, model-cheap groundedness gate alongside the LLM-judge groundedness
#   sensor). Regen-fixable; a degraded backend degrades (never auto-PASS).
# HARNESS_SENSOR_ATOMIC_FACT_THRESHOLD=0.8

#   Every provenance claim must carry >= 1 evidence span.
# HARNESS_SENSOR_CITATION_PRESENCE_THRESHOLD=1

#   Inferential (institutional RAG): >= 80% of CITED claims must be entailed by their cited knowledge chunk(s) per
#   the same judge — a strict citations check (regen-fixable; degrades to the "unverified" badge on outage).
# HARNESS_SENSOR_CITATION_VERIFY_THRESHOLD=0.8

#   >= 80% of transcript entities must be reflected in the note.
# HARNESS_SENSOR_COVERAGE_THRESHOLD=0.8

#   Zero-tolerance: any note entity ungrounded in the transcript fails.
# HARNESS_SENSOR_ENTITY_FAITHFULNESS_THRESHOLD=1

#   Inferential: >= 80% of provenance claims must be entailed by the transcript/evidence per the LM Studio judge
#   (lower than the zero-tolerance checks — semantic entailment is graded, not exact-match).
# HARNESS_SENSOR_GROUNDEDNESS_THRESHOLD=0.8

#   Zero-tolerance: every numeric/dose value in the note must match the transcript.
# HARNESS_SENSOR_NUMERIC_DOSE_THRESHOLD=1

# ── Settings ────────────────────────────────────────────────────────────

# HARNESS_API_BASE_URL=http://localhost:8868

#   apps/api internal-harness mount. ``HarnessInternalController`` sits under the global ``/api/v1`` prefix
#   (``@Controller('internal/harness')``), so the live, out-of-the-box mount is ``/api/v1/internal/harness``.
#   Override via ``HARNESS_API_INTERNAL_PREFIX`` if the gateway prefix ever changes.
# HARNESS_API_INTERNAL_PREFIX=/api/v1/internal/harness

# HARNESS_API_TIMEOUT_S=30

#   Reference-free atomic-fact verifier kill-switch (HARNESS_ATOMIC_FACT_ENABLED, default OFF). When ON, the
#   ``run_inferential_sensors`` activity runs the DETERMINISTIC self-hosted-NLI atomic-fact verifier ALONGSIDE the
#   LLM-judge groundedness sensor (a second, model-cheap groundedness gate). Read at runtime inside the
#   (non-deterministic) activity — NOT the workflow body — so it adds no new command / snapshot / patch marker (the
#   sensor result flows through the activity output; the workflow command sequence is byte-identical, replay-safe).
#   Default OFF ⇒ enabling it is an explicit ops rollout once a self-hosted NLI model (MiniCheck / AlignScore /
#   HHEM-class) is provisioned; the hermetic default entailer (:class:`DeterministicOverlapEntailer`) needs no model
#   and never auto-PASSes.
# HARNESS_ATOMIC_FACT_ENABLED=false

#   Per-claim entailment decision: P(entailed) >= this ⇒ grounded.
# HARNESS_ATOMIC_FACT_ENTAIL_THRESHOLD=0.5

#   Cache dir for weights materialised from an `s3://` source_uri.
# HARNESS_ATOMIC_FACT_MODEL_CACHE_DIR=/models/harness-cache

# HARNESS_ATOMIC_FACT_MODEL_ID=nvhf/MiniCheck-Flan-T5-Large-Q6_K-GGUF

#   Optional self-hosted MiniCheck-Flan-T5 GGUF entailer (owner directive 2026-07-11: "GGUF everywhere"). When
#   `atomic_fact_model_path` is set (a staged local .gguf), the verifier swaps the model-free
#   DeterministicOverlapEntailer for the MiniCheck NLI; unset (default) keeps the hermetic model-free entailer.
#   `model_id`/ `model_file` are provenance only. A build/calibration failure falls back to the safe deterministic
#   entailer (see `_atomic_fact_entailer`). CPU-default (Q6 quant). BOOTSTRAP FALLBACK ONLY. The runtime value comes
#   from the control plane's effective-config `modelWeights['minicheck-flan-t5-large']` (harness holds no DB handle,
#   so it cannot read the control plane directly). This env var applies when that key is absent — which is every
#   deployment until the `modelWeights` control-plane rollout completes — so behaviour predating that rollout is
#   preserved byte-for-byte.
# HARNESS_ATOMIC_FACT_MODEL_PATH=

#   512 matches Flan-T5's training context (`n_ctx_train`); MiniCheck windows long documents to ~512-token chunks,
#   so more only wastes the encoder KV alloc and trips llama.cpp's `n_ctx_seq > n_ctx_train` overflow warning.
# HARNESS_ATOMIC_FACT_N_CTX=512

# HARNESS_ATOMIC_FACT_N_GPU_LAYERS=0

# HARNESS_ATOMIC_FACT_N_THREADS=

#   TTL for `ConsentClient`'s per-(tenant, patient, purpose) cache — a bounded-staleness BACKSTOP, not the
#   propagation mechanism (mirrors `.claude/rules/09-infrastructure-devops.md` §Config caches rule 2; this phase has
#   no cross-process invalidation channel for the harness worker, a disclosed, TTL-bounded scope choice — see
#   consent-design.md). Mirrors the TS-side ConsultationConsentService cache TTL (30s).
# HARNESS_CONSENT_CACHE_TTL_SECONDS=30

#   TASK-712 (consent-abac Phase 4) — gateway-internal consent-assert mount. A SIBLING of api_internal_prefix
#   (``ConsentInternalController`` is `@Controller('internal/consent')`, not nested under `internal/harness`), so it
#   gets its own prefix rather than reusing the harness one.
# HARNESS_CONSENT_INTERNAL_PREFIX=/api/v1/internal/consent

# HARNESS_CONVERSATION_LANGUAGE=en

# HARNESS_CORS_ENABLED=false

# HARNESS_CORS_ORIGINS=[]

# HARNESS_DEBUG=false

#   Deployment signal. Deliberately SEPARATE from ``debug``: that flag defaults False, so "not debug" cannot
#   distinguish a production deploy from unconfigured local dev — and the claim-check guard below must not fire on
#   the latter. Production/staging deploys set ``HARNESS_ENVIRONMENT`` explicitly.
# HARNESS_ENVIRONMENT=development

# HARNESS_GATE_ESCALATION_SECONDS=43200

# HARNESS_GATE_SLA_SECONDS=86400

#   Peer service — the summarization palette's `guardrail.check` node (TASK-720) calls apps/guardrail directly,
#   mirroring the established `text_base_url`/`nlp_base_url` bootstrap floor pattern (rule 09 §Configuration Tiers:
#   a `*_URL` transport address is the ONE sanctioned kind of hardcoded default). `X-Tenant-Id` is mandatory on
#   every call (TASK-737).
# HARNESS_GUARDRAIL_BASE_URL=http://localhost:8863

#   Legacy fallback for the harness→guardrail hop (env HARNESS_GUARDRAIL_SERVICE_TOKEN), i.e. apps/guardrail's own
#   GUARDRAIL_SERVICE_TOKEN. Superseded by the shared INTERNAL_ACCESS_TOKEN; before D-D this hop wrongly presented
#   HARNESS_SERVICE_TOKEN, which apps/guardrail never accepts.
HARNESS_GUARDRAIL_SERVICE_TOKEN=CHANGE_ME

# HARNESS_GUARDRAIL_TIMEOUT_S=30

#   Application
# HARNESS_HOST=0.0.0.0

#   Dedicated token for the institutional-knowledge ingest endpoint (``POST /internal/knowledge/ingest``). The
#   ingest guard accepts an ``X-Service-Token`` matching THIS secret OR the shared ``service_token``; empty (and an
#   empty shared token) disables the guard for local dev. The BullMQ ingest processor presents this as the ingest
#   contract's token.
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_INTERNAL_SERVICE_TOKEN=CHANGE_ME

# HARNESS_LOG_LEVEL=info

#   F-29 — Worker-level admission cap (``Worker(max_concurrent_activities=...)``, ``worker.py``). Left unset,
#   Temporal admits activities unbounded, which lets many concurrent inferential activities queue behind the single
#   ``HARNESS_LLM_MAX_CONCURRENCY`` semaphore (``core/llm_concurrency.py``) — a cheap non-LLM activity
#   (fetch_policy, persist_entities, ...) can then starve behind that queue. Kept deliberately conservative (well
#   above ``HARNESS_LLM_MAX_CONCURRENCY``'s default of 1, since most admitted activities never touch the LLM
#   governor at all); raise together with ``HARNESS_LLM_MAX_CONCURRENCY`` if the semaphore is ever raised.
# HARNESS_MAX_CONCURRENT_ACTIVITIES=8

#   Bounded-regen budget + clinician-gate timing (durable, deterministic).
# HARNESS_MAX_REGEN=2

# HARNESS_METRICS_ENABLED=true

# HARNESS_MODEL_CACHE_MAX_MODELS=1

#   BOOTSTRAP FALLBACK ONLY — the runtime value comes from the control plane
#   (`harness.modelCache.{ttlSeconds,maxModels}`), applied by
#   `sensors.inferential.minicheck_entailer.configure_entailer_cache`. Env: HARNESS_MODEL_CACHE_TTL_SECONDS /
#   HARNESS_MODEL_CACHE_MAX_MODELS. The 600 s default is an owner decision; maxModels 1 preserves today's residency
#   exactly.
# HARNESS_MODEL_CACHE_TTL_SECONDS=600

#   NER-priors reuse kill-switch (HARNESS_NER_PRIORS_ENABLED, default OFF). When ON, the transcript
#   ``extract_entities`` activity reuses already-persisted CODED NamedEntity rows as the NER priors instead of
#   re-running the cold NLP pass — killing the redundant second transcript-NER pass. Read at runtime inside the
#   (non-deterministic) activity, NOT the workflow body, so it needs no snapshot/patch marker; when OFF (or when no
#   prior carries a code) the activity falls back to the cold extraction, so enabling it is an explicit ops rollout,
#   never a silent default flip, and it is inert until coded entities are actually persisted elsewhere.
# HARNESS_NER_PRIORS_ENABLED=false

# HARNESS_NLP_BASE_URL=http://localhost:8864

HARNESS_NLP_SERVICE_TOKEN=CHANGE_ME

# HARNESS_NLP_TIMEOUT_S=30

#   Optimistic two-phase delivery kill-switch. The FIRST key of the two-key optimistic gate; the second is the
#   durable ``workflow.patched("task-355-optimistic-delivery")`` marker (permanent in code). Read here, in
#   NON-workflow settings, and snapshotted into ``HarnessGateConfig`` at workflow start (document:start + the policy
#   merge), so it stays deterministic across replay — never read from env inside the workflow body. Default OFF ⇒
#   the legacy single-phase path, byte-identical to before optimistic delivery.
# HARNESS_OPTIMISTIC_DELIVERY_ENABLED=false

#   Precedence matches STT and the OTel collector: DEPLOYMENT_ENVIRONMENT (what the k8s overlays patch) then
#   NODE_ENV (the repo-wide selector, ) then "development".
# HARNESS_OTEL_DEPLOYMENT_ENVIRONMENT=development

#   Default OFF and requires an explicit endpoint (not just the flag) — a bare ``HARNESS_OTEL_ENABLED=true`` with no
#   collector configured must not change startup behaviour. See ``otel_tracing_enabled`` below.
# HARNESS_OTEL_ENABLED=false

# HARNESS_OTEL_EXPORTER_ENDPOINT=

# HARNESS_OTEL_INSECURE=true

# HARNESS_OTEL_SERVICE_NAME=harness

# HARNESS_OTEL_SERVICE_NAMESPACE=hope

# HARNESS_PORT=8866

#   F-19 — assembled-prompt size alarm (``HARNESS_PROMPT_SIZE_WARN_CHARS``). The doc loop deliberately re-sends the
#   ENTIRE template+transcript prefix on every regen iteration and never compacts or truncates it: dropping clinical
#   content to fit a budget is the wrong failure mode. This threshold makes an oversized prompt VISIBLE instead —
#   above it the ``generate`` activity emits a structured ``harness.prompt_size_warn`` and generates anyway. 400_000
#   chars ~= 100k tokens at the chars/4 heuristic, i.e. the point where a long consultation starts to crowd a
#   128k-context model.
# HARNESS_PROMPT_SIZE_WARN_CHARS=400000

#   ENV-TIER and staying that way: this is how the process REACHES Redis, which is exactly the bootstrap floor rule
#   09 reserves for env — a value delivered over the channel it configures could never bootstrap itself. Unreachable
#   ⇒ the service still boots and still converges on the TTL backstop.
# HARNESS_REDIS_URL=redis://localhost:6379/0

#   LEGACY per-service credential (empty = auth disabled for local dev). This is HARNESS_SERVICE_TOKEN: it guards
#   the inbound internal endpoints AND is the ``X-Service-Token`` the api_client presents to apps/api when the
#   shared INTERNAL_ACCESS_TOKEN above is unset.
# [duplicate key, see API GATEWAY (apps/api) above] # HARNESS_SERVICE_TOKEN=CHANGE_ME

#   Loopback by default: this is a PHI-processing service and must not become LAN-reachable by accident.
#   `scripts/dev-service.sh` takes the same posture for the HTTP ports; containers override with 0.0.0.0.
# HARNESS_TEMPORAL_METRICS_HOST=127.0.0.1

# HARNESS_TEMPORAL_METRICS_PORT=9464

#   Loop / gate-adapter Tool-service base URLs the durable loop calls out to.
# HARNESS_TEXT_BASE_URL=http://localhost:8862

# HARNESS_TEXT_MODEL=

#   Text generation defaults (None => let the Text service choose).
# HARNESS_TEXT_PROVIDER=

