  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Session Handshake (routes.py → session_manager.py)",
      "items": [
        "routes.py:108: create_streaming_session() receives POST /sessions from NestJS Gateway before WebSocket connection.",
        "session_manager.py:1435: Draining guard rejects requests with 503 if node is scaling down.",
        "session_manager.py:1441: CapacityGuard.try_acquire() checks GPU concurrency slots; shielded by _creating set during model cold load.",
        "session_manager.py:1677: Spawns IngestionConsumer on stt:audio:{id} and ControlListener on stt:control:{id}."
      ]
    },
    {
      "dot": "emerald",
      "title": "Audio Front-End Preprocessing (preprocessor.py: feed & VAD)",
      "items": [
        "preprocessor.py:591: Converts int16 PCM to float32 [-1, 1] and resamples to 16 kHz mono.",
        "preprocessor.py:603: Stage 2 Denoise applies DeepFilterNet3 or RNNoise (dual scope: 'vad_only' or 'full').",
        "preprocessor.py:614: Stage 3 Silero VAD evaluates speech probability against hysteresis thresholds.",
        "preprocessor.py:759: SemanticEndpointer checks End-of-Utterance (EOU) model to cut complete sentences early."
      ]
    },
    {
      "dot": "violet",
      "title": "GPU Neural Inference & Post-Processing (inference.py: process_utterance)",
      "items": [
        "session_manager.py:3528: _start_inference_loop consumes utterances from inference_queue.",
        "inference.py:740: Runs acoustic neural ASR (Parakeet / FastConformer / Whisper) in GPU VRAM.",
        "inference.py:752: RepeatGuard (collapse_repeats) prevents autoregressive n-gram hallucination loops.",
        "inference.py:816: Cadence-Fast restores truecase capitalization and punctuation marks within 400ms budget.",
        "inference.py:883: Pyannote extracts 512-dim voice embeddings in parallel to classify speaker IDs.",
        "redis_streams.py:510: ResultPublisher writes final SegmentResult to stt:result:{id} for real-time WebSocket egress."
      ]
    }
  ]
}