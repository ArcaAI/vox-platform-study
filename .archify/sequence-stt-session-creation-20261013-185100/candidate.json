  "cards": [
    {
      "dot": "emerald",
      "title": "1. Input: Request Payloads & Ingress",
      "items": [
        "Doctor UI requests stream initialization with consultation ID and languageMode ('en', 'ml', 'ml-en', 'auto').",
        "API Gateway verifies tenant auth and compiles the complete ResolvedAsrSpec runtime contract from database.",
        "Gateway sends POST /internal/streaming/sessions with session_id, tenant_id, pipeline_id, resolved_spec, and voice_profiles."
      ]
    },
    {
      "dot": "violet",
      "title": "2. Processing: Capacity, Compilation & State Allocation",
      "items": [
        "CapacityGuard verifies active worker sessions are under max_streams limit (rejects with 503 Retry-After if full).",
        "spec.py compiles resolved_spec into typed InferenceConfig (Whisper prompt/hotwords), AudioFrontEndConfig (Silero VAD), and DiarizationConfig.",
        "SessionManager binds EngineSwitchController (primary/fallback) and seeds doctor/patient voice profiles onto SpeakerTracker.",
        "Redis stream keys (stt:audio:{id}, stt:result:{id}, stt:control:{id}) are initialized for audio transport."
      ]
    },
    {
      "dot": "cyan",
      "title": "3. Response: Created Payload & WebSocket Readiness",
      "items": [
        "STT returns HTTP 201 Created with StreamingSessionResponse (status: active, max_concurrent, active_engine: 'primary').",
        "voice_profile_seeded indicates if biometric speaker vectors were successfully enrolled.",
        "Gateway returns sessionId and dedicated wss:// WebSocket URL to the frontend.",
        "Frontend receives the ready signal and opens the live audio uplink stream."
      ]
    }
  ]
