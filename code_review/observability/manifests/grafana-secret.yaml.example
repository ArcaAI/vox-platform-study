# EXAMPLE ONLY — DO NOT COMMIT A REAL PASSWORD, and this file is deliberately
# named `.example` so `kubectl apply -f manifests/` does not pick it up.
#
# Create the real Secret out-of-band so the password never enters git (this is
# the C-3 fix from Arca-AgenticSystemDeployment/REVIEW_REPORT.md, which found a
# live Grafana admin password committed in `grafana-secret.yaml`):
#
#   kubectl -n project-hope-vox-infra create secret generic grafana-admin \
#     --from-literal=GF_SECURITY_ADMIN_USER=admin \
#     --from-literal=GF_SECURITY_ADMIN_PASSWORD="$(openssl rand -hex 24)"
#
# Verify:
#   kubectl -n project-hope-vox-infra get secret grafana-admin
#
# The Deployment (09-grafana.yaml) reads both keys below.
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: project-hope-vox-infra
  labels:
    app: grafana
    app.kubernetes.io/part-of: project-hope
type: Opaque
stringData:
  GF_SECURITY_ADMIN_USER: admin
  GF_SECURITY_ADMIN_PASSWORD: REPLACE_ME_WITH_a_random_value
