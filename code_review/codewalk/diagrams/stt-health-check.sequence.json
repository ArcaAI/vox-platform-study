{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "STT Health Checks",
    "subtitle": "Kubernetes probes + detailed health endpoint",
    "output": "stt-health-check.html",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "kubelet", "type": "external", "label": "Kubelet", "sublabel": "Probes" },
    { "id": "stt_http", "type": "backend", "label": "STT", "sublabel": "FastAPI" },
    { "id": "db", "type": "database", "label": "PostgreSQL", "sublabel": "SQLAlchemy" },
    { "id": "minio", "type": "database", "label": "MinIO", "sublabel": "S3" },
    { "id": "redis", "type": "database", "label": "Redis", "sublabel": "asyncio" },
    { "id": "session_mgr", "type": "backend", "label": "SessionMgr", "sublabel": "Python" },
    { "id": "processors", "type": "backend", "label": "ASR Bindings", "sublabel": "faster-whisper/cpp" },
    { "id": "config_client", "type": "backend", "label": "ConfigClient", "sublabel": "Control Plane" }
  ],
  "messages": [
    { "from": "kubelet", "to": "stt_http", "y": 160, "label": "GET /health/live", "variant": "default" },
    { "from": "stt_http", "to": "kubelet", "y": 210, "label": "200 healthy", "variant": "return" },
    { "from": "kubelet", "to": "stt_http", "y": 260, "label": "GET /health/startup", "variant": "default" },
    { "from": "stt_http", "to": "kubelet", "y": 310, "label": "200/503 healthy/unhealthy", "variant": "return", "note": "Checks app.state.service_release_task" },
    { "from": "kubelet", "to": "stt_http", "y": 360, "label": "GET /health/ready", "variant": "default" },
    { "from": "stt_http", "to": "db", "y": 410, "label": "SELECT 1", "variant": "default" },
    { "from": "db", "to": "stt_http", "y": 460, "label": "OK / disabled", "variant": "return" },
    { "from": "stt_http", "to": "minio", "y": 510, "label": "health_check()", "variant": "default" },
    { "from": "minio", "to": "stt_http", "y": 560, "label": "OK", "variant": "return" },
    { "from": "stt_http", "to": "redis", "y": 610, "label": "ping()", "variant": "default" },
    { "from": "redis", "to": "stt_http", "y": 660, "label": "PONG", "variant": "return" },
    { "from": "stt_http", "to": "session_mgr", "y": 710, "label": "is_draining?", "variant": "default" },
    { "from": "session_mgr", "to": "stt_http", "y": 760, "label": "false", "variant": "return" },
    { "from": "stt_http", "to": "kubelet", "y": 810, "label": "200/503 healthy/draining", "variant": "return" },
    { "from": "kubelet", "to": "stt_http", "y": 860, "label": "GET /health", "variant": "default" },
    { "from": "stt_http", "to": "processors", "y": 910, "label": "asr_processor_health()", "variant": "default" },
    { "from": "processors", "to": "stt_http", "y": 960, "label": "engines + bindings", "variant": "return" },
    { "from": "stt_http", "to": "config_client", "y": 1010, "label": "diagnostics()", "variant": "default" },
    { "from": "config_client", "to": "stt_http", "y": 1060, "label": "config source + timestamps", "variant": "return" },
    { "from": "stt_http", "to": "kubelet", "y": 1110, "label": "200 detailed health JSON", "variant": "return", "note": "Always 200; status in body" }
  ]
}