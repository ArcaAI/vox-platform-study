{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "NLP Text Classification",
    "subtitle": "POST /api/v1/classify/text — document categorization",
    "output": "nlp-text-classification.html",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "client", "type": "frontend", "label": "Client", "sublabel": "HTTP" },
    { "id": "gateway", "type": "backend", "label": "API GW", "sublabel": "NestJS" },
    { "id": "nlp_http", "type": "backend", "label": "NLP", "sublabel": "FastAPI" },
    { "id": "cache", "type": "backend", "label": "ModelCache", "sublabel": "TextClassifier" },
    { "id": "service", "type": "backend", "label": "Transformer", "sublabel": "TextClassifier" },
    { "id": "semaphore", "type": "backend", "label": "Semaphore", "sublabel": "inference_bound" }
  ],
  "messages": [
    { "from": "client", "to": "gateway", "y": 160, "label": "POST /classify/text", "variant": "default", "note": "text + model_name + tenant_id" },
    { "from": "gateway", "to": "nlp_http", "y": 210, "label": "POST /classify/text", "variant": "default" },
    { "from": "nlp_http", "to": "cache", "y": 260, "label": "pinned_text_classifier(model, path)", "variant": "default" },
    { "from": "cache", "to": "nlp_http", "y": 310, "label": "TextClassifier (pinned, weights loaded)", "variant": "return", "note": "first use: load from HF Hub" },
    { "from": "nlp_http", "to": "semaphore", "y": 360, "label": "acquire inference_bound", "variant": "default" },
    { "from": "semaphore", "to": "nlp_http", "y": 410, "label": "granted", "variant": "return" },
    { "from": "nlp_http", "to": "service", "y": 460, "label": "service.process(request)", "variant": "default" },
    { "from": "service", "to": "nlp_http", "y": 510, "label": "TextClassificationResponse", "variant": "return", "note": "label, confidence, all_scores" },
    { "from": "nlp_http", "to": "semaphore", "y": 560, "label": "release inference_bound", "variant": "default" },
    { "from": "nlp_http", "to": "cache", "y": 610, "label": "unpin(key)", "variant": "default" },
    { "from": "nlp_http", "to": "gateway", "y": 660, "label": "200 response", "variant": "return" },
    { "from": "gateway", "to": "client", "y": 710, "label": "200 response", "variant": "return" }
  ]
}