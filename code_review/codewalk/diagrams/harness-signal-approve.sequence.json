    "output": "harness-signal-approve.html",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "gateway", "type": "backend", "label": "API GW", "sublabel": "NestJS" },
    { "id": "harness", "type": "backend", "label": "Harness", "sublabel": "FastAPI" },
    { "id": "temporal", "type": "backend", "label": "Temporal", "sublabel": "Frontend" }
  ],
  "messages": [
    { "from": "gateway", "to": "harness", "y": 160, "label": "/workflows/{id}/signal/approve", "variant": "default", "note": "X-Service-Token + attestation_hash" },
    { "from": "harness", "to": "temporal", "y": 210, "label": "get_workflow_handle(harness-doc-{id})", "variant": "default" },
    { "from": "temporal", "to": "harness", "y": 260, "label": "WorkflowHandle", "variant": "return" },
    { "from": "harness", "to": "temporal", "y": 310, "label": "signal(approval, ApprovalSignal)", "variant": "default", "note": "attestation_hash + clinician_id" },
    { "from": "temporal", "to": "harness", "y": 360, "label": "OK", "variant": "return" },
    { "from": "harness", "to": "gateway", "y": 410, "label": "{workflowId, signaled:true}", "variant": "return" }
  ]
}