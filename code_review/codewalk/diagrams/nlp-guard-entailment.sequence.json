{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "NLP Guardrail Entailment Scoring",
    "subtitle": "POST /api/v1/guard/entailment — MiniCheck NLI",
    "output": "nlp-guard-entailment.html",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "client", "type": "frontend", "label": "Client", "sublabel": "HTTP" },
    { "id": "gateway", "type": "backend", "label": "API GW", "sublabel": "NestJS" },
    { "id": "nlp_http", "type": "backend", "label": "NLP", "sublabel": "FastAPI" },
    { "id": "cache", "type": "backend", "label": "ModelCache", "sublabel": "EntailmentScorer" },
    { "id": "scorer", "type": "backend", "label": "MiniCheck", "sublabel": "NLI (GGUF)" },
    { "id": "semaphore", "type": "backend", "label": "Semaphore", "sublabel": "inference_bound" }
  ],
  "messages": [
    { "from": "client", "to": "gateway", "y": 160, "label": "POST /guard/entailment", "variant": "default", "note": "pairs[] {document, claim} + model + calibration + tenant_id" },
    { "from": "gateway", "to": "nlp_http", "y": 210, "label": "POST /guard/entailment", "variant": "default" },
    { "from": "nlp_http", "to": "cache", "y": 260, "label": "pinned_entailment_scorer(model, path, calibration)", "variant": "default" },
    { "from": "cache", "to": "nlp_http", "y": 310, "label": "MiniCheck scorer (pinned)", "variant": "return", "note": "calibration in cache key; GGUF staged path required" },
    { "from": "nlp_http", "to": "semaphore", "y": 360, "label": "acquire inference_bound", "variant": "default" },
    { "from": "semaphore", "to": "nlp_http", "y": 410, "label": "granted", "variant": "return" },
    { "from": "nlp_http", "to": "scorer", "y": 460, "label": "scorer.score_pairs(pairs)", "variant": "default" },
    { "from": "scorer", "to": "nlp_http", "y": 510, "label": "probabilities[]", "variant": "return" },
    { "from": "nlp_http", "to": "semaphore", "y": 560, "label": "release inference_bound", "variant": "default" },
    { "from": "nlp_http", "to": "cache", "y": 610, "label": "unpin(key)", "variant": "default" },
    { "from": "nlp_http", "to": "gateway", "y": 660, "label": "GuardEntailmentResponse", "variant": "return", "note": "scores[], model_version, inference_ms, device" },
    { "from": "gateway", "to": "client", "y": 710, "label": "200 response", "variant": "return" }
  ]
}