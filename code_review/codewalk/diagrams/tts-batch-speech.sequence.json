{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "TTS Batch Speech Synthesis",
    "subtitle": "POST /api/v1/audio/speech — batch, SSE, and raw streaming modes",
    "output": "tts-batch-speech.html",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "client", "type": "frontend", "label": "Client", "sublabel": "HTTP" },
    { "id": "gateway", "type": "backend", "label": "API GW", "sublabel": "NestJS" },
    { "id": "tts_http", "type": "backend", "label": "TTS", "sublabel": "FastAPI" },
    { "id": "router", "type": "backend", "label": "TTSRouter", "sublabel": "Python" },
    { "id": "engine", "type": "backend", "label": "Engine", "sublabel": "Kokoro/Azure/..." },
    { "id": "model_cache", "type": "backend", "label": "HF Cache", "sublabel": "ONNX/HF" },
    { "id": "metrics", "type": "backend", "label": "Prometheus", "sublabel": "Metrics" }
  ],
  "messages": [
    { "from": "client", "to": "gateway", "y": 160, "label": "POST /api/v1/audio/speech", "variant": "default", "note": "text + resolved_spec + BYOK" },
    { "from": "gateway", "to": "tts_http", "y": 210, "label": "POST /api/v1/audio/speech", "variant": "default" },
    { "from": "tts_http", "to": "router", "y": 260, "label": "candidate_chain(spec, voice)", "variant": "default" },
    { "from": "router", "to": "tts_http", "y": 310, "label": "ordered candidates[]", "variant": "return" },
    { "from": "tts_http", "to": "router", "y": 360, "label": "synthesize(spec, text, voice, fmt)", "variant": "default" },
    { "from": "router", "to": "engine", "y": 410, "label": "_engine_for(candidate)", "variant": "default", "note": "candidates() filters by circuit breaker" },
    { "from": "engine", "to": "model_cache", "y": 460, "label": "load weights (ONNX/HF)", "variant": "default", "note": "First use only — cached" },
    { "from": "model_cache", "to": "engine", "y": 510, "label": "weights loaded", "variant": "return" },
    { "from": "engine", "to": "router", "y": 560, "label": "AudioChunk stream", "variant": "return" },
    { "from": "router", "to": "tts_http", "y": 610, "label": "first chunk → winner", "variant": "return", "note": "provider, connection_id, device" },
    { "from": "tts_http", "to": "metrics", "y": 660, "label": "record_usage_metrics", "variant": "default" },
    { "from": "tts_http", "to": "gateway", "y": 710, "label": "200 Response", "variant": "return", "note": "batch/SSE/raw + X-Tts-* headers" }
  ]
}