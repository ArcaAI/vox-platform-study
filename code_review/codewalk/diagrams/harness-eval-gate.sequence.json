{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Harness Eval Gate",
    "subtitle": "POST /api/v1/internal/eval/run — golden set + PDSQI-9 judge + release gate",
    "output": "harness-eval-gate.html",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "gateway", "type": "backend", "label": "API GW", "sublabel": "NestJS" },
    { "id": "harness", "type": "backend", "label": "Harness", "sublabel": "FastAPI" },
    { "id": "judge", "type": "backend", "label": "Judge", "sublabel": "PDSQI-9" },
    { "id": "config", "type": "backend", "label": "Config", "sublabel": "Control Plane" }
  ],
  "messages": [
    { "from": "gateway", "to": "harness", "y": 160, "label": "/eval/run", "variant": "default", "note": "goldenSet + promptTemplateId + X-Service-Token" },
    { "from": "harness", "to": "config", "y": 210, "label": "get_effective_config()", "variant": "default", "note": "reasoning mode/effort" },
    { "from": "config", "to": "harness", "y": 260, "label": "reasoning_mode + effort", "variant": "return" },
    { "from": "harness", "to": "judge", "y": 310, "label": "build PDSQI9Judge + faithfulness", "variant": "default", "note": "validate case count <= max_cases" },
    { "from": "harness", "to": "judge", "y": 360, "label": "run_and_gate(golden_set, judge)", "variant": "default", "note": "PDSQI-9 mean + faithfulness" },
    { "from": "judge", "to": "harness", "y": 410, "label": "EvalResult (passed/fail + scores)", "variant": "return" },
    { "from": "harness", "to": "gateway", "y": 460, "label": "EvalResult + provenance", "variant": "return", "note": "promptTemplateId + caseScores" }
  ]
}