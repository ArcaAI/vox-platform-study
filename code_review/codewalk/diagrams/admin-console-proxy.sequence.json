{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Admin Console BFF Proxy",
    "subtitle": "* /api/hope/* — JWE session → Gateway with auto-refresh on 401",
    "output": "admin-console-proxy.html",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "browser", "type": "frontend", "label": "Browser", "sublabel": "React" },
    { "id": "admin_console", "type": "backend", "label": "Admin Console", "sublabel": "Next.js" },
    { "id": "gateway", "type": "backend", "label": "API Gateway", "sublabel": "NestJS" }
  ],
  "messages": [
    { "from": "browser", "to": "admin_console", "y": 160, "label": "GET /api/hope/tenants", "variant": "default", "note": "cookie: SESSION=JWE" },
    { "from": "admin_console", "to": "gateway", "y": 210, "label": "GET /api/v1/tenants", "variant": "default", "note": "unsealSession() → JWT decrypt (A256GCM)" },
    { "from": "gateway", "to": "admin_console", "y": 260, "label": "200 OK + data", "variant": "return" },
    { "from": "admin_console", "to": "browser", "y": 310, "label": "200 + forwarded headers", "variant": "return", "note": "content-type, etag, cache-control" },
    { "from": "browser", "to": "admin_console", "y": 360, "label": "POST /api/hope/resource (401)", "variant": "default", "note": "expired access token" },
    { "from": "admin_console", "to": "gateway", "y": 410, "label": "POST /api/v1/resource → 401", "variant": "default" },
    { "from": "admin_console", "to": "gateway", "y": 460, "label": "POST /api/v1/resource (retry)", "variant": "default", "note": "refreshSession() → new accessToken" },
    { "from": "gateway", "to": "admin_console", "y": 510, "label": "200 OK", "variant": "return" },
    { "from": "admin_console", "to": "browser", "y": 560, "label": "200 OK", "variant": "return" }
  ]
}