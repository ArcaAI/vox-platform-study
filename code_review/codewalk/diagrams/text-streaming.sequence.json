{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Text Streaming Generation",
    "subtitle": "POST /api/v1/generate (stream=true) + GET /generations/{id}/stream — SSE with resumable tail",
    "output": "text-streaming.html",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "client", "type": "frontend", "label": "Client", "sublabel": "HTTP" },
    { "id": "gateway", "type": "backend", "label": "API GW", "sublabel": "NestJS" },
    { "id": "text", "type": "backend", "label": "Text Svc", "sublabel": "FastAPI" },
    { "id": "hub", "type": "backend", "label": "GenHub", "sublabel": "Producer + Ring" },
    { "id": "provider", "type": "backend", "label": "Provider", "sublabel": "LLM" },
    { "id": "redis", "type": "database", "label": "Redis", "sublabel": "Streams + State" },
    { "id": "usage", "type": "backend", "label": "UsageLedger", "sublabel": "Gateway" }
  ],
  "messages": [
    { "from": "client", "to": "gateway", "y": 160, "label": "POST /generate stream=true", "variant": "default", "note": "Idempotency-Key + X-Tenant-Id" },
    { "from": "gateway", "to": "text", "y": 210, "label": "POST /api/v1/generate", "variant": "default" },
    { "from": "text", "to": "redis", "y": 260, "label": "GET text:idem:stream:{key}", "variant": "default", "note": "stream idempotency" },
    { "from": "redis", "to": "text", "y": 310, "label": "generation_id / miss", "variant": "return" },
    { "from": "text", "to": "hub", "y": 360, "label": "hub.start(generation_id, producer)", "variant": "default" },
    { "from": "hub", "to": "provider", "y": 410, "label": "run_generation_producer()", "variant": "default" },
    { "from": "provider", "to": "hub", "y": 460, "label": "chunk events (seq, payload)", "variant": "return" },
    { "from": "hub", "to": "redis", "y": 510, "label": "XADD text:events:{id} (durable)", "variant": "default" },
    { "from": "hub", "to": "text", "y": 560, "label": "EventSourceResponse (SSE)", "variant": "return" },
    { "from": "text", "to": "gateway", "y": 610, "label": "SSE stream → client", "variant": "return" },
    { "from": "client", "to": "gateway", "y": 660, "label": "GET /generations/{id}/stream", "variant": "default", "note": "Resume from Last-Event-ID cursor" },
    { "from": "gateway", "to": "text", "y": 710, "label": "GET /generations/{id}/stream", "variant": "default" },
    { "from": "text", "to": "redis", "y": 760, "label": "XREAD text:events:{id} (tail)", "variant": "default" },
    { "from": "redis", "to": "text", "y": 810, "label": "events from cursor", "variant": "return" },
    { "from": "text", "to": "gateway", "y": 860, "label": "SSE resume → client", "variant": "return" },
    { "from": "text", "to": "usage", "y": 910, "label": "usage_detail on terminal frame", "variant": "default" }
  ]
