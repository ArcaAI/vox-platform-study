{
  "name": "@arcaai/stt",
  "version": "0.1.0",
  "description": "Speech-to-text plugin for @arcaai/room with local Whisper and backend fallback support",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": "./dist/react-server-stub.mjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.ts*\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed"
  },
  "keywords": [
    "speech-to-text",
    "stt",
    "whisper",
    "transcription",
    "audio",
    "web-audio",
    "transformers",
    "onnx",
    "webgpu",
    "react"
  ],
  "author": "ARCAAI",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "eventemitter3": "^5.0.4",
    "onnxruntime-common": "1.27.0",
    "onnxruntime-web": "1.27.0"
  },
  "peerDependencies": {
    "@arcaai/room": "workspace:*",
    "react": "^18.3.0 || ^19.0.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@arcaai/room": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "http-server": "^14.1.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
