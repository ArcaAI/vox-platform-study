{
  "name": "@arcaai/stt",
  "version": "3.6.0",
  "description": "Speech-to-text plugin for @arcaai/room with local Whisper and backend fallback support",
  "deprecated": "DEPRECATED (TASK-865) — removed in R4, two releases after R2. In-browser Whisper is retired; transcription is backend streaming ASR selected by the tenant's ASR Agent (@arcaai/vox audio.start({ agentSlug })). The browser never runs a model. See docs/operations/deprecation-register.md.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": "./dist/react-server-stub.mjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config e2e/playwright.config.ts --debug"
  },
  "keywords": [
    "speech-to-text",
    "stt",
    "whisper",
    "transcription",
    "audio",
    "web-audio",
    "transformers",
    "onnx",
    "webgpu",
    "react"
  ],
  "author": "ARCAAI",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "eventemitter3": "^5.0.4",
    "onnxruntime-common": "1.27.0",
    "onnxruntime-web": "1.27.0"
  },
  "peerDependencies": {
    "@arcaai/room": "workspace:^",
    "react": "^18.3.0 || ^19.0.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@arcaai/room": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "http-server": "^14.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaAI/project-hope.git"
  }
}
