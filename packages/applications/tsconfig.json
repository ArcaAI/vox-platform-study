{
  "extends": "@arcaai/config-ts/nestjs.json",
  "compilerOptions": {
    "lib": [
      "ES2015",
      "DOM"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}