{
  "name": "@arcaai/vad",
  "version": "0.1.0",
  "description": "Voice Activity Detection plugin for @arcaai/room using Silero VAD v5 with ONNX Runtime",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worklet": {
      "types": "./dist/worklets/vad.worklet.d.ts",
      "import": "./dist/worklets/vad.worklet.js"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:e2e": "tsup && cp -r dist e2e/fixtures/",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.ts*\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:chromium": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts --project=chromium",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "audio",
    "voice-activity-detection",
    "vad",
    "silero",
    "onnx",
    "webassembly",
    "wasm",
    "web-audio",
    "audioworklet",
    "speech-detection",
    "arcaai",
    "room"
  ],
  "author": "ARCAAI",
  "license": "MIT",
  "peerDependencies": {
    "@arcaai/room": "^0.1.0",
    "react": "^18.3.0 || ^19.0.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30"
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@arcaai/room": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/audioworklet": "^0.0.96",
    "@types/react": "^19.2.14",
    "http-server": "^14.1.1",
    "jsdom": "^28.1.0",
    "onnxruntime-web": "^1.24.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.17"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaAI/Arca-AgenticSDK.git"
  },
  "type": "module"
}
