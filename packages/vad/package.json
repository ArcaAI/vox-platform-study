{
  "name": "@arcaai/vad",
  "version": "3.1.0",
  "description": "Voice Activity Detection plugin for @arcaai/room using Silero VAD v5 with ONNX Runtime",
  "deprecated": "DEPRECATED (TASK-865) — removed in R4, two releases after R2. Client-side VAD is retired; the tenant's ASR Agent runs VAD server-side. The browser never runs a model. See docs/operations/deprecation-register.md.",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-server": "./dist/react-server-stub.mjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:e2e": "tsup && cp -r dist e2e/fixtures/",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:chromium": "pnpm build:e2e && playwright test --config=e2e/playwright.config.ts --project=chromium"
  },
  "keywords": [
    "audio",
    "voice-activity-detection",
    "vad",
    "silero",
    "onnx",
    "webassembly",
    "wasm",
    "web-audio",
    "audioworklet",
    "speech-detection",
    "arcaai",
    "room"
  ],
  "author": "ARCAAI",
  "license": "MIT",
  "peerDependencies": {
    "@arcaai/room": "workspace:^",
    "react": "^18.3.0 || ^19.0.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30"
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@arcaai/room": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/audioworklet": "^0.0.100",
    "@types/react": "^19.2.18",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "onnxruntime-web": "1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaAI/project-hope.git"
  },
  "type": "module"
}
