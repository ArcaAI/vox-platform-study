{
    "name": "@arcaai/logger",
    "version": "0.0.1",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "clean": "rimraf dist tsconfig.tsbuildinfo",
        "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
        "dev": "tsc -w",
        "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.ts*\" --max-warnings 0",
        "test": "vitest run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "winston-s3-transport": "^2.1.2"
    },
    "devDependencies": {
        "@arcaai/config-eslint": "workspace:*",
        "@arcaai/config-ts": "workspace:*",
        "@types/node": "^25.9.4",
        "jsdom": "^29.1.1",
        "typescript": "^5.9.3"
    }
}