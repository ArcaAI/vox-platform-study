{
  "name": "@arcaai/vox",
  "version": "5.0.1",
  "description": "ARCAAI Vox SDK for medical consultation workflows",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.mjs",
      "require": "./dist/plugins.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "plugins": [
        "./dist/plugins.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && pnpm build:dts",
    "build:dts": "tsc -p tsconfig.json --emitDeclarationOnly --declaration",
    "dev": "tsup --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo e2e/fixtures/dist",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo e2e/fixtures/dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm build && playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "pnpm build && playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:chromium": "pnpm build && playwright test --config=e2e/playwright.config.ts --project=chromium"
  },
  "dependencies": {
    "@arcaai/json-schema-subset": "workspace:*",
    "@arcaai/types": "workspace:*",
    "@arcaai/room": "workspace:*",
    "@arcaai/stt": "workspace:*",
    "deepmerge-ts": "^8.0.2",
    "diff": "^9.0.0",
    "eventemitter3": "^5.0.4",
    "valibot": "^1.4.2",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@microsoft/clarity": "^1.0.0",
    "highlight.run": "^9.0.0",
    "react": "^18.3.0 || ^19.0.4",
    "react-dom": "^18.3.0 || ^19.0.4"
  },
  "peerDependenciesMeta": {
    "@microsoft/clarity": {
      "optional": true
    },
    "highlight.run": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@microsoft/clarity": "^1.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "arcaai",
    "vox",
    "medical",
    "consultation",
    "speech-to-text",
    "react",
    "hooks",
    "plugin",
    "personalization"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaAI/project-hope.git"
  }
}
