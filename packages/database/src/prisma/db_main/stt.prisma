// =============================================================================
// STT SERVICE DOMAIN MODELS
// Speech-to-Text service data models for AI models and transcription jobs.
//
// TASK-1006 — the `AsrPipeline` / `AsrPipelineVersion` catalogue (the
// pre-agent pipeline stack, deprecated by TASK-861) is RETIRED: selection is
// `agentSlug` only, resolved by the gateway (`AsrAgentResolverService`) into a
// `ResolvedAsrSpec` handed to `apps/stt`. See `TranscriptionJob.agentVersionId`
// / `resolvedSpec` below.
// =============================================================================

// =============================================================================
// TRANSCRIPTION JOB
// Tracks transcription job status and progress
// =============================================================================

model TranscriptionJob {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Job type
  jobType TranscriptionJobType // BATCH, STREAMING

  // Related entities (external references, no FK to Consultation/ContextItem)
  consultationId String? // Target consultation
  contextItemId  String? // Created ContextItem (after completion)
  mediaId        String? // Source audio file (for batch)

  // TASK-861 — the ASR Agent VERSION that ran this job (`Agent.id`; rows are
  // versions). No FK: the agent row may be deprecated/archived after the job,
  // and the job must stay readable as operational history. TASK-1006 made
  // this the ONLY attribution: the deprecated `pipelineId` column is gone.
  agentVersionId String?
  // TASK-861 — the exact `ResolvedAsrSpec` (packages/types `asr-spec.ts`) the
  // gateway resolved for this job and handed to the worker. Snapshot, never
  // re-resolved: the job is reproducible from its own row. Never carries a
  // credential (provider overrides travel separately).
  resolvedSpec Json? @db.JsonB

  /// TASK-999 — the STT session this row mirrors, for `jobType = STREAMING`
  /// rows. A realtime session's own state lives in Redis (`stt:session:{id}`,
  /// 24h TTL); this column is the durable handle that lets a live session and
  /// its row be reconciled while Redis still holds it, and that keeps the row
  /// meaningful after Redis has forgotten. NULL for every BATCH row.
  streamSessionId String?

  /// TASK-999 — which entry of `resolvedSpec.fallback.chain` ACTUALLY served.
  /// The chain is a snapshot of what COULD run; nothing recorded what did, and
  /// the engine name alone cannot disambiguate a primary from a fallback that
  /// shares its provider. Shape: `{ chainIndex, source: 'primary' | 'fallback',
  /// agentSlug, modelSlug, provider, engine }`. NULL = not recorded (every
  /// pre-TASK-999 row, and any job that never reached a worker).
  servedBy Json? @db.JsonB

  // TASK-992 FU-1 — everything needed to RE-PUBLISH this job's Dramatiq message,
  // snapshotted by `TranscriptionRealtimeService.dispatchDramatiqJob` at the moment
  // it enqueues. Without it a retry is only a status flip: the row goes back to
  // QUEUED with no message behind it and no worker ever claims it.
  //
  // `audioUri` is the reason this column has to exist at all — the upload path
  // derives it from the request filename plus this job's own id, so it is gone the
  // instant the request ends, and that path's `mediaId` is a bare uuid with no
  // media row behind it. It is NOT reconstructable from anything else here.
  //
  // Written at DISPATCH, not at create: the URI contains the job id, so it does
  // not exist yet when the row is inserted.
  //
  // NEVER a credential. The `storage` kwarg the worker also receives is a
  // `StorageDescriptor` carrying `secret_access_key` / `account_key` /
  // `connection_string`; only its BUCKET NAME is kept here and the descriptor is
  // re-resolved live on retry.
  dispatchEnvelope Json? @db.JsonB

  // Job status
  status   TranscriptionJobStatus @default(QUEUED)
  progress Int                    @default(0) // 0-100

  // Timing
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Results (on completion). The plaintext resultText / resultMetadata
  // columns have been DROPPED; persisted as Vault-Transit ciphertext only.

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // transcription result (resultText / resultMetadata) plus the shared Transit
  // key version. These ciphertext columns are now the system of record.
  encryptedResultText     Bytes?
  encryptedResultMetadata Bytes?
  keyVersion              Int?

  /// TASK-999 — size of the produced transcript, measured ONCE by the writer at
  /// completion. `encryptedResultText` cannot be measured without a Vault
  /// decrypt, so an admin read must not be the thing that counts it. NULL =
  /// never measured; 0 is a real empty transcript, not a missing one.
  resultWordCount Int?
  resultCharCount Int?

  // Error handling
  errorMessage String?
  errorCode    String?
  retryCount   Int     @default(0)
  maxRetries   Int     @default(3)

  /// TASK-992 — crash-RECLAIMS, counted separately from `retryCount` (OD-2).
  /// A worker that died mid-flight and a transcription that genuinely failed
  /// are different events: sharing one budget means a worker OOM spends the
  /// allowance a bad audio file needs. Bumped by
  /// `TranscriptionJobEntity.reclaimProcessing`; the BOUND lives in
  /// `stt.batch.maxReclaims` (global-kv), not in a sibling column — it is a
  /// platform threshold, not a per-row property.
  reclaimCount Int @default(0)

  // Worker info
  workerId String? // Which worker processed this

  // Audit
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([tenantId], name: "TranscriptionJob_tenantId_idx")
  @@index([status], name: "TranscriptionJob_status_idx")
  @@index([agentVersionId], name: "TranscriptionJob_agentVersionId_idx")
  @@index([consultationId], name: "TranscriptionJob_consultationId_idx")
  @@index([createdAt], name: "TranscriptionJob_createdAt_idx")
  @@index([tenantId, status, createdAt], name: "TranscriptionJob_tenant_status_created_idx")
  /// TASK-992 — the reaper's exact access path: cross-tenant
  /// `status = PROCESSING AND updatedAt < :staleBefore`, ordered by `updatedAt`.
  @@index([status, updatedAt], name: "TranscriptionJob_status_updated_idx")
  /// TASK-999 — the admin list's access path once realtime sessions are rows
  /// too: one tenant, filtered by kind, newest first.
  @@index([tenantId, jobType, createdAt], name: "TranscriptionJob_tenant_jobType_created_idx")
  /// TASK-999 — reconciling a live STT session with its row.
  @@index([streamSessionId], name: "TranscriptionJob_streamSessionId_idx")
  @@schema("core")
}
