// =============================================================================
// STT SERVICE DOMAIN MODELS
// Speech-to-Text service data models for ASR pipelines, AI models, and jobs
// =============================================================================

// =============================================================================
// ASR PIPELINE DEFINITION
// Stores ASR pipeline configurations managed by administrators
// Models are referenced by slug in configYaml, no FK relationships to AiModel
// =============================================================================

model AsrPipeline {
  // Meta fields (BaseEntity pattern)
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant (system-wide or tenant-specific)
  tenantId String

  // Core fields
  name        String // e.g., "whisper-large-v3-medical"
  slug        String // URL-friendly unique identifier
  description String?

  // Pipeline configuration (YAML stored as text, validated on write)
  // Contains model references by slug: models.asr, models.vad, models.denoise
  configYaml String @db.Text

  // Per-tenant default backend pipeline assignment
  isDefault Boolean @default(false)

  // Template lineage. The SYSTEM-tenant catalog rows ARE the
  // templates: they carry `sourceTemplateSlug = null` and `templateLocked = false`.
  // A tenant copy cloned from a template records the template's slug here
  // (provenance survives clone chains) and is `templateLocked = true`, which the
  // application layer treats as read-only for content edits + delete — tenant
  // admins clone it to customize. `templateLocked` is deliberately absent from
  // every request DTO, so the gateway's whitelist pipe rejects attempts to flip
  // it over the API. No FK: pipelines already reference each other by slug.
  sourceTemplateSlug String?
  templateLocked     Boolean @default(false)

  // Resource status + Audit
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Tags
  tags String[] @default([])

  // Relations (only TranscriptionJob references pipeline)
  TranscriptionJobs TranscriptionJob[]
  Versions          AsrPipelineVersion[]

  // Indexes
  @@unique([tenantId, slug], name: "AsrPipeline_tenant_slug_unique")
  @@index([tenantId], name: "AsrPipeline_tenantId_idx")
  @@index([resourceStatus], name: "AsrPipeline_status_idx")
  // Resync/backfill scan predicate (per-tenant locked-copy sweep).
  @@index([tenantId, templateLocked], name: "AsrPipeline_tenant_locked_idx")
  @@schema("core")
}

// =============================================================================
// ASR PIPELINE VERSION
// Immutable history of an AsrPipeline's configYaml for rollback/diff.
// =============================================================================

model AsrPipelineVersion {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent pipeline
  asrPipelineId String
  AsrPipeline   AsrPipeline @relation(fields: [asrPipelineId], references: [id])

  // Version snapshot
  versionNumber Int
  configYaml    String  @db.Text
  name          String?
  description   String?

  // Change tracking
  changeReason String?
  changedBy    String?

  // Timestamps
  createdAt DateTime @default(now())

  // Constraints
  @@unique([asrPipelineId, versionNumber])
  // Indexes
  @@index([tenantId], name: "AsrPipelineVersion_tenantId_idx")
  @@index([asrPipelineId], name: "AsrPipelineVersion_asrPipelineId_idx")
  @@schema("core")
}

// =============================================================================
// AI MODEL REGISTRY
// Standalone registry for AI models (ASR, VAD, Noise Reduction, etc.)
// No direct relationships - referenced by slug in pipeline configYaml
// =============================================================================

model AiModel {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Core identification
  name        String // e.g., "Whisper Large V3"
  slug        String // e.g., "whisper-large-v3" (used in pipeline YAML)
  description String?

  // Model classification (using existing enums)
  category  ModelCategory // AUDIO
  taskType  ModelTaskType // AUTOMATIC_SPEECH_RECOGNITION, VOICE_ACTIVITY_DETECTION
  modelType ModelType // BASE_MODEL, FINETUNED_MODEL, QUANTIZED_MODEL

  // Model source and location
  //
  // `sourceUri` scheme grammar honoured by every service's
  // `resolve_model_dir` (stt, guardrail, nlp, harness):
  //   hf:<org>/<repo> | <org>/<repo>  HuggingFace Hub snapshot (bare id also
  //                                   accepted); honours HF_HUB_OFFLINE
  //   file:///abs/path                verified in place, never copied
  //   s3://bucket/prefix              downloaded once into the service cache,
  //                                   single-flight + SHA256-verified
  // Anything else is a hard `ModelSourceError` — never a silent fallback.
  // Only `s3://` is supported; `azure-blob://` is deferred.
  source         AiModelSource // HUGGINGFACE, GITHUB, MLFLOW, LOCAL, S3
  sourceUri      String // e.g., "openai/whisper-large-v3", "s3://models/minicheck", "file:///opt/models/x"
  sourceRevision String? // Git revision, MLFlow version, etc.

  // Model format for loader selection
  format AiModelFormat // SAFETENSOR, ONNX, NEMO, PYTORCH

  // Serving provider + architecture — nullable; set for admin-
  // selectable task models (LLM/guardrail/NLP/TTS) and backfilled for engines.
  provider     String? // ollama | lm-studio | azure | bedrock | built-in | sarvam
  architecture String? // e.g. gemma4, gemma3, qwen3.5, granite, whisper

  // Resource requirements (for scheduling/allocation)
  memorySizeMb Int? // Estimated GPU/CPU memory in MB
  computeType  String? // float32, float16, int8

  // Download/cache status
  // `downloadStatus`/`downloadedAt` are manual registry bookkeeping
  // (no write-back automation yet).
  downloadStatus AiModelDownloadStatus @default(NOT_DOWNLOADED)
  // Operator/admin override — HIGHEST precedence in every service's
  // `resolve_model_dir`, ahead of `sourceUri` scheme dispatch. Use it for
  // air-gapped hosts and pre-staged NFS mounts. Set-but-missing falls THROUGH
  // to scheme dispatch with a structlog warning (never a hard failure).
  localPath      String?
  downloadedAt   DateTime?
  fileSizeMb     Int?
  // SHA256 for verification. When set, single-file artifacts (GGUF/ONNX) are
  // verified after download and on first use of a pre-existing cache entry;
  // a mismatch is a HARD error and the model is never served. On directory
  // snapshots (HF) it is a documented no-op with a warning.
  checksum       String?

  // Resource status + Audit
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Tags
  tags String[] @default([])

  // NO RELATIONS - models are referenced by slug in pipeline YAML

  // Indexes
  @@unique([tenantId, slug], name: "AiModel_tenant_slug_unique")
  @@index([tenantId], name: "AiModel_tenantId_idx")
  @@index([category], name: "AiModel_category_idx")
  @@index([taskType], name: "AiModel_taskType_idx")
  @@index([source], name: "AiModel_source_idx")
  @@index([format], name: "AiModel_format_idx")
  @@index([provider], name: "AiModel_provider_idx")
  @@index([resourceStatus], name: "AiModel_status_idx")
  @@schema("core")
}

// =============================================================================
// TRANSCRIPTION JOB
// Tracks transcription job status and progress
// =============================================================================

model TranscriptionJob {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Job type
  jobType TranscriptionJobType // BATCH, STREAMING

  // Related entities (external references, no FK to Consultation/ContextItem)
  consultationId String? // Target consultation
  contextItemId  String? // Created ContextItem (after completion)
  mediaId        String? // Source audio file (for batch)

  // Pipeline used (FK relationship)
  pipelineId String
  Pipeline   AsrPipeline @relation(fields: [pipelineId], references: [id])

  // Job status
  status   TranscriptionJobStatus @default(QUEUED)
  progress Int                    @default(0) // 0-100

  // Timing
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Results (on completion). The plaintext resultText / resultMetadata
  // columns have been DROPPED; persisted as Vault-Transit ciphertext only.

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // transcription result (resultText / resultMetadata) plus the shared Transit
  // key version. These ciphertext columns are now the system of record.
  encryptedResultText     Bytes?
  encryptedResultMetadata Bytes?
  keyVersion              Int?

  // Error handling
  errorMessage String?
  errorCode    String?
  retryCount   Int     @default(0)
  maxRetries   Int     @default(3)

  // Worker info
  workerId String? // Which worker processed this

  // Audit
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([tenantId], name: "TranscriptionJob_tenantId_idx")
  @@index([status], name: "TranscriptionJob_status_idx")
  @@index([pipelineId], name: "TranscriptionJob_pipelineId_idx")
  @@index([consultationId], name: "TranscriptionJob_consultationId_idx")
  @@index([createdAt], name: "TranscriptionJob_createdAt_idx")
  @@index([tenantId, status, createdAt], name: "TranscriptionJob_tenant_status_created_idx")
  @@schema("core")
}
