// ============================================================================
// Per-Tenant STT (Speech-to-Text) Configuration
//
// DB-backed, tenant-admin-editable STT "spec", resolved at request time by the
// apps/api gateway and injected into the STATELESS apps/stt service (the Python
// service never touches Postgres). Mirrors the TTS pair
// (tenant-tts-config.prisma) file-for-file.
//
//   TenantSttConfig — ONE row per tenant (tenantId @unique). The reserved
//   SYSTEM tenant `00000000-0000-0000-0000-000000000000` owns the PLATFORM-
//   DEFAULT row; a tenant row overrides it field-by-field (null => inherit).
//   Carries the tenant-level FALLBACK POINTER (`fallbackPipelineId`) and the
//   auto-switch kill-switch (`autoSwitchEnabled`, default ON). Resolution
//   (tenant row merged over the SYSTEM default) lives in TenantSttConfigService
//   (packages/applications, Phase C). `configJson` is the forward-compat
//   escape hatch (mirrors TenantTtsConfig.configJson).
//
// The former per-(tenant, provider) BYO credential model, TenantSttProviderCredential,
// was DROPPED in — its rows were copied into the unified
// `AiProviderConnection` table (`service='stt'`), which is now the ONLY
// credential/connection store for STT. `ResourceType.TenantSttProviderCredential`
// remains a harmless-unused enum member (see audit.prisma) so enum-parity stays
// green without an unsafe Postgres enum-value drop.
//
// This model is OCC-written (carries `_version`); its mapper strips `version`.
// ============================================================================

model TenantSttConfig {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields (one config per tenant; SYSTEM tenant = platform default)
  tenantId String @unique

  // core fields — tenant STT spec. NULLABLE = inherit from the SYSTEM default /
  // code default. `fallbackPipelineId` points at the tenant-level default
  // fallback pipeline (validated in the service: tenant-visible, ENABLED,
  // cloud-engine-backed). `autoSwitchEnabled` is the tenant kill-switch for the
  // error-triggered auto-switch (default ON). `configJson` is the forward-compat
  // escape hatch.
  fallbackPipelineId String?
  autoSwitchEnabled  Boolean @default(true)
  configJson         Json?   @db.JsonB

  // TASK-843 — CONSTANT for the table (every row is a speech-to-text binding),
  // so NOT NULL with the correct default. See `AsrPipeline.taskKind` for the
  // full rationale, including why a redundant column is the right migration
  // seam for TASK-844. This table is NOT retired here.
  taskKind AiTaskKind @default(SPEECH_TO_TEXT)

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // indexing
  @@index([tenantId], name: "TenantSttConfig_tenantId_idx")
  @@schema("core")
}
