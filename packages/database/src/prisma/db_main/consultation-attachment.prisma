// =============================================================================
// CONSULTATION ATTACHMENT
// =============================================================================

// One uploaded file attached to a consultation (or to a feedback entry, with
// `purpose = FEEDBACK`). Created as an upload INTENT, moved through UPLOADED →
// PROCESSING → READY (or FAILED / EXPIRED). The object key carries ids only;
// the original file name is PHI-prone and stored as Vault-Transit (hope-phi)
// ciphertext. `consultationId`, `mediaId`, `contextItemId` and
// `transcriptionJobId` are soft references (no FK).
model ConsultationAttachment {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // core fields
  consultationId     String
  encounterSeq       Int?
  purpose            ConsultationAttachmentPurpose @default(ATTACHMENT)
  kind               ConsultationAttachmentKind
  status             ConsultationAttachmentStatus  @default(INTENT)
  uploadMode         String                        @default("PRESIGNED") // PRESIGNED | GATEWAY
  declaredMime       String
  declaredSizeBytes  Int
  declaredSha256     String // hex
  bucketName         String
  objectKey          String // ids only
  encryptedFileName  Bytes?
  keyVersion         Int?
  idempotencyKey     String?
  uploadExpiresAt    DateTime
  intentExpiresAt    DateTime // reaper cutoff
  completedAt        DateTime?
  failureCode        String?
  mediaId            String?
  contextItemId      String?
  transcriptionJobId String?

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, consultationId, idempotencyKey], map: "ConsultationAttachment_idem_uq")
  @@index([tenantId], name: "ConsultationAttachment_tenantId_idx")
  @@index([tenantId, consultationId], name: "ConsultationAttachment_tenant_consultation_idx")
  @@index([status, intentExpiresAt], name: "ConsultationAttachment_reap_idx")
  @@index([transcriptionJobId], name: "ConsultationAttachment_job_idx")
  @@schema("core")
}
