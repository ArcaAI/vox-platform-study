// ============================================================================
// RBAC Models - Policy-Based Authorization
// ============================================================================
// This schema implements a policy-based RBAC system using CASL.
// 
// Key concepts:
// - Role: A named collection of policies (e.g., ADMIN, MANAGER, USER)
// - Policy: A set of CASL rules stored as JSON (e.g., can read User, can manage Consultation)
// - RolePolicy: Links roles to policies with priority
// - UserRoleAssignment: Assigns roles to users (with optional tenant scope)
//
// Authorization flow:
// 1. User authenticates
// 2. PolicyEngine loads user's roles via UserRoleAssignment
// 3. For each role, load associated policies via RolePolicy
// 4. Build CASL ability from all policy rules
// 5. Check permissions using ability.can(action, subject)
// ============================================================================

model Role {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  // OD-1 (owner decision, 2026-08-20). `Role` used to be a GLOBAL table, which
  // is why a tenant admin could not be granted write access to its OWN custom
  // roles without also being able to touch every other tenant's — CASL
  // `conditions` are shadow-mode, so `{ isSystemRole: false }` constrained
  // nothing at request time. Giving `Role` a real `tenantId` puts it behind the
  // tenant-scope Prisma extension, which is a data-layer boundary rather than a
  // handler-level guard that each new route has to remember.
  //
  // Two kinds of row live here:
  //   • SYSTEM tenant (00000000-…) — the platform's built-in roles
  //     (SUPER_ADMIN, TENANT_ADMIN, DOCTOR, NURSE, SERVICE_ACCOUNT,
  //     DEPARTMENT_HEAD, SENIOR_NURSE). `Role` is in SYSTEM_SHARED_READ_MODELS,
  //     so every tenant RESOLVES these directly — they are never cloned per
  //     tenant. Reads widen to `tenantId IN [caller, SYSTEM]`; writes do NOT.
  //   • A customer tenant — a custom role that tenant created via
  //     `POST /admin/rbac/roles` or `:id/clone`, protected exactly like any
  //     other tenant-owned row.
  //
  // No FK and no default, per the standard field template: every writer states
  // the tenant explicitly.
  tenantId String

  // core fields
  name         String
  description  String?
  externalName String? // Display name for UI
  externalId   String? // External system integration ID

  // System role flag (built-in roles cannot be deleted)
  isSystemRole Boolean @default(false)

  // Role hierarchy - child roles inherit parent's policies
  parentRoleId String?
  ParentRole   Role?   @relation("_Role_ParentRole", fields: [parentRoleId], references: [id])
  ChildRoles   Role[]  @relation("_Role_ParentRole")

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  RolePolicies        RolePolicy[]         @relation("_Role_RolePolicies")
  UserRoleAssignments UserRoleAssignment[] @relation("_Role_UserRoleAssignments")

  // indexing
  // DELIBERATELY still a GLOBAL unique on `name`, NOT the `[tenantId, name]`
  // composite the standard field template would suggest. Role names are
  // globally unique TODAY (the table was global), so keeping the constraint
  // preserves the status quo instead of shipping a second semantic change
  // alongside the tenancy one. Concretely it stops a tenant's custom role from
  // shadowing a built-in name that other code keys off by name — the seeds
  // (`92-bootstrap-admin.ts`, `93-bootstrap-tenant-admin.ts`) and
  // `UserRoleAssignmentService.assertAssignableRoleTier`'s `SUPER_ADMIN` check.
  //
  // The cost is real and is recorded as an open follow-up in
  // one tenant
  // taking the name "REVIEWER" refuses it to every other tenant. Relaxing this
  // to `@@unique([tenantId, name], map: "Role_tenantId_name_unique")` is the
  // fix, and it needs a service-layer guard that refuses a tenant-created name
  // colliding with a SYSTEM role name. Out of scope here.
  @@unique([name], name: "Role_name_unique")
  @@index([parentRoleId], name: "Role_parentRoleId_idx")
  @@index([tenantId], name: "Role_tenantId_idx")
  @@schema("core")
}

// `Policy` deliberately gets NO `tenantId` — it stays a GLOBAL table, and so
// does the `RolePolicy` join (OD-1 resolution, 2026-08-20).
//
// OD-1's gap was "a tenant admin cannot mutate its own tenant's CUSTOM ROLES".
// A tenant admin never AUTHORS a policy; it attaches and detaches
// platform-authored ones, which it can already do — `manage:RolePolicy` is in
// the seeded `rbac-tenant-manage` grant. So `Policy` needs no tenancy to close
// OD-1, and giving it one would mean:
//   • a per-tenant CASL rule-authoring plane nobody asked for (a tenant could
//     write its own `rules` JSON — the single most privilege-sensitive column
//     in the schema);
//   • breaking the by-NAME global lookups the platform depends on —
//     `seed/03-role.ts`'s `policyMap`, and `PROTECTED_SYSTEM_POLICY_NAMES` /
//     `Policy.isProtected`, the anti-lockout guard that keeps super admins in.
// `packages/database/src/extensions/__tests__/tenant-scope.test.ts` pins this:
// `Policy` and `RolePolicy` must stay OUT of `TENANT_SCOPED_MODELS`.
model Policy {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // core fields
  name        String
  description String?

  // CASL rules stored as JSON array
  // Each rule follows CASL format:
  // {
  //   "action": "read" | "create" | "update" | "delete" | "manage" | "list" | "archive" | "export",
  //   "subject": "User" | "Consultation" | "Media" | "all" | etc.,
  //   "conditions": { "tenantId": "${context.tenantId}", "createdBy": "${user.id}" },
  //   "fields": ["id", "name", "email"], // Optional: restrict to specific fields
  //   "inverted": false, // Optional: true = "cannot" rule
  //   "reason": "You can only access your own data" // Optional: shown on denial
  // }
  //
  // Template variables:
  // - ${user.id} - Current user's ID
  // - ${user.tenantId} - Current user's tenant ID
  // - ${context.tenantId} - Request tenant context
  // - ${params.xxx} - Route parameters
  rules Json @db.JsonB

  // Policy scope
  scope PolicyScope @default(TENANT)

  // Anti-lockout protected marker (rename-proof identification of the
  // system-critical policies; seeded true for `system-full-access` and
  // `rbac-system-manage` only). NOT writable through the API — only the seed
  // (or a DBA) sets it. Mirrors the `Role.isSystemRole` flag convention.
  isProtected Boolean @default(false)

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  RolePolicies RolePolicy[] @relation("_Policy_RolePolicies")

  // indexing
  @@unique([name], name: "Policy_name_unique")
  @@index([scope], name: "Policy_scope_idx")
  @@schema("core")
}

model RolePolicy {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // core fields
  // Priority determines order of rule evaluation (lower = higher priority)
  // Useful when policies have conflicting rules
  priority Int @default(0)

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  roleId   String
  Role     Role   @relation("_Role_RolePolicies", fields: [roleId], references: [id], onDelete: Cascade)
  policyId String
  Policy   Policy @relation("_Policy_RolePolicies", fields: [policyId], references: [id], onDelete: Cascade)

  // indexing
  @@unique([roleId, policyId], name: "RolePolicy_roleId_policyId_unique")
  @@index([roleId], name: "RolePolicy_roleId_idx")
  @@index([policyId], name: "RolePolicy_policyId_idx")
  @@schema("core")
}
