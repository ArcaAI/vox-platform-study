model Media {
    // meta fields
    metaData Json?  @map("_metadata") @db.JsonB
    version  Int    @default(1) @map("_version")
    id       String @id @default(uuid(7))

    // multi tenant fields
    tenantId String? @default("50000000-0000-0000-0000-000000000000")

    // core fields
    name      String
    uri       String
    extension String
    mimeType  String
    size      Int
    hash      String

    // Tenant bucket reference (which bucket this file belongs to)
    bucketId String?
    Bucket   TenantBucket? @relation(fields: [bucketId], references: [id])

    // audit fields
    createdBy String?  @default("60000000-0000-0000-0000-000000000000")
    updatedBy String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // resource status fields
    resourceStatus          ResourceStatusType @default(ENABLED)
    resourceStatusUpdatedAt DateTime?
    resourceStatusUpdatedBy String?

    // tags
    tags String[] @default([])

    // relations
    UserMedias UserMedia[] @relation("_Media_UserMedia")

    // indexing
    @@index([tenantId], name: "Media_tenantId_index")
    @@index([bucketId], name: "Media_bucketId_index")
    @@schema("core")
}
