// ============================================================================
// Password Reset Token (TASK-400)
// ============================================================================
// Revocable, DB-backed, single-use password-reset tokens (replaces the
// TASK-388 stateless JWT). Only a SHA-256 hash of the token is stored —
// never the plaintext. Lifecycle is column-driven and UPDATE-only:
//   - expiresAt   TTL bound (issued now + 60 min)
//   - usedAt      stamped on successful completion (single-use)
//   - revokedAt   stamped when a newer token is issued for the same user,
//                 or when the password changes through another path.
// Rows are never deleted by the application (audit trail).
// Not tenant-scoped: tokens hang off the platform-level User (tenancy is
// carried by UserRoleAssignment), mirroring the User model itself.
// ============================================================================

model PasswordResetToken {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // core fields
  tokenHash String    @unique // SHA-256 hex of the raw token (never plaintext)
  purpose   String    @default("password_reset")
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  // audit provenance
  requestedByUserId String? // admin who initiated (null for self-service)
  requestedVia      String? // 'admin' | 'self-service'
  requestIp         String?

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  userId String
  User   User   @relation("_User_PasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  // indexing
  @@index([userId], name: "PasswordResetToken_userId_idx")
  @@index([expiresAt], name: "PasswordResetToken_expiresAt_idx")
  @@schema("core")
}
