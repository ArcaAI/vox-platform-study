// ==========================================================================
// USER VOICE PROFILE MODEL
// ==========================================================================

model UserVoiceProfile {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // core fields
  userId String
  // Data Encryption Initiative Phase 3D — DECISION: the speaker `embedding`
  // (pgvector vector(256)) is deliberately NOT field-encrypted. It is a
  // biometric used for cosine-similarity diarization (the ANN/`<->` distance
  // operators require the raw vector); Vault-Transit randomized encryption
  // would make the column opaque and break similarity search entirely. It
  // stays protected by Phase 1 at-rest disk encryption + RBAC (tenant/user
  // scoping). Revisit only if a searchable-encryption / secure-enclave scheme
  // is adopted. (See plan Phase 3D + TASK-369 README "voiceprint".)
  embedding Unsupported("vector(256)")
  isActive  Boolean                    @default(false)
  label     String?                    @db.VarChar(100)
  modelId   String?

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  User User @relation("_User_VoiceProfiles", fields: [userId], references: [id], onDelete: Cascade)

  // indexing
  @@index([userId, isActive], name: "UserVoiceProfile_userId_isActive_idx")
  @@index([resourceStatus], name: "UserVoiceProfile_status_idx")
  @@schema("core")
}

// ============================================================================
// User ↔ Department assignment (TASK-328 A1–A3)
// Tenant-scoped join table linking users to the departments they belong to.
// ============================================================================

model UserDepartment {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // core fields
  isPrimary Boolean @default(false)

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  userId       String
  User         User       @relation("_User_UserDepartments", fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  Department   Department @relation(fields: [departmentId], references: [id])

  // indexing
  @@unique([tenantId, userId, departmentId], name: "UserDepartment_tenant_user_department_unique")
  @@index([tenantId], name: "UserDepartment_tenantId_idx")
  @@index([userId], name: "UserDepartment_userId_idx")
  @@index([departmentId], name: "UserDepartment_departmentId_idx")
  @@index([tenantId, userId], name: "UserDepartment_tenant_user_idx")
  @@schema("core")
}
