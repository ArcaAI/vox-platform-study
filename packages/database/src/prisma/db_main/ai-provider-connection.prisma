// ============================================================================
// AI Provider Connections (config-plane core — UNIFIED provider-connection plane)
//
// WHERE a serving provider lives and HOW to authenticate. One row per
// (tenant, SERVICE, provider); the reserved SYSTEM tenant row is the platform
// default. This is the ONE credential/connection store for all three AI
// capabilities — LLM (TEXT), STT and TTS — unifying the former
// TenantTtsProviderCredential / TenantSttProviderCredential tables.
//
// `service` is the capability discriminator — a validated string (no Prisma
// enum, per the AiModel.provider convention), whose vocabulary is owned by
// PROVIDER_SERVICES in the application service. It resolves the provider-NAME
// collision across capabilities: `azure` means Azure OpenAI under
// `service='llm'` but Azure Speech under `service='stt'`, and `(llm,azure)` /
// `(stt,azure)` are distinct rows.
//
// TASK-799 P1-C.1 — the vocabulary is `llm | stt | tts` (INFERENCE) plus
// `embeddings | rerank | vector` (non-inference INTEGRATIONS). It was widened
// because the three-value set made this the home for vendor LLM/STT/TTS
// credentials ONLY, so a tenant secret that was not one of ~11 vendor slots —
// a Qdrant API key, a TEI reranker or embeddings endpoint — had nowhere to
// live and had to stay an environment variable. Widening rather than adding a
// sibling store is decision D-2 ("never invent a third home"): a sibling would
// have to re-implement all seven hops of the BYO credential contract, whereas
// this reuses the cascade, the veto, the entitlement gate, derived funding,
// Vault-Transit at rest, the OCC route and the masked read DTO unchanged.
//
// NOTE: `service` is a plain TEXT column with NO database CHECK constraint (see
// the init migration), so widening the vocabulary required NO DDL and NO
// migration. The `@default("llm")` is unchanged.
//
// `provider` is a capability-scoped provider id (see CLOUD_BYO_PROVIDERS in the
// application service). Tenant rows are allowed ONLY for the cloud API providers
// listed for their service (service-layer 403 otherwise, mirroring
// SUPER_ADMIN_ONLY_TASK_PREFIXES); self-host engines are SYSTEM-only.
// `encryptedApiKey` is Vault-Transit ciphertext via secret-field.util —
// NEVER returned by any read DTO (hasKey boolean only).
// Resolution: tenant row (enabled) → SYSTEM row → fail closed, filtered by
// `service`. removed the former per-service ENV-key fallback for the
// STT/TTS/TEXT cloud credentials: the SYSTEM row IS the platform default, and a
// request with no enabled tenant/SYSTEM row now fails closed (typically 503)
// rather than substituting an env secret. (Bedrock/Vertex remain ambient-cloud-
// credential providers; they carry no static API key here.)
//
// Data class 2 (per-tenant secret as Vault-Transit ciphertext in a DB column).
// This model IS a SYSTEM-shared read model — the SYSTEM row is the catalog entry
// every tenant's resolver must read. The widening is [caller, SYSTEM] only and
// never exposes another tenant's BYO row.
// ============================================================================

model AiProviderConnection {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields (SYSTEM row = platform default; tenant row = BYO cloud)
  tenantId String

  // core fields
  service         String  @default("llm") // capability discriminator (PROVIDER_SERVICES: llm|stt|tts|embeddings|rerank|vector|model-registry); backfills existing rows to 'llm'. Plain TEXT with no CHECK constraint on purpose — widening the vocabulary costs NO DDL; the governance list in @arcaai/applications constants.ts is the source of truth.
  provider        String // capability-scoped provider id (e.g. llm:azure/bedrock, stt:azure-speech/sarvam/openai, tts:azure/sarvam, vector:qdrant, rerank:tei)
  baseUrl         String? // endpoint (ollama/lm-studio/vllm/llama-cpp/azure LLM; STT/TTS endpoint migrated from `endpoint`; the Qdrant/TEI URL for the integration services)
  region          String? // bedrock; classic Azure Speech
  apiVersion      String? // azure
  deploymentName  String? // azure
  encryptedApiKey Bytes? // Vault-Transit ciphertext (secret-field.util); plaintext never stored
  keyVersion      Int?
  enabled         Boolean @default(false)
  extraJson       Json?   @db.JsonB // provider-specific extras (validated per-provider in the DTO)

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // indexing — one connection per (tenant, service, provider)
  @@unique([tenantId, service, provider], name: "AiProviderConnection_tenant_service_provider_unique")
  @@index([tenantId, service], name: "AiProviderConnection_tenantId_service_idx")
  @@index([service, provider], name: "AiProviderConnection_service_provider_idx")
  @@index([provider], name: "AiProviderConnection_provider_idx")
  @@schema("core")
}
