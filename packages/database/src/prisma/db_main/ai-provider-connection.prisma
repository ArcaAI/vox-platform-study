// ============================================================================
// AI Provider Connections (config-plane core — UNIFIED provider-connection plane)
//
// WHERE a serving provider lives and HOW to authenticate. TASK-958: one
// DEFAULT row per (tenant, SERVICE, provider) plus any number of NAMED sibling
// rows on the tenant tier — a tenant admin that holds two OpenAI accounts
// keeps two connections, each with its own endpoint, key and ceilings. The
// SYSTEM tier stays ONE row per (service, provider): the platform default is a
// per-provider concept and the reserved SYSTEM tenant row is that default.
// Identity is `(tenantId, service, slug)`; `defaultForProvider` (= `provider`
// on the default row, NULL on every sibling) makes "exactly one default per
// provider" a database fact rather than a service-layer convention.
// This is the ONE credential/connection store for all three AI
// capabilities — LLM (TEXT), STT and TTS — unifying the former
// TenantTtsProviderCredential / TenantSttProviderCredential tables.
//
// `service` is the capability discriminator — a validated string (no Prisma
// enum, per the AiModel.provider convention), whose vocabulary is owned by
// PROVIDER_SERVICES in the application service. It resolves the provider-NAME
// collision across capabilities: `azure` means Azure OpenAI under
// `service='llm'` but Azure Speech under `service='stt'`, and `(llm,azure)` /
// `(stt,azure)` are distinct rows.
//
// C.1 — the vocabulary is `llm | stt | tts` (INFERENCE) plus
// `embeddings | rerank | vector` (non-inference INTEGRATIONS). It was widened
// because the three-value set made this the home for vendor LLM/STT/TTS
// credentials ONLY, so a tenant secret that was not one of ~11 vendor slots —
// a Qdrant API key, a TEI reranker or embeddings endpoint — had nowhere to
// live and had to stay an environment variable. Widening rather than adding a
// sibling store is decision D-2 ("never invent a third home"): a sibling would
// have to re-implement all seven hops of the BYO credential contract, whereas
// this reuses the cascade, the veto, the entitlement gate, derived funding,
// Vault-Transit at rest, the OCC route and the masked read DTO unchanged.
//
// NOTE: `service` is a plain TEXT column with NO database CHECK constraint (see
// the init migration), so widening the vocabulary required NO DDL and NO
// migration. The `@default("llm")` is unchanged.
//
// `provider` is a capability-scoped provider id (see CLOUD_BYO_PROVIDERS in the
// application service). Tenant rows are allowed ONLY for the cloud API providers
// listed for their service (service-layer 403 otherwise, mirroring
// SUPER_ADMIN_ONLY_TASK_PREFIXES); self-host engines are SYSTEM-only.
// `encryptedApiKey` is Vault-Transit ciphertext via secret-field.util —
// NEVER returned by any read DTO (hasKey boolean only).
// Resolution: the tenant's DEFAULT row (enabled) → SYSTEM row → fail closed,
// filtered by `service`. A NON-default sibling is reached only by a model row
// that names it (`AiModel.sourceConnectionId`); it never participates in the
// provider-NAME cascade and therefore never vetoes a provider. removed the former per-service ENV-key fallback for the
// STT/TTS/TEXT cloud credentials: the SYSTEM row IS the platform default, and a
// request with no enabled tenant/SYSTEM row now fails closed (typically 503)
// rather than substituting an env secret. (Bedrock/Vertex remain ambient-cloud-
// credential providers; they carry no static API key here.)
//
// Data class 2 (per-tenant secret as Vault-Transit ciphertext in a DB column).
// This model IS a SYSTEM-shared read model — the SYSTEM row is the catalog entry
// every tenant's resolver must read. The widening is [caller, SYSTEM] only and
// never exposes another tenant's BYO row.
// ============================================================================

model AiProviderConnection {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields (SYSTEM row = platform default; tenant row = BYO cloud)
  tenantId String

  // core fields
  service            String  @default("llm") // capability discriminator (PROVIDER_SERVICES: llm|stt|tts|embeddings|rerank|vector|model-registry); backfills existing rows to 'llm'. Plain TEXT with no CHECK constraint on purpose — widening the vocabulary costs NO DDL; the governance list in @arcaai/applications constants.ts is the source of truth.
  provider           String // capability-scoped provider id (e.g. llm:azure/bedrock, stt:azure-speech/sarvam/openai, tts:azure/sarvam, vector:qdrant, rerank:tei)
  // TASK-958 — connection IDENTITY within (tenant, service). Tenant-chosen,
  // `^[a-z0-9][a-z0-9-]{1,62}$`, IMMUTABLE after create (it is embedded in BYO
  // model slugs and in the `connection_key` on the Python wire, so a rename
  // would re-key live bindings; the free-text `name` is what gets renamed).
  // Backfilled to `provider` for every pre-TASK-958 row, which is what keeps
  // every existing route, model slug and catalogue id byte-for-byte unchanged.
  slug               String
  // Display label a tenant admin recognises ("Research account"). NULL = fall
  // back to the slug (or the provider label when slug == provider).
  name               String?
  // = `provider` on the tenant's DEFAULT row for that provider; NULL on every
  // sibling. NULLs are distinct in Postgres, so the unique below expresses
  // "at most one default per (tenant, service, provider)" without a partial
  // index (which Prisma cannot declare).
  defaultForProvider String?
  baseUrl            String? // endpoint (ollama/lm-studio/vllm/llama-cpp/azure LLM; STT/TTS endpoint migrated from `endpoint`; the Qdrant/TEI URL for the integration services)
  region             String? // bedrock; classic Azure Speech
  apiVersion         String? // azure
  deploymentName     String? // azure
  encryptedApiKey    Bytes? // Vault-Transit ciphertext (secret-field.util); plaintext never stored
  keyVersion         Int?
  enabled            Boolean @default(false)
  extraJson          Json?   @db.JsonB // provider-specific extras (validated per-provider in the DTO)

  // Connection-level CEILINGS (TASK-862 — moved here from the retired
  // `AiRuntimeProfile`). They bound what this connection may be driven at, per
  // tier: a tenant's BYO row carries the tenant's own vendor limits, the SYSTEM
  // row the platform account's. Generation hyper-parameters (temperature,
  // topP, maxTokens, …) do NOT live here — they belong to the Agent (TASK-863).
  // Every field is nullable = "no opinion" (the consuming service's own default
  // applies); a value is a hard cap the router/adapter must not exceed.
  maxConcurrent Int? // simultaneous in-flight requests on this connection
  rpmLimit      Int? // requests per minute
  tpmLimit      Int? // tokens per minute (LLM/embeddings); characters for TTS
  timeoutS      Int? // per-request timeout, seconds

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  //
  // the back-relation of `AiRoutingPolicy.providerConnectionId`, the
  // real FK that replaces F-6's `(service, provider)` string join. `Restrict`
  // is declared on the owning side: a connection a live provider configuration
  // binds cannot be hard-deleted. Adding a back-relation is a Prisma
  // requirement, not a new access path — nothing reads this field.
  routingPolicies AiRoutingPolicy[] @relation("AiRoutingPolicyConnection")
  // TASK-890 §3.1 — the tenant-owned `AiModel` rows this connection DECLARED
  // (BYO provider + model in one act). A real FK, unlike the by-slug catalogue
  // convention, for the reason `AiRoutingPolicy.modelId` is one: without it a
  // connection could be deleted out from under the models that only it can
  // serve. `onDelete: Restrict` sits on the owning side.
  models          AiModel[]         @relation("AiModelSourceConnection")

  // indexing — identity is (tenant, service, slug); at most one DEFAULT row per
  // (tenant, service, provider). NOTE: `map:` is what names the DATABASE index;
  // the client-facing compound key falls out of the field list.
  @@unique([tenantId, service, slug], map: "AiProviderConnection_tenant_service_slug_key")
  @@unique([tenantId, service, defaultForProvider], map: "AiProviderConnection_tenant_service_default_key")
  @@index([tenantId, service], name: "AiProviderConnection_tenantId_service_idx")
  @@index([service, provider], name: "AiProviderConnection_service_provider_idx")
  @@index([provider], name: "AiProviderConnection_provider_idx")
  @@schema("core")
}
