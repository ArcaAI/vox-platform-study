// ============================================================================
// Service Version & Release Registry
//
// Answers, from the admin console, "what version of each service is running,
// from which commit, since when" — captured at build time (baked
// `build-info.json`, W3/W4) and persisted here on self-registration (W7/W9).
//
// Two lifetimes, two tables:
//   - ServiceRelease   — immutable BUILD FACTS. One row per (service, build).
//                        Written once, never updated. The release history.
//   - ServiceInstance  — RUNTIME OBSERVATION. One row per running process,
//                        heartbeated (`lastSeenAt`) every 5 minutes.
//
// Both are platform-wide: `tenantId` is always the reserved SYSTEM tenant
// `00000000-0000-0000-0000-000000000000` (`NULL = global` is banned house-wide).
//
// `ServiceRelease.releaseVersion` — deliberately NOT named `version`: the
// standard template's OCC counter field is already called `version`
// (`@map("_version")`) on every model, and Prisma forbids two fields of the
// same name. `releaseVersion` carries the git-tag-derived SemVer (or the
// `0.0.0-<branch>.<sha8>` untagged shape).
//
// Neither `ServiceRelease` nor `ServiceInstance` is human-edited — both are
// non-OCC (machine-written by the internal self-registration endpoint), so
// neither needs the `FIELDS_NOT_WRITABLE = ['version']` mapper guard (that is
// reserved for `ChangelogEntry` below, the one human-edited model here).
// Neither carries a `resourceStatus` column — rows are pruned wholesale by the
// existing scheduler surface (30-day retention, of the README), not
// individually soft-deleted, so both are listed in `MODELS_WITHOUT_SOFT_DELETE`.
// ============================================================================

model ServiceRelease {
  // meta fields
  metaData Json? @map("_metadata") @db.JsonB
  version  Int   @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields — always the SYSTEM tenant (platform-wide)
  tenantId String

  // core (business) fields — immutable build facts
  serviceName     String // api | text | stt-worker | ...
  releaseVersion  String // SemVer from the git tag, or 0.0.0-<branch>.<sha8>
  releaseTag      String? // TEXT-2.1.0; null on untagged builds
  gitBranch       String
  gitCommitSha    String // full 40-char
  buildAt         DateTime
  imageRepository String?
  imageDigest     String? // filled by the CI publish step after push
  ciPipelineId    String?
  ciPipelineUrl   String?
  changelog       Json? @db.JsonB // generated technical changelog, immutable
  firstSeenAt     DateTime @default(now())

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  instances ServiceInstance[]

  @@unique([serviceName, gitCommitSha, releaseTag], name: "ServiceRelease_service_commit_tag_unique")
  @@index([tenantId], name: "ServiceRelease_tenantId_idx")
  @@index([serviceName, buildAt], name: "ServiceRelease_serviceName_buildAt_idx")
  @@schema("core")
}

model ServiceInstance {
  // meta fields
  metaData Json? @map("_metadata") @db.JsonB
  version  Int   @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields — always the SYSTEM tenant (platform-wide)
  tenantId String

  // core (business) fields — runtime observation, heartbeated
  releaseId   String
  ServiceRelease ServiceRelease @relation(fields: [releaseId], references: [id])
  serviceName String // denormalised for cheap grouping
  environment String // dev | staging | prod
  instanceId  String // pod name, or hostname:pid outside k8s
  startedAt   DateTime
  lastSeenAt  DateTime @default(now())

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceName, environment, instanceId], name: "ServiceInstance_service_env_instance_unique")
  @@index([tenantId], name: "ServiceInstance_tenantId_idx")
  @@index([lastSeenAt], name: "ServiceInstance_lastSeenAt_idx")
  @@schema("core")
}

// ============================================================================
// Changelog — two audiences, two artifacts.
//
// `ChangelogEntry` is the CURATED release-notes artifact ("What's New"), one
// row per platform (`ALL-`) train version. CI creates a DRAFT pre-filled from
// Conventional Commits; a super admin edits it into human language and
// publishes. This is the ONE model on this page that is genuinely human-edited,
// so it carries real OCC: the mapper strips `version` from every write
// (`FIELDS_NOT_WRITABLE`) and the PATCH route (W13, out of this unit's scope)
// takes `@RequiresIfMatch()` + `@ExpectedVersion()`.
// ============================================================================

model ChangelogEntry {
  // meta fields
  metaData Json? @map("_metadata") @db.JsonB
  version  Int   @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields — always the SYSTEM tenant (platform-wide)
  tenantId String

  // core (business) fields
  platformVersion String // 2.1.0 (the ALL- train)
  title           String
  summary         String
  body            String // markdown, rendered sanitised
  severity        ChangelogSeverity  @default(INFO)
  audience        ChangelogAudience  @default(ALL)
  publishStatus   ChangelogPublishStatus @default(DRAFT)
  publishedAt     DateTime?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  acknowledgements UserChangelogAcknowledgement[]

  @@unique([platformVersion], name: "ChangelogEntry_platformVersion_unique")
  @@index([tenantId], name: "ChangelogEntry_tenantId_idx")
  @@index([publishStatus, publishedAt], name: "ChangelogEntry_publishStatus_publishedAt_idx")
  @@schema("core")
}

// One row per (user, changelog entry) acknowledgement of the one-time
// "What's New" popup. Server-side and per-user so support can answer
// "was this admin actually shown the breaking-change notice" — deliberately
// NOT localStorage and NOT a single `lastSeenChangelogVersion` column (see
// for the rejected alternatives). Scoped to the
// ACKNOWLEDGING USER'S tenant (the one exception among these four models —
// everything else here is platform-wide SYSTEM-tenant data).
model UserChangelogAcknowledgement {
  // meta fields
  metaData Json? @map("_metadata") @db.JsonB
  version  Int   @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields — the acknowledging user's own tenant
  tenantId String

  // core (business) fields
  userId           String
  changelogEntryId String
  ChangelogEntry   ChangelogEntry @relation(fields: [changelogEntryId], references: [id])
  acknowledgedAt   DateTime @default(now())
  autoAcknowledged Boolean  @default(false) // true when back-filled for a new user (rule 6)

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, changelogEntryId], name: "UserChangelogAck_user_entry_unique")
  @@index([tenantId], name: "UserChangelogAck_tenantId_idx")
  @@index([userId], name: "UserChangelogAck_userId_idx")
  @@schema("core")
}
