// the workflow safety validator. A rule with severity WARNING is
// recorded on `WorkflowValidationReport` but never blocks publish; ERROR
// blocks it. Graduated rollout: a rule may ship as WARNING and be promoted to
// ERROR later by a row edit (bumping `ruleVersion`), never the reverse for a
// SYSTEM-owned row (see the one-way-strictness rule in
// workflow-invariant-rule.prisma).
enum WorkflowRuleSeverity {
  ERROR
  WARNING

  @@schema("core")
}

// the CLOSED catalogue of predicate *kinds* a `WorkflowInvariantRule`
// row may parameterize (the kind is code, the instance is data). Mirrors
// `WORKFLOW_RULE_PREDICATE_TYPES` in `packages/workflow-contract/src/predicates/index.ts`
// verbatim — adding a member here means adding the matching evaluator there
// first; the two must never drift; see `contracts/rule-model.md`
enum WorkflowRulePredicateType {
  ACYCLIC
  SINGLE_ENTRY
  REACHABLE_FROM_ENTRY
  REACHES_TERMINAL
  REQUIRED_NODE_TYPE
  FORBIDDEN_NODE_TYPE
  REQUIRED_PATH_THROUGH
  FORBIDDEN_PATH
  ORDERED_BEFORE
  BOUND
  CONFIG_PREDICATE

  @@schema("core")
}

// how a `RateLimitRule.routeMatch` pattern is compared against the
// live route key (`METHOD:/route/pattern`).
//
// EXACT — the whole route key must match, e.g. `POST:/api/v1/auth/login`.
// PREFIX — a `METHOD:` (or `*:`) part plus a path that may end in `/*`,
//          e.g. `*:/api/v1/admin/*`. The reserved pattern `*` matches every
//          route and is how a tenant expresses "all of my traffic".
//
// Within one scope, EXACT always beats PREFIX and a longer PREFIX beats a
// shorter one — the "most specific match wins" convention every API gateway
// uses. Across scopes, precedence is by scope, not by pattern (see
// `rate-limit-resolver.ts`).
enum RateLimitMatchKind {
  EXACT
  PREFIX

  @@schema("core")
}

// Governance lifecycle of a `DocumentTemplate`. Deliberately the
// same three members as `ConsultationContextSchemaStatus` above, because it is
// the same governance triple (head → immutable version → movable pin): DRAFT is
// editable and never served, PUBLISHED is served to generation nodes, APPROVED
// additionally records a clinical sign-off. A template with no pin is never
// served whatever its status.
enum DocumentTemplateStatus {
  DRAFT
  PUBLISHED
  APPROVED

  @@schema("core")
}

// the per-section state machine of a live-generated clinical
// document. The states are ordered by how much clinical authority the content
// carries, and the ONLY transition a machine may perform on its own is
// EMPTY -> PROVISIONAL -> PROVISIONAL.
//
//   EMPTY nothing extracted yet. Renders as a skeleton, NOT an error — an
//               unpopulated section of an in-progress note is a normal state.
//   PROVISIONAL model-written. A later flush may freely replace it.
//   CONFIRMED a clinician has touched it. A flush may APPEND to it but must
//               never overwrite it; that rule is what makes the running note
//               safe to edit while it is still being generated.
//   LOCKED finalized at the endpoint. Every write is rejected.
//
// NOT the same thing as the COMPILED section-state machine
// (`CompiledSectionStateMachine.states` = PENDING | NOT_DISCUSSED | DRAFTED |
// CONFIRMED, in `document-template-compiler.ts`). That one is the TEMPLATE's
// declaration of how a section may legitimately be filled in — it is authored
// data. This one is the PERSISTED runtime state of an actual section row, and
// it is what per-section OCC protects. The two share the member `CONFIRMED`
// and nothing else; TypeScript refuses any accidental cross-assignment because
// no other member overlaps.
enum DocumentSectionState {
  EMPTY
  PROVISIONAL
  CONFIRMED
  LOCKED

  @@schema("core")
}

// governance lifecycle of an `AiRoutingPolicy` row. The same
// three-member governance triple as `DocumentTemplateStatus` above, and for the
// same reason: a routing policy is AUTHORED, then made live, then superseded.
//
//   DRAFT editable, never resolved at runtime. This is what the dry-run
//             (`/simulate`) endpoint replays recorded traffic against.
//   ACTIVE the row the runtime resolver serves for its (tenant, taskKey).
//   ARCHIVED a superseded revision, kept addressable for one-click rollback
// and for the HIPAA before/after audit trail
//
// Supersede-only: an ACTIVE row is not edited in place, it is replaced by a
// higher `policyVersion` and demoted to ARCHIVED. That is why `policyVersion`
// is a column of its own and is NOT the `_version` OCC counter.
enum AiRoutingPolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("core")
}

// how the router picks among the candidates of one rank tier.
// The vocabulary is the common denominator of the gateways surveyed in
// (LiteLLM Router, Portkey, Envoy AI Gateway, Kong AI Proxy Advanced,
// OpenRouter, Cloudflare AI Gateway).
//
//   PRIORITY strict candidate order; `rank` decides, weights ignored.
//   WEIGHTED weighted split WITHIN a rank tier.
//   LEAST_BUSY fewest in-flight requests.
//   LOWEST_LATENCY best observed TTFT.
//   LOWEST_COST cheapest per the `AiPriceBook` row effective now.
//
// Deliberately NOT a member: any learned / prompt-difficulty strategy.
// rules quality-aware routing out for day one — the space has no reproducible
// evaluation yet, so a member here would be a promise the resolver cannot keep.
enum AiRoutingStrategy {
  PRIORITY
  WEIGHTED
  LEAST_BUSY
  LOWEST_LATENCY
  LOWEST_COST

  @@schema("core")
}

// what happens when a request NAMES a provider and that
// provider is down. The platform default is STRICT, which deliberately inverts
// the industry default (OpenRouter and Cloudflare default `allow_fallbacks` to
// true; LiteLLM fires configured fallbacks by default).
//
//   STRICT 503 `provider_unavailable`. No silent substitution.
//   STRICT_UNLESS_OPTED_IN hard-fail unless the request itself carried
//                           `allow_fallbacks: true`.
//   POLICY_MAY_OVERRIDE the policy chain may re-route without the caller
//                           asking.
//
// The justification is clinical, not stylistic: BAA coverage is per-vendor AND
// per-model, so one fallback hop can move PHI outside BAA coverage; RFC 9111
// obsoleted the `Warning` header, so there is no standard way to tell a caller
// a substitution happened; and under BYOK a hop onto a SYSTEM credential
// silently flips the metering class. Whatever this mode says, the three hard
// gates (same residency class, BAA-covered target, same funding tier) are
// enforced in CODE, not in policy text — a hop crossing any of them is a
// rejection, not a fallback.
enum AiExplicitProviderMode {
  STRICT
  STRICT_UNLESS_OPTED_IN
  POLICY_MAY_OVERRIDE

  @@schema("core")
}

// the CANONICAL AI TASK TAXONOMY.
//
// WHICH PLATFORM TASK a provider binding serves. This is the axis the product
// means by "one configuration per task": text generation, translation,
// speech-to-text and text-to-speech are four first-class tasks, and before this
// enum only the first had any taxonomy at all. Translation had no mechanism
// whatsoever; STT routed through `AsrPipeline` + `TenantSttConfig` and TTS
// through `TenantTtsConfig` — three unrelated mechanisms no single query could
// reach.
//
// ── Why this is NOT `ModelTaskType`, and not `AiCapability` ────────────────
// Three enums now touch the word "task". They are orthogonal, and conflating
// any two of them loses information the platform already relies on:
//
//   ModelTaskType WHAT SHAPE OF ARTIFACT a model is — the HuggingFace
//                  pipeline-tag vocabulary, a property of `AiModel`. 47 members
//                  including TEXT_TO_3D and TABULAR_REGRESSION, and
//                  parity-gated member-for-member against a Python mirror
//                  (`apps/stt/tests/unit/test_db_enum_mirrors.py`).
//   AiCapability WHAT A LEDGER ROW IS BILLED UNDER — five COGS buckets
//                  (STT/LLM/NLP/TTS/EMBEDDING). Deliberately coarse: its own
//                  comment records that guardrail and harness LLM calls meter
//                  under `LLM` because they are the same cost unit. Too coarse
//                  to select with — "the translation model" is not expressible.
//   AiTaskKind WHICH TASK A BINDING IS FOR — this enum.
//
// The proof they are different axes is already in the tree:
// `AI_TASK_MODEL_TASK_TYPES` (ai-routing-policy/constants.ts) is a MANY-TO-ONE
// map from task key to `ModelTaskType`. You do not write a map between a thing
// and itself. Concretely `ModelTaskType.TOKEN_CLASSIFICATION` serves BOTH
// `nlp.ner` and `guardrail.pii`, and `ModelTaskType.TEXT_CLASSIFICATION` serves
// four more keys — so keying provider selection on model SHAPE would merge
// selections that are today different models under different governance.
//
// ── Granularity ───────────────────────────────────────────────────────────
// COARSER than `taskKey`, deliberately: `taskKey` stays the fine-grained
// selector (`text.live` and `text.finalize` are ONE kind, TWO selections) and
// this enum is the product-visible grouping over it. The mapping is
// `AI_TASK_KIND_BY_TASK_KEY` in
// `packages/applications/src/services/ai-routing-policy/constants.ts`, whose
// exhaustive `Record<AiTaskKey, AiTaskKind>` makes it impossible to add a task
// key without deciding its kind.
//
// CONSEQUENCE FOR, stated here because the column is what invites the
// mistake: a "one default per task" constraint must be keyed on the SELECTION
// (`taskKey`), NOT on this KIND. A partial unique index on
// `(tenantId, taskKind) WHERE isDefault` would collapse `text.live` with
// `text.finalize`, and `nlp.ner` with `guardrail.pii`.
//
// ── Extensibility ─────────────────────────────────────────────────────────
// Postgres enums extend with `ALTER TYPE … ADD VALUE`. Two capabilities that
// exist in the platform are deliberately ABSENT because nothing SELECTS them
// yet, and a member here would promise a binding surface that does not exist:
// RERANK (the TEI reranker on :8870, `ProviderService = 'rerank'`) and the
// `vector` / `model-registry` `ProviderService` values, which are
// infrastructure connections rather than AI tasks. Add them when a selection
// surface does.
enum AiTaskKind {
  // The four product tasks.
  TEXT_GENERATION // text.live | text.finalize | *.fallback | text.test | harness.judge
  // TRANSLATION has no rows yet. Served ONLY by a provider with a NATIVE
  // endpoint — Sarvam, which has one with explicit `ml-IN`. Azure is
  // deliberately not offered: Azure OpenAI has no text-translation endpoint at
  // all (`/audio/translations` is Whisper audio→English), so serving it would
  // require Azure AI Translator — a separate resource, key and billing. Owner
  // decision OD-8, 2026-09-01.
  TRANSLATION
  SPEECH_TO_TEXT // AsrPipeline + TenantSttConfig
  TEXT_TO_SPEECH // TenantTtsConfig

  // Capabilities that ALREADY exist, named so this taxonomy does not silently
  // swallow them. Each has live rows or a live selection today.
  VISION_EXTRACTION // vlm.extract — image + text in, text out
  EMBEDDING // AiCapability.EMBEDDING / ProviderService 'embeddings'
  NAMED_ENTITY_RECOGNITION // nlp.ner
  TEXT_CLASSIFICATION // nlp.classification | .diagnosis | .sentiment | .toxicity | .topic | .intent
  CONTENT_SAFETY // guardrail.validate | guardrail.safety
  GROUNDEDNESS // guardrail.groundedness
  PII_DETECTION // guardrail.pii | guardrail.pii.spans

  @@schema("core")
}

// ── AgentTask (TASK-863) ──────────────────────────────────────────────────────
// The ONE task an `Agent` performs. Deliberately three members (owner directive
// 2026-09-04: "Agent is only based on LLM/ASR/TTS models"); classification is
// a workflow node (`core.classify`, TASK-864), not an agent. Distinct from
// `AiTaskKind` (the routing-policy taxonomy) and `ModelTaskType` (the HF
// registry taxonomy): AGENT_TASK_MODEL_TASK_TYPE in @arcaai/workflow-contract
// maps each member to the registry task type a backing model must carry.
enum AgentTask {
  SPEECH_TO_TEXT
  TEXT_GENERATION
  TEXT_TO_SPEECH
  NAMED_ENTITY_RECOGNITION

  @@schema("core")
}
