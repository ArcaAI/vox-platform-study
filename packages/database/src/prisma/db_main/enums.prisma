enum ConsultationStatus {
  OPEN // Active consultation, not yet under review
  RECORDING // Audio capture in progress
  DRAFT_PENDING_SENSORS // Draft delivered early (visible/readable); assurance (inferential) pass running concurrently. Cannot be signed until it lands.
  PENDING_REVIEW // Summary generated + assurance complete + gate verdict recorded; awaiting clinician review/attestation
