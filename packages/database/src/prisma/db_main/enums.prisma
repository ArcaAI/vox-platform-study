// APPROVED is an explicit human decision that the exemplar may be shown to the
// model as a style reference; REJECTED excludes it permanently. Whether the
// retriever actually ENFORCES the gate is a separate, default-off knob
// (`agentic.fewshot.curationMode`), so adding the column changes no behaviour
// until an operator opts in.
enum ExemplarCurationStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("core")
}

