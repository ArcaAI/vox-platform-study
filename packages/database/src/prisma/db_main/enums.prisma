enum ContextItemType {
  AUDIO_RECORDING // Audio recordings from consultation
  WORKNOTE // User-entered work notes
  RAW_SUMMARY // AI-generated final summary
  MODIFIED_SUMMARY // User-modified summary
  PRE_SUMMARY // AI-generated pre-summary (summarizes case notes for final summarization)
  NAMED_ENTITY // Recognized named entities (container)
  TRANSCRIPT // Transcription of audio
  CASE_NOTE // Case notes - shared across linked consultations as additional context
  ATTACHMENT // Other attachments
  SIGNED_NOTE // Clinician-attested, immutable signed note (confirm-before-commit gate)

  @@schema("core")
}

// First-class consultation lifecycle state machine.
// Previously the lifecycle lived in the free-form `Consultation.metadata.status`
// JSON; this enum promotes it to a typed column so the clinical-documentation
// harness can gate transitions (e.g. PENDING_REVIEW → SIGNED on attestation).
enum ConsultationStatus {
  OPEN // Active consultation, not yet under review
  RECORDING // Audio capture in progress
  DRAFT_PENDING_SENSORS // Draft delivered early (visible/readable); assurance (inferential) pass running concurrently. Cannot be signed until it lands.
  PENDING_REVIEW // Summary generated + assurance complete + gate verdict recorded; awaiting clinician review/attestation
  SIGNED // Clinician-attested (immutable signed note committed)
  CLOSED // Consultation closed
  REOPENED // Reopened after being closed

  @@schema("core")
}

enum ContextItemSource {
  USER // User-entered
  AI // AI-generated
  SYSTEM // System-generated
  TRANSCRIPTION // From transcription service

  @@schema("core")
}

// Which persisted surface a manual doctor highlight is
// anchored to. Distinct from ContextItemType so manual marks never pollute the
// AI NER / context-item taxonomy. The live caption transcript is ephemeral
// (client-only) until Stop; durable highlights anchor to persisted items only.
enum HighlightTargetKind {
  TRANSCRIPT // Post-stop persisted transcript ContextItem
  CASE_NOTE // Case note ContextItem
  WORKNOTE // Work note ContextItem
  SUMMARY // AI draft / signed summary ContextItem

  @@schema("core")
}

