// Platform-issued machine identity for administration.
//
// ─── Why a THIRD credential class ────────────────────────────────────────────
//
// The platform has exactly two machine credential paths today, and policy rule
// A2 (`/api/v1/admin/*` is JWT-only) closes or excludes both:
//
// Tenant API key (`X-API-Key`) — removed from `/admin/*` by.
//   - `X-Service-Token` (peer svcs) — structurally confined to `/internal/*`.
//
// The owner ruling ("we cannot mix the `/admin/*` and `/internal/*`
// routes as they were designed for different purposes") forbids both cheap
// fixes — extending the service token to admin routes, and re-admitting tenant
// API keys there. So headless administration needs its own class, with its own
// issuance path, its own scope namespace (`svc:*`), its own guard branch and
// its own CASL principal, sharing NO mechanism with either.
//
// ─── Credential storage: Vault-tier, NEVER a plaintext column ────────────────
//
// Per `09-infrastructure-devops.md` §Configuration Tiers, the client secret is
// a `vault-kv`/`db-secret`-tier value. `credentialsRef` holds the VAULT PATH;
// `SecretsService` resolves it. This follows the `TenantStorageConfig.
// credentialsRef` precedent exactly. NOTHING in this table is secret material:
// `clientId` is a public identifier, and `secretVerifier` is a peppered
// HMAC-SHA256 of the secret (the same one-way verifier shape `ApiKey.keyHash`
// uses), which authenticates a presented secret without being able to reproduce
// it. The retrievable copy — the one an operator needs to provision a consumer
// — lives ONLY in Vault.
//
// ─── Tenant binding (see ServiceAccountService for the cascade) ──────────────
//
// `tenantId` is NOT NULL like every other model. Two shapes, and only two:
//   - tenant-bound: `tenantId` = the customer tenant. Config resolves
//                     tenant-first → SYSTEM exactly as for a human there.
//   - platform: `tenantId` = SYSTEM (`00000000-…`). Must supply an
//                     explicit `X-Tenant-Id` on every tenant-scoped request,
//                     validated against `allowedTenantIds`. With no header,
//                     config resolves SYSTEM ONLY — never a customer tenant,
//                     and never `50000000-…` ("Global"), which is a CUSTOMER
//                     tenant and must never appear in a runtime cascade.
// There is deliberately no ambient-default tenant for a machine principal.

model ServiceAccount {
  // Meta fields (BaseEntity pattern)
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant fields
  tenantId String

  // Identity (all NON-SECRET)
  clientId    String  @unique // public, non-secret client identifier (`hope_svc_<hex>`)
  displayName String
  description String?

  // Authority
  scopes Json  @db.JsonB // string[] — every member MUST be in the `svc:*` namespace
  // Platform accounts (`tenantId` = SYSTEM) may act on the tenants listed here
  // and no others; an `X-Tenant-Id` outside the list is a 403 privilege
  // boundary. NULL/empty on a tenant-bound account, which may only ever act on
  // its own tenant.
  allowedTenantIds Json? @db.JsonB
  allowedIps       Json? @db.JsonB
  // Whether this account's principal carries SUPER_ADMIN. Explicit and
  // persisted rather than inferred: `isSuperAdmin` reads `user.roles`, and a
  // machine principal that omits `roles` silently fails every imperative
  // super-admin check while one that includes it carelessly silently BECOMES a
  // super admin. Neither may happen by accident.
  superAdmin Boolean @default(false)

  // Token exchange
  tokenTtlSeconds Int       @default(900) // 15 min; bounded by a platform ceiling
  lastUsedAt      DateTime?

  // Credential storage — Vault paths only, never secret VALUES.
  credentialsRef String // e.g. `service-accounts/<clientId>/current`
  // Peppered HMAC-SHA256 verifier for the CURRENT secret. One-way; cannot
  // reproduce the secret. Not unique-indexed (two accounts could in principle
  // collide only on a hash collision, which is not a lookup path here — the
  // exchange looks up by `clientId` first, then verifies in constant time).
  secretVerifier String

  // Two-slot rotation with an overlap window, so a consumer rotates without
  // downtime. During the overlap BOTH verifiers exchange successfully; after
  // `previousCredentialExpiresAt` only the current one does.
  previousCredentialsRef      String?
  previousSecretVerifier      String?
  previousCredentialExpiresAt DateTime?
  rotatedAt                   DateTime?

  // Resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // Audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId], name: "ServiceAccount_tenantId_idx")
  @@index([clientId], name: "ServiceAccount_clientId_idx")
  @@index([resourceStatus], name: "ServiceAccount_resourceStatus_idx")
  @@index([lastUsedAt], name: "ServiceAccount_lastUsedAt_idx")
  @@schema("core")
}
