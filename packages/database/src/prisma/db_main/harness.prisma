// =============================================================================
// Clinical Documentation Harness
//
// Eval storage + WORM audit. Two groups of models live here:
//
//   1. Eval tables (GoldenSet / GoldenCase / EvalRun / EvalScore) — standard
//      tenant-scoped models (tenantId + resourceStatus + audit + _version /
//      _metadata). They store golden transcript→note pairs and judge results
//      for offline evaluation of the documentation harness.
//
//   2. HarnessAuditEvent — an APPEND-ONLY, hash-chained WORM audit record.
//      It deliberately has NO _version / resourceStatus / updatedAt columns:
//      rows are immutable. The migration that introduces this table also
//      `REVOKE UPDATE, DELETE` on it from the application role so append-only
//      is enforced at the database-privilege layer, not only in application
//      code (see research/clinical-harness/03-…-guardrails-governance.md).
// =============================================================================

enum HarnessAuditAction {
  GENERATE
  SENSOR_RUN
  GATE_DECISION
  ATTEST
  CONSENT_GIVEN
  CONSENT_WITHDRAWN
  BREACH_REPORTED
  REDUCED_ASSURANCE
  // Optimistic-delivery, relaxed sign-off governance.
  SAFETY_OVERRIDE // Clinician one-click override of a COMPLETED safety FLAG at sign-off (no free-text).
  SIGNED_BEFORE_ASSURANCE // Note signed while assurance still running (DRAFT_PENDING_SENSORS); correlation annotation.
  POST_SIGN_FLAG // Assurance returned a FLAG/REGEN AFTER an early sign (note immutable); amendment/follow-up.
  // Harness gate SLA-breach escalation records (from apps/harness escalate_gate).
  GATE_ESCALATED // reason=gate_sla_breached — an un-signed gate passed its SLA and was escalated (non-terminal).
  GATE_ABANDONED // reason=gate_sla_abandoned — the terminal escalation before the gate abandons.
  // TASK-711: session state machine transition audit rows. SIGNED is already
  // covered by ATTEST — no fourth member for it.
  SESSION_PRIMED // OPEN → PRIMED
  SESSION_TIMED_OUT // PENDING_REVIEW → TIMED_OUT (gate SLA exhausted; the clock never signs)
  SESSION_REOPENED // TIMED_OUT|SIGNED|CLOSED_COMPLETE|CLOSED_INCOMPLETE → REOPENED
  // TASK-711 follow-up: owner decision on CLOSED_COMPLETE/CLOSED_INCOMPLETE
  // (state-machine.md §1a) — the terminal close itself is clinically significant now that it
  // types whether a human gave feedback, so it gets its own WORM row (unlike the original
  // design's plain CLOSED, which reused ResourceUpdated only).
  SESSION_CLOSED_COMPLETE // SIGNED → CLOSED_COMPLETE (human closed with a signed note)
  SESSION_CLOSED_INCOMPLETE // TIMED_OUT|PRIMED|DRAINING|DRAFT_PENDING_SENSORS|REOPENED → CLOSED_INCOMPLETE (sweep or manual close, no signature)

  @@schema("core")
}

// =============================================================================
// EVAL STORAGE
// =============================================================================

model GoldenSet {
  // Meta fields (BaseEntity pattern)
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Business fields
  name          String
  description   String? @db.Text
  // Pinned dataset version label (e.g. "v1") an EvalRun executes against, so
  // a run is reproducible against a frozen snapshot of the golden cases.
  pinnedVersion String?
  // Optional department scoping (OD-5): a golden set may be scoped to a single
  // department's agents. NULL ⇒ tenant-wide. No FK (mirrors the tenantId posture);
  // indexed for the per-department picker on the console eval panel.
  departmentId  String?

  // Resource status + Audit (standard fields)
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations
  GoldenCases GoldenCase[]
  EvalRuns    EvalRun[]

  @@index([tenantId], name: "GoldenSet_tenantId_idx")
  @@index([tenantId, name], name: "GoldenSet_tenant_name_idx")
  @@index([tenantId, departmentId], name: "GoldenSet_tenant_department_idx")
  @@schema("core")
}

model GoldenCase {
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  tenantId String

  // Parent golden set
  goldenSetId String
  GoldenSet   GoldenSet @relation(fields: [goldenSetId], references: [id])

  // The input transcript and the reference (gold) note for this case.
  // The plaintext transcript / referenceNote columns have been DROPPED;
  // persisted as Vault-Transit ciphertext only.
  label         String?

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // golden transcript + reference note plus the shared Transit key version.
  // These ciphertext columns are now the system of record.
  encryptedTranscript    Bytes?
  encryptedReferenceNote Bytes?
  keyVersion             Int?

  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  EvalScores EvalScore[]

  @@index([tenantId], name: "GoldenCase_tenantId_idx")
  @@index([goldenSetId], name: "GoldenCase_goldenSetId_idx")
  @@index([tenantId, goldenSetId], name: "GoldenCase_tenant_set_idx")
  @@schema("core")
}

model EvalRun {
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  tenantId String

  goldenSetId String
  GoldenSet   GoldenSet @relation(fields: [goldenSetId], references: [id])

  // What was evaluated (model + prompt provenance, judge model)
  modelName           String
  modelVersion        String?
  promptTemplateId    String?
  promptVersion       String?
  // The numeric PromptVersion.versionNumber this run gated (null for non-template
  // runs). Complements the free-form `promptVersion` label with the pin-addressable
  // version number the promotion gate keys on.
  promptVersionNumber Int?
  judgeModel          String?

  // How the run was triggered: MANUAL (admin run-now), PROMOTION (approve /
  // agent pin re-point gate), or CI. Free-form String (mirrors `status`) so no
  // enum migration is needed. Null on legacy rows.
  triggerType String?

  // Lifecycle (free-form for Phase 0: QUEUED | RUNNING | COMPLETED | FAILED)
  status      String?
  startedAt   DateTime?
  completedAt DateTime?

  // Aggregate metrics across the run (e.g. mean faithfulness / coverage).
  // The plaintext `notes` column has been DROPPED; persisted as
  // Vault-Transit ciphertext only.
  aggregateScores Json?   @db.JsonB

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // free-text run notes plus the shared Transit key version. This
  // ciphertext column is now the system of record.
  encryptedNotes Bytes?
  keyVersion     Int?

  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  EvalScores EvalScore[]

  @@index([tenantId], name: "EvalRun_tenantId_idx")
  @@index([goldenSetId], name: "EvalRun_goldenSetId_idx")
  @@index([tenantId, goldenSetId], name: "EvalRun_tenant_set_idx")
  @@index([tenantId, createdAt], name: "EvalRun_tenant_createdAt_idx")
  @@schema("core")
}

model EvalScore {
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  tenantId String

  evalRunId String
  EvalRun   EvalRun @relation(fields: [evalRunId], references: [id])

  goldenCaseId String
  GoldenCase   GoldenCase @relation(fields: [goldenCaseId], references: [id])

  // A single metric result for (run, case)
  metric     String // e.g. 'faithfulness' | 'coverage' | 'pdsqi9'
  score      Float
  maxScore   Float?
  judgeModel String?
  // The plaintext rationale / details columns have been DROPPED; persisted
  // as Vault-Transit ciphertext only.

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // judge rationale + details JSONB plus the shared Transit key version.
  // These ciphertext columns are now the system of record.
  encryptedRationale Bytes?
  encryptedDetails   Bytes?
  keyVersion         Int?

  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([tenantId], name: "EvalScore_tenantId_idx")
  @@index([evalRunId], name: "EvalScore_evalRunId_idx")
  @@index([goldenCaseId], name: "EvalScore_goldenCaseId_idx")
  @@index([tenantId, evalRunId], name: "EvalScore_tenant_run_idx")
  @@schema("core")
}

// =============================================================================
// WORM AUDIT (append-only, hash-chained)
// =============================================================================

model HarnessAuditEvent {
  // Identity only — NO _version / _metadata / updatedAt / resourceStatus.
  // Rows are immutable (append-only); the migration REVOKEs UPDATE/DELETE
  // on this table from the application role.
  id String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Subject of the event
  //
  // NULLABLE (TASK-712, consent-abac Phase 4): a consent grant/revoke has no
  // consultation — `ConsentGrant` is keyed on (tenantId, externalPatientId,
  // purpose), not a consultation. Widening this from NOT NULL is additive
  // and hash-compatible: `computeHarnessAuditHash` folds
  // `consultationId ?? null` into the canonical digest, which is a no-op for
  // every EXISTING row (they always carried a non-null string) — proven by
  // `harnessAuditHash.test.ts`'s backward-compatibility golden-hash case.
  consultationId       String?
  contextItemVersionId String?

  // What happened + the model that did it (version, not just name)
  action       HarnessAuditAction
  modelName    String
  modelVersion String

  // Prompt provenance
  promptTemplateId String?
  promptVersion    String?

  // Evidence captured at the time of the event.
  // Data Encryption Initiative Phase 3D — IMPLEMENTED (WORM / hash-chained):
  //   ENCRYPT-BEFORE-HASH for NEW rows only. `sensorScores`/`citations` are
  //   encrypted via Vault Transit (hope-phi) into `encryptedSensorScores`/
  //   `encryptedCitations`, and the row `hash` is derived over the CIPHERTEXT
  //   (see `computeHarnessAuditHash` + `verifyHarnessAuditChain`, applied in
  //   BOTH the insert path and the chain verifier). For an encrypted row the
  //   plaintext JSONB columns hold a non-PHI redaction sentinel ({"_encrypted":
  //   true}) — the table is immutable (UPDATE/DELETE revoked) so plaintext can
  //   never be scrubbed later; storing the sentinel keeps NEW rows confidential
  //   from the start while the ciphertext (hashed) remains the source of truth.
  //   EXISTING rows are NEVER rewritten: they keep plaintext (encrypted* NULL),
  //   hash over plaintext, and stay protected by Phase 1 disk encryption. Same
  //   approach applies to HarnessPolicyChange / PipelinePolicyChange.
  sensorScores Json @db.JsonB
  citations    Json @db.JsonB

  // Phase 3D additive ciphertext + shared Transit key version (nullable; NULL on
  // historical/plaintext rows). When set, `hash` is computed over these bytes.
  encryptedSensorScores Bytes?
  encryptedCitations    Bytes?
  keyVersion            Int?

  // Governance
  gateDecision    String?
  clinicianId     String?
  attestationHash String?

  // Tamper-evident hash chain: prevHash links to the previous event's hash
  // for the same tenant; hash = SHA-256 over the canonical event fields.
  prevHash String
  hash     String

  createdAt DateTime @default(now())

  @@unique([hash], name: "HarnessAuditEvent_hash_key")
  @@index([tenantId], name: "HarnessAuditEvent_tenantId_idx")
  @@index([tenantId, consultationId], name: "HarnessAuditEvent_tenant_consultation_idx")
  @@index([tenantId, createdAt], name: "HarnessAuditEvent_tenant_createdAt_idx")
  @@index([consultationId], name: "HarnessAuditEvent_consultationId_idx")
  @@index([prevHash], name: "HarnessAuditEvent_prevHash_idx")
  @@schema("core")
}

// =============================================================================
// POLICY MANAGEMENT (Harness Administration Console)
//
// DB-backed, editable runtime knobs that drive the clinical documentation loop
// live: the durable workflow reads the effective policy via a `fetch_policy`
// activity at start, so an edit takes effect on the NEXT run with NO redeploy.
//
//   1. HarnessPolicy — a STANDARD tenant-scoped row (tenantId + _version OCC +
//      resourceStatus + audit). The reserved system tenant
//      `00000000-0000-0000-0000-000000000000` owns the GLOBAL-DEFAULT row; a
//      per-tenant row OVERRIDES it. Column defaults mirror the harness runtime
//      defaults (sensors/config.py SensorThresholds + core/config.py
//      SafetyGuardConfig / PhiConfig / gate timing) so a fresh row is a faithful
//      snapshot of the code defaults.
//
//   2. HarnessPolicyChange — an APPEND-ONLY, WORM change log (mirrors
//      HarnessAuditEvent): every policy edit writes a before/after row. The
//      migration that introduces it `REVOKE UPDATE, DELETE` for the app role so
//      the change trail is immutable at the DB-privilege layer.
// =============================================================================

model HarnessPolicy {
  // Meta fields (BaseEntity pattern) — `_version` is the OCC token.
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant — system tenant owns the global-default row; tenant rows override.
  tenantId String

  // Computational sensor thresholds (fractions in [0, 1]). Defaults mirror
  // apps/harness/src/harness/sensors/config.py (SensorThresholds).
  entityFaithfulnessThreshold Float @default(1.0)
  coverageThreshold           Float @default(0.8)
  citationPresenceThreshold   Float @default(1.0)
  numericDoseThreshold        Float @default(1.0)
  groundednessThreshold       Float @default(0.8)

  // Guardrail toggles + engine selection. Defaults mirror SafetyGuardConfig
  // (apps/harness/src/harness/core/config.py) + PhiConfig.
  safetyEnabled  Boolean @default(true)
  phiEnabled     Boolean @default(true)
  phiFailClosed  Boolean @default(true)
  safetyProvider String  @default("lm-studio")
  safetyModel    String  @default("granite-guardian-4.1-8b")

  // SMR generation defaults (null => let the SMR service choose). Mirrors
  // Settings.smr_provider / smr_model.
  smrProvider String?
  smrModel    String?

  // Bounded-regen budget + clinician-gate timing (durable, deterministic).
  // Mirrors Settings.max_regen / gate_sla_seconds / gate_escalation_seconds.
  maxRegen              Int @default(2)
  gateSlaSeconds        Int @default(86400)
  gateEscalationSeconds Int @default(43200)

  // Tool allow-list the loop may call out to (JSON array of tool ids); null =
  // no restriction (all tools allowed).
  toolAllowlist Json? @db.JsonB

  // agentic loop knobs the workflow reads. ADDITIVE + NULLABLE:
  // null ⇒ the harness env/code default applies (per-field fallthrough, mirroring the
  // smrProvider/smrModel precedent in harness-policy.service.ts). Phase 6 consumes the
  // behaviour; 3A only makes them DB-editable and threads them onto the effective policy.
  optimisticDeliveryEnabled Boolean?
  atomicFactEnabled         Boolean?
  retrievalEnabled          Boolean?
  warmStartEnabled          Boolean?
  nerPriorsEnabled          Boolean?
  maxEditReruns             Int?
  regenFeedbackEnabled      Boolean?

  // MCP external-tools master switch. ADDITIVE + NULLABLE:
  // null ⇒ OFF (the harness env/code default is off), so the whole MCP tool path
  // stays dormant until a global admin explicitly flips this per-tenant knob AND
  // the referenced McpServer.enabled is true. Same per-field fallthrough as the
  // knobs above.
  mcpToolsEnabled Boolean?

  // Resource status + Audit (standard fields)
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // One policy row per tenant (the system tenant's row is the global default).
  // The unique index doubles as the tenant lookup index, so no separate
  // `@@index([tenantId])` is declared (it would be redundant).
  @@unique([tenantId], name: "HarnessPolicy_tenantId_key")
  @@schema("core")
}

model HarnessPolicyChange {
  // Identity only — NO _version / _metadata / updatedAt / resourceStatus.
  // Rows are immutable (append-only); the migration REVOKEs UPDATE/DELETE
  // on this table from the application role.
  id String @id @default(uuid(7))

  // Multi-tenant — the policy row's tenant (system tenant for global-default edits).
  tenantId String

  // Who made the change (user id) + the optimistic-concurrency version of the
  // policy row AFTER the edit (the `_version` the CAS produced), for correlation.
  changedBy     String?
  policyVersion Int?

  // Full before/after snapshots of the policy values (null `beforeJson` => the
  // policy row was created by this change).
  beforeJson Json?   @db.JsonB
  afterJson  Json    @db.JsonB
  reason     String? @db.Text

  // Data Encryption Initiative Phase 3D — additive Vault-Transit (hope-phi)
  // ciphertext of the before/after policy snapshots + shared key version. WORM
  // (UPDATE/DELETE revoked): NEW rows store ciphertext here with a non-PHI
  // redaction sentinel ({"_encrypted": true}) in the plaintext JSONB columns;
  // historical rows keep plaintext (encrypted* NULL) and are never rewritten.
  encryptedBeforeJson Bytes?
  encryptedAfterJson  Bytes?
  keyVersion          Int?

  createdAt DateTime @default(now())

  @@index([tenantId], name: "HarnessPolicyChange_tenantId_idx")
  @@index([tenantId, createdAt], name: "HarnessPolicyChange_tenant_createdAt_idx")
  @@schema("core")
}

/// Gate-edit mining store.
///
/// Derived, append-only learning corpus built from the clinician approve-vs-edit
/// signal: gate decisions live in the WORM `HarnessAuditEvent`, and the
/// RAW_SUMMARY→MODIFIED_SUMMARY diff supplies the edit stats. Rows here are a
/// DERIVED projection, never the audit truth — the WORM table remains
/// authoritative.
///
/// PHI posture: content snippets are PHI-**REDACTED AT WRITE** (fail-closed —
/// a redaction failure drops the candidate rather than persisting it), so this
/// store never accumulates PHI. It is an ops table, not a WORM one: no
/// UPDATE/DELETE revoke, and it is deletable wholesale.
///
/// Soft-delete EXEMPT (no `resourceStatus` column) — see
/// MODELS_WITHOUT_SOFT_DELETE in packages/database/src/client.ts.
model GateEditExemplar {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // Source consultation + retrieval facets. `departmentId` is the retrieval key
  // for per-department few-shot exemplars; `visitType` narrows it further.
  consultationId String
  departmentId   String?
  visitType      String?

  // The clinician signal. `gateDecision` mirrors the GATE_DECISION audit event;
  // `qualitySignal` is the mined label (APPROVED_CLEAN | HEAVILY_EDITED) that
  // retrieval ranks on.
  gateDecision  String
  qualitySignal String

  // Edit-burden stats derived from the RAW→MODIFIED diff
  // (harness-observability/edit-burden.ts).
  editDistance      Int?
  editDistanceRatio Float?
  timeToSignSeconds Int?

  // PHI-redacted before/after snippets. Redaction happens BEFORE persistence.
  redactedBefore String? @db.Text
  redactedAfter  String? @db.Text

  // Provenance for corpus export + regression attribution.
  contextItemId    String?
  modelName        String?
  promptTemplateId String?

  // Human curation gate. Mining writes PENDING; a curator
  // moves the row to APPROVED/REJECTED through the admin curation endpoint.
  // The few-shot retriever only FILTERS on this when
  // `agentic.fewshot.curationMode = 'enforce'` — default `off` keeps today's
  // behaviour (every mined APPROVED_CLEAN row is eligible), so the column is
  // inert until an operator turns the gate on.
  curationStatus ExemplarCurationStatus @default(PENDING)

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId], name: "GateEditExemplar_tenantId_idx")
  @@index([tenantId, consultationId], name: "GateEditExemplar_tenant_consultation_idx")
  // Retrieval path: findTopForRetrieval filters (tenantId, qualitySignal
  // [, departmentId]) and orders by createdAt desc.
  @@index([tenantId, departmentId, qualitySignal, createdAt], name: "GateEditExemplar_retrieval_idx")
  // Curation queue + enforce-mode retrieval filter.
  @@index([tenantId, curationStatus], name: "GateEditExemplar_tenant_curationStatus_idx")
  @@schema("core")
}
