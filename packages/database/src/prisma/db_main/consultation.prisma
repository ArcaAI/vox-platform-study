// Consultation Domain Models
// Consultation is the top-level entity for SDK v2

model Consultation {
  // Meta fields (BaseEntity pattern)
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Patient (external system - no FK)
  patientId       String
  appointmentDate DateTime @db.Date

  // Doctor (FK to User)
  doctorId String
  Doctor   User   @relation("DoctorConsultations", fields: [doctorId], references: [id])

  // Department (FK to lookup table)
  departmentId String?
  Department   Department? @relation(fields: [departmentId], references: [id])

  // Visit linking: NULL = initial visit, NOT NULL = follow-up/referral
  parentConsultationId String?
  ParentConsultation   Consultation?  @relation("ConsultationChain", fields: [parentConsultationId], references: [id])
  ChildConsultations   Consultation[] @relation("ConsultationChain")

  // Flexible metadata (scheduling info, external refs, etc.)
  metadata Json? @db.JsonB

  // Lifecycle state — typed promotion of the legacy free-form
  // `metadata.status` JSON. Backfilled non-destructively; the attestation
  // gate transitions PENDING_REVIEW → SIGNED.
  status ConsultationStatus @default(OPEN)

  // TASK-711: health-flag projection on the active phase, not a state of its
  // own — the reference model's `Degraded` state is REJECTED (see
  // state-machine.md). Append-only within a session; cleared on SIGNED.
  degradedReasons String[] @default([])

  // Resource status + Audit (standard fields)
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations
  ContextItems ContextItem[]
  // Manual doctor highlights anchored to this consultation's persisted
  // surfaces (virtual relation; FK lives on Highlight).
  Highlights   Highlight[]
  // TASK-811 (OD-7) — the per-section rows of every clinical document being
  // generated for this consultation (virtual relation; FK lives on
  // DocumentSection).
  DocumentSections DocumentSection[]

  // Indexes (no unique constraint - allows multiple visits same doctor/day)
  @@index([tenantId], name: "Consultation_tenantId_idx")
  @@index([patientId], name: "Consultation_patientId_idx")
  @@index([appointmentDate], name: "Consultation_appointmentDate_idx")
  @@index([parentConsultationId], name: "Consultation_parentId_idx")
  // Composite tenant-leading indexes replace single-column doctorId/departmentId
  // indexes so the planner picks tenantId+X for every tenant-scoped fetch
  // (which is every fetch under RLS).
  @@index([tenantId, doctorId], name: "Consultation_tenant_doctor_idx")
  @@index([tenantId, departmentId], name: "Consultation_tenant_department_idx")
  @@index([tenantId, patientId, appointmentDate], name: "Consultation_tenant_patient_date_idx")
  // Tenant-leading lifecycle filter (e.g. review queues).
  @@index([tenantId, status], name: "Consultation_tenant_status_idx")
  @@schema("core")
}

// =============================================================================
// CORE CONTEXT ITEM (Base/Parent for all consultation content)
// =============================================================================

model ContextItem {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent consultation
  consultationId String
  Consultation   Consultation @relation(fields: [consultationId], references: [id])

  // Type discriminator (enum for type safety)
  type   ContextItemType
  source ContextItemSource @default(USER)

  // Current version tracking
  currentVersionNumber Int @default(1)

  // Data Encryption Initiative — clinical free-text content.
  // The plaintext `content` column has been DROPPED.
  // Persistence is Vault-Transit (hope-phi) ciphertext only; reads decrypt on
  // the fly into the entity's transient `content` field.
  encryptedContent  Bytes?
  contentKeyVersion Int?

  // Attachment media reference (reference ID, same soft-reference pattern as
  // dnaWritingStyleId). Set for ATTACHMENT-type items pointing to an uploaded
  // file in object storage; resolved to bucket+key via the Media record.
  mediaId String?

  // DNA Writing Style (reference ID, similar to mediaId pattern)
  dnaWritingStyleId String?

  // Tenant-facing context-kind discriminator, layered ABOVE `type`.
  // `type` keeps its exact meaning (so every existing row, query and
  // encryption path is untouched); `kindKey` names the tenant-declared kind
  // (`kinds[].key` of the pinned ConsultationContextSchemaVersion) and
  // `contextSchemaVersionId` records WHICH immutable version this row was
  // validated against — the pin is captured at write time so a later publish
  // can never retroactively invalidate an accepted item. Both NULL for every
  // pre- row and for every write that names no kind, which is exactly
  // the legacy behaviour.
  //
  // Soft references (no FK), the same convention `mediaId` and
  // `dnaWritingStyleId` above already use.
  kindKey                String?
  contextSchemaVersionId String?

  // TASK-811 (OD-6) — WHICH clinical document this item belongs to, layered
  // ABOVE `type` exactly as `kindKey` is. `type` keeps its meaning, so every
  // existing row, query and encryption path is untouched and there is ZERO
  // backfill: NULL means "the single, unnamed document", which is what every
  // pre-TASK-811 row is.
  //
  // It exists because `ContextItemType.PRE_SUMMARY` is overloaded (D-22): the
  // context-derived pre-summary and the live running-note snapshot are the same
  // enum member, and with more than one document streaming per consultation
  // (`soap`, `discharge`, ...) that ambiguity becomes unresolvable. The key is
  // the tenant's own `DocumentTemplate.slug`.
  //
  // Soft reference (no FK), the same convention `kindKey` above uses.
  documentKey            String?

  // Qdrant sync status (for semantic search). RESERVED, NO WRITER (
  // Phase 0 / SOTA gap review D2): the target `context_items` Qdrant
  // collection was never actually provisioned-and-used — its provisioning
  // was removed from infrastructure/docker/scripts/init-qdrant-collections.py
  // as orphaned. `markQdrantNeedsSync()` (context.service.ts) still flips
  // `qdrantSynced` to false on content updates, but nothing ever flips it
  // back to true or reads/writes a `context_items` point — these columns are
  // additive-safe dead weight kept for a future semantic-search feature, not
  // an active sync flag. Columns intentionally left in place (no migration).
  qdrantSynced   Boolean   @default(false)
  qdrantSyncedAt DateTime?

  // Resource status + Audit
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations to type-specific data
  AudioRecordings AudioRecording[]
  SummaryMeta     SummaryMeta?
  NamedEntities   NamedEntity[]        @relation("NamedEntityParent")
  Versions        ContextItemVersion[]
  // segment-level structure of a TRANSCRIPT context item (turns /
  // diarized segments with time + character-offset anchors). Only populated
  // for TRANSCRIPT items; empty for every other type.
  TranscriptSegments TranscriptSegment[]

  // NamedEntities whose transcript span points at THIS (TRANSCRIPT) context
  // item. Distinct from the `NamedEntities` container relation above, so both
  // relations are explicitly named.
  TranscriptNamedEntities NamedEntity[] @relation("NamedEntityTranscript")

  // Indexes
  @@index([tenantId], name: "ContextItem_tenantId_idx")
  @@index([consultationId], name: "ContextItem_consultationId_idx")
  @@index([type], name: "ContextItem_type_idx")
  @@index([source], name: "ContextItem_source_idx")
  @@index([createdAt], name: "ContextItem_createdAt_idx")
  @@index([qdrantSynced], name: "ContextItem_qdrantSynced_idx")
  @@index([dnaWritingStyleId], name: "ContextItem_dnaWritingStyleId_idx")
  @@index([mediaId], name: "ContextItem_mediaId_idx")
  // Per-consultation "give me every item of kind X" reads, and the
  // reverse lookup "which items were validated against this schema version"
  // that a schema-retirement check needs.
  @@index([consultationId, kindKey], name: "ContextItem_consultation_kindKey_idx")
  // TASK-811 (OD-6) — the `documentKey` twin of the index above: "give me every
  // item of document X for this consultation".
  @@index([consultationId, documentKey], name: "ContextItem_consultation_documentKey_idx")
  @@index([contextSchemaVersionId], name: "ContextItem_contextSchemaVersionId_idx")
  // Composite for common queries
  @@index([consultationId, type], name: "ContextItem_consultation_type_idx")
  @@index([tenantId, type, createdAt], name: "ContextItem_tenant_type_created_idx")
  // Tenant-leading composite for per-consultation reads
  @@index([tenantId, consultationId, type], name: "ContextItem_tenant_consultation_type_idx")
  @@schema("core")
}

// =============================================================================
// AUDIO RECORDINGS (Multiple per consultation)
// Supports multiple audio recordings with ordering
// =============================================================================

model AudioRecording {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent context item (type should be AUDIO_RECORDING)
  contextItemId String
  ContextItem   ContextItem @relation(fields: [contextItemId], references: [id])

  // Reference to Media table (stores actual file info)
  // NOTE: no code path resolves this (or rawMediaId/processedMediaId below) via
  // MediaRepository today (verified 2026-08-11) — ContextDtoMapper.toAudioRecordingResponse
  // returns all three raw. Producers historically wrote the raw storage key instead of a
  // Media UUID here (same bug class fixed for ContextItem.mediaId in); that fix
  // also corrects new writes to this table, but pre-fix rows may still hold a raw key.
  // Inert today (nothing resolves it), but a future playback/download resolver must
  // re-check for non-UUID values before trusting these fields — see the backfill
  // script (packages/database/scripts/backfill-context-item-media-id.ts) for the pattern.
  mediaId String

  // Dual capture — soft references to the raw vs processed (noise-cancelled /
  // VAD-trimmed / resampled) media. Nullable + additive; `mediaId` above is
  // retained as the primary/back-compat reference. Same unresolved-reference caveat as above.
  rawMediaId       String?
  processedMediaId String?

  // Audio-specific metadata
  duration   Int? // Duration in milliseconds
  format     String? // e.g., "wav", "mp3", "webm"
  sampleRate Int? // e.g., 44100, 48000
  channels   Int? // 1 = mono, 2 = stereo
  bitrate    Int? // e.g., 128000
  language   String? // Detected or specified language

  // Ordering for multiple recordings in a consultation
  sequenceNumber Int @default(1)

  // Recording timestamp (when the audio was recorded, not created in system)
  recordedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes
  @@index([tenantId], name: "AudioRecording_tenantId_idx")
  @@index([contextItemId], name: "AudioRecording_contextItemId_idx")
  @@index([mediaId], name: "AudioRecording_mediaId_idx")
  @@index([contextItemId, sequenceNumber], name: "AudioRecording_sequence_idx")
  // Tenant-leading composite for per-contextItem reads.
  // (AudioRecording is keyed off ContextItem, not Consultation directly.)
  @@index([tenantId, contextItemId], name: "AudioRecording_tenant_contextItem_idx")
  @@schema("core")
}

// =============================================================================
// SUMMARY METADATA (AI generation context and cost tracking)
// One-to-one relationship with ContextItem of type RAW_SUMMARY, MODIFIED_SUMMARY, or PRE_SUMMARY
// =============================================================================

model SummaryMeta {
  // Meta fields
  // `_version` is the optimistic-concurrency counter. It exists because this row
  // is written TWICE by the two-phase optimistic-delivery flow: `persistDraft`
  // (EARLY) creates it with the computational scores only, then
  // `finalizeAssurance` backfills the inferential verdict. Without a
  // compare-and-set the backfill is a read-modify-write race whose only guard was
  // the HTTP idempotency key. Database-owned: never written by the mapper (see
  // FIELDS_NOT_WRITABLE in SummaryMetaEntityMapper), only by
  // `Repository.updateWithVersion`.
  version Int    @default(1) @map("_version")
  id      String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent context item (1:1 relationship)
  contextItemId String      @unique
  ContextItem   ContextItem @relation(fields: [contextItemId], references: [id])

  // AI Model information
  aiModelId      String? // Reference to AI model registry
  aiModelVersion String? // Version of the model used
  promptVersion  String? // Version of the prompt template used

  // Cost tracking (time-based - duration in milliseconds)
  processingTimeMs Int? // Time taken by AI model to complete the task

  // Token usage (for analytics)
  inputTokens  Int? // Tokens used for input
  outputTokens Int? // Tokens generated

  // AD-1 generation-stats headline fields. Persisted per
  // summary alongside the existing token/latency columns. `stopReason` is the
  // NORMALIZED stop reason (stop | length | content_filter | tool_call | abort
  // | error | other); `ttftMs` is time-to-first-token; `tokensPerSecond` is the
  // decode throughput. predicted/total token counts are DERIVABLE from the
  // existing inputTokens/outputTokens, so they are intentionally NOT added. All
  // nullable/additive.
  stopReason      String? // normalized generation stop reason
  ttftMs          Int? // time-to-first-token in milliseconds
  tokensPerSecond Float? // decode throughput (predicted tokens / decode-time)

  // Cache + quality analytics
  cacheHit     Boolean? // Whether this summary was served from cache
  qualityScore Float? // Quality/score of the generated summary (0.0 - 1.0)

  // Context used for generation (IDs of related items)
  caseNoteIds        String[] @default([]) // IDs of case notes used as context
  preSummaryIds      String[] @default([]) // IDs of pre-summaries used
  previousSummaryIds String[] @default([]) // IDs of previous consultation summaries

  // Generation metadata
  generatedAt DateTime? // When the summary was generated

  // Prompt resolution provenance — which tier of the PromptResolutionService
  // chain produced the summary, plus the prompt id actually used. Nullable +
  // additive.
  promptResolvedFrom String? // 'preferred' | 'department' | 'default'
  resolvedPromptId   String? // the promptId actually used

  // Session-agent lineage: the DepartmentAgent identity frozen
  // at recording start and carried live-flushes → LIVE_SOAP_SNAPSHOT metaData →
  // finalize. Null for every non-live-session summary (and for every summary
  // produced before the live agent loop shipped). `sessionAgentPromptVersion`
  // is "<templateId>@<versionNumber>" — the immutable PromptVersion the LIVE
  // loop actually served, which is distinct from `promptVersion` above (that
  // one names finalize's own template version). Columns land here in C2; C5
  // populates them.
  sessionAgentId            String?
  sessionAgentPromptVersion String?

  // Clinical-harness sensor scores + citation provenance. All nullable/additive;
  // populated by the eval/guardrail pipeline.
  entityFaithfulnessScore Float? // NER entity faithfulness (0.0 - 1.0)
  coverageScore           Float? // transcript coverage (0.0 - 1.0)
  ragTriadScore           Float? // RAG triad (context relevance / groundedness / answer relevance)
  // Plaintext citationsMap / guardrailDecisions JSONB columns DROPPED;
  // persisted as Vault-Transit ciphertext only (see encrypted* below).
  attestationRef          String? // ref to the attestation (ContextItemVersion id / audit hash)
  modelName               String? // model that produced the scored summary

  // Two-phase (optimistic) assurance. Both nullable/additive.
  // The early draft persist writes neither (gateDecision=null ⇒ DRAFT_PENDING_SENSORS);
  // finalize_assurance writes both ONCE the inferential verdict is computed (WORM
  // truthfulness: a gate decision is recorded only when it exists). The sign-off guard
  // reads assuranceCompletedAt (must be set) + guardrailDecisions.safety (must not FLAG).
  gateDecision         String? // 'PASS' | 'REGEN' | 'FLAG' — mirrors harness GateDecision; written only when computed
  assuranceCompletedAt DateTime? // null = assurance pending (DRAFT_PENDING_SENSORS); set = assurance finalised (verdict recorded)

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // JSONB provenance blobs (citationsMap / guardrailDecisions) plus the shared
  // Transit key version. The plaintext JSONB columns have been DROPPED; these
  // ciphertext columns are now the system of record.
  encryptedCitationsMap       Bytes?
  encryptedGuardrailDecisions Bytes?
  keyVersion                  Int?

  // DNA redaction/rewrite audit. `redactionApplied` is a plaintext,
  // queryable marker: the redaction transform ran and changed the note. The
  // manifest DETAIL (rule ids, actions, spans, counts — NEVER removed PHI
  // plaintext) is Vault-Transit (hope-phi) ciphertext, mirroring citationsMap;
  // it shares the `keyVersion` above. Both nullable/additive: absent ⇒ no
  // redaction ran (or a pre- history).
  redactionApplied           Boolean?
  encryptedRedactionManifest Bytes?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([tenantId], name: "SummaryMeta_tenantId_idx")
  @@index([contextItemId], name: "SummaryMeta_contextItemId_idx")
  @@index([aiModelId], name: "SummaryMeta_aiModelId_idx")
  @@index([generatedAt], name: "SummaryMeta_generatedAt_idx")
  @@index([promptResolvedFrom], name: "SummaryMeta_promptResolvedFrom_idx")
  // Tenant-leading composite for per-contextItem reads.
  @@index([tenantId, contextItemId], name: "SummaryMeta_tenant_contextItem_idx")
  @@schema("core")
}

// =============================================================================
// NAMED ENTITIES (NER results from AI recognition)
// Stores recognized entities with confidence scores and AI model info
// =============================================================================

model NamedEntity {
  // Meta fields
  id String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent context item (typically linked to TRANSCRIPT or RAW_SUMMARY)
  contextItemId String
  ContextItem   ContextItem @relation("NamedEntityParent", fields: [contextItemId], references: [id])

  // Entity information.
  // Plaintext `text` / `normalizedText` columns DROPPED (persisted as
  // Vault-Transit ciphertext; see encrypted* below).
  className      String // Entity class (e.g., "MEDICATION", "CONDITION", "PROCEDURE", "ANATOMY")

  // Clinical ontology normalization codes (nullable; set by the
  // NER/normalization pipeline). Enables entity-faithfulness scoring and coded
  // problem / medication / observation lists.
  //
  // These five columns are currently READ by the durable summarization path
  // (prompt-assembly / harness-internal / summary processor) but WRITTEN by no
  // code: the NLP token classifier emits no codes and there is no ontology
  // linker yet. A groundedness guard in prompt-assembly.service.ts makes the
  // empty-code case explicit. Do NOT treat these as orphaned or drop them —
  // they are the future ontology linker's write target.
  umlsCui    String? // UMLS Concept Unique Identifier
  snomedCode String? // SNOMED CT code
  rxnormCode String? // RxNorm code (medications)
  icdCode    String? // ICD-10 code
  loincCode  String? // LOINC code (labs / observations)

  // Transcript provenance — FK back into the originating TRANSCRIPT context
  // item plus the character span, so summaries can cite the exact source
  // offsets that grounded each entity.
  transcriptContextItemId String?
  TranscriptContextItem   ContextItem? @relation("NamedEntityTranscript", fields: [transcriptContextItemId], references: [id])
  transcriptStartOffset   Int? // Character offset start within the transcript
  transcriptEndOffset     Int? // Character offset end within the transcript

  // Location in source text
  startOffset Int? // Character offset start
  endOffset   Int? // Character offset end

  // negation/assertion polarity for this mention (ConText/NegEx).
  // One of PRESENT | ABSENT | HISTORICAL | FAMILY | HYPOTHETICAL. Nullable +
  // additive; a null value is read as PRESENT (the safe default) so existing
  // rows and any writer that does not set it stay positive assertions.
  // Downstream faithfulness / concept-F1 sensors exclude ABSENT from
  // positive-claim checks.
  assertion String?

  // Confidence and scoring
  confidence Float? // Confidence score (0.0 - 1.0)

  // AI Model used for recognition
  aiModelId      String?
  aiModelVersion String?

  // Cost tracking (time-based - duration in milliseconds)
  processingTimeMs Int? // Time taken for recognition

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // recognized free-text span (text / normalizedText) and the metadata JSONB
  // blob, plus the shared Transit key version. The plaintext text /
  // normalizedText / metadata columns AND the now-unused
  // `NamedEntity_text_idx` have been DROPPED. The coded ontology columns
  // (umlsCui/snomedCode/rxnormCode/icdCode/loincCode) are NOT encrypted and
  // remain plaintext.
  encryptedText           Bytes?
  encryptedNormalizedText Bytes?
  encryptedMetadata       Bytes?
  keyVersion              Int?

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes
  @@index([tenantId], name: "NamedEntity_tenantId_idx")
  @@index([contextItemId], name: "NamedEntity_contextItemId_idx")
  @@index([className], name: "NamedEntity_className_idx")
  // `NamedEntity_text_idx` dropped with the `text` column.
  @@index([confidence], name: "NamedEntity_confidence_idx")
  @@index([contextItemId, className], name: "NamedEntity_item_class_idx")
  // Tenant-leading composite for entity-class lookups.
  @@index([tenantId, contextItemId, className], name: "NamedEntity_tenant_item_class_idx")
  // Transcript-span provenance lookups.
  @@index([transcriptContextItemId], name: "NamedEntity_transcriptContextItem_idx")
  @@schema("core")
}

// =============================================================================
// CONTEXT ITEM VERSION (Snapshot history for content changes)
// Tracks version history with diff support for analytics
// =============================================================================

model ContextItemVersion {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent context item
  contextItemId String
  ContextItem   ContextItem @relation(fields: [contextItemId], references: [id])

  // Version number (1, 2, 3...)
  versionNumber Int

  // Change metadata. The free-text snapshot columns (content / contentDiff /
  // changeSummary / fieldChanges) have been DROPPED; they are persisted as
  // Vault-Transit ciphertext only (see encrypted* below).
  // changeReason / changedBy / changeSource are NOT encrypted and remain.
  changeReason  String? // e.g., "user_edit", "ai_regeneration", "correction", "typo_fix"
  changedBy     String? // User ID or "system"
  changeSource  String? // e.g., "manual", "ai_model_v2", "bulk_update", "api"

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // free-text clinical snapshot fields (content / contentDiff / changeSummary /
  // fieldChanges) plus the shared Transit key version. These ciphertext
  // columns are now the system of record (plaintext columns dropped).
  encryptedContent       Bytes?
  encryptedContentDiff   Bytes?
  encryptedChangeSummary Bytes?
  encryptedFieldChanges  Bytes?
  keyVersion             Int?

  // Clinician attestation (confirm-before-commit gate). Populated when a
  // SIGNED_NOTE version is written on approveSummary; the attestationHash
  // anchors the version to its append-only HarnessAuditEvent (action = ATTEST).
  // All nullable/additive.
  attestedAt      DateTime? // when the clinician attested
  attestedBy      String? // clinician user id who attested
  attestationHash String? // SHA-256 hash linking to the WORM audit event
  modelName       String? // model that produced the attested content
  modelVersion    String?
  sensorScores    Json?     @db.JsonB // guardrail/sensor scores captured at attestation

  // Timestamp
  createdAt DateTime @default(now())

  // Unique: one version number per context item
  @@unique([contextItemId, versionNumber])
  // Indexes
  @@index([tenantId], name: "ContextItemVersion_tenantId_idx")
  @@index([contextItemId], name: "ContextItemVersion_contextItemId_idx")
  @@index([versionNumber], name: "ContextItemVersion_versionNumber_idx")
  @@index([createdAt], name: "ContextItemVersion_createdAt_idx")
  @@index([changedBy], name: "ContextItemVersion_changedBy_idx")
  // Composite for fetching version history
  @@index([contextItemId, versionNumber], name: "ContextItemVersion_item_version_idx")
  @@schema("core")
}

// =============================================================================
// HIGHLIGHT (Manual doctor highlighting)
// Durable, per-tenant, soft-deletable doctor-authored highlight anchored to a
// persisted ContextItem (transcript / case note / work note / summary) via W3C
// dual selectors (TextQuoteSelector exact/prefix/suffix + TextPositionSelector
// start/end). Separate model from NamedEntity so manual marks NEVER pollute the
// AI NER aggregation.
// =============================================================================

model Highlight {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent consultation
  consultationId String
  Consultation   Consultation @relation(fields: [consultationId], references: [id])

  // Anchor target — the persisted ContextItem this highlight is anchored to
  // (soft reference, same pattern as ContextItem.mediaId / dnaWritingStyleId).
  // Nullable for a possible future "live ephemeral promoted on stop". The
  // targetKind discriminates WHICH persisted surface the mark lives on.
  sourceContextItemId String?
  targetKind          HighlightTargetKind

  // W3C Web Annotation dual selectors:
  //  - TextQuoteSelector  : exact + ~32-char prefix/suffix (robust to re-flow)
  //  - TextPositionSelector: startOffset/endOffset (precise but brittle)
  // The quote-selector / note free-text columns (exact / prefix / suffix /
  // note) have been DROPPED; persisted as Vault-Transit ciphertext only (see
  // encrypted* below).
  startOffset Int
  endOffset   Int

  // Presentation
  color String?
  label String?

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the W3C
  // quote selectors + free-text note (exact / prefix / suffix / note) plus the
  // shared Transit key version. These ciphertext columns are now the
  // system of record (plaintext columns dropped).
  encryptedExact  Bytes?
  encryptedPrefix Bytes?
  encryptedSuffix Bytes?
  encryptedNote   Bytes?
  keyVersion      Int?

  // Resource status + Audit
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Indexes
  @@index([tenantId], name: "Highlight_tenantId_idx")
  @@index([consultationId], name: "Highlight_consultationId_idx")
  @@index([sourceContextItemId], name: "Highlight_sourceContextItemId_idx")
  // Tenant-leading composite for per-consultation reads.
  @@index([tenantId, consultationId], name: "Highlight_tenant_consultation_idx")
  @@schema("core")
}

// =============================================================================
// TRANSCRIPT SEGMENT
// =============================================================================
// A single ordered segment (a diarized turn / VAD segment) of a TRANSCRIPT
// context item. STT emits per-segment metadata (start/end timestamps, speaker,
// and the text slice) which the ingest previously dropped. Persisting them
// here lets the harness/summary paths cite the exact source segment for a
// grounded claim (sentence-level `[[seg:<id>]]` provenance) and lets a future
// console click-to-source seek the audio (t0/t1).
//
// PHI posture (deliberate): this row stores ONLY non-PHI structural metadata —
// the segment's ordinal, time span, diarization label, and the CHARACTER
// OFFSETS [charStart, charEnd) into the parent TRANSCRIPT's content. The
// segment TEXT is NOT duplicated here: it is a slice of the transcript
// ContextItem's already-encrypted `content`, recoverable via the offsets. This
// keeps the table free of any new plaintext-PHI surface and avoids a second
// ciphertext column set.
//
// Like NamedEntity / AudioRecording (sibling per-transcript annotation tables)
// it is TENANT-SCOPED but soft-delete EXEMPT: segments live and die with their
// parent transcript, so there is no `resourceStatus` column and the model is
// listed in MODELS_WITHOUT_SOFT_DELETE.
model TranscriptSegment {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent TRANSCRIPT context item.
  contextItemId String
  ContextItem   ContextItem @relation(fields: [contextItemId], references: [id])

  // 0-based ordinal within the transcript (append order = playback order).
  idx Int

  // Segment time span (milliseconds from the recording start). Nullable — a
  // text-only transcript (no diarization/timestamps) still persists ordered
  // segments with null timings.
  t0Ms Int?
  t1Ms Int?

  // Diarization / speaker label (e.g. "SPEAKER_00", "doctor"). Nullable.
  speaker String?

  // Character offsets [charStart, charEnd) of this segment within the parent
  // TRANSCRIPT's decrypted content — the anchor NER grounding resolves to map
  // an entity's transcript span onto its source segment id. Nullable when the
  // offsets could not be resolved (segment text not found in the transcript).
  charStart Int?
  charEnd   Int?

  // Audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (contextItem, idx) — idempotent re-ingest of a transcript's
  // segments, and the natural ordering key.
  @@unique([contextItemId, idx], name: "TranscriptSegment_item_idx_unique")
  @@index([tenantId], name: "TranscriptSegment_tenantId_idx")
  @@index([contextItemId], name: "TranscriptSegment_contextItemId_idx")
  // Tenant-leading composite for per-transcript reads.
  @@index([tenantId, contextItemId], name: "TranscriptSegment_tenant_item_idx")
  @@schema("core")
}

// =============================================================================
// DOCUMENT SECTION (TASK-811, OD-7)
// =============================================================================
// One section of one clinical document being generated for a consultation —
// `(consultationId, documentKey, sectionKey)` is its identity.
//
// WHY A CHILD TABLE AND NOT JSON ON `ContextItem.metaData` (the deciding
// argument is CONCURRENCY, not queryability):
//
//   The rule "a CONFIRMED section is never overwritten by a flush" needs
//   per-section optimistic concurrency. `ContextItem.encryptedContent` is a
//   single opaque blob behind a single `_version`, so on that shape EVERY flush
//   contends with EVERY clinician edit, and two documents generating
//   concurrently contend with each other. One `_version` per section is what
//   makes the rule hold; there is no way to express it on a blob.
//
// SHAPE mirrors `TranscriptSegment` above, which already carries the exact span
// anchors provenance needs (`idx`, `charStart`/`charEnd`, and time offsets
// through the transcript segments it cites).
//
// PHI POSTURE differs from `TranscriptSegment` deliberately. A section's text is
// NOT a slice of an already-encrypted parent — it is generated prose that exists
// nowhere else — so it is stored here, encrypted, following
// `ContextItem.encryptedContent Bytes?` (Vault-Transit `hope-phi` ciphertext,
// decrypted on the fly). `annotations` and `provenance` are structural metadata
// with SECTION-LOCAL offsets and carry no clinical text.
//
// Like `TranscriptSegment` it is TENANT-SCOPED but soft-delete EXEMPT: sections
// live and die with their consultation's document, so there is no
// `resourceStatus` column and the model is listed in MODELS_WITHOUT_SOFT_DELETE.
// Emptying a section is a content update under the state machine (and needs a
// transcript contradiction), never a row delete.
model DocumentSection {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  // Per-SECTION optimistic-concurrency token — the whole reason this is a table.
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent consultation.
  consultationId String
  Consultation   Consultation @relation(fields: [consultationId], references: [id])

  // WHICH document (the tenant's `DocumentTemplate.slug`, e.g. `soap-note`,
  // `discharge-summary`). Mirrors `ContextItem.documentKey`.
  documentKey String
  // WHICH section within that document (the compiled template's section key).
  sectionKey  String
  // Human-readable heading as compiled for this section, so a reader needs no
  // template join to render the note.
  title       String
  // 0-based ordinal within the document — the render order.
  idx         Int

  // The section state machine (see `DocumentSectionState`).
  state DocumentSectionState @default(EMPTY)

  // Monotonic per-section revision. Advanced by every accepted write; the SSE
  // `section.patch` carries it so a client can discard an out-of-order patch.
  revision Int @default(0)

  // Generated section prose. PHI: Vault-Transit ciphertext only, exactly like
  // `ContextItem.encryptedContent` — there is no plaintext column.
  encryptedContent  Bytes?
  contentKeyVersion Int?

  // Section-LOCAL annotation spans: entities, groundedness verdicts and flagged
  // spans whose `start`/`end` index THIS section's content, never a concatenated
  // running summary (§2b — a global offset is invalidated the moment any earlier
  // section grows).
  annotations Json? @db.JsonB
  // Provenance anchors back to the transcript (`transcriptSegmentId` /
  // `[charStart, charEnd)`), so a claim in the note can be traced to the turn it
  // came from.
  provenance  Json? @db.JsonB

  // The IMMUTABLE `DocumentTemplateVersion` this section's shape was compiled
  // from, pinned at write time so a later publish cannot retroactively
  // restructure a document already produced. Soft reference (no FK), the same
  // convention `ContextItem.contextSchemaVersionId` uses.
  documentTemplateVersionId String?

  // Clinician-touch record — set on the PROVISIONAL -> CONFIRMED transition.
  confirmedAt DateTime?
  confirmedBy String?
  // Endpoint finalization — set on the -> LOCKED transition.
  lockedAt DateTime?

  // Audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (consultation, document, section) — the natural upsert key for a
  // flush, and what makes a re-run idempotent.
  @@unique([consultationId, documentKey, sectionKey], name: "DocumentSection_consultation_document_section_unique", map: "DocumentSection_consultation_document_section_key")
  @@index([tenantId], name: "DocumentSection_tenantId_idx")
  @@index([consultationId], name: "DocumentSection_consultationId_idx")
  // Tenant-leading composite for "render document X of this consultation".
  @@index([tenantId, consultationId, documentKey], name: "DocumentSection_tenant_consultation_document_idx")
  @@schema("core")
}
