model Notification {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // core fields. TASK-369 Phase 6 — plaintext messageText / messageRichText /
  // messageContent columns DROPPED; persisted as Vault-Transit ciphertext only.
  // `title` is NOT encrypted and remains a plaintext column.
  title           String
  type            NotificationType
  read            Boolean          @default(false)

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the
  // message body (messageText / messageRichText / messageContent) plus the
  // shared Transit key version. Phase 6: these ciphertext columns are now the
  // system of record.
  encryptedMessageText     Bytes?
  encryptedMessageRichText Bytes?
  encryptedMessageContent  Bytes?
  keyVersion               Int?

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tags
  tags String[]

  // relations
  resourceSubscriptionId String?
  ResourceSubscription   ResourceSubscription? @relation("_Subscription_Notification", fields: [resourceSubscriptionId], references: [id])
  targetUserId           String
  TargetUser             User                  @relation("_User_UserNotification", fields: [targetUserId], references: [id])

  // indexing
  @@index([tenantId], name: "Notification_tenantId_index")
  @@schema("core")
}

model ResourceSubscription {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // core fields
  resourceId           String?
  resourceTypeName     String?
  subscriptionType     ResourceSubscriptionType
  targetUserId         String
  subscriptionMetadata Json?                    @db.JsonB

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tags
  tags String[]

  // relations
  Subscribers   User[]         @relation("_User_Subscription")
  Notifications Notification[] @relation("_Subscription_Notification")

  // indexing
  @@index([tenantId], name: "ResourceSubscription_tenantId_index")
  @@schema("core")
}
