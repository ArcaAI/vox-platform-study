model GlobalSetting {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // core fields
  locked         Boolean   @default(false)
  name           String
  description    String?
  key            String
  defaultValue   String?
  value          String
  // Vault-Transit-encrypted ciphertext for secrets.
  // Nullable so existing non-secret rows continue to read `value`. New writes
  // populate these; a later, user-gated migration removes the plaintext
  // `value` column for migrated secrets after a one-release readback window.
  encryptedValue Bytes?
  keyVersion     Int?
  dataType       ValueType @default(String)
  namespace      String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // tags
  tags String[] @default([])

  // relations

  // indexing
  @@unique([tenantId, name, key], name: "GlobalSetting_tenantId_name_key_unique")
  @@index(tenantId, name: "GlobalSetting_tenantId_idx")
  @@index([tenantId, name, key], name: "GlobalSetting_tenantId_key_idx")
  @@schema("core")
}
