// ============================================================================
// Plan Entitlements (additive)
//
// DB-backed entitlement model: a platform-wide per-plan default
// matrix (`PlanEntitlement`) + a per-tenant admin-editable override
// (`TenantEntitlement`), plus a rolling-monthly consumption meter
// (`TenantUsageMeter`). Enforcement ships OFF by default behind the
// `entitlements.enabled` GlobalSetting kill-switch.
// ============================================================================

// The rolling-monthly consumption meters.
//
// The first three are BUSINESS-OBJECT meters counted from the clinical tables
// (consultations created, audio minutes recorded, summaries generated). The six
// added by are UNIT meters derived from the `AiUsageEvent` ledger via
// `AiUsageRollupDaily` (D5) — they measure what the platform actually consumed
// per capability, which is what the new per-capability allowances (D11) are
// denominated in.
enum UsageMeterMetric {
  CONSULTATIONS
  TRANSCRIPTION_MINUTES
  SUMMARIES

  // Ledger-derived unit meters.
  // STT is quota'd and billed on SESSION seconds — socket open→close — not
  // audio seconds (OQ1); audio seconds are still recorded for repricing.
  STT_SESSION_SECONDS
  // All billable token kinds summed (input + output + cache + reasoning).
  LLM_TOKENS
  // TTS input, counted as Unicode code points.
  TTS_CHARACTERS
  NLP_TEXT_UNITS
  // Metered for COGS visibility only — guardrail is NEVER quota-blocked (D6/D16):
  // it is platform-mandated safety, so blocking it would degrade clinical safety
  // to save money.
  GUARDRAIL_CALLS
  EMBEDDING_TOKENS

  // A fourth BUSINESS-OBJECT meter (TASK-722 exposure plane): a COUNT of
  // `WorkflowRun` rows in the window, the same shape as CONSULTATIONS/
  // SUMMARIES — one row per invocation of a published workflow through
  // `/api/v1/workflows/:slug/invoke`.
  WORKFLOW_INVOCATIONS

  @@schema("core")
}

// ---------------------------------------------------------------------------
// PlanEntitlement — platform-wide per-plan default matrix (/ Q1).
// One row per `TenantPlan`. NOT tenant-scoped (a platform reference table, like
// Permission/Role): it has no `tenantId` column, so the tenant-scope Prisma
// extension never filters it. A null quantity/meter column = "unlimited". The
// resolver reads these rows (falling back to the seeded constants when a row is
// missing). Admin-editable by super admins only.
// ---------------------------------------------------------------------------
model PlanEntitlement {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // core field — exactly one row per commercial plan
  plan TenantPlan @unique

  // quantity limits (null = unlimited)
  maxUsers           Int?
  maxDepartments     Int?
  maxPromptTemplates Int?
  maxAsrPipelines    Int?
  maxApiKeys         Int?
  storageQuotaBytes  BigInt?
  // Quantity ceiling on PUBLISHED WorkflowDefinition slugs a tenant may hold
  // (TASK-722 exposure plane), modelled verbatim on `maxAsrPipelines`. Checked
  // by TASK-719's authoring create path, not this migration's own caller.
  maxWorkflowDefinitions Int?

  // concurrency limit — simultaneous active STT sessions (null = unlimited).
  // A distinct axis from the total-seat cap (`maxUsers`): "how many doctors can
  // stream at the same instant", enforced against the live socket-registry.
  maxConcurrentSessions Int?

  // rolling-monthly meters (null = unlimited)
  monthlyConsultations        Int?
  monthlyTranscriptionMinutes Int?
  monthlySummaries            Int?
  // A fourth business-object meter (TASK-722): PUBLISHED-workflow invocations
  // via `/api/v1/workflows/:slug/invoke`, gated on `assertMeterQuota` at
  // invoke time. Same Int shape as its three siblings (a monthly invocation
  // count never approaches Int32).
  monthlyWorkflowInvocations Int?

  // Per-capability INCLUDED ALLOWANCES over the same UTC-calendar-month windows
  // . Usage above an allowance is billed as overage at the SELL
  // rate rather than blocked — soft caps for paid tiers, hard caps only for
  // TRIAL (D12).
  //
  // Per-capability rather than a fungible credit pool: healthcare buyers price
  // PREDICTABILITY over fungibility, and the market signal is unambiguous
  // (Windsurf reverted from credits for exactly this reason).
  //
  // BigInt because token and character counts reach the billions on an
  // enterprise plan — an Int32 would overflow. `null` = unlimited, so seeding
  // these as NULL for every existing plan is a strict no-op.
  //
  // No `monthlyGuardrailCalls`: guardrail is metered but never quota-blocked
  // (D6/D16), so an allowance ceiling for it would be a control nothing reads.
  monthlySttSessionSeconds BigInt?
  monthlyLlmTokens         BigInt?
  monthlyTtsCharacters     BigInt?
  monthlyNlpTextUnits      BigInt?
  monthlyEmbeddingTokens   BigInt?

  // feature toggles
  featureDnaReports       Boolean @default(false)
  featureVoiceEnrollment  Boolean @default(false)
  featureMonitoringAccess Boolean @default(false)

  // May this plan's tenants consume the PLATFORM-DEFAULT
  // (SYSTEM-tenant) provider credential when they have no key of their own?
  //
  // Unlike its three neighbours this flag is ENFORCING, not display-only: it
  // decides whether the provider-credential cascade may reach the SYSTEM tier,
  // i.e. whether the platform spends its own money serving this tenant.
  //
  // `false` on all four seeded plans (OD-7). Granting it plan-wide on PRO or
  // ENTERPRISE would hand every tenant on that plan a platform-funded cloud
  // path, reopening the margin hole closed. Grants are per tenant, via
  // `TenantEntitlement.featurePlatformDefaultCredential`.
  featurePlatformDefaultCredential Boolean @default(false)

  // May this plan's tenants publish an `stt`-palette `WorkflowDefinition`
  // (TASK-724)? Display-only, checked once at publish time — `true` on every
  // seeded plan: STT pipeline authoring is a core platform capability, not a
  // premium add-on, unlike featureDnaReports/featureVoiceEnrollment.
  featurePaletteStt Boolean @default(true)

  // Does this plan include the harness AGENTIC LOOP (TASK-705)? Enforcing, not
  // display-only: `LoopContextSignalService` resolves it on every signal, and a
  // `false` here suppresses the ContextAdded / consultation-ending / loop-cancel
  // signals sent to `ConsultationLoopWorkflow`. `false` on STARTER (the loop is
  // a premium capability), `true` on TRIAL/PRO/ENTERPRISE. Composed with the
  // `consultation.loop.emergencyStop` kill-switch, which can only SUBTRACT.
  featureAgenticLoop Boolean @default(true)

  // model access tier (clone-subset, Q8) + rate-limit tier (Q7)
  modelTier     String @default("full")
  rateLimitTier String @default("default")

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("core")
}

// ---------------------------------------------------------------------------
// TenantEntitlement — per-tenant override (proposal Q1 / Q7). One row per
// tenant. Every limit/feature column is nullable: null = "inherit the plan
// default", a concrete value overrides it. Also carries the per-tenant
// rate-limit override ("increase on demand", Q7).
// ---------------------------------------------------------------------------
model TenantEntitlement {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi-tenant fields (one override row per tenant)
  tenantId String @unique

  // per-tenant limit overrides (null = inherit plan default)
  maxUsers           Int?
  maxDepartments     Int?
  maxPromptTemplates Int?
  maxAsrPipelines    Int?
  maxApiKeys         Int?
  storageQuotaBytes  BigInt?
  // Per-tenant override of `PlanEntitlement.maxWorkflowDefinitions` (null =
  // inherit the plan default).
  maxWorkflowDefinitions Int?

  // per-tenant concurrency override (null = inherit plan default) — "increase
  // on demand" for simultaneous active STT sessions.
  maxConcurrentSessions Int?

  monthlyConsultations        Int?
  monthlyTranscriptionMinutes Int?
  monthlySummaries            Int?
  // Per-tenant override of `PlanEntitlement.monthlyWorkflowInvocations` (null
  // = inherit the plan default).
  monthlyWorkflowInvocations Int?

  // Per-capability allowance overrides (null = inherit the plan default) —
  // the negotiated-allowance hook for an enterprise contract. Same units and
  // semantics as `PlanEntitlement`; see the commentary there.
  monthlySttSessionSeconds BigInt?
  monthlyLlmTokens         BigInt?
  monthlyTtsCharacters     BigInt?
  monthlyNlpTextUnits      BigInt?
  monthlyEmbeddingTokens   BigInt?

  // Optional TENANT-SET monthly spend ceiling in integer micros (D12). Distinct
  // from an allowance: allowances are what the PLAN includes, this is what the
  // TENANT is willing to spend beyond them. Exhausting it returns 402
  // (payment/credit) rather than 429 (throughput) or 409 (quantity quota).
  // `null` = no self-imposed limit, which is the default for every tenant.
  monthlySpendLimitMicros BigInt?

  // feature overrides (null = inherit)
  featureDnaReports       Boolean?
  featureVoiceEnrollment  Boolean?
  featureMonitoringAccess Boolean?

  // The per-tenant platform-default-credential grant, and the
  // ONLY way it is ever granted (no plan carries it — OD-7). Tri-state:
  //   null  = inherit the plan value (which is `false` on every seeded plan)
  //   true  = GRANT — this tenant's credential cascade may reach the SYSTEM tier
  //   false = explicit DENY, even if a plan row is later flipped on
  // A tenant's own DISABLED provider row remains a stronger, per-provider VETO
  // that this grant can never override.
  featurePlatformDefaultCredential Boolean?

  // Per-tenant override of PlanEntitlement.featurePaletteStt (null = inherit
  // the plan default, which is `true` on every seeded plan).
  featurePaletteStt Boolean?

  // Per-tenant override of PlanEntitlement.featureAgenticLoop (null = inherit
  // the plan default, which is `false` on STARTER and `true` elsewhere).
  featureAgenticLoop Boolean?

  // model + rate-limit overrides (null = inherit) — Q7 "increase on demand"
  modelTier          String?
  rateLimitTier      String?
  rateLimitPerMinute Int?

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId], name: "TenantEntitlement_tenantId_idx")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// TenantUsageMeter — rolling-monthly windowed consumption counter (proposal
// Q5). One row per (tenant, metric, window). `usedCount` is maintained by the
// rollover/reconcile job from Postgres aggregates (the source of truth, since
// Prometheus carries no tenantId). Windows are calendar months (UTC).
// ---------------------------------------------------------------------------
model TenantUsageMeter {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi-tenant fields
  tenantId String

  // windowed meter
  metric       UsageMeterMetric
  periodStart  DateTime
  periodEnd    DateTime
  // BigInt (follow-up #5): token/character meters accumulate monthly
  // per-tenant totals that overflow Int32 (~2.1B) for a heavy tenant. The meter
  // is a summed count, never negative, so the widened range is the only change.
  usedCount    BigInt    @default(0)
  reconciledAt DateTime?

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, metric, periodStart], name: "TenantUsageMeter_tenant_metric_period_unique")
  @@index([tenantId], name: "TenantUsageMeter_tenantId_idx")
  @@schema("core")
}

// ---------------------------------------------------------------------------
// TenantPlanHistory — append-only record of a tenant's plan over time
// (follow-up #6). Enables TRUE mid-period plan-fee proration (D15):
// the invoice engine's `computePlanFeeLines` is already multi-segment and
// golden-tested, so with a source of dated plan segments the engine bills
// `fee × ownedDays / periodDays` per segment instead of the whole-period
// `planFeeBasis: PERIOD_END_PLAN` approximation.
//
// POSTURE (the AiUsageEvent precedent): append-only FACTS, tenant-scoped, NO
// soft-delete lifecycle (no `resourceStatus`; listed in
// MODELS_WITHOUT_SOFT_DELETE) and NO sys-events on write (no ResourceType) —
// the plan-change itself broadcasts on the Tenant it mutates; this is its
// financial-history side-record. One row per plan the tenant has held:
// `effectiveFrom` inclusive, `effectiveTo` null = still in force. A period with
// no covering row simply has no plan fee (null-plan legacy tenants, D3).
// ---------------------------------------------------------------------------
model TenantPlanHistory {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // The plan in force over [effectiveFrom, effectiveTo). Only real plans are
  // recorded; removing a plan closes the current row and inserts nothing.
  plan          TenantPlan
  effectiveFrom DateTime
  effectiveTo   DateTime?
  // The plan this row replaced (null for a tenant's first plan). Audit only —
  // proration reads `plan` + the effective window.
  previousPlan  TenantPlan?
  // Bounded enum-ish label (initial | upgrade | downgrade | correction). Never
  // free text — this plane stays PHI-free like the rest of the billing plane.
  changeReason  String?

  // audit fields (no resource-status — append-only fact, see the header)
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId], name: "TenantPlanHistory_tenantId_idx")
  @@index([tenantId, effectiveFrom], name: "TenantPlanHistory_tenant_effectiveFrom_idx")
  @@schema("core")
}
