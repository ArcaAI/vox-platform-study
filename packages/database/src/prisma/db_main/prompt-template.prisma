// ============================================================================
// Prompt Template & Versioning
// Manages reusable prompt templates with version history for AI interactions
// ============================================================================

enum PromptTemplateCategory {
  SYSTEM
  SUMMARY
  DNA_ANALYSIS
  CUSTOM

  @@schema("core")
}

enum PromptTemplateScope {
  TENANT_DEFAULT
  DEPARTMENT_DEFAULT
  USER_PERSONAL

  @@schema("core")
}

enum PromptTemplateStatus {
  DRAFT
  PUBLISHED
  // APPROVED is a governance gate: a template is only resolvable for
  // clinical generation flows once a SUPER_ADMIN has approved it (prompt
  // publishing becomes approval-gated at resolution time).
  APPROVED

  @@schema("core")
}

model PromptTemplate {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Template content
  name        String
  description String?
  content     String                 @db.Text
  category    PromptTemplateCategory
  status      PromptTemplateStatus   @default(DRAFT)
  variables   Json?                  @db.JsonB

  // Quality/score testing — last text-scored test run.
  // The plaintext `lastTestOutput` column has been DROPPED; persisted as
  // Vault-Transit ciphertext only. (`content` is the prompt body and is NOT
  // encrypted — it remains a plaintext column.)
  lastTestScore  Float?
  lastTestAt     DateTime?

  // Data Encryption Initiative — Vault-Transit (hope-phi) ciphertext of the last
  // text-scored test output plus the shared Transit key version. This
  // ciphertext column is now the system of record.
  encryptedLastTestOutput Bytes?
  keyVersion              Int?

  // Version tracking
  currentVersionNumber Int @default(1)
  // Version snapshot pinned at last approval; null = never approved under this
  // scheme. Resolution serves THIS PromptVersion (not the mutable `content`
  // column / latest edit) for unpinned agents and the preferred/legacy/default
  // tiers, so a post-approval content edit accumulates un-served versions until
  // the next (eval-gated) re-approval. See PromptResolutionService.
  approvedVersionNumber Int?

  // Department assignment (optional)
  departmentId String?
  Department   Department? @relation(fields: [departmentId], references: [id])

  // Scope discriminator: tenant default vs department default vs user-personal overlay
  scope       PromptTemplateScope @default(TENANT_DEFAULT)
  ownerUserId String?
  Owner       User?               @relation("_User_OwnedPromptTemplates", fields: [ownerUserId], references: [id])

  // Resource status + Audit
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?
  createdBy               String?            @default("60000000-0000-0000-0000-000000000000")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Tags
  tags String[] @default([])

  // Relations
  Versions         PromptVersion[]
  DepartmentAgents DepartmentAgent[]

  // Constraints
  @@unique([tenantId, name])
  @@unique([tenantId, departmentId, ownerUserId, name], name: "PromptTemplate_scope_unique")
  // Indexes
  @@index([tenantId], name: "PromptTemplate_tenantId_idx")
  @@index([departmentId], name: "PromptTemplate_departmentId_idx")
  @@index([category], name: "PromptTemplate_category_idx")
  @@index([tenantId, scope], name: "PromptTemplate_tenantId_scope_idx")
  @@index([ownerUserId], name: "PromptTemplate_ownerUserId_idx")
  @@schema("core")
}

model PromptVersion {
  // Meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Parent template
  promptTemplateId String
  PromptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id])

  // Version content snapshot
  versionNumber Int
  content       String @db.Text
  variables     Json?  @db.JsonB

  // Change tracking
  changeReason String?
  changedBy    String?

  // Timestamps
  createdAt DateTime @default(now())

  // Constraints
  @@unique([promptTemplateId, versionNumber])
  // Indexes
  @@index([promptTemplateId], name: "PromptVersion_promptTemplateId_idx")
  @@schema("core")
}
