// ============================================================================
// Department Agent — first-class agent entity
//
// The DepartmentAgent is the first-class "agent" the catalog/console/marketing
// can name (admin vocabulary: Agent Template → Agent → Version → Default). One
// row binds a tenant department to:
//   - a PromptTemplate at a PINNED or TRACKED version (movable-pointer pattern:
//     `pinnedVersionNumber` null ⇒ track latest APPROVED; consumers resolve the
//     pointer, never the raw latest),
//   - a DNA-style gate (`dnaStylePolicy`),
// - (later) harness overrides (`harnessOverrides`, tenant-tier
//     HarnessPolicy keys only — validated in the application service),
// - (later) a golden set (`goldenSetId`).
//
// Template lineage columns (`sourceAgentTemplateSlug`, `templateLocked`) mirror
// the shipped AsrPipeline pattern; their CONSUMPTION lands in
// But the columns are provisioned now so no later migration is needed.
// `templateLocked` is deliberately absent from every request DTO, so the
// gateway's whitelist pipe rejects attempts to flip it over the API.
// ============================================================================

model DepartmentAgent {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // core (business) fields
  departmentId String
  Department   Department @relation(fields: [departmentId], references: [id])
  name         String
  slug         String
  description  String?

  // binding
  promptTemplateId    String
  PromptTemplate      PromptTemplate @relation(fields: [promptTemplateId], references: [id])
  pinnedVersionNumber Int? // null ⇒ track latest APPROVED version
  dnaStylePolicy      DepartmentAgentDnaPolicy @default(INHERIT) // INHERIT | DISABLED
  harnessOverrides    Json?  @db.JsonB // tenant-tier HarnessPolicy keys ONLY (validated in service)
  goldenSetId         String? // consumed by

  // ── Capability-keyed bindings (/ DR-1). ALL NULLABLE; null ⇒
  // the LEGACY behavior for that capability (base `promptTemplateId` for
  // summary, the tenant/SYSTEM tiers for pre-summary and live). Every existing
  // row is null on all six, so resolution is byte-identical to before.
  //
  // Loose `String` refs with NO FK relation — the legacy `Department` prompt-id
  // column precedent (department.prisma:21-23), NOT `promptTemplateId`'s FK.
  // Four named relations would put four back-relation arrays on PromptTemplate
  // for zero query benefit (bindings are read off the agent row, never joined).
  // Integrity is service-enforced (`DepartmentAgentService.assertTemplateBindable`
  // per binding) and resolver-enforced (unapproved / missing snapshot ⇒ the
  // agent tier falls through to the legacy chain).
  newPatientTemplateId String?
  revisitTemplateId    String?
  preSummaryTemplateId String?
  livePromptTemplateId String?
  // Which live-loop tools run for sessions under this agent:
  //   { version: 1, tools: { ner: {enabled}, vitals: {enabled}, groundedness: {enabled|null} } }
  // Null ⇒ the platform default (today's NER + vitals, groundedness per env).
  // Validated against LIVE_TOOL_KEYS in the application service; consumed by
  // the LiveToolRegistry.
  toolConfig Json? @db.JsonB
  // Optional per-task LLM override, keyed by the SmrRoutingTask subset:
  //   { live?: { aiModelSlug }, finalize?: { aiModelSlug } }   (OD-3b)
  // Validated against ENABLED TEXT_GENERATION AiModel rows at write time;
  // read-time precedence is agent override → tenant AiTaskDefault
  // (text.live / text.finalize) → fail-closed. NEVER one global field — a
  // low-latency live model must not silently drive finalize (RF-4).
  llmOverrides Json? @db.JsonB

  // one default agent per department
  isDefault Boolean @default(false)

  // template lineage (consumed by; columns land now)
  sourceAgentTemplateSlug String?
  templateLocked          Boolean @default(false)

  // ──: loop configuration + promotion surface. ALL NULLABLE (role
  // carries a DB default); every pre-existing row is null on the other six,
  // so resolution/behavior stays byte-identical to before this ticket.
  //
  // Loop role — see DepartmentAgentRole. Exactly one ENABLED PRIMARY per
  // department, enforced in the application service.
  role DepartmentAgentRole @default(SPECIALIST)
  // Context kinds (`kinds.key`) this agent listens for, with an
  // optional per-kind filter. Structural shape validated in
  // DepartmentAgentService; kind keys are additionally cross-checked against
  // the department's resolved ConsultationContextSchemaVersion when one
  // exists.
  //   { version: 1, kinds: [{ key: "referral_letter", filter?: {...} }] }
  subscribedKinds Json? @db.JsonB
  // Output kinds (`outputs.key`) this agent may produce. Same
  // cross-check as subscribedKinds.
  //   { version: 1, outputs: ["soap_note"] }
  writeScope Json? @db.JsonB
  // Constrained goal — deliberately NOT a free-text system prompt (D8): a
  // short, length-capped objective plus optional bounded success criteria.
  // Free-text prompt authoring stays where it already is — the
  // approval-gated PromptTemplate bound above.
  //   { version: 1, objective: "...", successCriteria?: ["..."] }
  goal Json? @db.JsonB
  // Named guardrail profile from a closed platform catalogue
  // (GUARDRAIL_PROFILE_KEYS). Placement, not permission (D9): the actual
  // clinical-safety enforcement runs at a boundary the agent cannot route
  // around — this column only SELECTS which profile that
  // boundary applies.
  guardrailProfile String?
  // Compliance envelope (D11 — no rule engine; subscriptions + goals with
  // always/never as the envelope). Each entry is one of AGENT_ACTION_KEYS;
  // the same key must never appear in both lists (validated in the service).
  //   ["harness.finalize"]
  alwaysActions Json? @db.JsonB
  neverActions  Json? @db.JsonB

  // relations
  Versions DepartmentAgentVersion[]

  // resource status fields
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // audit fields
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tags
  tags String[] @default([])

  // Constraints
  @@unique([tenantId, departmentId, slug], name: "DepartmentAgent_tenant_dept_slug_key")
  // Indexes
  @@index([tenantId], name: "DepartmentAgent_tenantId_idx")
  @@index([departmentId], name: "DepartmentAgent_departmentId_idx")
  @@index([promptTemplateId], name: "DepartmentAgent_promptTemplateId_idx")
  // Covers the hottest read: findDefaultForDepartment (one per prompt
  // resolution / policy overlay / harness start) filters
  // (tenantId, departmentId, isDefault).
  @@index([tenantId, departmentId, isDefault], name: "DepartmentAgent_tenantId_departmentId_isDefault_idx")
  @@schema("core")
}

// IMMUTABLE snapshot of a DepartmentAgent's loop-configuration surface
// the house governance triple applied to the
// agent: DepartmentAgent is the mutable head, this is the immutable version.
// Promotion copies the exact immutable version rather than
// re-authoring the target, and a running consultation loop pins
// `agentConfigVersionId` alongside `contextSchemaVersionId` at start (C1) — a
// mid-run edit to the agent must not change a run already underway. Written
// once by `DepartmentAgentService.create`/`update` and never updated after
// insert — a correction is a new version, exactly like PromptVersion /
// ConsultationContextSchemaVersion. No `resourceStatus`, no
// `updatedAt`/`updatedBy` by design (listed in MODELS_WITHOUT_SOFT_DELETE).
model DepartmentAgentVersion {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields
  tenantId String

  // parent agent
  agentId String
  Agent   DepartmentAgent @relation(fields: [agentId], references: [id])

  // core (business) fields
  versionNumber Int

  // Canonical (key-sorted, array-order-preserved) snapshot of the seven
  // loop-config fields on DepartmentAgent (role, subscribedKinds, writeScope,
  // goal, guardrailProfile, alwaysActions, neverActions) at the moment of
  // writing.
  configSnapshot Json @db.JsonB

  // sha256 over the canonical JSON of configSnapshot. Drives the
  // no-op-write guard (identical checksum ⇒ no new version).
  checksum String

  changeReason String?

  // audit fields (immutable row: no updatedAt/updatedBy by design)
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  createdAt DateTime @default(now())

  // constraints + indexes
  @@unique([agentId, versionNumber], name: "DepartmentAgentVersion_agent_versionNumber_unique")
  @@index([tenantId], name: "DepartmentAgentVersion_tenantId_idx")
  @@index([agentId], name: "DepartmentAgentVersion_agentId_idx")
  @@schema("core")
}

// IMMUTABLE, WORM record of one agent promotion from a source tenant into a
// target tenant. Promotion is admin-chosen, ANY tenant to ANY tenant
// there is no platform environment, tier or tenant-family
// concept, so "the actor holds manage rights on BOTH tenants" is the ENTIRE
// authorization control, enforced in `AgentPromotionService`.
//
// The row is written once and never updated — re-promoting writes a NEW row, so
// the table is the promotion history of an agent. No `resourceStatus` and no
// `updatedAt`/`updatedBy` (listed in MODELS_WITHOUT_SOFT_DELETE), the same
// shape as DepartmentAgentVersion / PromptVersion.
//
// OWNERSHIP: `tenantId` IS `toTenantId`. The promotion record is the TARGET's
// lineage, so the target tenant owns and reads it; `AgentPromotionEntity.validate()`
// enforces the equality so the two columns can never diverge.
//
// NO `@relation` ON ANY OF THE FOUR ID COLUMNS BELOW — deliberate. `agentVersionId`
// and `sourceAgentId` name rows in the SOURCE tenant; a Prisma relation would put
// a navigable path from a target-tenant row into another tenant's data on the
// model. The `tenantId` column's own no-FK convention is the precedent. Integrity
// is service-enforced at write time (both sides are loaded and authorized first).
model AgentPromotion {
  // meta fields
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // multi tenant fields — ALWAYS equal to toTenantId (see header)
  tenantId String

  // the promotion itself
  fromTenantId String
  toTenantId   String

  // SOURCE side: the exact immutable version that was promoted. Promotion
  // copies THIS snapshot rather than re-authoring the agent in the target —
  // the same discipline as the repo's own `promote-*` CI jobs, which re-tag a
  // digest rather than rebuild.
  agentVersionId String
  sourceAgentId  String

  // TARGET side: the agent row the promotion created or advanced, and the
  // immutable snapshot written there. This is the lineage a target-tenant
  // admin reads to answer "where did this agent come from".
  targetAgentId        String
  targetAgentVersionId String?

  // The promoted loop-config snapshot, verbatim, plus its sha256 over the
  // canonical JSON. Storing both makes the record self-contained (auditable
  // without resolving the source tenant at all) and makes drift detectable:
  // compare against the target agent's CURRENT checksum at read time.
  configSnapshot Json   @db.JsonB
  checksum       String

  // Eval attestations — TWO columns, deliberately never conflated:
  // "eval re-runs at the target tenant; the source EvalRun travels
  // as an attestation". `evalRunId` is the run executed AT THE TARGET against
  // the target's own corpus; `sourceEvalRunId` is the source-tenant run that
  // travelled as evidence only. GoldenCase rows hold Vault-Transit-encrypted
  // PHI and NEVER cross a tenant boundary — not even `goldenSetId` is copied.
  evalRunId       String?
  sourceEvalRunId String?

  // Non-blocking operator alerts issued at promotion time (e.g. "N consultations
  // are currently running on the previous version and will complete on it"),
  // recorded so the row shows what the operator was told.
  warnings Json? @db.JsonB

  // The actor. Named explicitly rather than leaning on `createdBy`, which
  // carries a system default and reads as "whoever inserted the row".
  promotedBy String?

  // audit fields (immutable row: no updatedAt/updatedBy by design)
  createdBy String?  @default("60000000-0000-0000-0000-000000000000")
  createdAt DateTime @default(now())

  // indexes — the target's lineage read (tenantId + targetAgentId) is the hot
  // one; fromTenantId supports "what did this tenant export".
  @@index([tenantId], name: "AgentPromotion_tenantId_idx")
  @@index([tenantId, targetAgentId], name: "AgentPromotion_tenantId_targetAgentId_idx")
  @@index([fromTenantId], name: "AgentPromotion_fromTenantId_idx")
  @@index([agentVersionId], name: "AgentPromotion_agentVersionId_idx")
  @@schema("core")
}
