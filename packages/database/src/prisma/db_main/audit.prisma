model AuditLog {
  // Meta fields (BaseEntity pattern)
  metaData Json?  @map("_metadata") @db.JsonB
  version  Int    @default(1) @map("_version")
  id       String @id @default(uuid(7))

  // Multi-tenant
  tenantId String

  // Actor information
  //
  // TASK-762 — an admin action may be performed by a HUMAN or by a platform-
  // issued MACHINE identity (`ServiceAccount`), never by both. Exactly one of
  // the two columns below is populated per row:
  //   - `responsibleUserId`          — an interactive human principal (JWT), or
  //                                    the human an API key is bound to.
  //   - `responsibleServiceAccountId`— a service-account principal.
  // Attributing a machine action to the human who happens to have issued the
  // credential is WRONG in a way a reviewer cannot detect, so the machine path
  // leaves `responsibleUserId` NULL rather than borrowing a person's identity.
  responsibleUserId           String?
  responsibleServiceAccountId String?
  responsibleIp               String?

  // Resource identification
  resourceType     ResourceType
  resourceId       String?
  resourceDatabase String?

  // Event correlation (for distributed tracing)
  correlationId String?
  causationId   String?

  // Action and event categorization
  action    AuditAction
  eventType String? // Categorizes audit events (e.g., 'AUTHORIZATION', 'RESOURCE', 'SYSTEM')
  success   Boolean? // Tracks success/failure of operations

  // Data payloads
  // Data Encryption Initiative Phase 3D — IMPLEMENTED (AuditLog is the highest-
  // volume write path, so a Vault Transit round-trip PER ROW is too costly):
  //   ENVELOPE ENCRYPTION with a cached Data Encryption Key (DEK). A DEK is
  //   generated once per process and wrapped ONCE via Vault Transit (hope-phi);
  //   the wrapped DEK + its Transit key version are persisted per row
  //   (`dekWrapped` / `dekKeyVersion`) so rows stay decryptable after rotation.
  //   Each row's `data`/`previousData` is encrypted LOCALLY with authenticated
  //   AES-256-GCM (the hardened CryptoService) into `encryptedData`/
  //   `encryptedPreviousData` — zero Vault calls on the hot path. Plaintext
  //   JSONB columns are RETAINED for the dual-read soak (reads decrypt with a
  //   plaintext fallback; removal is Phase 6, user-gated). `metadata` stays
  //   plaintext (non-PHI: ids/flags). (See plan Phase 3D "AuditLog".)
  data         Json  @db.JsonB
  previousData Json  @db.JsonB
  metadata     Json? @db.JsonB

  // Phase 3D additive envelope-encryption columns (all nullable; NULL on
  // historical/plaintext rows). `dekWrapped` is the Vault-wrapped DEK reference
  // (vault:vN:...) and `dekKeyVersion` is the Transit key version that wrapped it.
  encryptedData         Bytes?
  encryptedPreviousData Bytes?
  dekWrapped            String?
  dekKeyVersion         Int?

  // Resource status (standard fields)
  resourceStatus          ResourceStatusType @default(ENABLED)
  resourceStatusUpdatedAt DateTime?
  resourceStatusUpdatedBy String?

  // Audit fields
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // =============================================================================
  // INDEXES - Optimized for high-performance querying
  // =============================================================================

  // Primary query patterns
  @@index([tenantId], name: "AuditLog_tenantId_idx")
  @@index([createdAt], name: "AuditLog_createdAt_idx")
  @@index([responsibleUserId], name: "AuditLog_responsibleUserId_idx")
  @@index([responsibleServiceAccountId], name: "AuditLog_responsibleServiceAccountId_idx")
  // Resource-based queries
  @@index([resourceType, resourceId], name: "AuditLog_resource_idx")
  @@index([action, resourceType], name: "AuditLog_action_resource_idx")
  // Event categorization queries
  @@index([eventType], name: "AuditLog_eventType_idx")
  @@index([success], name: "AuditLog_success_idx")
  // Distributed tracing
  @@index([correlationId], name: "AuditLog_correlationId_idx")
  // Composite indexes for common query patterns
  @@index([tenantId, createdAt], name: "AuditLog_tenant_createdAt_idx")
  @@index([tenantId, resourceType, createdAt], name: "AuditLog_tenant_resource_time_idx")
  @@index([eventType, responsibleUserId, createdAt], name: "AuditLog_event_user_time_idx")
  @@index([tenantId, eventType, success, createdAt], name: "AuditLog_tenant_event_success_time_idx")
  // Additional indexes for high-performance querying
  @@index([tenantId, action, createdAt], name: "AuditLog_tenant_action_time_idx")
  @@index([resourceId], name: "AuditLog_resourceId_idx")
  @@schema("core")
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  ARCHIVE
  LOGIN
  LOGOUT
  IMPERSONATED_ACTION

  @@schema("core")
}

enum ResourceType {
  // AUDIT LOG

  AuditLog

  // CORE

  ApiKey
  Department
  GlobalSetting
  IntegrationPackage
  IntegrationItem
  Media
  Notification
  ResourceSubscription
  Role
  Permission
  RolePermission
  Tag
  Tenant
  UserRoleAssignment
  User
  UserSettings
  UserProfile
  UserMedia
  Webhook
  WebhookRunHistory

  // CONSULTATION

  Consultation
  ContextItem
  ContextItemVersion
  AudioRecording
  SummaryMeta
  NamedEntity

  // STT / AI

  AsrPipeline
  AiModel
  TranscriptionJob

  // PROMPT / DNA

  PromptTemplate
  DnaWritingStyleReport

  // STORAGE

  TenantBucket
  StorageAccessKey
  TenantStorageConfig

  // Reconciles the DB enum with the application `ResourceType` enum.
  // These values are emitted as audit `resourceType` by their services'
  // `broadcastSysEvent(...)` calls but were missing from the database enum,
  // causing every AuditLog write (and therefore the originating mutation) to
  // fail with "Invalid value for argument `resourceType`". Appended in
  // declaration order so the schema matches the append-only ADD VALUE
  // migration and Postgres enum sort order.
  Highlight
  AsrPipelineVersion
  UserVoiceProfile
  UserDepartment
  TenantFrontendConfig
  TenantTtsConfig
  // Tenant-scoped external identity provider (OIDC).
  TenantIdentityProvider
  FederatedIdentity
  // Per-tenant default model per AI task.
  AiTaskDefault
  // MCP external-tools registry.
  McpServer
  // Config-plane core: provider endpoints/credentials and runtime
  // hyperparameter profiles. Emitted as audit `resourceType` by
  // AiProviderConnectionService / AiRuntimeProfileService broadcastSysEvent.
  AiProviderConnection
  AiRuntimeProfile
  // Gate-edit mining store; the mining job broadcasts
  // ResourceCreated per persisted exemplar.
  GateEditExemplar
  // First-class department agent entity: binds a department to a
  // prompt template at a pinned/tracked version. Emitted as audit
  // `resourceType` by DepartmentAgentService.broadcastSysEvent.
  DepartmentAgent
  // Eval run: the eval-gated-promotion runner broadcasts
  // ResourceCreated per persisted EvalRun.
  EvalRun
  // Per-tenant STT fallback config.
  // Emitted as audit `resourceType` by TenantSttConfigService.broadcastSysEvent.
  TenantSttConfig
  // HARMLESS-UNUSED: the `TenantSttProviderCredential` table was
  // DROPPED (credential rows now live in the unified `AiProviderConnection`
  // plane, service='stt') but this enum VALUE is kept — Postgres cannot
  // cheaply drop a value already used by historical rows in this column, and
  // the domains-layer `ResourceType` TS enum must stay in parity with this
  // one (resourceType.enum-parity.test.ts). Never emitted again.
  TenantSttProviderCredential
  // CORS control plane: tenant-owned browser origin registry.
  // Emitted as audit `resourceType` by TenantAllowedOriginService.broadcastSysEvent.
  TenantAllowedOrigin

  // USAGE METERING + BILLING.
  //
  // Only the three ADMIN-MANAGED models of the metering/billing plane appear
  // here — these are the mutations a compliance reviewer or a billing dispute
  // actually needs a trail for:
  //   - AiPriceBook: SUPER_ADMIN rate-card edits (both COST and SELL planes).
  //   - BillingInvoice: draft computation, finalize (the immutability
  //     transition), void.
  //   - BillingAdjustment: issuing a credit memo against a finalized period.
  //
  // DELIBERATELY ABSENT: AiUsageEvent, AiUsageOutbox, AiUsageRollupHourly/Daily
  // and BillingInvoiceLine. The ledger and its derivatives are append-only
  // per-request telemetry (the AgentTrajectoryStep precedent) — emitting a
  // sys-event per metered provider call would flood the audit trail at request
  // volume with rows carrying no compliance meaning, and the ledger IS its own
  // evidence. Invoice LINES are written as part of the invoice aggregate, whose
  // own event already covers them.
  AiPriceBook
  BillingInvoice
  BillingAdjustment

  // Service Version & Release Registry. Only the first
  // registration of a previously-unseen ServiceRelease broadcasts
  // ResourceCreated — heartbeats and ServiceInstance upserts deliberately do
  // NOT (~15 processes heartbeating every 5
  // minutes would otherwise flood the audit trail with ~4,300 noise rows/day).
  // ChangelogEntry create/update/publish and UserChangelogAcknowledgement are
  // included for parity with their sys-event-emitting services (W7/W13,
  // outside this unit's scope).
  ServiceRelease
  ServiceInstance
  ChangelogEntry
  UserChangelogAcknowledgement

  // Consultation context schema. The MUTABLE head row is the
  // audited resource — create / update / publish / pin / delete all broadcast
  // against it, so a reviewer sees one lifecycle per schema rather than one
  // per snapshot. `ConsultationContextSchemaVersion` is DELIBERATELY ABSENT:
  // an immutable version row is written as part of the publish of its parent
  // aggregate and has no lifecycle of its own — the `PromptVersion` /
  // `AsrPipelineVersion` / `DnaWritingStyleVersion` precedent, none of which
  // is a ResourceType. Adding one later means adding it to BOTH enums plus an
  // `ALTER TYPE ... ADD VALUE` migration (resourceType.enum-parity.test.ts).
  ConsultationContextSchema

  // Agent promotion between tenants. UNLIKE the immutable version
  // rows above, this one IS its own audited resource: it has a lifecycle of
  // its own (one promotion is one event, not a side effect of some other
  // aggregate's write), it crosses a tenant boundary, and
  // `AgentPromotionService` broadcasts `ResourceCreated` against it. A
  // cross-tenant privileged write is exactly the thing an auditor needs to be
  // able to enumerate.
  AgentPromotion

  // Workflow definition (TASK-715). The row IS the audited resource — its
  // rows ARE versions (no separate head/version split; see
  // workflow-definition.prisma), so create / update / validate / publish /
  // activate / deprecate / delete all broadcast against this single
  // ResourceType, mirroring the ConsultationContextSchema precedent where
  // only the mutable aggregate — never a would-be immutable snapshot row —
  // is a ResourceType.
  WorkflowDefinition

  // Consent & ABAC (TASK-712). Emitted as audit `resourceType` by
  // ConsentGrantService.broadcastSysEvent on create/revoke. Deliberately
  // routed through the standard AuditLog sys-event pipeline rather than the
  // HarnessAuditEvent WORM ledger — see
  // docs/implementation/TASK-712-Consent-Abac/consent-design.md §6.
  ConsentGrant

  // Workflow test fixture (TASK-721). Per-tenant saved synthetic
  // Workbench inputs — ordinary CRUD (create/update/delete broadcast), NOT
  // telemetry, so unlike its sibling WorkflowRun it DOES need a ResourceType
  // (rule 03 step 4: the entry is conditioned on sys-event emission, and
  // WorkflowTestFixtureService broadcasts on every mutation).
  WorkflowTestFixture

  // Tenant NLP task instructions (TASK-729). Tenant-writable topic/intent
  // instruction content for `nlp.topic`/`nlp.intent` — deliberately separate
  // from AiTaskDefault's model-selection governance (see
  // tenant-nlp-task-instructions.prisma). Emitted as audit `resourceType` by
  // TenantNlpTaskInstructionsService.broadcastSysEvent.
  TenantNlpTaskInstructions

  // Institutional-RAG knowledge document (TASK-728). The
  // `KnowledgeDocument` head row is the audited resource — register / approve
  // / archive / delete all broadcast against it, mirroring the
  // ConsultationContextSchema precedent. `KnowledgeChunk` is DELIBERATELY
  // ABSENT as its own ResourceType: chunk rows are written as a side effect of
  // their parent document's ingest (no lifecycle of their own), and a chunk
  // LIST READ is audited under the parent KnowledgeDocument's resourceType +
  // resourceId (see knowledge-document.service.ts#listChunks).
  KnowledgeDocument

  // Platform-issued machine identity for administration (TASK-762). The
  // THIRD credential class: not a tenant API key (`ApiKey`) and not the
  // shared peer-service token, which the TASK-708 §6 owner ruling forbids
  // extending to `/admin/*`. Issued SUPER_ADMIN-only; every issuance,
  // rotation and revocation broadcasts against this resourceType.
  ServiceAccount

  // Per-scope workflow assignment (TASK-733). WHICH workflow definition
  // governs a tenant/department for a palette — a governance act distinct
  // from the definition it points at, so it is its own audited resource
  // (WorkflowAssignmentService broadcasts on create/update/delete). Its
  // append-only sibling WorkflowAssignmentChange is DELIBERATELY ABSENT as
  // its own ResourceType: change rows are written as part of the assignment
  // mutation they record, exactly as PipelinePolicyChange is.
  WorkflowAssignment

  @@schema("core")
}
