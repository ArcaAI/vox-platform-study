# PgBouncer validation rig environment (TASK-302 Stream C Phase 1)
#
# Copy to `.env` in the same directory before running `pnpm pgbv:test`.
# These URLs point at the Compose stack in this folder (`pnpm pgbv:up`).
#
# DATABASE_URL is what Prisma 7's `PrismaPg` adapter opens against — i.e. the
# pooler. DIRECT_URL is the un-pooled path, consumed by Prisma Migrate (per
# Phase 0 `prisma.config.ts` rules) and by tests that need to bypass the
# pooler (e.g. SHOW POOLS verification using pg directly).

DATABASE_URL="postgres://hope_app:hope_app_local@127.0.0.1:6532/hope?sslmode=disable"
DIRECT_URL="postgres://hope_app:hope_app_local@127.0.0.1:5532/hope?sslmode=disable"

# Match the Compose-time pool sizing assumptions.
# Budget rule (Phase 0): pods × PRISMA_PG_MAX ≤ 0.7 × PG max_connections.
# Rig: 1 vitest process × 10 ≤ 0.7 × 200  →  10 ≤ 140  ✅
PRISMA_PG_MAX=10

NODE_ENV=test
