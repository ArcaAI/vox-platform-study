{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./base.json",
    "Display": "Vite",
    "compilerOptions": {
        "allowJs": false,
        "esModuleInterop": false,
        "jsx": "react",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "module": "ESNext",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": false,
        "target": "ESNext",
        // Re-states "node" because `types` REPLACES the inherited array rather than
        // merging with base.json's. Dropping it costs `process` / `node:*` globals.
        "types": [
            "node",
            "vite/client"
        ]
    }
}