{
  "name": "@arcaai/med-ner",
  "version": "2.0.1",
  "description": "Medical Named Entity Recognition plugin for @arcaai/room using Transformers.js",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-server": "./dist/react-server-stub.mjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "import": "./dist/workers/medner.worker.js",
      "default": "./dist/workers/medner.worker.js"
    }
  },
  "files": [
    "dist",
    "!dist/e2e",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm build && playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "pnpm build && playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:chromium": "pnpm build && playwright test --config=e2e/playwright.config.ts --project=chromium",
    "e2e:serve": "node e2e/serve.mjs"
  },
  "keywords": [
    "medical",
    "ner",
    "named-entity-recognition",
    "nlp",
    "transformers",
    "huggingface",
    "healthcare",
    "biomedical",
    "clinical",
    "arcaai",
    "room"
  ],
  "author": "ARCAAI",
  "license": "MIT",
  "peerDependencies": {
    "@arcaai/room": "^0.1.0",
    "react": "^18.3.0 || ^19.0.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@arcaai/room": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaAI/project-hope.git"
  },
  "type": "module"
}
