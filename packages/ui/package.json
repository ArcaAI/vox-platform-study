{
  "name": "@arcaai/ui",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./globals.css": "./src/styles/globals.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components/shared": {
      "types": "./dist/components/shared/index.d.ts",
      "import": "./dist/components/shared/index.mjs",
      "require": "./dist/components/shared/index.js"
    },
    "./components/metrics": {
      "types": "./dist/components/metrics/index.d.ts",
      "import": "./dist/components/metrics/index.mjs",
      "require": "./dist/components/metrics/index.js"
    },
    "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
    "./*": "./src/*.tsx"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css",
    "check-types": "tsc --noEmit",
    "dev": "tsup --watch --onSuccess 'tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css'",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --max-warnings 0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "test:ct:ui": "playwright test -c playwright-ct.config.ts --ui",
    "test:ct:debug": "playwright test -c playwright-ct.config.ts --debug",
    "test:ct:report": "playwright show-report test-results/html",
    "test:all": "vitest run && playwright test -c playwright-ct.config.ts"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
