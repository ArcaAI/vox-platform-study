{
  "name": "@arcaai/types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for ArcaAI/HOPE",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "arcaai",
    "types",
    "typescript"
  ],
  "author": "ArcaAI Team",
  "license": "MIT"
}
