{
  "name": "@arcaai/pipeline",
  "version": "3.0.0",
  "description": "Pipeline infrastructure for sequential and parallel processing with state management",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "pnpm build && playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "pnpm build && playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:chromium": "pnpm build && playwright test --config=e2e/playwright.config.ts --project=chromium"
  },
  "keywords": [
    "pipeline",
    "processing",
    "sequential",
    "parallel",
    "orchestration",
    "state-management"
  ],
  "author": "ARCAAI",
  "license": "MIT",
  "dependencies": {
    "eventemitter3": "^5.0.4"
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@playwright/test": "^1.62.1",
    "http-server": "^14.1.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaAI/project-hope.git"
  },
  "type": "module"
}
