{
  "name": "@arcaai/domains",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@arcaai/database": "workspace:*",
    "@arcaai/exceptions": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "nestjs-cls": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
