{
  "name": "@arcaai/vox-node",
  "version": "3.6.0",
  "description": "HOPE server-side Node SDK — non-browser client for the HOPE gateway (summarization, consultations, jobs)",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo tsconfig.tsbuildinfo",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check:exports": "attw --pack . && publint",
    "gen:admin": "tsx ../vox-node-codegen/src/cli.ts",
    "gen:admin:check": "tsx ../vox-node-codegen/src/cli.ts --check"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@arcaai/types": "workspace:*",
    "@arcaai/vox-node-codegen": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^26.5.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "arcaai",
    "hope",
    "vox",
    "sdk",
    "node",
    "server"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaAI/project-hope.git"
  }
}
