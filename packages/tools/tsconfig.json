{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    // `packages/` — not `./src` — because src/utils/loadEnv.ts imports the
    // dependency-free env-file resolver from
    // `packages/applications/src/common/env` by source path (see that file for
    // why this package must not take a package dependency on @arcaai/applications).
    // This package has no `build` script; `typecheck` runs with --noEmit and
    // ts-node compiles in memory, so rootDir only affects TS6059 here.
    "rootDir": ".."
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}