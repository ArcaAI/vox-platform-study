{{#if enumValues.length}}

export enum {{className}} {
    {{#each enumValues}}
    {{#if comment}}
    {{{comment}}}
    {{/if}}
    {{name}} = '{{name}}',
    {{/each}}
}

{{else if baseModel}}

{{#if relationFields.length}}
import { {{baseModel}}, VirtualDbProperty } from '../../../common';{{else}}import { {{baseModel}} } from '../../../common';{{/if}}
import { JsonValue } from '../../../interfaces';
import * as Enums from '../../../enums';
import * as Models from './';

{{#if classDoc}}
{{{classDoc}}}
{{/if}}
export class {{className}} extends {{baseModel}} {
    {{#each scalarFields}}
    {{#if comment}}
    {{{comment}}}
    {{/if}}
    public {{name}}: {{type}};
    {{/each}}
    {{#each relationFields}}
    @VirtualDbProperty()
    public {{name}}: {{type}} | undefined;
    {{/each}}

    constructor(data: {{className}} & {{baseModel}}) {
        super(data);
        {{#each scalarFields}}
        this.{{name}} = {{{init}}};
        {{/each}}
        {{#each relationFields}}
        this.{{name}} = data.{{name}};
        {{/each}}
    }
}

{{else}}

