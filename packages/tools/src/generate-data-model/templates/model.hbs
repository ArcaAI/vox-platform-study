{{#if classDoc}}
{{{classDoc}}}
{{/if}}
export class {{className}} {
    {{#each scalarFields}}
    {{#if comment}}
    {{{comment}}}
    {{/if}}
    public {{name}}: {{type}};
    {{/each}}
    {{#each relationFields}}
