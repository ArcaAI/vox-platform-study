    "generate-data-entity:check": "ts-node src/generate-data-entity/index.ts --check",
    "generate-mapper": "ts-node src/generate-mapper/index.ts",
    "generate-repository": "ts-node src/generate-repository/index.ts --overwrite true",
    "generate-factory": "ts-node src/generate-factory/index.ts",
    "generate-factory:all": "ts-node src/generate-factory/index.ts --yes",
    "generate-factory:check": "ts-node src/generate-factory/index.ts --check",
    "generate-service-module": "ts-node src/generate-service-module/index.ts",
    "generate-controller": "ts-node src/generate-controller/index.ts",
    "gen-dev-token": "ts-node src/gen-dev-token/index.ts",
    "gen-api-key": "ts-node src/gen-api-key/index.ts create"
