  "scripts": {
    "prisma-commander": "ts-node src/prisma-commander/index.ts",
    "generate-prisma-index": "ts-node src/generate-prisma-index.ts",
    "generate-data-model": "ts-node src/generate-data-model/index.ts --overwrite true",
