# Dependencies (installed inside the container)
node_modules
**/node_modules

# Build outputs (rebuilt inside the container)
**/dist
**/.next
**/storybook-static
# TypeScript incremental-build cache — must be excluded alongside dist. A host-stale
# buildinfo makes `@arcaai/types`' `tsc --build` trust it and SKIP emit, so
# packages/types/dist is never regenerated in-container and @arcaai/applications fails
# with TS2307: Cannot find module '@arcaai/types'. Excluding it forces a clean emit.
**/*.tsbuildinfo

# Version control
.git
.gitignore

# IDE / OS
.vscode
.idea
**/.DS_Store

# CI/CD
.gitlab-ci.yml

# Documentation & config not needed in builds
*.md
LICENSE
docs/
knowledge/
research/

# Environment files
.env
.env.*
!.env.example

# Test artifacts
coverage/
**/coverage
**/__tests__
**/*.test.*
**/*.spec.*

# Turborepo
.turbo

# Python caches (for nlp/smr apps)
**/__pycache__
**/*.pyc
**/.venv
**/venv

# Misc
.github
