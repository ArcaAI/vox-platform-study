  "cards": [
    {
      "dot": "rose",
      "title": "Three gaps block every call",
      "items": [
        "Wrong path: NLP posts to /generate; text serves /api/v1/generate (harness adds /api/v1 itself)",
        "No model: text has no default model and NLP's topic/intent schema has no model field",
        "No provider_overrides: text holds no LLM endpoint or key; the gateway must inject them"
      ]
    },
    {
      "dot": "amber",
      "title": "Smaller risks once fixed",
      "items": [
        "LLM output is returned verbatim, not matched to the topic list",
        "Patient text sits inside the prompt with no system prompt (prompt injection)",
        "NLP retries 404 and 422, which can never succeed"
      ]
    },
    {
      "dot": "slate",
      "title": "Evidence",
      "items": [
        "Reproduced locally: NLP log shows 3 attempts, each 404 on /generate",
        "Direct call to /api/v1/generate without model returned 422",
        "NLP tests mock the text client, so these gaps were not caught"
      ]
    }
  ]
