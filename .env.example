# ============================================================================
# HOPE Platform - Environment Configuration Example
# ============================================================================
# This file contains all environment variables for the HOPE monorepo.
#
# ENVIRONMENT FILE CONVENTION:
#   - .env.dev        → Local development (NODE_ENV=development)
#   - .env.test       → Local testing (NODE_ENV=test)
#   - .env.production → Production template (NODE_ENV=production uses host env)
#   - .env            → Fallback for backwards compatibility (deprecated)
#
# USAGE:
#   1. Copy this file to .env.dev: cp .env.example .env.dev
#   2. Update the values marked with <CHANGE_ME> or your-*-here
#   3. For sensitive values, use environment variables directly (not files)
#
# LOADING PRIORITY:
#   - Host environment variables ALWAYS have highest priority
#   - Local Development: Loads from .env.dev (falls back to .env)
#   - Local Testing: Loads from .env.test (via dotenv-cli)
#   - CI/CD: Uses only host environment variables (no files loaded)
#   - Production: Uses only host environment variables (no files loaded)
#
# TESTING:
#   Tests use .env.test which has ISOLATED infrastructure (different ports):
#   - PostgreSQL: 5433 (dev uses 5432)
#   - Redis: 6380 (dev uses 6379)
#   - MinIO: 9002 (dev uses 9000)
#
#   Run tests with: pnpm test:unit / pnpm test:integration / pnpm test:e2e
#
# ============================================================================

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================
NODE_ENV=development
DEBUG=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
#
# TASK-302 Stream C Phase 2A: production uses PgBouncer in transaction mode.
# The DATABASE_URL / DIRECT_URL split is now MANDATORY in prod/staging.
#
#   DATABASE_URL  → runtime queries through pgbouncer (port 6432, txn mode)
#   DIRECT_URL    → migrations only; un-pooled (port 5432 direct, or 5000
#                   HAProxy R/W). Prisma Migrate's advisory locks do not
#                   survive transaction-mode pooling.
#
# resolveMigrationUrl (packages/database/src/migration-url.ts) implements
# the selection — prisma.config.ts reads DIRECT_URL ?? DATABASE_URL.
#
# Local dev (no pooler in path): set DATABASE_URL to your direct PG and
# leave DIRECT_URL unset. The same DATABASE_URL is used for both.
#
# Examples by environment:
#   Local dev:    postgres://postgres:postgres@localhost:5432/hope
#   Docker:       postgres://postgres:postgres@postgres:5432/hope
#   HA direct:    postgresql://hope_app:<pwd>@10.10.1.250:5000/hope?sslmode=require
#   HA pooled:    postgresql://hope_app:<pwd>@10.10.1.250:6432/hope?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hope

# Legacy alias; kept as a back-compat documentation marker — not consumed
# at runtime. Use DIRECT_URL (canonical) for new configurations.
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/hope

# ── Direct (un-pooled) connection — REQUIRED in prod/staging post-Phase 2A ──
# Set to the un-pooled endpoint when DATABASE_URL targets pgbouncer (6432).
# Consumed by prisma.config.ts → resolveMigrationUrl() for Prisma Migrate.
# Example (HA cluster with PgBouncer in front):
#   DIRECT_URL=postgresql://hope_app:<password>@10.10.1.250:5000/hope?sslmode=require
# DIRECT_URL=

# ── Prisma adapter pool (Phase 0 of TASK-302 Stream C) ──
# Per-pod connection pool size. Default 5 in packages/database/src/client.ts.
# Budget rule: pods * PRISMA_PG_MAX <= 0.7 * PG max_connections
# (At max_connections=200, max=5 supports up to ~28 simultaneous pods.)
PRISMA_PG_MAX=5

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Application password (used by Node.js/Python services)
REDIS_PASS=
# Full Redis URL (alternative to host/port/pass)
REDIS_URL=redis://localhost:6379

# =============================================================================
# LOGGING CONFIGURATION (Shared across all services)
# =============================================================================
# Log levels: debug, info, warn, error (Node.js) / DEBUG, INFO, WARNING, ERROR (Python)
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=100
LOG_FILE_DATE_PATTERN=YYYY-MM-DD
LOG_FILE_SEPARATE_ERROR=false
# Enables NestJS's own internal debug logger (@nestjs/core), separate from the general DEBUG above.
NEST_DEBUG=false
# Overrides the auto-detected env file path used by pydantic-settings/dotenv loaders.
ENV_FILE_PATH=

# =============================================================================
# OPENTELEMETRY CONFIGURATION (Shared across all services)
# =============================================================================
OTEL_SERVICE_NAMESPACE=hope
OTEL_SERVICE_VERSION=1.0.0
# Telemetry export is OPT-IN (TASK-411): leave empty unless an OTLP collector
# is running — dev has none by default (see infrastructure/docker/README.md,
# "Observability" section). Example: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false
# Prefix applied to the simplified in-process metrics fallback (used when OTEL
# metrics export is disabled); how often it collects, in ms.
METRICS_PREFIX=hope
METRICS_COLLECT_INTERVAL=15000
# Prometheus server URL, only needed for services that query Prometheus directly
# (packages/applications platform-metrics) rather than just exposing /metrics.
PROMETHEUS_URL=http://localhost:9090

# =============================================================================
# MINIO / S3 CONFIGURATION (Shared across services)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_admin
MINIO_USE_SSL=false

# =============================================================================
# API GATEWAY SERVICE (apps/api)
# =============================================================================
# Server
# Base URL internal service-discovery defaults are built from (packages/applications
# baseServices/_meta/config.service.ts) — distinct from the browser-facing API_URL below.
URL=http://localhost
API_PORT=8868
API_URL=http://localhost:8868

# Session & Security
SESSION_SECRET_KEY=<CHANGE_ME>-session-secret-key
JWT_SECRET=<CHANGE_ME>-jwt-secret-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=<CHANGE_ME>-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
# Canonical secret name resolved through SecretsService/Vault at boot
# (apps/api/src/bootstrap/jwt-secret-placeholder-audit.ts); falls back to a
# dev-only literal when unset.
JWT_SECRET_KEY=<CHANGE_ME>-jwt-secret-key

# Refresh token lifetime, in seconds. Unset uses the service default.
REFRESH_TOKEN_TTL_SECONDS=

# Rate limiting (apps/api throttler)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000
SHUTDOWN_DRAIN_DELAY_MS=1000

# =============================================================================
# ADMIN CONSOLE (apps/admin-console)
# =============================================================================
# Session-cookie encryption secret (>= 32 chars).
ADMIN_SESSION_SECRET=<CHANGE_ME>-admin-console-session-secret-32chars
# Gateway origin the BROWSER connects to directly for SSE/WS streams.
NEXT_PUBLIC_API_HOST=http://localhost:8868

# CORS (for production, set specific origins)
CORS_ALLOWED_ORIGINS=*

# MQTT (if used)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Sentry (optional)
SENTRY_DSN_API=

# Prisma Studio (embedded database browser at /api/pstudio)
# Set to 'true' to enable, 'false' to disable. Defaults to enabled in non-production.
ENABLE_PRISMA_STUDIO=true

# API Key Security
# HMAC-SHA256 pepper for API key hashing (defense-in-depth).
# When set, API keys are hashed with HMAC-SHA256 using this pepper as the secret.
# When unset, falls back to plain SHA-256 (backward compatible).
# IMPORTANT: Changing this value invalidates ALL existing API keys.
API_KEY_PEPPER=<CHANGE_ME>-api-key-pepper-secret

# Allow API keys to be passed via query parameter (?apiKey=...).
# Default: false (disabled). Query parameter keys appear in server logs, browser
# history, and proxy logs. Only enable for development/debugging.
API_KEY_ALLOW_QUERY_PARAM=false

# Maximum API key lifetime in days. When set, keys without an explicit expiresAt
# are auto-expired after this many days. Keys with expiresAt beyond this limit
# are rejected. When unset, no lifetime enforcement is applied.
API_KEY_MAX_LIFETIME_DAYS=365

# =============================================================================
# STT SERVICE (apps/stt-v2) - Speech-to-Text V2
# =============================================================================
# Azure Speech Service (used by STT-V2)
AZURE_SPEECH_KEY=<CHANGE_ME>-your-azure-speech-key
AZURE_SPEECH_REGION=eastus
# TASK-505 P3 — Azure AI Foundry MAI-Transcribe (D4: preview, batch-only, off by default)
AZURE_FOUNDRY_ENABLED=false
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=mai-transcribe-1.5
# TASK-505 P3 — parakeet.cpp ggml runtime
PARAKEET_CPP_LIBRARY_PATH=
PARAKEET_CPP_NUM_THREADS=4
WHISPER_CPP_LIBRARY_PATH=
WHISPER_CPP_NUM_THREADS=4

# STT-specific MinIO bucket
STT_MINIO_BUCKET=recordings

# =============================================================================
# STT-V2 SERVICE (apps/stt-v2) - Speech-to-Text V2 Configuration
# =============================================================================
# Multi-model ASR with VAD, diarization, and real-time streaming.
#
# SETUP: See apps/stt-v2/README.md for conda environment instructions.
# INFRA: Requires PostgreSQL, Redis, MinIO, and Qdrant running.
#
# Start infrastructure:
#   docker compose -f infrastructure/docker/docker-compose.yml \
#                  -f infrastructure/docker/docker-compose.dev.yml up -d

# Server
STT_V2_HOST=0.0.0.0
STT_V2_PORT=8861
STT_V2_LOG_LEVEL=INFO
# Gateway-side base URL for the service (read by @arcaai/applications:
# config.service.ts, pipeline.service.ts, serviceHealthMonitoring.service.ts).
STT_V2_URL=http://localhost:8861

# --- Semantic Endpointing (TASK-473 A3, streaming hot path) ---
# Content-driven end-of-utterance detection that augments the fixed Silero-VAD
# silence offset. Default OFF — the streaming preprocessor keeps the fixed timer
# until this is enabled and measured on the TASK-470 scorecard. Self-hosted only
# (no cloud endpointing vendor). MODEL_ID empty = model-free heuristic core.
SEMANTIC_ENDPOINT_ENABLED=false
SEMANTIC_ENDPOINT_MIN_SILENCE_MS=200
SEMANTIC_ENDPOINT_MAX_SILENCE_MS=500
SEMANTIC_ENDPOINT_CONFIDENCE_THRESHOLD=0.85
SEMANTIC_ENDPOINT_MIN_WORDS=3
SEMANTIC_ENDPOINT_MODEL_ID=

# --- Qdrant (Vector Store for Speaker Embeddings) ---
# Used by the diarization module to store and search 512-dim speaker embeddings.
# Qdrant is started via docker-compose.dev.yml on port 6333.
# QDRANT_URL is defined once in the Docker Compose section below.
QDRANT_COLLECTION_SPEAKERS=stt_speaker_embeddings
QDRANT_POOL_SIZE=20
QDRANT_TIMEOUT=30

# --- Voice Activity Detection (Silero VAD v5 ONNX) ---
# The ONNX model is auto-downloaded on first startup if VAD_MODEL_PATH is empty.
VAD_MODEL_PATH=
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=100
VAD_MIN_SILENCE_DURATION_MS=500
VAD_SPEECH_PAD_MS=200
VAD_SAMPLE_RATE=16000

# --- Speaker Diarization (wespeaker Embedding, CC-BY-4.0) ---
DIARIZATION_HF_MODEL_ID=pyannote/wespeaker-voxceleb-resnet34-LM
DIARIZATION_SIMILARITY_THRESHOLD=0.7
DIARIZATION_DEVICE=auto

# --- Worker & Inference ---
WORKER_THREADS=4
WORKER_TIMEOUT_MS=600000
WORKER_MAX_RETRIES=3
INFERENCE_POOL_SIZE=0

# --- HuggingFace ---
HUGGINGFACE_TOKEN=
HUGGINGFACE_CACHE_DIR=

# --- MLFlow (Reserved — not yet implemented) ---
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_REGISTRY=

# =============================================================================
# GUARDRAIL SERVICE (apps/guardrail) - Safety / PII engine
# =============================================================================
# Gateway-facing downstream URL (Guardrail listens on 8863). See
# apps/guardrail/.env.example for the service's own configuration.
GUARDRAIL_URL=http://localhost:8863

# Service-to-service token for the gateway's PHI-bearing Guardrail hop
# (TASK-460 C4-02). AiInferenceClient ALWAYS attaches it as `X-Service-Token`
# (fail-closed: unset resolves to an empty header value). Receiver-side
# enforcement in apps/guardrail is tracked as TASK-465; empty = dev bypass.
GUARDRAIL_SERVICE_TOKEN=

# TASK-535 — where guardrail reads its effective config (model-cache retention).
# Bootstrap TRANSPORT only; the retention values themselves come from the
# control plane at `guardrail.modelCache.*`.
GUARDRAIL_V2_GATEWAY_URL=http://localhost:8868/api/v1

# Per-tenant model resolution from the DB (TASK-506, DEFAULT-ON): the guardian
# provider/model resolve at request time from core."AiTaskDefault" (taskKey
# guardrail.validate) joined to core."AiModel" (provider / sourceUri /
# metaData.azureDeployment), tenant row over SYSTEM row, with a 60s TTL cache.
# Fail posture is FAIL-CLOSED: selection is DB-only, so when no ENABLED SYSTEM
# selection exists the resolved config is empty and the caller fails closed with
# 503 — it must NOT fall back to env for provider/model selection. Only the DB
# *read* failure path degrades: a load error is negatively cached for one TTL
# window (at most one connection attempt per tenant per TTL), and the caller then
# uses the env-selected engine (settings.engine) for that window.
# Set false to force env-only selection (GUARDRAIL_V2_PROVIDER et al.).
GUARDRAIL_DB_CONFIG_ENABLED=true
# Read-only connection to the shared HOPE core DB (postgres:// is auto-normalized
# to the asyncpg form; production appends `?ssl=require`).
GUARDRAIL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope

# Live OUTPUT groundedness gate (TASK-479, SOTA D2) — `POST /guardrail/ground`.
# ENABLED is the dev/CI bypass switch: false (default) answers honestly with
# `unverified` verdicts and never loads a model. Clinical/production sets it true
# (ops rollout) AND requires the SELF-HOSTED MiniCheck-class NLI model staged on the
# host (track guardrail: no cloud PHI). Fail posture is FAIL-CLOSED: disabled gate,
# un-staged model, or scoring error all degrade to `unverified` — never `grounded`.
GUARDRAIL_V2_GROUNDEDNESS_ENABLED=false
GUARDRAIL_V2_GROUNDEDNESS_MODEL_ID=lytang/MiniCheck-Flan-T5-Large
GUARDRAIL_V2_GROUNDEDNESS_ENTAILMENT_THRESHOLD=0.5
GUARDRAIL_V2_GROUNDEDNESS_BATCH_SIZE=16
GUARDRAIL_V2_GROUNDEDNESS_MAX_SEGMENTS=200

# Guardian engines — production self-host tiers.
# Both speak the OpenAI-compatible `/v1` wire and serve a guardian-capable model
# (Granite Guardian). Select at runtime with GUARDRAIL_V2_PROVIDER=vllm|llama-cpp;
# every other GUARDRAIL_OPENAI_COMPAT_* field (content_safety_model, pii_detection_
# model, timeout_s, …) has a mirror under these prefixes. Disabled by default.
GUARDRAIL_VLLM_ENABLED=false
GUARDRAIL_VLLM_BASE_URL=http://localhost:8000/v1
GUARDRAIL_VLLM_API_KEY=vllm
GUARDRAIL_VLLM_GUARDIAN_MODEL=granite-guardian-4.1-8b
GUARDRAIL_LLAMA_CPP_ENABLED=false
GUARDRAIL_LLAMA_CPP_BASE_URL=http://localhost:8080/v1
GUARDRAIL_LLAMA_CPP_API_KEY=llama-cpp
GUARDRAIL_LLAMA_CPP_GUARDIAN_MODEL=granite-guardian-4.1-8b

# =============================================================================
# SMR SERVICE (apps/smr) - Summarization
# =============================================================================
SMR_HOST=0.0.0.0
SMR_PORT=8862
SMR_URL=http://localhost:8862
# Gateway-internal alias some apps/api services resolve directly (distinct from
# the IConfigService-mediated SMR_URL used by modules/**).
SMR_SERVICE_URL=http://localhost:8862

# Azure OpenAI credentials — NOT read by any service process. Two consumers only:
#   1. the SMR e2e suite, which reads these keys out of the monorepo root `.env`
#      and maps them onto SMR_V2_AZURE_* (apps/smr/src/smr_v2/tests/e2e/conftest.py)
#   2. the `hope-secrets` Secret key names in deployment/secrets.{dev,prod}.yaml.example,
#      projected onto SMR_V2_AZURE_* env vars by deployment/k3s/base/smr.yaml
# The runtime prefix is SMR_V2_AZURE_* (below) — see apps/smr/src/smr_v2/core/config.py.
AZURE_OPENAI_API_KEY=<CHANGE_ME>-your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_MODEL=gpt-4

# SMR V2 Service (apps/smr) - Provider Configuration
# TASK-525 — BOOTSTRAP TRANSPORT, not config authority: the address of the
# control plane the service pulls its runtime knobs from
# (GET /api/v1/internal/effective-config?service=smr). Per-provider
# max_concurrent / timeout_s below are bootstrap fallbacks; their runtime values
# come from AiRuntimeProfile rows. An unreachable gateway is safe: the service
# negative-caches and keeps its env values.
SMR_V2_GATEWAY_URL=http://localhost:8868/api/v1

# TASK-528 — per-provider cap for the `/providers` LISTING probe ONLY (never
# generation). Providers are probed in parallel; one hung engine reports
# `probe_status: "timeout"` and the endpoint still returns 200 with the rest
# intact. Keep this SHORT: the per-provider `*_TIMEOUT_S` values below are
# generation timeouts (300 s) and are far too long for an admin-facing listing.
SMR_V2_PROVIDER_PROBE_TIMEOUT_S=5

SMR_V2_OLLAMA_ENABLED=false
SMR_V2_OLLAMA_BASE_URL=http://localhost:11434
SMR_V2_OLLAMA_DEFAULT_MODEL=llama3.2:latest
SMR_V2_OLLAMA_TIMEOUT_S=300

# SMR V2 - Azure OpenAI provider (apps/smr/src/smr_v2/core/config.py, AzureOpenAIConfig).
# SMR is a stateless gateway: it never selects a provider/model from env — the
# gateway injects {provider, model} per request. A provider is available iff its
# connection config is present, so leaving API_KEY/ENDPOINT empty disables Azure.
SMR_V2_AZURE_API_KEY=<CHANGE_ME>
SMR_V2_AZURE_ENDPOINT=
SMR_V2_AZURE_API_VERSION=2024-12-01-preview
SMR_V2_AZURE_DEPLOYMENT_NAME=
SMR_V2_AZURE_DEFAULT_MODEL=gpt-5-mini
SMR_V2_AZURE_TIMEOUT_S=120
SMR_V2_AZURE_MAX_CONCURRENT=10
SMR_V2_AZURE_TPM_LIMIT=80000
SMR_V2_AZURE_RPM_LIMIT=480
SMR_V2_AZURE_ADAPTIVE_LIMITS=true
SMR_V2_AZURE_CONTENT_FILTER_SEVERITY=medium

# SMR V2 - Production inference engines
# LM Studio + Ollama stay the local dev/test engines; vLLM + llama.cpp are the
# production self-host engines (AD-4). Both ship DISABLED — flip ENABLED=true and
# point BASE_URL at the running engine (see the `inference` compose profile).
#
# vLLM (OpenAI wire; BASE_URL includes /v1; /health + /metrics at the root):
SMR_V2_VLLM_ENABLED=false
SMR_V2_VLLM_BASE_URL=http://localhost:8000/v1
SMR_V2_VLLM_TIMEOUT_S=300
SMR_V2_VLLM_MAX_CONCURRENT=8
# vLLM < 0.8 only: route JSON-schema structured output via extra_body.guided_json.
SMR_V2_VLLM_USE_GUIDED_JSON=false
# Optional explicit prefix-cache /metrics scrape target (default: BASE_URL root + /metrics).
SMR_V2_VLLM_METRICS_URL=
#
# llama.cpp server (native /completion; GGUF tier; timings = the AD-1 reference):
SMR_V2_LLAMA_CPP_ENABLED=false
SMR_V2_LLAMA_CPP_BASE_URL=http://localhost:8080
SMR_V2_LLAMA_CPP_TIMEOUT_S=300
SMR_V2_LLAMA_CPP_MAX_CONCURRENT=4
#
# `inference` compose-profile helpers (used by infrastructure/docker/docker-compose.dev.yml):
#   VLLM_MODEL=Qwen/Qwen3-8B
#   VLLM_MAX_MODEL_LEN=8192
#   VLLM_GPU_MEM_UTIL=0.90
#   HF_TOKEN=                       # only for gated HF model downloads
#   LLAMA_CPP_MODELS_DIR=./models/llama-cpp   # host dir holding the pre-staged GGUF
#   LLAMA_CPP_MODEL=model.gguf      # GGUF filename inside LLAMA_CPP_MODELS_DIR
#   LLAMA_CPP_CTX_SIZE=8192
#   HOPE_TEI_EMBED_MODEL=BAAI/bge-m3
#   HOPE_TEI_EMBED_PORT=8871

# SMR V2 - Input Guardrail (PHI moderation, TASK-478)
# ENABLED is the dev/CI bypass switch: false (default) turns input moderation OFF so
# local dev + hermetic CI run without a guardrail service. Clinical/production MUST set
# it true (an ops rollout step — guardrail reachable). The fail posture is degrade-safe
# → fail-CLOSED: a transient blip is absorbed by a bounded retry, a sustained outage
# rejects (503), and an errored guardrail NEVER allows.
SMR_V2_EXTERNAL_GUARDRAIL_ENABLED=false
SMR_V2_EXTERNAL_GUARDRAIL_MAX_RETRIES=2
SMR_V2_EXTERNAL_GUARDRAIL_RETRY_BACKOFF_MS=100

# Summary Agent Settings
SUMMARY_AGENT_HOST=0.0.0.0
SUMMARY_AGENT_PORT=8862
SUMMARY_AGENT_REDIS_URL=redis://localhost:6379
SUMMARY_AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope
SUMMARY_AGENT_MAX_CONVERSATION_LENGTH=50000
SUMMARY_AGENT_CHUNK_SIZE=10000

# =============================================================================
# NLP SERVICE (apps/nlp) - Natural Language Processing
# =============================================================================
NLP_HOST=0.0.0.0
NLP_PORT=8864
NLP_URL=http://localhost:8864

# TASK-525 — BOOTSTRAP TRANSPORT, not config authority: the address of the
# control plane the service pulls its runtime knobs from
# (GET /api/v1/internal/effective-config?service=nlp). The knobs themselves
# (e.g. nlp.inference.maxConcurrent) live in the DB, not here. An unreachable
# gateway is safe: the service negative-caches and keeps its env values.
NLP_GATEWAY_URL=http://localhost:8868/api/v1

# Service-to-service token for the gateway's PHI-bearing NLP hop
# (TASK-460 C4-02). AiInferenceClient ALWAYS attaches it as `X-Service-Token`
# (fail-closed: unset resolves to an empty header value). Receiver-side
# enforcement in apps/nlp is tracked as TASK-465; empty = dev bypass.
NLP_SERVICE_TOKEN=

# Model Configuration — bootstrap fallbacks only since TASK-506: the effective
# per-tenant models resolve from the AiTaskDefault registry and are injected by
# the gateway as a per-request `model_name`. TEXT_CLASSIFIER_MODEL_NAME was
# removed — the doc-type classifier deliberately stays an unconfigured sentinel
# until a clinical model/taxonomy is chosen (nlp/core/config.py TASK-330 §3.4).
TOKEN_CLASSIFIER_MODEL_NAME=blaze999/Medical-NER
MEDICAL_SUGGESTER_MODEL_NAME=shanover/symps_disease_bert_v3_c41

# Clinical ontology linker (TASK-476 C1). The token classifier links recognized
# spans to UMLS/SNOMED/RxNorm/ICD-10/LOINC via a bundled self-hosted vocabulary
# (no cloud PHI). Optional — sensible defaults baked in.
#   NLP_LINKER_ENABLED           master toggle (default true)
#   NLP_LINKER_CONFIDENCE_FLOOR  min NER confidence to link a span (default 0.0)
NLP_LINKER_ENABLED=true
NLP_LINKER_CONFIDENCE_FLOOR=0.0

# =============================================================================
# LIVE DOCUMENTATION — realtime SOAP watcher (TASK-339 / TASK-340)
# LiveDocumentationService: debounce + SMR running-note + NLP entities over SSE.
# All optional; sensible defaults are baked in if unset.
# =============================================================================
# Feature kill-switch — set to `false` to disable the live watcher entirely.
LIVE_DOC_ENABLED=true
# Debounce: flush after this many final STT segments, or after the idle window.
LIVE_DOC_SEGMENT_THRESHOLD=3
LIVE_DOC_DEBOUNCE_MS=5000
# SSE heartbeat cadence (keeps idle streams alive through proxies).
LIVE_DOC_HEARTBEAT_MS=15000
# Min ms between SMR calls per session (throttle — protects the local LM pool).
LIVE_DOC_MIN_INTERVAL_MS=4000
# Durable snapshot throttle: upsert one PRE_SUMMARY (metadata.subType=LIVE_SOAP_SNAPSHOT) at most this often. 0 disables periodic durable writes.
LIVE_DOC_DURABLE_SNAPSHOT_MS=30000
# Bounded live-generation params for the SMR call.
LIVE_DOC_SMR_MAX_TOKENS=1500
LIVE_DOC_SMR_TIMEOUT_MS=20000
# Optional dedicated fast provider/model for the live loop (blank → SMR service default).
LIVE_DOC_SMR_PROVIDER=
LIVE_DOC_SMR_MODEL=
# TTL (seconds) for the per-session admin-console stats snapshot + active-set membership in Redis.
# Refreshed on every flush; a crashed/quiet session falls out of the admin "live" list after this window.
LIVE_DOC_STATS_TTL_SEC=300
# Output groundedness gate (TASK-479, SOTA D2): verify the generated note against the
# transcript (guardrail `POST /guardrail/ground`) BETWEEN build and publish, marking
# ungrounded segments before the clinician reads them. ENABLED=false (default) is the
# dev/CI bypass (payload unchanged, guardrail never called); enabling is the clinical/ops
# rollout step (guardrail reachable + its NLI model staged). Degrade-safe → fail-CLOSED:
# a transient blip is absorbed by a bounded retry, a sustained outage marks segments
# `unverified` (the feed keeps publishing) — an error path can NEVER mark `grounded`.
LIVE_DOC_GROUNDEDNESS_ENABLED=false
LIVE_DOC_GROUNDEDNESS_TIMEOUT_MS=5000
LIVE_DOC_GROUNDEDNESS_MAX_RETRIES=1
LIVE_DOC_GROUNDEDNESS_RETRY_BACKOFF_MS=200

# =============================================================================
# MLFLOW SERVICE (apps/mlflow)
# =============================================================================
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5020
MLFLOW_TRACKING_URI=http://localhost:5020

# Qdrant (vector database for prompts)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PROMPTS=prompts
QDRANT_COLLECTION_DNA=dna_writing_style

# =============================================================================
# HARNESS SERVICE (apps/harness) - Clinical Documentation Harness (TASK-330)
# =============================================================================
# Python/FastAPI orchestrator running the bounded guides→generate→sensors→gate
# loop as a Temporal durable workflow. apps/api stays the gateway/system-of-record.
HARNESS_HOST=0.0.0.0
HARNESS_PORT=8866
HARNESS_URL=http://localhost:8866

# =============================================================================
# TTS SERVICE (apps/tts-v2) - Realtime Text-to-Speech (English + Malayalam)
# =============================================================================
TTS_PORT=8865
TTS_URL=http://localhost:8865
# Inter-service token (empty = dev bypass). Fail-open on miss (no header set).
TTS_SERVICE_TOKEN=
# TASK-535 — where tts-v2 reads its effective config (local-engine retention).
# Bootstrap TRANSPORT only; the values come from the control plane at
# `tts.modelCache.ttlSeconds` (note the `tts` key prefix vs the `tts-v2` service name).
TTS_GATEWAY_URL=http://localhost:8868/api/v1
# Cloud provider: Azure Speech reuses the shared AZURE_SPEECH_KEY/AZURE_SPEECH_REGION.
TTS_AZURE_ENABLED=false
# Sarvam AI Bulbul (cloud; best code-switched Malayalam). ⚠️ Public API is NOT
# PHI-safe (no HIPAA/BAA, 30-day retention) — set TTS_SARVAM_BASE_URL to the
# enterprise VPC/on-prem host before enabling for patient data (TASK-493 §5).
TTS_SARVAM_ENABLED=false
TTS_SARVAM_API_KEY=
# TTS_SARVAM_BASE_URL=https://api.sarvam.ai
TTS_SARVAM_USE_STREAMING=false
# Self-hosted local engines (need the [local] extra + a GPU) — off by default.
TTS_KOKORO_ENABLED=false
TTS_PARLER_ENABLED=false
# Indic Parler internal mirror (TASK-495). The HF repo is click-through gated, so
# PROD loads from an ungated internal mirror instead of a personal HF_TOKEN — set
# these (+ HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE) in the GPU overlay per
# docs/operations/tts-model-mirror/. Empty = dev fallback to the gated hub pull.
# TTS_PARLER_MODEL_PATH=/models/indic-parler-tts/<sha>
# TTS_PARLER_DESC_ENCODER_PATH=/models/flan-t5-large/<sha>
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# IndicF5 (Malayalam voice-clone) — EXPERIMENTAL. ⚠️ prod/commercial enablement is
# NO-GO pending license review (TASK-494: fine-tune of a CC-BY-NC base). Dev opt-in
# only; also add indic_f5 to TTS_ROUTING_ML to route to it. Needs a reference wav +
# transcript (TTS_INDICF5_REF_AUDIO_PATH / TTS_INDICF5_REF_TEXT) and the mirrored
# weights (TTS_INDICF5_MODEL_PATH, TASK-495).
TTS_INDICF5_ENABLED=false

# --- Tenant-scoped external identity provider (OIDC) — TASK-498, master switch default OFF ---
# TENANT_IDP_ENABLED: read by the apps/api layer (@arcaai/applications TenantIdpConfigService,
# IdpResolverService, FederatedAuthService). When OFF, the /auth/sso/* routes and
# admin/tenant-idp-config surface are inert regardless of per-tenant TenantIdentityProvider rows —
# an explicit ops rollout, not a silent default flip. Local password login is never affected.
TENANT_IDP_ENABLED=false
# TENANT_IDP_MS_GRAPH_ENABLED / TENANT_IDP_GOOGLE_DIRECTORY_ENABLED (TASK-498 P3): per-provider
# gates for the admin-triggered directory-pull sync (DirectorySyncService). Directory-API
# credentials themselves are tenant-supplied and Vault-sealed (TenantIdentityProvider.
# directoryCredentialsRef) — these flags only control whether that provider's client is wired up.
TENANT_IDP_MS_GRAPH_ENABLED=false
TENANT_IDP_GOOGLE_DIRECTORY_ENABLED=false

# --- Verified self-signup (TASK-497 D1), master switch default OFF ---
# REGISTRATION_SELF_SIGNUP_ENABLED: read via IConfigService (@arcaai/applications
# ConfigService). When OFF, POST /auth/register and /auth/register/verify are
# inert (404/403) regardless of caller — healthcare/PHI platform, so open signup
# is an explicit ops rollout, not a silent default flip.
REGISTRATION_SELF_SIGNUP_ENABLED=false

# Service-to-service token for the apps/api <-> apps/harness gate adapter
# (TASK-330 Lane G). The harness sends it as the `X-Service-Token` header;
# apps/api's HarnessServiceTokenGuard validates inbound /internal/harness/* calls
# against it, and HarnessGatewayService attaches it to outbound start/approve
# calls. Fail-closed: inbound calls are rejected when this is unset.
HARNESS_SERVICE_TOKEN=dev-harness-service-token-change-me

# --- Harness lineage-unification kill-switches (TASK-480, both default OFF) ---
# HARNESS_WARM_START_ENABLED (Half-A): read by the apps/api layer (@arcaai/applications
# HarnessInternalService + PromptAssemblyService). When ON, the harness warm-starts from
# the live session's running SOAP snapshot (a two-stage scratchpad→final: it REFINES the
# prior draft; the transcript stays the single source of truth on conflict) instead of
# regenerating cold. Enabling it is an explicit ops rollout, not a silent default flip.
HARNESS_WARM_START_ENABLED=false
# HARNESS_NER_PRIORS_ENABLED (Half-B): read by the apps/harness Python Settings. When ON,
# the transcript NER pass reuses already-persisted CODED NamedEntity rows (TASK-476) as
# priors instead of re-extracting cold; falls back to cold when off / no prior carries a
# code (inert until TASK-476's codes exist).
HARNESS_NER_PRIORS_ENABLED=false
# --- Harness reference-free atomic-fact verifier (TASK-481 E2, default OFF) ----
# HARNESS_ATOMIC_FACT_ENABLED: read by the apps/harness Python Settings. When ON, the
# inferential pass runs a DETERMINISTIC, self-hosted-NLI atomic-fact groundedness verifier
# ALONGSIDE the LLM-judge groundedness sensor (a second, model-cheap gate; never the LLM
# judge — no cloud egress). A degraded backend degrades (never auto-PASS). Default OFF ⇒
# enabling it is an explicit ops rollout once a self-hosted NLI model (MiniCheck /
# AlignScore / HHEM-class) is provisioned; the hermetic default entailer needs no model.
HARNESS_ATOMIC_FACT_ENABLED=false
# --- Harness claim-check payload store (TASK-483) ---------------------------
# Read by the apps/harness Python Settings. Large clinical blobs (transcript / assembled
# prompt / generated note / RAG chunks) are moved OUT of the Temporal workflow history
# and replaced with a small content-addressed reference, protecting the ~50 MB history
# budget under long / heavily-regenerated encounters. SELF-HOSTED store only (MinIO,
# S3-compatible) — the offloaded payloads carry clinical content; never a cloud bucket.
# ENABLED on with the threshold set (small payloads stay inline — no store tax). The
# DEFAULT store is the process-local in-memory fake (single-worker dev/test); a MULTI-worker
# deploy MUST set STORE=s3 + the MinIO endpoint/creds (a cross-worker retry against the
# in-memory fake fails LOUD). Creds are secrets — set real values only in host env, never here.
# TASK-533 D-28: that MUST is now ENFORCED — with HARNESS_ENVIRONMENT=production|prod|staging,
# ENABLED=true + STORE=memory is a hard startup error (settings validator + worker boot check).
HARNESS_CLAIM_CHECK_ENABLED=true
HARNESS_CLAIM_CHECK_STORE=memory
HARNESS_CLAIM_CHECK_MIN_BYTES=65536
HARNESS_CLAIM_CHECK_BUCKET=harness-claim-check
HARNESS_CLAIM_CHECK_ENDPOINT_URL=http://localhost:9000
HARNESS_CLAIM_CHECK_ACCESS_KEY=
HARNESS_CLAIM_CHECK_SECRET_KEY=
HARNESS_CLAIM_CHECK_REGION=us-east-1
HARNESS_CLAIM_CHECK_SECURE=false
HARNESS_CLAIM_CHECK_TTL_SECONDS=604800

# --- LLM-as-judge (harness eval) — model-agnostic selector -------------------
# Pick the judge backend with HARNESS_JUDGE_PROVIDER; vllm/llama-cpp (
# Phase 4B/4C production self-host engines, AD-4) route onto the SAME OpenAI-
# compatible judge client as openai_compat — just point the OPENAI_COMPAT
# base_url at the engine's `/v1`. Also: openai_compat | ollama | azure | bedrock.
HARNESS_JUDGE_PROVIDER=openai_compat
HARNESS_JUDGE_MODEL=google/gemma-4-e4b
HARNESS_JUDGE_OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
HARNESS_JUDGE_OPENAI_COMPAT_API_KEY=lm-studio

# --- Temporal durable-workflow substrate (shared TEMPORAL_ prefix) ----------
# Consumed by apps/harness (FastAPI app + worker; apps/api in later phases).
# The dev Temporal stack is OPT-IN via the docker compose `temporal` profile:
#   docker compose -f infrastructure/docker/docker-compose.yml \
#                  -f infrastructure/docker/docker-compose.dev.yml \
#                  --profile temporal up -d temporal temporal-ui
#   Web UI: http://localhost:8233   ·   gRPC frontend: localhost:7233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=harness-task-queue
TEMPORAL_CONNECT_TIMEOUT_S=5.0

# --- Temporal dev stack image/port pins (docker compose `temporal` profile) -
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_VERSION=1.29.1
TEMPORAL_UI_VERSION=2.34.0
# Temporal shares the core hope-postgres instance (no dedicated container).
# auto-setup provisions these two DEDICATED databases next to the app `hope` DB,
# using the POSTGRES_USER / POSTGRES_PASSWORD superuser defined below.
TEMPORAL_DB_NAME=temporal
TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility

# =============================================================================
# CELERY CONFIGURATION (Shared by SMR, MLflow, FedL)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=true

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================
# These variables are used by infrastructure/docker/docker-compose.yml
# Docker Compose will automatically load this .env file when run from the
# monorepo root, or you can use --env-file flag.
#
# Usage from monorepo root:
#   docker compose -f infrastructure/docker/docker-compose.yml up -d
#
# Or with explicit env file:
#   docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hope
POSTGRES_PORT=5432

# Redis (Docker container password - leave empty for no auth in development)
# Note: If you set this, also update REDIS_PASS above for application access
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# HASHICORP VAULT (TASK-302 Stream B — Secrets / Transit / Database engines)
# =============================================================================
# Local dev defaults to the EnvSecretsProvider (SECRETS_PROVIDER=env) and the
# Vault container is opt-in via `./scripts/start-infra.sh --all` (which passes
# `--profile vault`). Flip SECRETS_PROVIDER to `vault` only when exercising
# the Vault code path locally. See infrastructure/docker/README.md for the
# AppRole bootstrap flow that mints VAULT_ROLE_ID / VAULT_WRAPPED_SECRET_ID.
#
# Engines mounted by infrastructure/docker/configs/vault/dev-init.sh:
#   secret/    → kv-v2  (static secrets, seeded under secret/hope/*)
#   transit/   → transit (envelope-encryption of GlobalSetting rows, Phase 4)
#   database/  → database (short-lived Postgres credentials, Phase 5)

# --- Provider selection ----------------------------------------------------
# One of: env | vault | aws | azure | in-memory  (defaults to env)
SECRETS_PROVIDER=env

# --- Vault server (used by both the container and the app client) ---------
# Token used by Vault server in `-dev` mode (compose only) and as a shorthand
# for the bootstrap script. Application code authenticates via AppRole, not
# this token.
VAULT_DEV_ROOT_TOKEN=root
VAULT_ADDR=http://localhost:8200
# VAULT_NAMESPACE=                 # Vault Enterprise only

# --- AppRole credentials (required when SECRETS_PROVIDER=vault) -----------
# LOCAL DEV: run `./scripts/refresh-vault-creds.sh` — it populates
# VAULT_ROLE_ID + a RAW VAULT_SECRET_ID and blanks VAULT_WRAPPED_SECRET_ID.
# The raw secret_id is reusable across unlimited restarts (the dev AppRole uses
# secret_id_num_uses=0 + secret_id_ttl=720h), which the `nest start --watch`
# loop needs — a wrapped token is single-use and dies on the first reload.
#
# PRODUCTION: use VAULT_WRAPPED_SECRET_ID (a one-shot response-wrapped token
# injected per pod; the plaintext secret_id never touches disk). If both are
# set, the provider prefers the wrapped one.
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_WRAPPED_SECRET_ID=

# --- Vault paths & timeouts (defaults match dev-init.sh) ------------------
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=hope
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=hope-globalsetting
VAULT_REQUEST_TIMEOUT_MS=5000

# --- Rotation worker audit-log tail (TASK-312 A.4) ------------------------
# When SECRETS_PROVIDER=vault, set this to a path the API process can read
# (the host side of Vault's file audit device). The VaultRotationWorker tails
# it to publish cache-invalidation events on operator-driven rotations.
# Leave empty to disable the worker. Local dev uses /tmp/hope-vault-audit/
# (see .env.dev + docker-compose.dev.yml); production points it at the shared
# audit volume mounted into the API pod.
VAULT_AUDIT_LOG_PATH=

# --- Dynamic PostgreSQL credentials (TASK-312 A.5) ------------------------
# When true AND SECRETS_PROVIDER=vault, the API mints short-lived PG users
# via Vault's database engine instead of using DATABASE_URL credentials.
# One-time setup creates the vault_admin/hope_app_template PG roles + wires
# Vault's DB engine to the target DB:
#   pnpm dev:setup                 # full: infra -> migrations -> bootstrap
#   ./scripts/setup-dev-vault-db.sh # if infra + migrations already up
# Left false in this template (the example defaults to SECRETS_PROVIDER=env);
# .env.dev ships it true.
PG_DYNAMIC_CREDS=false
PG_VAULT_ROLE=hope-app-role
# BUG-006 follow-up — must match the Vault role's max_ttl (in seconds).
# The renewer force-swaps the pool once elapsed time nears this ceiling;
# if unset it falls back to a conservative 24h. Dev = 604800 (7d, set by
# scripts/setup-dev-vault-db.sh); production = 2592000 (30d, see
# docs/operations/vault/README.md "Dynamic DB credentials").
PG_VAULT_MAX_TTL_SEC=604800
# Pool target for the Vault-backed client. Mirror DATABASE_URL's host/port/db
# so dynamic creds hit the SAME database as the static path + migrations.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hope

# --- vault-init sidecar (configures the database engine target) -----------
# host.docker.internal resolves to the host PG (5432) from inside the
# vault-init container on Docker Desktop. Change to `postgres` to point at
# the dockerised PG instead.
# VAULT_DB_NAME MUST match the real database (DATABASE_URL → /hope); the old
# `hope_main` default never matched any DB and silently failed the engine's
# connection test.
VAULT_DB_HOST=host.docker.internal
VAULT_DB_PORT=5432
VAULT_DB_NAME=hope
VAULT_DB_ADMIN_USER=vault_admin
VAULT_DB_ADMIN_PASS=vault_admin_dev_pw

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333

# =============================================================================
# DEVELOPMENT & DEBUG
# =============================================================================
# Enable for verbose debugging (not for production)
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_PROFILING=false

# Prisma debugging
DEBUG_PRISMA=false

# =============================================================================
# TASK-527 — Model source & path resolution (s3:// weight sources)
# =============================================================================
# Every service resolves model weights as: AiModel.localPath (operator override,
# HIGHEST precedence) -> sourceUri scheme dispatch. Supported schemes:
#   hf:<org>/<repo> or a bare HuggingFace id   (honours HF_HUB_OFFLINE)
#   file:///abs/path                           (verified in place, never copied)
#   s3://bucket/prefix                         (downloaded once, SHA256-verified)
# OD-4: s3:// only this program; azure-blob:// is out of scope.
#
# These bootstrap credentials are OPTIONAL and per-service. Unset simply means an
# s3:// source_uri errors cleanly (never a silent fallback). Point them at the
# in-deployment MinIO; set *_SECURE=false for a plain-HTTP local endpoint.
# STT_V2_MODEL_S3_ENDPOINT=localhost:9000
# STT_V2_MODEL_S3_ACCESS_KEY=
# STT_V2_MODEL_S3_SECRET_KEY=
# STT_V2_MODEL_S3_SECURE=true
# GUARDRAIL_V2_MODEL_S3_ENDPOINT=localhost:9000
# GUARDRAIL_V2_MODEL_S3_ACCESS_KEY=
# GUARDRAIL_V2_MODEL_S3_SECRET_KEY=
# GUARDRAIL_V2_MODEL_S3_SECURE=true
# NLP_MODEL_S3_ENDPOINT=localhost:9000
# NLP_MODEL_S3_ACCESS_KEY=
# NLP_MODEL_S3_SECRET_KEY=
# NLP_MODEL_S3_SECURE=true
# HARNESS_MODEL_S3_ENDPOINT=localhost:9000
# HARNESS_MODEL_S3_ACCESS_KEY=
# HARNESS_MODEL_S3_SECRET_KEY=
# HARNESS_MODEL_S3_SECURE=true
#
# Cache dirs for weights materialised from an s3:// source_uri.
# GUARDRAIL_V2_GROUNDEDNESS_MODEL_CACHE_DIR=/models/guardrail-cache
# HARNESS_ATOMIC_FACT_MODEL_CACHE_DIR=/models/harness-cache
