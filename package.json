{
    "name": "hope-monorepo",
    "version": "1.0.0",
    "description": "HOPE Monorepo",
    "private": true,
    "scripts": {
        "------------ BUILD ------------": "",
        "build": "turbo run build",
        "build:api": "turbo run build --filter=@arcaai/api...",
        "build:packages": "turbo run build --filter=@arcaai/logger --filter=@arcaai/exceptions --filter=@arcaai/database --filter=@arcaai/domains",
        "build:modules": "turbo run build --filter=@arcaai/applications...",
        "build:sdk": "turbo run build --filter=@arcaai/vox...",
        "clean": "turbo run clean && rimraf \"**/dist\" \"**/tsconfig.tsbuildinfo\"",
        "nuke": "rimraf pnpm-lock.yaml && turbo run nuke && pnpm install",
        "------------ DEV SERVERS ------------": "",
        "dev:api": "NODE_ENV=development turbo run dev --filter=@arcaai/api",
        "dev:api:watch": "NODE_ENV=development turbo run dev:watch --filter=@arcaai/api --filter=@arcaai/applications",
        "dev:stt-v2": "conda run -n arcaenv --no-capture-output uvicorn stt_v2.main:app --host 0.0.0.0 --port 8861 --reload --app-dir apps/stt-v2/src",
        "dev:smr-v2": "conda run -n arcaenv --no-capture-output uvicorn smr_v2.main:app --host 0.0.0.0 --port 8862 --reload --app-dir apps/smr/src",
        "dev:nlp": "conda run -n arcaenv --no-capture-output uvicorn --factory nlp.app:get_app --host 0.0.0.0 --port 8864 --reload --app-dir apps/nlp/src",
        "dev:ui-playground": "pnpm --filter @arcaai/ui-playground dev",
        "------------ DATABASE ------------": "",
        "db:generate": "pnpm --filter @arcaai/database db:generate",
        "db:migrate": "pnpm --filter @arcaai/database db:migrate",
        "db:migrate:deploy": "pnpm --filter @arcaai/database db:migrate:deploy",
        "db:push": "pnpm --filter @arcaai/database db:push",
        "db:push:force": "pnpm --filter @arcaai/database db:push:force",
        "db:studio": "pnpm --filter @arcaai/database db:studio",
        "db:seed": "pnpm --filter @arcaai/database seed",
        "db:all": "pnpm gen:prisma push --all --force && pnpm gen:prisma generate --all && pnpm db:seed",
        "ok": "pnpm db:all && turbo run build",
        "------------ DOCKER (Dev Infrastructure) ------------": "",
        "docker:dev:up": "./scripts/start-infra.sh",
        "docker:dev:up:all": "./scripts/start-infra.sh --all",
        "docker:dev:down": "./scripts/start-infra.sh --stop",
        "docker:dev:logs": "./scripts/start-infra.sh --logs",
        "docker:dev:status": "./scripts/start-infra.sh --status",
        "------------ DOCKER (Test Infrastructure) ------------": "",
        "docker:test:up": "./scripts/start-test-infra.sh",
        "docker:test:down": "./scripts/start-test-infra.sh --stop",
        "docker:test:logs": "./scripts/start-test-infra.sh --logs",
        "docker:test:status": "./scripts/start-test-infra.sh --status",
        "docker:test:validate": "./scripts/start-test-infra.sh --validate",
        "------------ CODE GENERATION ------------": "",
        "gen:prisma": "pnpm --filter @arcaai/tools prisma-commander",
        "gen:model": "pnpm --filter @arcaai/tools generate-data-model",
        "gen:entity": "pnpm --filter @arcaai/tools generate-data-entity",
        "gen:mapper": "pnpm --filter @arcaai/tools generate-mapper",
        "gen:repository": "pnpm --filter @arcaai/tools generate-repository",
        "gen:factory": "pnpm --filter @arcaai/tools generate-factory",
        "gen:service": "pnpm --filter @arcaai/tools generate-service-module",
        "gen:controller": "pnpm --filter @arcaai/tools generate-controller",
        "gen:token": "pnpm --filter @arcaai/tools gen-dev-token",
        "gen:api-key": "pnpm --filter @arcaai/tools gen-api-key",
        "------------ TESTS (TypeScript) ------------": "",
        "test:api:up": "./scripts/start-test-api.sh",
        "test:stt-v2:up": "./scripts/start-test-stt-v2.sh",
        "test:smr-v2:up": "./scripts/start-test-smr-v2.sh",
        "test:nlp:up": "./scripts/start-test-nlp.sh",
        "test:unit": "dotenv -e .env.test -- vitest run --exclude '**/integration/**' --exclude '**/e2e/**'",
        "test:unit:watch": "dotenv -e .env.test -- vitest --exclude '**/integration/**' --exclude '**/e2e/**'",
        "test:unit:ui": "dotenv -e .env.test -- vitest --ui --exclude '**/integration/**' --exclude '**/e2e/**'",
        "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
        "test:e2e": "dotenv -e .env.test -- playwright test",
        "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
        "test:e2e:debug": "dotenv -e .env.test -- playwright test --debug",
        "test:coverage": "dotenv -e .env.test -- vitest run --coverage --exclude '**/integration/**' --exclude '**/e2e/**'",
        "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
        "test:ci": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
        "test:db:push": "dotenv -e .env.test -- pnpm --filter @arcaai/database db:push:force",
        "test:db:seed": "dotenv -e .env.test -- pnpm --filter @arcaai/database seed",
        "test:db:reset": "pnpm test:db:push && pnpm test:db:seed",
        "------------ TESTS (Python - STT-v2) ------------": "",
        "py:stt-v2:setup": "make -C apps/stt-v2 setup-cpu",
        "py:stt-v2:setup:apple": "make -C apps/stt-v2 setup-apple",
        "py:stt-v2:setup:gpu": "make -C apps/stt-v2 setup-gpu",
        "py:stt-v2:check-env": "make -C apps/stt-v2 check-env",
        "py:stt-v2:test": "conda run -n arcaenv --no-capture-output pytest apps/stt-v2/tests/ -v --tb=short",
        "py:stt-v2:test:unit": "conda run -n arcaenv --no-capture-output pytest apps/stt-v2/tests/unit/ -v --tb=short",
        "py:stt-v2:test:integration": "conda run -n arcaenv --no-capture-output pytest apps/stt-v2/tests/integration/ -v --tb=short",
        "py:stt-v2:test:cov": "conda run -n arcaenv --no-capture-output pytest apps/stt-v2/tests/ --cov=apps/stt-v2/src/stt_v2 --cov-report=term-missing",
        "py:stt-v2:lint": "conda run -n arcaenv --no-capture-output ruff check apps/stt-v2/src/ apps/stt-v2/tests/",
        "py:stt-v2:format": "conda run -n arcaenv --no-capture-output black apps/stt-v2/src/ apps/stt-v2/tests/",
        "py:stt-v2:typecheck": "conda run -n arcaenv --no-capture-output mypy apps/stt-v2/src/",
        "------------ TESTS (Python - SMR-v2) ------------": "",
        "py:smr-v2:test": "conda run -n arcaenv --no-capture-output pytest apps/smr/src/smr_v2/tests/ -v --tb=short",
        "py:smr-v2:test:unit": "conda run -n arcaenv --no-capture-output pytest apps/smr/src/smr_v2/tests/unit/ -v --tb=short",
        "py:smr-v2:test:cov": "conda run -n arcaenv --no-capture-output pytest apps/smr/src/smr_v2/tests/ --cov=apps/smr/src/smr_v2 --cov-report=term-missing",
        "py:smr-v2:lint": "conda run -n arcaenv --no-capture-output ruff check apps/smr/src/",
        "py:smr-v2:format": "conda run -n arcaenv --no-capture-output black apps/smr/src/",
        "py:smr-v2:typecheck": "conda run -n arcaenv --no-capture-output mypy apps/smr/src/",
        "------------ TESTS (Python - NLP) ------------": "",
        "py:nlp:test": "conda run -n arcaenv --no-capture-output pytest apps/nlp/tests/ -v --tb=short",
        "py:nlp:lint": "conda run -n arcaenv --no-capture-output ruff check apps/nlp/src/ apps/nlp/tests/",
        "py:nlp:format": "conda run -n arcaenv --no-capture-output black apps/nlp/src/ apps/nlp/tests/",
        "py:nlp:typecheck": "conda run -n arcaenv --no-capture-output mypy apps/nlp/src/",
        "------------ PYTHON SETUP ------------": "",
        "py:setup": "./scripts/setup-python-env.sh",
        "py:setup:check": "./scripts/setup-python-env.sh --check",
        "py:setup:apple": "./scripts/setup-python-env.sh --apple",
        "py:setup:gpu": "./scripts/setup-python-env.sh --gpu",
        "------------ CODE QUALITY ------------": "",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\""
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.31.0+sha512.e3927388bfaa8078ceb79b748ffc1e8274e84d75163e67bc22e06c0d3aed43dd153151cbf11d7f8301ff4acb98c68bdc5cadf6989532801ffafe3b3e4a63c268",
    "devDependencies": {
        "@arcaai/config-eslint": "workspace:*",
        "@arcaai/config-rollup": "workspace:*",
        "@arcaai/config-ts": "workspace:*",
        "@playwright/test": "^1.58.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.5.0",
        "@vitest/coverage-istanbul": "^4.1.1",
        "@vitest/coverage-v8": "^4.1.1",
        "@vitest/ui": "^4.1.1",
        "bcryptjs": "^3.0.3",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.4",
        "jsdom": "^28.1.0",
        "jsonwebtoken": "^9.0.3",
        "prettier": "^3.8.1",
        "prisma": "^7.5.0",
        "rollup": "^4.60.0",
        "ts-node": "^10.9.2",
        "turbo": "^2.8.20",
        "typescript": "^5.9.3",
        "vitest": "^4.1.1",
        "zod": "^4.3.6"
    },
    "dependencies": {
        "@highlight-run/node": "^3.12.22",
        "@nestjs/bullmq": "^11.0.4",
        "@prisma/client": "^7.5.0",
        "bullmq": "^5.71.0",
        "class-validator": "0.14.1",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.3.1",
        "rimraf": "^6.1.3"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "pnpm": {
        "overrides": {
            "class-validator": "0.14.1",
            "@types/react": "^19.2.14",
            "@types/react-dom": "^19.2.3"
        }
    }
}
