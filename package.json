{
    "name": "hope-monorepo",
    "version": "1.0.0",
    "description": "HOPE Monorepo",
    "private": true,
    "scripts": {
        "------------ BUILD ------------": "",
        "build": "turbo run build",
        "build:api": "turbo run build --filter=@arcaai/api...",
        "build:packages": "turbo run build --filter=@arcaai/logger --filter=@arcaai/exceptions --filter=@arcaai/database --filter=@arcaai/domains",
        "build:modules": "turbo run build --filter=@arcaai/applications...",
        "build:sdk": "turbo run build --filter=@arcaai/vox...",
        "clean": "turbo run clean && rimraf \"**/dist\" \"**/tsconfig.tsbuildinfo\"",
        "nuke": "rimraf pnpm-lock.yaml && turbo run nuke && pnpm install",
        "------------ DEV SERVERS ------------": "",
        "dev:api": "NODE_ENV=development turbo run dev --filter=@arcaai/api",
        "dev:api:test": "dotenv -e .env.test -- pnpm --filter @arcaai/api dev",
        "dev:api:watch": "NODE_ENV=development turbo run dev:watch --filter=@arcaai/api --filter=@arcaai/applications",
        "dev:admin": "pnpm --filter @arcaai/admin-console dev",
        "dev:stack": "./scripts/dev-stack.sh",
        "dev:stack-o": "./scripts/dev-stack.sh --observability",
        "dev:stack-e": "./scripts/dev-stack.sh --inference",
        "dev:doctor": "./scripts/dev-doctor.sh",
        "------------ DATABASE ------------": "",
        "db:generate": "pnpm --filter @arcaai/database db:generate",
        "db:migrate": "pnpm --filter @arcaai/database db:migrate",
        "db:migrate:create": "pnpm --filter @arcaai/database db:migrate:create",
        "db:migrate:deploy": "pnpm --filter @arcaai/database db:migrate:deploy",
        "db:migrate:status": "pnpm --filter @arcaai/database db:migrate:status",
        "db:migrate:reset": "pnpm --filter @arcaai/database db:migrate:reset",
        "db:push": "pnpm --filter @arcaai/database db:push",
        "db:push:force": "pnpm --filter @arcaai/database db:push:force",
        "db:studio": "pnpm --filter @arcaai/database db:studio",
        "db:seed": "pnpm --filter @arcaai/database seed",
        "db:all": "pnpm gen:prisma push --all --force && pnpm gen:prisma generate --all && pnpm db:seed",
        "ok": "pnpm db:all && turbo run build",
        "------------ DEV INFRASTRUCTURE ------------": "",
        "dev:setup": "./scripts/dev-setup.sh",
        "dev:setup-o": "./scripts/dev-setup.sh --observability",
        "dev:setup-e": "./scripts/dev-setup.sh --inference",
        "infra:up": "./scripts/dev-infra.sh up",
        "infra:down": "./scripts/dev-infra.sh down",
        "infra:status": "./scripts/dev-infra.sh status",
        "infra:logs": "./scripts/dev-infra.sh logs",
        "infra:observability:up": "./scripts/dev-infra.sh up --observability",
        "infra:observability:down": "docker compose --env-file .env --profile prometheus -f infrastructure/docker/docker-compose.yml -f infrastructure/docker/docker-compose.dev.yml stop prometheus grafana",
        "docker:dev:up": "./scripts/start-infra.sh",
        "docker:dev:up:all": "./scripts/start-infra.sh --all",
        "docker:dev:down": "./scripts/start-infra.sh --stop",
        "docker:dev:logs": "./scripts/start-infra.sh --logs",
        "docker:dev:status": "./scripts/start-infra.sh --status",
        "------------ TEST INFRASTRUCTURE ------------": "",
        "docker:test:up": "./scripts/start-test-infra.sh",
        "docker:test:down": "./scripts/start-test-infra.sh --stop",
        "docker:test:logs": "./scripts/start-test-infra.sh --logs",
        "docker:test:status": "./scripts/start-test-infra.sh --status",
        "docker:test:validate": "./scripts/start-test-infra.sh --validate",
        "test:setup": "./scripts/test-setup.sh",
        "test:api:up": "./scripts/start-test-api.sh",
        "test:stt:up": "./scripts/start-test-stt.sh",
        "test:smr:up": "./scripts/start-test-smr.sh",
        "test:nlp:up": "./scripts/start-test-nlp.sh",
        "------------ PGBOUNCER VALIDATION (TASK-302 Stream C) ------------": "",
        "pgbv:up": "docker compose -f packages/database/tests/pgbouncer-validation/docker-compose.yml up -d",
        "pgbv:down": "docker compose -f packages/database/tests/pgbouncer-validation/docker-compose.yml down -v",
        "pgbv:logs": "docker compose -f packages/database/tests/pgbouncer-validation/docker-compose.yml logs -f",
        "pgbv:ps": "docker compose -f packages/database/tests/pgbouncer-validation/docker-compose.yml ps",
        "pgbv:show:config": "PGPASSWORD=hope_app_local psql -h 127.0.0.1 -p 6532 -U hope_app -d pgbouncer -c 'SHOW CONFIG;'",
        "pgbv:show:pools": "PGPASSWORD=hope_app_local psql -h 127.0.0.1 -p 6532 -U hope_app -d pgbouncer -c 'SHOW POOLS;'",
        "pgbv:show:stats": "PGPASSWORD=hope_app_local psql -h 127.0.0.1 -p 6532 -U hope_app -d pgbouncer -c 'SHOW STATS;'",
        "pgbv:push": "dotenv -e packages/database/tests/pgbouncer-validation/.env -- pnpm --filter @arcaai/database db:push",
        "pgbv:test": "dotenv -e packages/database/tests/pgbouncer-validation/.env -- vitest run --config packages/database/tests/pgbouncer-validation/vitest.config.ts",
        "pgbv:pgbench": "bash packages/database/tests/pgbouncer-validation/pgbench/run-baseline.sh",
        "------------ CODE GENERATION ------------": "",
        "gen:prisma": "pnpm --filter @arcaai/tools prisma-commander",
        "gen:model": "pnpm --filter @arcaai/tools generate-data-model",
        "gen:entity": "pnpm --filter @arcaai/tools generate-data-entity",
        "gen:mapper": "pnpm --filter @arcaai/tools generate-mapper",
        "gen:repository": "pnpm --filter @arcaai/tools generate-repository",
        "gen:factory": "pnpm --filter @arcaai/tools generate-factory",
        "gen:service": "pnpm --filter @arcaai/tools generate-service-module",
        "gen:controller": "pnpm --filter @arcaai/tools generate-controller",
        "gen:token": "pnpm --filter @arcaai/tools gen-dev-token",
        "gen:api-key": "pnpm --filter @arcaai/tools gen-api-key",
        "------------ TESTS (TypeScript) ------------": "",
        "test": "turbo run test",
        "test:unit": "dotenv -e .env.test -- vitest run --exclude '**/integration/**' --exclude '**/e2e/**'",
        "test:unit:watch": "dotenv -e .env.test -- vitest --exclude '**/integration/**' --exclude '**/e2e/**'",
        "test:unit:ui": "dotenv -e .env.test -- vitest --ui --exclude '**/integration/**' --exclude '**/e2e/**'",
        "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
        "test:e2e": "dotenv -e .env.test -- playwright test",
        "test:e2e:all": "turbo run test:e2e",
        "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
        "test:e2e:debug": "dotenv -e .env.test -- playwright test --debug",
        "test:coverage": "dotenv -e .env.test -- vitest run --coverage --exclude '**/integration/**' --exclude '**/e2e/**'",
        "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
        "test:ci": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
        "test:db:push": "dotenv -e .env.test -- pnpm --filter @arcaai/database db:push:force",
        "test:db:seed": "dotenv -e .env.test -- pnpm --filter @arcaai/database seed && pnpm test:db:seed:media",
        "test:db:seed:media": "dotenv -e .env.test -- tsx packages/applications/scripts/media-seed.ts",
        "test:db:reset": "pnpm test:db:push && pnpm test:db:seed",
        "------------ PYTHON SERVICES (Dev Servers, TASK-346) ------------": "",
        "dev:stt": "./scripts/dev-service.sh stt",
        "dev:stt:watch": "./scripts/dev-service.sh stt --watch",
        "dev:smr": "./scripts/dev-service.sh smr",
        "dev:smr:watch": "./scripts/dev-service.sh smr --watch",
        "dev:guardrail": "./scripts/dev-service.sh guardrail",
        "dev:guardrail:watch": "./scripts/dev-service.sh guardrail --watch",
        "dev:nlp": "./scripts/dev-service.sh nlp",
        "dev:nlp:watch": "./scripts/dev-service.sh nlp --watch",
        "dev:harness": "./scripts/dev-service.sh harness",
        "dev:harness:watch": "./scripts/dev-service.sh harness --watch",
        "dev:harness:worker": "./scripts/dev-service.sh worker",
        "dev:tts": "./scripts/dev-service.sh tts",
        "dev:tts:watch": "./scripts/dev-service.sh tts --watch",
        "------------ PYTHON SERVICES (STT) ------------": "",
        "py:stt:setup": "make -C apps/stt setup-cpu",
        "py:stt:setup:apple": "make -C apps/stt setup-apple",
        "py:stt:setup:gpu": "make -C apps/stt setup-gpu",
        "py:stt:check-env": "make -C apps/stt check-env",
        "py:stt:test": "conda run -n arcaenv --no-capture-output pytest apps/stt/tests/ -v --tb=short",
        "py:stt:test:unit": "conda run -n arcaenv --no-capture-output pytest apps/stt/tests/unit/ -v --tb=short",
        "py:stt:test:integration": "conda run -n arcaenv --no-capture-output pytest apps/stt/tests/integration/ -v --tb=short",
        "py:stt:test:cov": "conda run -n arcaenv --no-capture-output pytest apps/stt/tests/ --cov=apps/stt/src/stt --cov-report=term-missing",
        "py:stt:lint": "conda run -n arcaenv --no-capture-output ruff check apps/stt/src/ apps/stt/tests/",
        "py:stt:format": "conda run -n arcaenv --no-capture-output black apps/stt/src/ apps/stt/tests/",
        "py:stt:typecheck": "conda run -n arcaenv --no-capture-output mypy --config-file apps/stt/pyproject.toml apps/stt/src/",
        "------------ PYTHON SERVICES (SMR) ------------": "",
        "py:smr:test": "conda run -n arcaenv --no-capture-output pytest apps/smr/src/smr/tests/ -v --tb=short",
        "py:smr:test:unit": "conda run -n arcaenv --no-capture-output pytest apps/smr/src/smr/tests/unit/ -v --tb=short",
        "py:smr:test:cov": "conda run -n arcaenv --no-capture-output pytest apps/smr/src/smr/tests/ --cov=apps/smr/src/smr --cov-report=term-missing",
        "py:smr:lint": "conda run -n arcaenv --no-capture-output ruff check apps/smr/src/",
        "py:smr:format": "conda run -n arcaenv --no-capture-output black apps/smr/src/",
        "py:smr:typecheck": "conda run -n arcaenv --no-capture-output mypy --config-file apps/smr/pyproject.toml apps/smr/src/",
        "------------ PYTHON SERVICES (TTS) ------------": "",
        "py:tts:test": "conda run -n arcaenv --no-capture-output pytest apps/tts/src/tts/tests/ -v --tb=short",
        "py:tts:test:unit": "conda run -n arcaenv --no-capture-output pytest apps/tts/src/tts/tests/unit/ -v --tb=short",
        "py:tts:test:cov": "conda run -n arcaenv --no-capture-output pytest apps/tts/src/tts/tests/ --cov=apps/tts/src/tts --cov-report=term-missing",
        "py:tts:lint": "conda run -n arcaenv --no-capture-output ruff check apps/tts/src/",
        "py:tts:format": "conda run -n arcaenv --no-capture-output black apps/tts/src/",
        "py:tts:typecheck": "conda run -n arcaenv --no-capture-output mypy --config-file apps/tts/pyproject.toml apps/tts/src/",
        "------------ PYTHON SERVICES (NLP) ------------": "",
        "py:nlp:test": "conda run -n arcaenv --no-capture-output pytest apps/nlp/tests/ -v --tb=short",
        "py:nlp:lint": "conda run -n arcaenv --no-capture-output ruff check apps/nlp/src/ apps/nlp/tests/",
        "py:nlp:format": "conda run -n arcaenv --no-capture-output black apps/nlp/src/ apps/nlp/tests/",
        "py:nlp:typecheck": "conda run -n arcaenv --no-capture-output mypy --config-file apps/nlp/pyproject.toml apps/nlp/src/",
        "------------ PYTHON SERVICES (Harness) ------------": "",
        "py:harness:dev": "./scripts/dev-service.sh harness",
        "py:harness:worker": "./scripts/dev-service.sh worker",
        "py:harness:test": "conda run -n arcaenv --no-capture-output pytest apps/harness/src/harness/tests/ -v --tb=short",
        "py:harness:test:unit": "conda run -n arcaenv --no-capture-output pytest apps/harness/src/harness/tests/unit/ -v --tb=short",
        "py:harness:test:cov": "conda run -n arcaenv --no-capture-output pytest apps/harness/src/harness/tests/ --cov=apps/harness/src/harness --cov-report=term-missing",
        "py:harness:lint": "conda run -n arcaenv --no-capture-output ruff check apps/harness/src/",
        "py:harness:format": "conda run -n arcaenv --no-capture-output black apps/harness/src/",
        "py:harness:typecheck": "conda run -n arcaenv --no-capture-output mypy --config-file apps/harness/pyproject.toml apps/harness/src/",
        "------------ PYTHON SERVICES (Guardrail) ------------": "",
        "py:guardrail:test": "conda run -n arcaenv --no-capture-output pytest apps/guardrail/src/guardrail/tests/ -v --tb=short",
        "py:guardrail:test:cov": "conda run -n arcaenv --no-capture-output pytest apps/guardrail/src/guardrail/tests/ --cov=apps/guardrail/src/guardrail --cov-report=term-missing",
        "py:guardrail:lint": "conda run -n arcaenv --no-capture-output ruff check apps/guardrail/src/",
        "py:guardrail:format": "conda run -n arcaenv --no-capture-output black apps/guardrail/src/",
        "py:guardrail:typecheck": "conda run -n arcaenv --no-capture-output mypy --config-file apps/guardrail/pyproject.toml apps/guardrail/src/",
        "------------ PYTHON SERVICES (Env Setup) ------------": "",
        "py:setup": "./scripts/setup-python-env.sh",
        "py:setup:check": "./scripts/setup-python-env.sh --check",
        "py:setup:apple": "./scripts/setup-python-env.sh --apple",
        "py:setup:gpu": "./scripts/setup-python-env.sh --gpu",
        "------------ CODE QUALITY ------------": "",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "------------ GIT HOOKS (Phase 0 Item 6, TASK-302) ------------": "",
        "prepare": "simple-git-hooks || true"
    },
    "simple-git-hooks": {
        "pre-commit": "./scripts/gitleaks-precommit.sh"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.31.0+sha512.e3927388bfaa8078ceb79b748ffc1e8274e84d75163e67bc22e06c0d3aed43dd153151cbf11d7f8301ff4acb98c68bdc5cadf6989532801ffafe3b3e4a63c268",
    "devDependencies": {
        "@arcaai/config-eslint": "workspace:*",
        "@arcaai/config-rollup": "workspace:*",
        "@arcaai/config-ts": "workspace:*",
        "@playwright/test": "^1.61.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.9.4",
        "@vitest/coverage-istanbul": "^4.1.9",
        "@vitest/coverage-v8": "^4.1.9",
        "@vitest/ui": "^4.1.9",
        "bcryptjs": "^3.0.3",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.4",
        "jsdom": "^29.1.1",
        "jsonwebtoken": "^9.0.3",
        "prettier": "^3.9.4",
        "prisma": "^7.8.0",
        "rollup": "^4.62.2",
        "simple-git-hooks": "^2.13.1",
        "ts-node": "^10.9.2",
        "turbo": "^2.10.3",
        "typescript": "^5.9.3",
        "vitest": "^4.1.9",
        "zod": "^4.4.3"
    },
    "dependencies": {
        "@highlight-run/node": "^3.12.22",
        "@nestjs/bullmq": "^11.0.4",
        "@prisma/client": "^7.8.0",
        "bullmq": "^5.79.2",
        "class-validator": "0.15.1",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.4.2",
        "rimraf": "^6.1.3"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
