# Redis Environment Configuration
# Copy to .env and update values before deploying.
# chmod 600 .env — this file contains secrets.

# ── Required ─────────────────────────────────────────────────────────
# Strong password for Redis AUTH. Generate with: openssl rand -base64 24
REDIS_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD

# Environment label (dev or staging)
ENVIRONMENT=dev

# ── Docker Resource Limits (optional overrides) ─────────────────────
# Dev defaults: 768M limit, 256M reservation
# Staging defaults: 2560M limit, 512M reservation
# REDIS_MEM_LIMIT=2560M
# REDIS_MEM_RESERVATION=512M
