###############################################################################
# Langfuse Self-Hosted — Environment Variables
#
# Copy this file to .env and fill in the values before deploying:
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
#
# Location on VM 400: /opt/langfuse/.env
###############################################################################

# ── PostgreSQL (HA TimescaleDB VIP — VMs 500-502) ────────────────────────
# User with ownership of the `langfuse` database.
PG_USER=langfuse
PG_PASSWORD=76593cd720fd9d09a74628b0ad8584bdd7c60987df2be2be

# ── Redis (VM 420) ───────────────────────────────────────────────────────
# Same password as configured in VM 420's redis.conf requirepass.
REDIS_AUTH=gLaEEiGFvxERWdU75EVz3IIaTk6JlCJu_dev_password_here

# ── ClickHouse (local container) ─────────────────────────────────────────
# Credentials for the local ClickHouse instance (used only by Langfuse).
# Generate password: openssl rand -base64 24
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=fDjDsGbTaxO3919qOag3lDRP6sjNHNUy

# ── MinIO / S3 (VM 402, HTTPS-only) ─────────────────────────────────────
# Service account access key for the `langfuse` bucket.
# Create via: mc admin user svcacct add homelab langfuse-svc
MINIO_ACCESS_KEY=P6MWIZBLZUB0GGBAU5NS
MINIO_SECRET_KEY=zvcZIcm7qVYz2eaUVIWGfsA+gwyLPNsAJgScFKQ2
# MinIO CA cert must be placed at /opt/langfuse/certs/minio-ca.crt
# (see deployment doc §2.5 for how to copy it from VM 402)

# ── Langfuse Core Secrets ────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
NEXTAUTH_SECRET=uZyeREck5025+CKF7+M8ZAi0LC/dqek7qWdBg0bzY2Q=

# Generate with: openssl rand -base64 32
LANGFUSE_SALT=v8vrHkW3V5n5rb/TaEn5RFzYkBr4LDCsuwXmZrH1x/4=

# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars)
LANGFUSE_ENCRYPTION_KEY=caa2ebcfe56497511c84316e75b0b53a3bafcc68d38973585e3c95a1e50708c5

# ── Initial Setup (remove after first successful login) ─────────────────
# These seed an org, project, and admin user on first startup.
# After verifying login, comment out or remove these lines.
LANGFUSE_INIT_ORG_NAME=4bits
LANGFUSE_INIT_PROJECT_NAME=4bits
LANGFUSE_INIT_USER_EMAIL=admin@taphuynh.dev
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=kVMBPw08MYEVRY4bIpIK4yhVzZVFvhGZ

# Optional: pre-set project keys (leave empty to auto-generate)
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=

# ── Batch Export (optional) ──────────────────────────────────────────────
# Enable to allow CSV/JSON exports of traces to MinIO.
LANGFUSE_S3_BATCH_EXPORT_ENABLED=true

# ── Email / SMTP (optional) ─────────────────────────────────────────────
# Required for password resets and email invitations.
# EMAIL_FROM_ADDRESS=langfuse@taphuynh.dev
# SMTP_CONNECTION_URL=smtp://user:pass@smtp.example.com:587
