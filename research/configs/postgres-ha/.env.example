# TimescaleDB HA Cluster — Environment Variables
# Image: timescale/timescaledb-ha:pg17-all-amd64
# Copy to .env and fill in values on each node
# Generate passwords: openssl rand -base64 24

# ── Node Identity ──
# Set per node: pg-node1, pg-node2, pg-node3
NODE_NAME=pg-node1
NODE_IP=10.10.1.200

# ── PostgreSQL ──
PG_PASSWORD=CHANGE_ME_superuser_password
REPL_PASSWORD=CHANGE_ME_replicator_password

# ── Application Database ──
APP_DB=hope
APP_USER=hope_app
APP_PASSWORD=CHANGE_ME_app_password

# ── PgBouncer ──
PGBOUNCER_PASSWORD=CHANGE_ME_pgbouncer_password

# ── Cluster Peers ──
PEER1_IP=10.10.1.200
PEER2_IP=10.10.1.201
PEER3_IP=10.10.1.202

# ── VIP (Keepalived) ──
VIP=10.10.1.250
