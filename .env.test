# ============================================================================
# HOPE Platform - Test Environment Configuration
# ============================================================================
# This file contains environment variables for running tests LOCALLY.
#
# IMPORTANT: This configuration uses ISOLATED test infrastructure:
#   - PostgreSQL: port 5433 (dev uses 5432)
#   - Redis:      port 6380 (dev uses 6379)
#   - MinIO:      port 9002 (dev uses 9000)
#   - Qdrant:     port 6335 (dev uses 6333)
#
# USAGE:
#   Local (docker-compose test containers):
#     1. Start test infrastructure: pnpm docker:test:up
#     2. Validate services: pnpm docker:test:validate
#     3. Run tests: pnpm test:unit / pnpm test:integration / pnpm test:e2e
#     4. Stop infrastructure: pnpm docker:test:down
#
#   CI/CD (external HA infrastructure):
#     - GitLab CI:      .gitlab/ci/test.yml injects env vars pointing to
#                        HA-Postgres (10.10.1.250:5000) and Redis (10.10.1.120:6379/8)
#     - GitHub Actions:  setup-test-env action with use-external-db=true, or
#                        falls back to ephemeral service containers (default)
#
#   See also:
#     - .github/actions/setup-test-env/action.yml (GitHub Actions env setup)
#     - .gitlab/ci/test.yml (GitLab CI test stage)
#     - tests/docker-compose.test.yml (local test containers)
#
# ============================================================================

# =============================================================================
# CORE ENVIRONMENT
# =============================================================================
NODE_ENV=test
CI=false

# =============================================================================
# DATABASE CONFIGURATION (Test Database - Port 5433)
# =============================================================================
# Uses port 5433 to avoid conflicts with local development database on 5432
# In-transit TLS (TASK-369 Phase 2): the test database is isolated/ephemeral
# (local containers, no server cert) and intentionally runs WITHOUT TLS. Only
# production/staging connection strings enforce sslmode=require|verify-full.
DATABASE_URL=postgresql://test:test@localhost:5433/hope_test?schema=public
DATABASE_URL_DIRECT=postgresql://test:test@localhost:5433/hope_test?schema=public

# =============================================================================
# REDIS CONFIGURATION (Test Redis - Port 6380)
# =============================================================================
# Uses port 6380 to avoid conflicts with local development Redis on 6379
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASS=test_redis_pass
REDIS_URL=redis://:test_redis_pass@localhost:6380

# =============================================================================
# MINIO CONFIGURATION (Test MinIO - Port 9002)
# =============================================================================
# Uses port 9002 to avoid conflicts with local development MinIO on 9000
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=testpassword
MINIO_USE_SSL=false

# S3Service reads S3_ENDPOINT (AppSettingsService) + S3_ACCESS_KEY/S3_SECRET_KEY
# (SecretsService). These mirror the MinIO test bucket above; without them the
# S3 client fails its required-config validation and storage routes 500.
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=testpassword

# =============================================================================
# API GATEWAY CONFIGURATION
# =============================================================================
PORT=8868
API_PORT=8868
API_URL=http://localhost:8868

# =============================================================================
# JWT/SECURITY CONFIGURATION (Test-only secrets)
# =============================================================================
# WARNING: These are test-only secrets - NEVER use in production
JWT_SECRET=test-jwt-secret-for-testing-only-do-not-use-in-production
# The auth sign-path + JwtStrategy resolve the signing key via
# SecretsService.getSecretSync('JWT_SECRET_KEY'). Without it the controller
# throws "Authentication system not configured" (401) and every login fails.
JWT_SECRET_KEY=test-jwt-secret-key-for-e2e-only-not-for-production-aaaa
JWT_EXPIRES_IN=1h
# SecretsService caches boot-warmed keys (JWT_SECRET_KEY, API_KEY_PEPPER, …)
# with this TTL. The auth sign-path reads them via getSecretSync (cache-only,
# no lazy re-fetch). At the 300s default the warmed JWT secret expires while a
# long-lived test API idles between runs, so the NEXT login throws
# "Authentication system not configured" (401) and cascades into every spec.
# A long TTL keeps the warmed secret valid for the whole test session; rotation
# isn't exercised in tests, so there's no downside here.
SECRETS_TTL_SEC=86400
JWT_REFRESH_SECRET=test-refresh-secret-for-testing-only
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET_KEY=test-session-secret

# API Key Security (test values)
API_KEY_PEPPER=test-pepper-for-testing-only-do-not-use-in-production
API_KEY_ALLOW_QUERY_PARAM=true
API_KEY_MAX_LIFETIME_DAYS=90

# =============================================================================
# RATE LIMITING (TASK-315 — disabled for the full E2E suite)
# =============================================================================
# The gateway throttler (TieredThrottlerGuard) keys per IP. Playwright runs
# fully parallel against ONE API process from ONE localhost IP, so the shared
# per-IP counters (login = 5/min, default tier = 100/min) trip 429 almost
# immediately and cascade through every spec's login. Disabling throttling for
# the suite is the documented kill-switch (TASK-315 §1.5 AC-5).
#
# Enforcement is still covered by the in-process integration test
# (apps/api/src/modules/throttle/__tests__/throttle-guard.test.ts, run under
# `pnpm test:unit` with throttling pinned ON). To exercise the E2E throttle
# spec, run it in isolation with throttling ON on BOTH the API and the runner:
#   RATE_LIMIT_ENABLED=true pnpm dev:api:test            # API with throttling on
#   RATE_LIMIT_ENABLED=true pnpm test:e2e --grep auth-throttle-per-endpoint
RATE_LIMIT_ENABLED=false

# =============================================================================
# MICROSERVICE URLS (Disabled for unit/integration tests)
# =============================================================================
# These services are mocked in unit tests and may or may not be available
# in integration/e2e tests depending on the test scope
STT_V2_PORT=8861
STT_V2_URL=http://localhost:8861
SMR_PORT=8862
SMR_URL=http://localhost:8862
NLP_PORT=8864
NLP_URL=http://localhost:8864
GUARDRAIL_URL=http://localhost:8863
HARNESS_URL=http://localhost:8866

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Minimal logging during tests for cleaner output
LOG_LEVEL=error
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs

# =============================================================================
# MQTT CONFIGURATION (Disabled for tests)
# =============================================================================
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# =============================================================================
# OBSERVABILITY (Disabled for tests)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false

# =============================================================================
# TEST-SPECIFIC CONFIGURATION
# =============================================================================
# Default tenant and user IDs for test data
DEFAULT_TENANT_ID=50000000-0000-0000-0000-000000000000
SYSTEM_USER_ID=60000000-0000-0000-0000-000000000000

# Prisma debugging (enable for troubleshooting)
DEBUG_PRISMA=false

# Skip seeding (useful for specific test scenarios)
SKIP_SEED=false
