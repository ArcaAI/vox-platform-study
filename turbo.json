{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "tasks": {
        "build": {
            "dependsOn": ["^build", "^db:generate"],
            "cache": false,
            "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/dist/**", "storybook-static/**", "pkg/**"],
            "env": ["NEXT_PUBLIC_API_HOST"]
        },
        "@arcaai/database#build": {
            "dependsOn": ["db:generate", "^build"],
            "cache": false,
            "outputs": ["dist/**"]
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "lint:fix": {
            "cache": false,
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build", "^db:generate"],
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^db:generate"]
        },
        "dev:watch": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^dev:watch"]
        },
        "start": {
            "dependsOn": ["^build"]
        },
        "clean": {
            "cache": false
        },
        "test:e2e": {},
        "test": {
            "dependsOn": ["build"],
            "outputs": [],
            "inputs": ["src/**/*.tsx", "src/**/*.ts", "__tests__/**/*.ts", "__tests__/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "test:unit": {
            "dependsOn": ["build"],
            "outputs": []
        },
        "test:cov": {
            "dependsOn": ["build"],
            "outputs": ["coverage/**"]
        },
        "db:generate": {
            "cache": false,
            "outputs": ["src/generated/**"]
        },
        "db:push": {
            "cache": false,
            "dependsOn": ["db:generate"]
        },
        "db:push:force": {
            "cache": false,
            "dependsOn": ["db:generate"]
        },
        "db:migrate": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["db:generate"]
        },
        "db:migrate:deploy": {
            "cache": false
        },
        "db:studio": {
            "cache": false,
            "persistent": true
        },
        "seed": {
            "cache": false,
            "dependsOn": ["db:generate"]
        },
        "prisma-commander": {
            "cache": false
        },
        "generate-prisma-index": {
            "cache": false
        },
        "gen-dev-token": {
            "cache": false
        },
        "nuke": {
            "cache": false
        },
        "storybook": {
            "dependsOn": ["@arcaai/ui#build"]
        }
    },
    "globalEnv": [
        "NEXT_PUBLIC_API_HOST",
        "NODE_ENV",
        "API_URL",
        "ADMIN_SESSION_SECRET",
        "DATABASE_URL",
        "PORT",
        "STT_URL",
        "STT_WS_EGRESS_HIGH_WATERMARK_BYTES",
        "STT_WS_RESUME_GRACE_MS",
        "STREAMING_PARTIAL_INTERVAL_S",
        "NLP_URL",
        "NLP_GATEWAY_URL",
        "SMR_URL",
        "TTS_URL",
        "TTS_PORT",
        "TTS_SERVICE_TOKEN",
        "TTS_GATEWAY_URL",
        "TTS_WS_EGRESS_HIGH_WATERMARK_BYTES",
