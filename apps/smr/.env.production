# =============================================================================
# SMR Service — Production Environment Variables
# =============================================================================

# Application
SMR_HOST=0.0.0.0
SMR_PORT=8862
SMR_LOG_LEVEL=info
SMR_DEBUG=false

# OpenTelemetry (TASK-254)
SMR_OTEL_ENABLED=true
SMR_OTEL_EXPORTER_ENDPOINT=http://10.10.1.100:4317
SMR_OTEL_SERVICE_NAME=smr
SMR_OTEL_SERVICE_NAMESPACE=hope
SMR_OTEL_DEPLOYMENT_ENVIRONMENT=production
SMR_OTEL_INSECURE=true
SMR_OTEL_LOGS_ENABLED=true

# Prometheus Metrics
SMR_METRICS_ENABLED=true

# Redis
SMR_REDIS_URL=redis://localhost:6379/0

# Providers — configure per deployment
SMR_AZURE_ENABLED=false
SMR_OLLAMA_ENABLED=false
SMR_OPENAI_COMPAT_ENABLED=false
