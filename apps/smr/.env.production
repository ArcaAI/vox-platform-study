# =============================================================================
# SMR Service — Production Environment Variables
# =============================================================================

# Application
SMR_V2_HOST=0.0.0.0
SMR_V2_PORT=8862
SMR_V2_LOG_LEVEL=info
SMR_V2_DEBUG=false

# OpenTelemetry (TASK-254)
SMR_V2_OTEL_ENABLED=true
SMR_V2_OTEL_EXPORTER_ENDPOINT=http://10.10.1.100:4317
SMR_V2_OTEL_SERVICE_NAME=smr-v2
SMR_V2_OTEL_SERVICE_NAMESPACE=hope
SMR_V2_OTEL_DEPLOYMENT_ENVIRONMENT=production
SMR_V2_OTEL_INSECURE=true
SMR_V2_OTEL_LOGS_ENABLED=true

# Prometheus Metrics
SMR_V2_METRICS_ENABLED=true

# Redis
SMR_V2_REDIS_URL=redis://localhost:6379/0

# Providers — configure per deployment
SMR_V2_AZURE_ENABLED=false
SMR_V2_OLLAMA_ENABLED=false
SMR_V2_BEDROCK_ENABLED=false
SMR_V2_OPENAI_COMPAT_ENABLED=false
