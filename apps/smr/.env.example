# =============================================================================
# SMR V2 — Environment Variables
# =============================================================================
# Copy this file to .env and fill in secrets. Used by docker-compose and local dev.
# All variables use the SMR_V2_ prefix (or provider-specific prefixes).

# -----------------------------------------------------------------------------
# Application (SMR_V2_)
# -----------------------------------------------------------------------------

# Bind host (default: 0.0.0.0)
SMR_V2_HOST=0.0.0.0

# Service port (default: 8862)
SMR_V2_PORT=8862

# Enable debug mode (default: false)
SMR_V2_DEBUG=false

# Log level: debug, info, warning, error (default: info)
SMR_V2_LOG_LEVEL=info

# CORS allowed origins as JSON array, e.g. ["http://localhost:8868/api/v1"]
SMR_V2_CORS_ORIGINS=[]

# Enable CORS middleware (default: false)
SMR_V2_CORS_ENABLED=false

# Service token for inter-service auth. Empty = auth disabled (local dev)
SMR_V2_SERVICE_TOKEN=

# HTTP client pool: max connections (default: 200)
SMR_V2_HTTPX_MAX_CONNECTIONS=200

# HTTP client pool: max keepalive connections (default: 100)
SMR_V2_HTTPX_MAX_KEEPALIVE=100

# Guardrail mode: log, block, or off (default: log)
SMR_V2_GUARDRAIL_MODE=log

# Enable guardrails (default: true)
SMR_V2_GUARDRAIL_ENABLED=true

# External Guardrail service integration (default: disabled)
SMR_V2_EXTERNAL_GUARDRAIL_ENABLED=false
SMR_V2_EXTERNAL_GUARDRAIL_BASE_URL=http://localhost:8863
SMR_V2_EXTERNAL_GUARDRAIL_TIMEOUT_S=10
SMR_V2_EXTERNAL_GUARDRAIL_FAIL_OPEN=false
SMR_V2_EXTERNAL_GUARDRAIL_REQUIRE_MEDICAL=true
SMR_V2_EXTERNAL_GUARDRAIL_INCLUDE_REASONING=false
SMR_V2_EXTERNAL_GUARDRAIL_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# OpenTelemetry (SMR_V2_OTEL_)
# -----------------------------------------------------------------------------

# Enable OpenTelemetry tracing (default: false)
SMR_V2_OTEL_ENABLED=false

# OTLP exporter endpoint (default: http://localhost:4317)
SMR_V2_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# Service name for traces (default: smr-v2)
SMR_V2_OTEL_SERVICE_NAME=smr-v2

# Enable Prometheus metrics endpoint (default: true)
SMR_V2_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Redis (SMR_V2_)
# -----------------------------------------------------------------------------

# Redis URL for task management (default: redis://localhost:6379/0)
SMR_V2_REDIS_URL=redis://localhost:6379/0

# Task TTL in seconds (default: 3600)
SMR_V2_TASK_TTL_SECONDS=3600

# Stream max length for Redis Streams (default: 10000)
SMR_V2_STREAM_MAX_LEN=10000

# -----------------------------------------------------------------------------
# Circuit Breaker (SMR_V2_CB_)
# -----------------------------------------------------------------------------

# Failures before opening circuit (default: 5)
SMR_V2_CB_FAILURE_THRESHOLD=5

# Seconds before half-open attempt (default: 30.0)
SMR_V2_CB_RECOVERY_TIMEOUT_S=30.0

# Max calls in half-open state (default: 3)
SMR_V2_CB_HALF_OPEN_MAX_CALLS=3

# Seconds before full reset (default: 120.0)
SMR_V2_CB_RESET_TIMEOUT_S=120.0

# Count rate limits as failures (default: true)
SMR_V2_CB_COUNT_RATE_LIMITS=true

# -----------------------------------------------------------------------------
# Request Queue (SMR_V2_QUEUE_)
# -----------------------------------------------------------------------------

# Max queue size per provider (default: 200)
SMR_V2_QUEUE_MAX_SIZE=200

# Max wait time in seconds before rejecting (default: 60.0)
SMR_V2_QUEUE_MAX_WAIT_S=60.0

# -----------------------------------------------------------------------------
# Ollama Provider (SMR_V2_OLLAMA_)
# -----------------------------------------------------------------------------

# Enable Ollama provider (default: false)
SMR_V2_OLLAMA_ENABLED=false

# Ollama base URL (default: http://localhost:11434)
SMR_V2_OLLAMA_BASE_URL=http://localhost:11434

# Default model (default: llama3.2:latest)
SMR_V2_OLLAMA_DEFAULT_MODEL=llama3.2:latest

# Request timeout in seconds (default: 300)
SMR_V2_OLLAMA_TIMEOUT_S=300

# Max concurrent requests (default: 4)
SMR_V2_OLLAMA_MAX_CONCURRENT=4

# Backoff between queued requests in seconds (default: 2.0)
SMR_V2_OLLAMA_QUEUE_BACKOFF_S=2.0

# -----------------------------------------------------------------------------
# Azure OpenAI Provider (SMR_V2_AZURE_)
# -----------------------------------------------------------------------------

# Enable Azure OpenAI provider (default: false)
SMR_V2_AZURE_ENABLED=false

# Azure API key (required if enabled)
SMR_V2_AZURE_API_KEY=

# Azure endpoint URL (e.g. https://your-resource.openai.azure.com/)
SMR_V2_AZURE_ENDPOINT=

# API version (default: 2024-12-01-preview)
SMR_V2_AZURE_API_VERSION=2024-12-01-preview

# Deployment name
SMR_V2_AZURE_DEPLOYMENT_NAME=

# Default model (default: gpt-4)
SMR_V2_AZURE_DEFAULT_MODEL=gpt-4

# Request timeout in seconds (default: 120)
SMR_V2_AZURE_TIMEOUT_S=120

# Max concurrent requests (default: 10)
SMR_V2_AZURE_MAX_CONCURRENT=10

# Tokens per minute limit (default: 80000)
SMR_V2_AZURE_TPM_LIMIT=80000

# Requests per minute limit (default: 480)
SMR_V2_AZURE_RPM_LIMIT=480

# Use adaptive limits from provider headers (default: true)
SMR_V2_AZURE_ADAPTIVE_LIMITS=true

# Content filter severity: low, medium, high (default: medium)
SMR_V2_AZURE_CONTENT_FILTER_SEVERITY=medium

# -----------------------------------------------------------------------------
# AWS Bedrock Provider (SMR_V2_BEDROCK_)
# -----------------------------------------------------------------------------

# Enable Bedrock provider (default: false)
SMR_V2_BEDROCK_ENABLED=false

# AWS region (default: us-east-1)
SMR_V2_BEDROCK_REGION=us-east-1

# Default model (e.g. anthropic.claude-3-haiku-20240307-v1:0)
SMR_V2_BEDROCK_DEFAULT_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Request timeout in seconds (default: 120)
SMR_V2_BEDROCK_TIMEOUT_S=120

# Max concurrent requests (default: 10)
SMR_V2_BEDROCK_MAX_CONCURRENT=10

# Max pool connections for httpx (default: 150)
SMR_V2_BEDROCK_MAX_POOL_CONNECTIONS=150

# Tokens per minute limit (default: 100000)
SMR_V2_BEDROCK_TPM_LIMIT=100000

# Requests per minute limit (default: 100)
SMR_V2_BEDROCK_RPM_LIMIT=100

# Backoff after throttle in seconds (default: 30.0)
SMR_V2_BEDROCK_THROTTLE_BACKOFF_S=30.0

# Bedrock guardrail ID (optional)
SMR_V2_BEDROCK_GUARDRAIL_ID=

# Guardrail version: DRAFT or version number (default: DRAFT)
SMR_V2_BEDROCK_GUARDRAIL_VERSION=DRAFT

# -----------------------------------------------------------------------------
# OpenAI-Compatible Provider (SMR_V2_OPENAI_COMPAT_)
# -----------------------------------------------------------------------------

# Enable OpenAI-compatible provider (default: false)
SMR_V2_OPENAI_COMPAT_ENABLED=false

# Base URL (e.g. http://localhost:1234/v1)
SMR_V2_OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1

# API key (use "not-needed" for local models without auth)
SMR_V2_OPENAI_COMPAT_API_KEY=not-needed

# Default model (default: local-model)
SMR_V2_OPENAI_COMPAT_DEFAULT_MODEL=local-model

# Request timeout in seconds (default: 300)
SMR_V2_OPENAI_COMPAT_TIMEOUT_S=300

# Max concurrent requests (default: 4)
SMR_V2_OPENAI_COMPAT_MAX_CONCURRENT=4

# Organization header (optional)
# SMR_V2_OPENAI_COMPAT_ORGANIZATION=

# -----------------------------------------------------------------------------
# Docker Compose Overrides (optional)
# -----------------------------------------------------------------------------

# SMR port mapping (default: 8862)
# SMR_PORT=8862

# Redis port mapping (default: 6379)
# REDIS_PORT=6379

# Grafana admin password when using monitoring profile (default: admin)
# GRAFANA_PASSWORD=admin
