# =============================================================================
# Text Service — Production Environment Reference
# =============================================================================
# Reference template — fill in for your deployment. Not loaded by the app
# itself; production is configured by whichever mechanism your deployment
# uses (K8s ConfigMap/Secret, systemd EnvironmentFile=) to populate the host
# environment.
#
# THIS FILE IS THE BOOTSTRAP FLOOR AND NOTHING ELSE.
#
# `apps/text` is a stateless ROUTER. It selects no provider, holds no vendor
# credential, owns no engine endpoint and stores no tuning value. Everything
# that varies — by tenant, by provider, by model, by deployment — arrives from
# the control plane through two channels: PUSH per request
# (connection, BYO credential, model selection) and PULL per service
# (`GET /internal/effective-config?service=text`).
#
# What survives here is only what the process needs BEFORE either channel can
# answer: its own port, the addresses it must reach, the one shared internal
# credential, and the PHI telemetry guard.
#
# There is deliberately NO per-provider block. `TEXT_{VLLM,LLAMA_CPP,OLLAMA,
# OPENAI,ANTHROPIC,AZURE,BEDROCK,VERTEX,OPENAI_COMPAT,SARVAM,TEI}_*` were
# DELETED and are banned by name in
# `test_task799_config_surface.py`. Setting one has no effect whatsoever.
# Engine endpoints live on `AiProviderConnection` rows; an adapter with no
# injected connection FAILS CLOSED (`core/connection.py`), because a
# process-wide endpoint is one no tenant could ever override.
# =============================================================================

# --- The one shared internal service credential (owner decision D-D) --------
# Identical across every HOPE service. What this service ACCEPTS as inbound
# `X-Service-Token` and what it PRESENTS on every outbound peer call.
# Empty = local-dev bypass; MUST be set in production.
INTERNAL_ACCESS_TOKEN=

# --- PHI telemetry guard — MANDATORY -----------------------------------------
# `NODE_ENV=production` REFUSES TO BOOT unless this is exactly `NO_CONTENT`
# (`TelemetryPhiGuardConfig._assert_content_capture_disabled_in_production`).
# The OpenTelemetry GenAI conventions capture prompt and response payloads when
# this is enabled; on a clinical path that is PHI in an observability store.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# --- Bootstrap transport addresses -------------------------------------------
# The control plane this service PULLs its capacity/timeout/lane budgets from.
TEXT_GATEWAY_URL=http://hope-api:8868/api/v1

# Streaming replay buffer and rate-limit state.
TEXT_REDIS_URL=redis://hope-redis:6379/0

# The moderation peer gating public generation. An ADDRESS, not a policy —
# posture and thresholds are control-plane resolved.
TEXT_EXTERNAL_GUARDRAIL_BASE_URL=http://hope-guardrail:8863

# OTLP collector. Empty disables export.
TEXT_OTEL_EXPORTER_ENDPOINT=

# --- Process identity ---------------------------------------------------------
TEXT_PORT=8862
TEXT_LOG_LEVEL=info
