# =============================================================================
# TEXT Service — Production Environment Variables
# =============================================================================

# Application
TEXT_HOST=0.0.0.0
TEXT_PORT=8862
TEXT_LOG_LEVEL=info
TEXT_DEBUG=false

# OpenTelemetry (TASK-254)
TEXT_OTEL_ENABLED=true
TEXT_OTEL_EXPORTER_ENDPOINT=http://10.10.1.100:4317
TEXT_OTEL_SERVICE_NAME=text
TEXT_OTEL_SERVICE_NAMESPACE=hope
TEXT_OTEL_DEPLOYMENT_ENVIRONMENT=production
TEXT_OTEL_INSECURE=true
TEXT_OTEL_LOGS_ENABLED=true

# Prometheus Metrics
TEXT_METRICS_ENABLED=true

# Redis
TEXT_REDIS_URL=redis://localhost:6379/0

# Providers — configure per deployment. NOTE: TEXT gates a provider by the
# PRESENCE of its connection config, not by an `enabled` flag — none of
# Azure/OpenAI-compat/vLLM/llama.cpp have such a field; leave a
# provider's base_url/api_key unset to disable it (verified 2026-07-28, TASK-582).

# TEXT production inference engines (relocated from the monorepo-root
# `.env.production`, TASK-584). In-cluster the engines are the hope-vllm /
# hope-llama-cpp Services (k3s base).
TEXT_VLLM_BASE_URL=http://hope-vllm:8000/v1
TEXT_VLLM_TIMEOUT_S=300
TEXT_VLLM_MAX_CONCURRENT=8
TEXT_VLLM_USE_GUIDED_JSON=false
TEXT_LLAMA_CPP_BASE_URL=http://hope-llama-cpp:8080
TEXT_LLAMA_CPP_TIMEOUT_S=300
TEXT_LLAMA_CPP_MAX_CONCURRENT=4
