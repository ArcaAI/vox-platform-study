# =============================================================================
# TEXT — Environment Variables
# =============================================================================
# Copy this file to .env and fill in secrets. Used by docker-compose and local dev.
# All variables use the TEXT_ prefix (or provider-specific prefixes).

# -----------------------------------------------------------------------------
# Application (TEXT_)
# -----------------------------------------------------------------------------

# Bind host (default: 0.0.0.0)
TEXT_HOST=0.0.0.0

# Service port (default: 8862)
TEXT_PORT=8862

# Enable debug mode (default: false)
TEXT_DEBUG=false

# Log level: debug, info, warning, error (default: info)
TEXT_LOG_LEVEL=info

# CORS allowed origins as JSON array, e.g. ["http://localhost:8868/api/v1"]
TEXT_CORS_ORIGINS=[]

# Enable CORS middleware (default: false)
TEXT_CORS_ENABLED=false

# Service token for inter-service auth. Empty = auth disabled (local dev)
TEXT_SERVICE_TOKEN=

# --- CANONICAL internal service credential (owner decision D-D, TASK-737/738) --
# INTERNAL_ACCESS_TOKEN is THE one shared internal access token: identical across
# every HOPE service, set by the DevOps engineer, internal use only. It is what
# this service ACCEPTS as X-Service-Token inbound and what it PRESENTS as
# X-Service-Token on every outbound peer call. Unprefixed on purpose — it belongs
# to no single service.
# The per-service / per-pair *_SERVICE_TOKEN vars below are retained ONLY as a
# zero-cost backward-compatibility fallback (inbound accepts EITHER; outbound
# prefers this one and falls back). Set this and the legacy family can be dropped.
# Empty everywhere = auth disabled (local dev / hermetic CI), unchanged.
INTERNAL_ACCESS_TOKEN=

# Where the control plane lives (bootstrap transport, not config authority).
TEXT_GATEWAY_URL=http://localhost:8868/api/v1

# HTTP client pool: max connections (default: 200)
TEXT_HTTPX_MAX_CONNECTIONS=200

# HTTP client pool: max keepalive connections (default: 100)
TEXT_HTTPX_MAX_KEEPALIVE=100

# External Guardrail service integration (default: disabled).
# Fail posture is degrade-safe -> fail-CLOSED (TASK-478): a transient blip is
# absorbed by a bounded retry (MAX_RETRIES / RETRY_BACKOFF_MS), a sustained outage
# rejects (retryable 503), and an errored guardrail NEVER allows. ENABLED=false is
# the dev/CI bypass; clinical/production must enable it (ops rollout step).
TEXT_EXTERNAL_GUARDRAIL_ENABLED=false
TEXT_EXTERNAL_GUARDRAIL_BASE_URL=http://localhost:8863
TEXT_EXTERNAL_GUARDRAIL_TIMEOUT_S=10
TEXT_EXTERNAL_GUARDRAIL_MAX_RETRIES=2
TEXT_EXTERNAL_GUARDRAIL_RETRY_BACKOFF_MS=100
TEXT_EXTERNAL_GUARDRAIL_REQUIRE_MEDICAL=true
TEXT_EXTERNAL_GUARDRAIL_INCLUDE_REASONING=false
TEXT_EXTERNAL_GUARDRAIL_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# OpenTelemetry (TEXT_OTEL_)
# -----------------------------------------------------------------------------

# Enable OpenTelemetry tracing (default: false)
TEXT_OTEL_ENABLED=false

# OTLP exporter endpoint (default: http://localhost:4317)
TEXT_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# Service name for traces (default: text)
TEXT_OTEL_SERVICE_NAME=text

# Service namespace for trace grouping (default: hope)
TEXT_OTEL_SERVICE_NAMESPACE=hope

# Deployment environment for trace filtering (default: production)
TEXT_OTEL_DEPLOYMENT_ENVIRONMENT=production

# Use insecure (non-TLS) gRPC connection to OTLP collector (default: true)
TEXT_OTEL_INSECURE=true

# Enable OTLP log export to Loki via OTel Collector (default: true when otel_enabled)
TEXT_OTEL_LOGS_ENABLED=true

# Enable Prometheus metrics endpoint (default: true)
TEXT_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# PHI-safe telemetry (bare — no TEXT_ prefix; shared cross-process convention,
# TASK-615 WS-G, docs/operations/telemetry-phi-guardrails.md)
# -----------------------------------------------------------------------------

# Pins the OTel GenAI instrumentation-library content-capture switch off so
# prompt/completion text (PHI) never lands on spans. Read identically by
# apps/api (Node) and every Python service via the SAME bare name — see
# `TelemetryPhiGuardConfig` in core/config.py. Boot refuses to start when
# NODE_ENV=production and this is unset or not exactly NO_CONTENT.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# -----------------------------------------------------------------------------
# Redis (TEXT_)
# -----------------------------------------------------------------------------

# Redis URL for task management (default: redis://localhost:6379/0)
TEXT_REDIS_URL=redis://localhost:6379/0

# Task TTL in seconds (default: 3600)
TEXT_TASK_TTL_SECONDS=3600

# Stream max length for Redis Streams (default: 10000)
TEXT_STREAM_MAX_LEN=10000

# -----------------------------------------------------------------------------
# Circuit Breaker (TEXT_CB_)
# -----------------------------------------------------------------------------

# Failures before opening circuit (default: 5)
TEXT_CB_FAILURE_THRESHOLD=5

# Seconds before half-open attempt (default: 30.0)
TEXT_CB_RECOVERY_TIMEOUT_S=30.0

# Max calls in half-open state (default: 3)
TEXT_CB_HALF_OPEN_MAX_CALLS=3

# Seconds before full reset (default: 120.0)
TEXT_CB_RESET_TIMEOUT_S=120.0

# Count rate limits as failures (default: true)
TEXT_CB_COUNT_RATE_LIMITS=true

# -----------------------------------------------------------------------------
# Request Queue (TEXT_QUEUE_)
# -----------------------------------------------------------------------------

# Max queue size per provider (default: 200)
TEXT_QUEUE_MAX_SIZE=200

# Max wait time in seconds before rejecting (default: 60.0)
TEXT_QUEUE_MAX_WAIT_S=60.0

# -----------------------------------------------------------------------------
# Ollama Provider (TEXT_OLLAMA_) — self-host tier (OPTIONAL).
# The provider logic is supported (owner decision 2026-08-17, TASK-736) but the
# platform seeds NO Ollama model catalog, so there is deliberately no
# TEXT_OLLAMA_DEFAULT_MODEL here: the model id is DB-tier config that arrives
# with the request (tenant AiModel / AiTaskDefault), never an env var.
# NOTE: no TEXT_OLLAMA_ENABLED — gated by base_url presence, same as vLLM.
# -----------------------------------------------------------------------------
# TEXT_OLLAMA_BASE_URL=http://localhost:11434
# TEXT_OLLAMA_TIMEOUT_S=300
# TEXT_OLLAMA_MAX_CONCURRENT=4
# TEXT_OLLAMA_QUEUE_BACKOFF_S=2.0

# -----------------------------------------------------------------------------
# vLLM Provider (TEXT_VLLM_) — production self-host tier (OPTIONAL).
# Root .env.production already configures this engine (hope-vllm in-cluster
# Service); commented here since it's not part of the local dev default stack.
# NOTE: no TEXT_VLLM_ENABLED — gated by base_url presence, same as Azure.
# -----------------------------------------------------------------------------
# TEXT_VLLM_BASE_URL=http://localhost:8000/v1
# TEXT_VLLM_TIMEOUT_S=300
# TEXT_VLLM_MAX_CONCURRENT=8
# TEXT_VLLM_USE_GUIDED_JSON=false

# -----------------------------------------------------------------------------
# llama.cpp Provider (TEXT_LLAMA_CPP_) — production self-host tier (OPTIONAL).
# Root .env.production already configures this engine (hope-llama-cpp
# in-cluster Service). NOTE: no TEXT_LLAMA_CPP_ENABLED, same reason as above.
# -----------------------------------------------------------------------------
# TEXT_LLAMA_CPP_BASE_URL=http://localhost:8080
# TEXT_LLAMA_CPP_TIMEOUT_S=300
# TEXT_LLAMA_CPP_MAX_CONCURRENT=4

# -----------------------------------------------------------------------------
# Azure OpenAI Provider (TEXT_AZURE_)
# -----------------------------------------------------------------------------

# NOTE: there is deliberately NO `TEXT_AZURE_ENABLED`. TEXT gates a provider by
# the PRESENCE of its connection config, not by an `enabled` flag —
# `AzureOpenAIConfig` has no such field (verified 2026-07-28, TASK-582).

# TASK-602: Azure OpenAI is BYOK-only — the api_key is NEVER an env var. It
# arrives per request via the DB/Vault provider-connection plane (tenant→SYSTEM).
# Only the non-secret ENDPOINT is configured here; a keyless request fails closed
# (503). TEXT_AZURE_API_KEY has been removed.

# Azure endpoint URL (e.g. https://your-resource.openai.azure.com/)
TEXT_AZURE_ENDPOINT=

# API version (default: 2024-12-01-preview)
TEXT_AZURE_API_VERSION=2024-12-01-preview

# Deployment name
TEXT_AZURE_DEPLOYMENT_NAME=

# Default model. Empty by design (TASK-579): provider/model SELECTION is
# fail-closed — an unresolved model raises rather than substituting a vendor
# default. This is informational only (providers listing), never substituted.
TEXT_AZURE_DEFAULT_MODEL=

# Request timeout in seconds (default: 120)
TEXT_AZURE_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_AZURE_MAX_CONCURRENT=10

# Tokens per minute limit (default: 80000)
TEXT_AZURE_TPM_LIMIT=80000

# Requests per minute limit (default: 480)
TEXT_AZURE_RPM_LIMIT=480

# Use adaptive limits from provider headers (default: true)
TEXT_AZURE_ADAPTIVE_LIMITS=true

# Content filter severity: low, medium, high (default: medium)
TEXT_AZURE_CONTENT_FILTER_SEVERITY=medium

# -----------------------------------------------------------------------------
# AWS Bedrock Provider (TEXT_BEDROCK_)
# -----------------------------------------------------------------------------

# AWS region (default: us-east-1)
TEXT_BEDROCK_REGION=us-east-1

# Default model. Empty by design (TASK-579) — see TEXT_AZURE_DEFAULT_MODEL note.
TEXT_BEDROCK_DEFAULT_MODEL=

# Request timeout in seconds (default: 120)
TEXT_BEDROCK_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_BEDROCK_MAX_CONCURRENT=10

# Max pool connections for httpx (default: 150)
TEXT_BEDROCK_MAX_POOL_CONNECTIONS=150

# Tokens per minute limit (default: 100000)
TEXT_BEDROCK_TPM_LIMIT=100000

# Requests per minute limit (default: 100)
TEXT_BEDROCK_RPM_LIMIT=100

# Backoff after throttle in seconds (default: 30.0)
TEXT_BEDROCK_THROTTLE_BACKOFF_S=30.0

# Bedrock guardrail ID (optional)
TEXT_BEDROCK_GUARDRAIL_ID=

# Guardrail version: DRAFT or version number (default: DRAFT)
TEXT_BEDROCK_GUARDRAIL_VERSION=DRAFT

# -----------------------------------------------------------------------------
# OpenAI Provider (TEXT_OPENAI_) — BYO/tenant-first
# The values below are the PLATFORM FALLBACK, used only when a request carries
# no tenant BYO credential. Tenant keys flow through the DB/Vault provider plane,
# never through env. An empty API key means no platform fallback is configured.
# -----------------------------------------------------------------------------

# TASK-602: OpenAI is BYOK-only — the api_key is NEVER an env var (arrives per
# request via the provider-connection plane). TEXT_OPENAI_API_KEY has been removed.

# Base URL (default: https://api.openai.com/v1)
TEXT_OPENAI_BASE_URL=https://api.openai.com/v1

# Default model. Empty by design (TASK-579) — see TEXT_AZURE_DEFAULT_MODEL note.
TEXT_OPENAI_DEFAULT_MODEL=

# Organization id (optional)
TEXT_OPENAI_ORGANIZATION=

# Request timeout in seconds (default: 120)
TEXT_OPENAI_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_OPENAI_MAX_CONCURRENT=10

# Tokens per minute limit, 0 = disabled (default: 0)
TEXT_OPENAI_TPM_LIMIT=0

# Requests per minute limit, 0 = disabled (default: 0)
TEXT_OPENAI_RPM_LIMIT=0

# -----------------------------------------------------------------------------
# Anthropic Provider (TEXT_ANTHROPIC_) — BYO/tenant-first
# Platform fallback only; tenant keys flow through the DB/Vault provider plane.
# -----------------------------------------------------------------------------

# TASK-602: Anthropic is BYOK-only — the api_key is NEVER an env var (arrives per
# request via the provider-connection plane). TEXT_ANTHROPIC_API_KEY has been removed.

# Base URL override (optional; empty uses the SDK default)
TEXT_ANTHROPIC_BASE_URL=

# Default model. Empty by design (TASK-579) — see TEXT_AZURE_DEFAULT_MODEL note.
TEXT_ANTHROPIC_DEFAULT_MODEL=

# Request timeout in seconds (default: 120)
TEXT_ANTHROPIC_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_ANTHROPIC_MAX_CONCURRENT=10

# Tokens per minute limit, 0 = disabled (default: 0)
TEXT_ANTHROPIC_TPM_LIMIT=0

# Requests per minute limit, 0 = disabled (default: 0)
TEXT_ANTHROPIC_RPM_LIMIT=0

# -----------------------------------------------------------------------------
# Google Vertex AI Provider (TEXT_VERTEX_) — BYO/tenant-first
# Platform fallback is ADC-authenticated; a tenant BYO credential carries a
# service-account JSON + its own project/location. Empty project = no fallback.
# -----------------------------------------------------------------------------

# GCP project id (platform fallback; empty for BYO-only)
TEXT_VERTEX_PROJECT=

# Location / region (default: us-central1)
TEXT_VERTEX_LOCATION=us-central1

# Default model. Empty by design (TASK-579) — see TEXT_AZURE_DEFAULT_MODEL note.
TEXT_VERTEX_DEFAULT_MODEL=

# Request timeout in seconds (default: 120)
TEXT_VERTEX_TIMEOUT_S=120

# Max concurrent requests (default: 10)
TEXT_VERTEX_MAX_CONCURRENT=10

# Tokens per minute limit, 0 = disabled (default: 0)
TEXT_VERTEX_TPM_LIMIT=0

# Requests per minute limit, 0 = disabled (default: 0)
TEXT_VERTEX_RPM_LIMIT=0

# -----------------------------------------------------------------------------
# Sarvam Translation Provider (TEXT_SARVAM_) — BYOK-ONLY
# Powers the `translate` capability (POST /api/v1/translate). Sarvam is
# BYOK-only: the api_key is NEVER an env var — it arrives per request via
# provider_overrides (the gateway resolves it from the provider-connection). A
# request with no override key fails closed -> 503. Only NON-secret operational
# settings live here.
# -----------------------------------------------------------------------------

# REST base URL (default: https://api.sarvam.ai)
TEXT_SARVAM_BASE_URL=https://api.sarvam.ai

# Translate model override, optional (empty = Sarvam default)
TEXT_SARVAM_MODEL=

# -----------------------------------------------------------------------------
# OpenAI-Compatible Provider (TEXT_OPENAI_COMPAT_)
# -----------------------------------------------------------------------------

# NOTE: there is deliberately NO `TEXT_OPENAI_COMPAT_ENABLED`. TEXT gates a
# provider by the PRESENCE of its connection config, not by an `enabled` flag —
# `OpenAICompatConfig` has no such field, so the variable configured nothing
# (verified 2026-07-25, TASK-558 lane D D7).

# Base URL (e.g. http://localhost:1234/v1)
TEXT_OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1

# API key (use "not-needed" for local models without auth)
TEXT_OPENAI_COMPAT_API_KEY=not-needed

# Default model (default: local-model)
TEXT_OPENAI_COMPAT_DEFAULT_MODEL=local-model

# Request timeout in seconds (default: 300)
TEXT_OPENAI_COMPAT_TIMEOUT_S=300

# Max concurrent requests (default: 4)
TEXT_OPENAI_COMPAT_MAX_CONCURRENT=4

# Organization header (optional)
# TEXT_OPENAI_COMPAT_ORGANIZATION=

# -----------------------------------------------------------------------------
# Docker Compose Overrides (optional)
# -----------------------------------------------------------------------------

# TEXT port mapping (default: 8862)
# TEXT_PORT=8862

# Redis port mapping (default: 6379)
# REDIS_PORT=6379

# Grafana admin password when using monitoring profile (default: admin)
# GRAFANA_PASSWORD=admin
