#   also: TEXT_V2_PROVIDER_PROBE_TIMEOUT_S
# TEXT_PROVIDER_PROBE_TIMEOUT_S=5

#   LEGACY per-service inter-service credential (empty = auth disabled for local dev). Superseded by the shared
