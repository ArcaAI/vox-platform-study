# ── CircuitBreakerConfig ────────────────────────────────────────────────

# TEXT_CB_COUNT_RATE_LIMITS=true

# TEXT_CB_FAILURE_THRESHOLD=5

#   ``None`` preserves the default unlimited/undecayed behavior (unlimited HALF_OPEN trial calls / no time-based
#   failure-count decay) — a non-null literal default would silently start capping/decaying on every unconfigured
#   deployment now that these fields are wired. Operators opt in via TEXT_CB_HALF_OPEN_MAX_CALLS /
#   TEXT_CB_RESET_TIMEOUT_S.
# TEXT_CB_HALF_OPEN_MAX_CALLS=

# TEXT_CB_RECOVERY_TIMEOUT_S=30

# TEXT_CB_RESET_TIMEOUT_S=

# ── ExternalGuardrailConfig ─────────────────────────────────────────────

# TEXT_EXTERNAL_GUARDRAIL_BASE_URL=http://localhost:8863

#   Dev/CI bypass switch. When False (default) input moderation is intentionally OFF so local dev + hermetic CI run
#   without a guardrail service (mirrors the empty-service-token bypass). Clinical/production deployments MUST
#   enable it — an ops rollout step (guardrail reachable), not a code default that would break dev.
# TEXT_EXTERNAL_GUARDRAIL_ENABLED=false

# TEXT_EXTERNAL_GUARDRAIL_INCLUDE_REASONING=false

#   Bounded retry for a transient guardrail blip: the moderation call is retried up to ``max_retries`` extra times
#   (total tries = max_retries + 1) with a linear ``retry_backoff_ms`` backoff before the client fails CLOSED. A
#   momentary error is absorbed (degrade-safe); a sustained outage rejects (never allows).
# TEXT_EXTERNAL_GUARDRAIL_MAX_RETRIES=2

#   Clinical enforce switch (default True): a reachable guardrail must classify the prompt as medical to allow it.
#   Setting it False is an EXPLICIT, documented non-clinical mode (allow any reachable verdict) — never a silent
#   default.
# TEXT_EXTERNAL_GUARDRAIL_REQUIRE_MEDICAL=true

# TEXT_EXTERNAL_GUARDRAIL_RETRY_BACKOFF_MS=100

TEXT_EXTERNAL_GUARDRAIL_SERVICE_TOKEN=CHANGE_ME

# TEXT_EXTERNAL_GUARDRAIL_TIMEOUT_S=10

