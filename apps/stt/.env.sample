# ============================================================================
# GENERATED FILE — DO NOT EDIT BY HAND.
#
# Produced by `pnpm env:sync` from apps/stt's pydantic-settings classes, via scripts/generated/python-env-surface.json
# (regenerate the manifest with `pnpm env:python-surface`, then `pnpm env:sync`).
# `pnpm env:sync --check` fails the build (CI job `env-drift-check`) when this
# file and the schema disagree. To change a variable, change its DECLARATION
# and regenerate — editing this file is reverted by the next sync.
#
# Committed example files carry PLACEHOLDERS ONLY, never secrets.
# ============================================================================
#
# Speech-to-Text — apps/stt, port 8861.
#
# A line is LIVE only when it must be set: a secret, a field pydantic has no
# default for, or one of the few local-dev values that legitimately differ
# from the code default (PYTHON_LOCAL_DEV_VALUES in scripts/env-sync.mts).
# Every other knob is listed COMMENTED OUT at its code default — the default
# lives in the Python source, and an env file that restates it only creates
# something to drift. Uncomment a line to override it.
#
# `# also:` lists the other names pydantic accepts for the same field, in
# precedence order after the canonical one.

# ── Settings ────────────────────────────────────────────────────────────

#   Internal service authentication key
API_GATEWAY_KEY=CHANGE_ME

# API_GATEWAY_TIMEOUT=30

#   Internal API Gateway URL
# API_GATEWAY_URL=http://localhost:8868/api/v1

#   The prefixed name is listed FIRST so it wins, and the bare name stays accepted so existing deployments keep
#   working (TASK-799 B.3). Fields that name genuinely SHARED infrastructure — `DATABASE_URL`, `REDIS_URL`,
#   `MINIO_*` — are deliberately left bare: one address, one value, every service.
# APP_NAME=stt

# APP_VERSION=2.0.0

#   Enable the Azure AI Foundry MAI-Transcribe engine (preview, off by default)
# AZURE_FOUNDRY_ENABLED=false

#   Azure AI Foundry / Speech resource endpoint, e.g. https://<res>.cognitiveservices.azure.com
# AZURE_FOUNDRY_ENDPOINT=

#   Azure Speech service region (e.g., eastus, westeurope)
# AZURE_SPEECH_REGION=

#   Default Azure storage account name (used when STORAGE_PROVIDER=azure_blob).
# AZURE_STORAGE_ACCOUNT=

#   Default Azure storage account shared key.
AZURE_STORAGE_ACCOUNT_KEY=CHANGE_ME

#   Default Azure connection string (preferred over account/key when set).
AZURE_STORAGE_CONNECTION_STRING=CHANGE_ME

#   Default Azure storage endpoint suffix.
# AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net

#   CORS — EMPTY by default. stt handles PHI audio, and the browser never talks to :8861 directly (the gateway
#   fronts every route), so there is no origin this service can name for itself. `["*"]` was the shipped default; an
#   operator with a genuine direct-browser need sets CORS_ORIGINS explicitly rather than inheriting a wildcard
#   nobody chose.
# CORS_ORIGINS=[]

# DATABASE_MAX_OVERFLOW=10

# DATABASE_POOL_SIZE=5

#   PostgreSQL connection string (read-only access)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope

#   Device for pyannote inference (auto, cuda, cpu)
# DIARIZATION_DEVICE=auto

#   HuggingFace model ID for speaker embedding extraction
# DIARIZATION_HF_MODEL_ID=pyannote/wespeaker-voxceleb-resnet34-LM

#   HuggingFace model cache directory
# HUGGINGFACE_CACHE_DIR=/Users/taphuynh/.cache/huggingface/hub

#   HuggingFace API token (optional)
HUGGINGFACE_TOKEN=CHANGE_ME

#   Shared internal service access token accepted as X-Service-Token.
INTERNAL_ACCESS_TOKEN=CHANGE_ME

#   Enable Prometheus metrics on /metrics
# METRICS_ENABLED=true

MINIO_ACCESS_KEY=CHANGE_ME

# MINIO_AUDIO_BUCKET=hope-audio

# MINIO_CERT_CHECK=true

# MINIO_CHUNK_BUCKET=hope-audio-chunks

#   MinIO (Object storage)
# MINIO_ENDPOINT=localhost:9000

MINIO_SECRET_KEY=CHANGE_ME

# MINIO_SECURE=false

#   Maximum number of models in LRU cache. Bootstrap fallback — the runtime value comes from the control plane
#   (effective-config).
# MODEL_CACHE_MAX_MODELS=5

#   Idle TTL for cached models in seconds (product clamp: min 60s / max 3600s). Active sessions pin models so TTL
#   applies only after the last release. Bootstrap fallback — the runtime value comes from the control plane
#   (effective-config); the clamp is re-applied to whatever is served.
# MODEL_CACHE_TTL_SECONDS=3600

#   Number of threads for ONNX Runtime intra_op parallelism. 0 = auto (recommended): ONNX Runtime auto-sizes to
#   physical CPU core count with proper thread affinity. Set explicitly only if profiling shows benefit.
# ONNX_NUM_THREADS=0

#   OpenAI (or Azure-OpenAI-compatible) API base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

#   Enable OpenTelemetry distributed tracing
# OTEL_ENABLED=false

#   OTLP gRPC collector endpoint
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317

#   Path to libparakeet shared library (env PARAKEET_CPP_LIBRARY_PATH)
# PARAKEET_CPP_LIBRARY_PATH=

#   CPU threads for parakeet.cpp inference
# PARAKEET_CPP_NUM_THREADS=4

#   DEPRECATED: optional comma-separated pipeline slugs to warm at startup. Not used for provider/model/pipeline
#   selection — request-time pipeline_id + DB AsrPipeline is authority. Prefer empty; models load on first use.
# PRELOAD_PIPELINES=

#   Redis Pub/Sub channel prefix for real-time transcription events. Full channel: {prefix}{job_id}. The NestJS
#   subscriber listens on the same channel to relay events via SSE.
# PUBSUB_CHANNEL_PREFIX=stt:transcription:

#   Enable Redis Pub/Sub publishing for real-time transcription events. When disabled, the worker skips event
#   publishing but still calls the gateway API for job lifecycle updates.
# PUBSUB_ENABLED=true

#   Device for punctuation inference: 'cpu', 'cuda', 'auto'
# PUNCTUATION_DEVICE=auto

#   Enable Cadence punctuation restoration at startup and runtime. Default false: the production Whisper ASR
#   pipelines already emit punctuation and casing, so Cadence is redundant for them, and cadence-punctuation 1.1.0
#   cannot load under the pinned transformers 5.5.4 (its tied-weights finalization raises 'Sequential has no
#   attribute weight'). Enable only with a transformers/cadence combination that is known to load the model — e.g.
#   an Indic ASR path whose engine does not self-punctuate, running transformers <5 in a dedicated environment — or
#   with the direct-load 'cadence-fast' option, which works under the pinned transformers 5.x.
# PUNCTUATION_ENABLED=false

#   Max sequence length / sliding window width for punctuation model
# PUNCTUATION_MAX_LENGTH=300

#   Cache dir for punctuation model weights (None = HF default cache)
# PUNCTUATION_MODEL_CACHE_DIR=

#   Default punctuation model: 'Cadence' (1B) or 'Cadence-Fast' (270M) via the cadence-punctuation wrapper, or
#   'cadence-fast' for the direct transformers load (works under transformers 5.x). Can be overridden per-pipeline
#   via YAML.
# PUNCTUATION_MODEL_NAME=Cadence

#   Redis connection string for Dramatiq
# REDIS_URL=redis://localhost:6379/0

#   Sarvam AI API base URL
# SARVAM_BASE_URL=https://api.sarvam.ai

#   Maximum gap (seconds) between adjacent VAD speech segments that allows merging into a single inference chunk.
#   Merging reduces the number of Whisper generate() calls, each of which incurs ~6s encoder overhead on CPU.
#   Default 2.0s works well for conversational audio with natural pauses. Set to 0 to disable merging entirely.
# SEGMENT_MERGE_GAP_THRESHOLD_S=2

#   Minimum decision confidence (0–1) to cut a final early. Raise it if measurement shows early cuts truncating
#   clinical content (measure-first; the fixed backstop always still fires).
# SEMANTIC_ENDPOINT_CONFIDENCE_THRESHOLD=0.85

#   Enable content-driven semantic end-of-utterance detection on the streaming hot path. Default OFF — the
#   preprocessor keeps the fixed Silero-VAD silence offset until this is enabled and measured against the
#   accuracy/latency scorecard. Env: SEMANTIC_ENDPOINT_ENABLED.
# SEMANTIC_ENDPOINT_ENABLED=false

#   Target-max EOU latency band (ms) — informational; the fixed VAD silence offset remains the true upper bound /
#   backstop.
# SEMANTIC_ENDPOINT_MAX_SILENCE_MS=500

#   Trailing-silence floor (ms) before a semantic early cut is allowed (target-min EOU latency, 160–500 ms band).
#   Kept below the fixed VAD backstop so a semantic cut is genuinely earlier.
# SEMANTIC_ENDPOINT_MIN_SILENCE_MS=200

#   Minimum running-hypothesis word count before a semantic early cut; tiny fragments defer to the fixed silence
#   timer.
# SEMANTIC_ENDPOINT_MIN_WORDS=3

#   OPTIONAL self-hosted turn/EOU model id. Empty = model-free heuristic only. A staged model can endpoint on
#   unpunctuated complete text; an un-staged id degrades to the heuristic (no cloud vendor ever — track guardrail).
# SEMANTIC_ENDPOINT_MODEL_ID=

#   Default object-storage provider when no per-tenant storage descriptor is supplied. The default keeps using the
#   global MinIO client unless set to 'azure_blob'.
# STORAGE_PROVIDER=minio

#   Seconds of no audio data before STT auto-stops a streaming session (default 5 min).
# STREAMING_AUDIO_IDLE_TIMEOUT_S=300

#   Approximate MAXLEN for Redis audio streams (per-session). The SINGLE source of truth for the audio-stream bound:
#   kept equal to the TS gateway bridge's XADD MAXLEN (the sole production writer of stt:audio). At ~30-80ms/frame
#   this retains minutes of audio, comfortably ahead of the consumer group.
# STREAMING_AUDIO_STREAM_MAXLEN=10000

#   Minimum interval (seconds) between XTRIM MINID calls on the consumed portion of stt:audio:{session_id}. 0
#   disables consumed-portion trimming (MAXLEN bound still applies).
# STREAMING_AUDIO_TRIM_INTERVAL_S=30

#   Maximum time (ms) the batch scheduler waits before dispatching an incomplete batch. 0 = auto-detect from
#   ExecutionProfile.
# STREAMING_BATCH_WAIT_MS=0

#   Device for speaker embedding extraction during streaming. 'auto' selects based on hardware profile (e.g. cuda:1,
#   cpu, mps).
# STREAMING_EMBEDDING_DEVICE=auto

#   Pipe-separated extra regex alternates appended to the streaming hallucination filler pattern. Default empty —
#   built-in English + Malayalam filler forms only.
# STREAMING_EXTRA_FILLER_PATTERNS=

#   Max seconds finalize waits for the inference queue to drain before building the transcript. On timeout (e.g. GPU
#   backlog) the still-queued tail utterances are transcribed inline rather than dropped, so the last utterance is
#   never lost.
# STREAMING_INFERENCE_DRAIN_TIMEOUT_S=60

#   Bound on the per-session in-process inference queue (SessionManager._register_inference_runtime). F-08: the
#   steady-state enqueue is a bounded wait_for (not a blocking put) — once the queue is full for longer than the
#   bounded wait, the utterance is DROPPED (with a structured warning + counter) rather than blocking the single
#   ingestion dispatch loop, which would otherwise stop XACK'ing Redis audio frames and let stt:audio's MAXLEN trim
#   unread raw audio. The finalize-path drain uses the separate streaming_inference_drain_timeout_s bound and is
#   unaffected.
# STREAMING_INFERENCE_QUEUE_MAXSIZE=64

#   Seconds to wait for a session's inference worker task to drain/stop before giving up (used both on graceful
#   session removal and when force-finalizing on session-end).
# STREAMING_INFERENCE_STOP_TIMEOUT_S=30

#   Hard cap (bytes) on the in-memory audio buffer per session. Once exceeded, new frames are silently dropped and a
#   warning is logged. Default ~500 MB ≈ ~87 min of 16 kHz mono s16le audio.
# STREAMING_MAX_AUDIO_BUFFER_BYTES=500000000

#   Maximum batch size for the dynamic batch scheduler (GPU inference). 0 = auto-detect from ExecutionProfile based
#   on hardware.
# STREAMING_MAX_BATCH_SIZE=0

#   Maximum number of concurrent streaming sessions. 0 = auto-detect from ExecutionProfile based on hardware.
#   Bootstrap fallback — the runtime value comes from the control plane (effective-config), applied after hardware
#   detection.
# STREAMING_MAX_CONCURRENT=0

#   Multi-GPU strategy for streaming: 'auto' (detect), 'replicate' (same model on each GPU), 'split' (ASR on GPU 0,
#   embeddings on GPU 1), or 'none' (single GPU / CPU).
# STREAMING_MULTI_GPU_STRATEGY=auto

#   Minimum wall-clock interval (seconds) between successive PARTIAL transcript emissions for a live utterance.
#   Lowered from the legacy hardcoded 1.0 s so newly-spoken words surface in near-real-time as a tentative tail; the
#   LocalAgreement-2 commit policy still governs when a word is *committed* (unchanged). The
#   streaming_partial_window_s tail bound and the 0.5 s minimum-buffered-audio floor are unaffected. The Settings
#   class has NO env_prefix, so the env var is the bare STREAMING_PARTIAL_INTERVAL_S.
# STREAMING_PARTIAL_INTERVAL_S=0.4

#   Tail window (seconds) of the current utterance decoded for PARTIAL transcripts. Set to the whisper.cpp
#   force-emit window (~6 s) so the last partial and the final decode the SAME audio — decoding is deterministic, so
#   matched windows converge and the final stops visibly rephrasing the partial. env STREAMING_PARTIAL_WINDOW_S
# STREAMING_PARTIAL_WINDOW_S=6

#   Max seconds a streaming FINAL waits for Cadence-Fast punctuation before the raw text is published (0.3-0.5 s
#   recommended). Applies only when the punctuation model resolves to 'cadence-fast'.
# STREAMING_PUNCTUATION_TIMEOUT_S=0.4

#   Interval (seconds) between background reaper scans for expired sessions.
# STREAMING_REAPER_INTERVAL_S=300

#   TTL (seconds) for Redis stream keys after session closes (1 hour).
# STREAMING_RESULT_STREAM_EXPIRE_S=3600

#   Approximate MAXLEN for the per-session Redis result stream (stt:result). Bounds the stream DURING an active
#   session (previously unbounded until the post-close EXPIRE). High enough that a keeping-up bridge/consumer never
#   misses a result; overflowed finals remain in the durable transcript.
# STREAMING_RESULT_STREAM_MAXLEN=10000

#   TTL (seconds) for Redis session metadata keys after session closes (24 hours).
# STREAMING_SESSION_METADATA_EXPIRE_S=86400

#   How often (seconds) to persist session metadata to Redis.
# STREAMING_SESSION_PERSIST_INTERVAL_S=5

#   Seconds of inactivity before a streaming session is auto-finalized by the reaper.
# STREAMING_SESSION_TIMEOUT_S=60

#   Interval (seconds) between audio snapshot uploads to S3 during active streaming sessions.
# STREAMING_SNAPSHOT_INTERVAL_S=30

#   Max re-drive attempts for a transcript in the durable Redis outbox before it is dropped with a loud alert. When
#   the inline persist exhausts its retries on a TRANSIENT error the transcript is enqueued to a shared Redis outbox
#   and re-driven by the reaper loop (any worker) with an idempotency key; a PERMANENT (4xx) error is dropped
#   immediately rather than retried.
# STREAMING_TRANSCRIPT_OUTBOX_MAX_ATTEMPTS=10

#   Base backoff (seconds) between durable-transcript persist retries; the delay scales with the attempt number. 0
#   disables the wait (used in tests).
# STREAMING_TRANSCRIPT_PERSIST_BACKOFF_S=0.5

#   Max attempts to persist the durable streaming transcript to the gateway during finalize. The transcript is the
#   clinical system of record AND the harness auto-draft trigger, so a transient gateway blip is retried rather than
#   silently swallowed. The persist endpoint is idempotent, so retries never double-create the transcript or
#   re-trigger the harness. Must be >= 1.
# STREAMING_TRANSCRIPT_PERSIST_MAX_ATTEMPTS=3

#   Interval (seconds) between worker heartbeat extensions in Redis.
# STREAMING_WORKER_HEARTBEAT_S=10

#   TTL (seconds) for the worker heartbeat key in Redis.
# STREAMING_WORKER_HEARTBEAT_TTL_S=30

#   also: DEBUG
# STT_DEBUG=false

#   also: HOST
# STT_HOST=0.0.0.0

#   also: LOG_LEVEL
# STT_LOG_LEVEL=INFO

#   Access key for s3:// model sources
#   also: STT_V2_MODEL_S3_ACCESS_KEY
STT_MODEL_S3_ACCESS_KEY=CHANGE_ME

#   S3/MinIO endpoint (host:port) backing s3:// model sources
#   also: STT_V2_MODEL_S3_ENDPOINT
# STT_MODEL_S3_ENDPOINT=

#   Secret key for s3:// model sources
#   also: STT_V2_MODEL_S3_SECRET_KEY
STT_MODEL_S3_SECRET_KEY=CHANGE_ME

#   Use TLS for the s3:// model endpoint (set false for local MinIO)
#   also: STT_V2_MODEL_S3_SECURE
# STT_MODEL_S3_SECURE=true

#   Service name in traces and metrics
#   also: OTEL_SERVICE_NAME
# STT_OTEL_SERVICE_NAME=stt

#   also: PORT
# STT_PORT=8861

#   Number of threads for PyTorch inter-op parallelism (torch.set_num_interop_threads). Default 1 is optimal for
#   single-request inference. Increase only for concurrent batch processing.
# TORCH_NUM_INTEROP_THREADS=1

#   Number of threads for PyTorch intra-op parallelism (torch.set_num_threads). 0 = auto: uses the number of
#   physical CPU cores. In K8s, set this to match the CPU request/limit (e.g. 8 for 8-core pods) to avoid under- or
#   over-subscribing.
# TORCH_NUM_THREADS=0

#   Audio chunk length (seconds) for Whisper inference. Whisper's feature extractor truncates audio to its context
#   window (30s max). Audio longer than this value is split into overlapping chunks with configurable stride.
#   Default 15s provides ~2x lower TTFW latency vs 30s while maintaining good accuracy. Set to 30 for maximum
#   accuracy, 10 for ultra-low latency.
# TRANSCRIPTION_CHUNK_LENGTH_S=15

#   Left and right overlap (seconds) between consecutive chunks, as a comma-separated pair. The HF pipeline uses
#   these overlaps to avoid cutting words at chunk boundaries. Default '4,2' means 4s left overlap and 2s right
#   overlap.
# TRANSCRIPTION_STRIDE_LENGTH_S=4,2

#   Maximum transcription job timeout in seconds (default: 10 min)
# TRANSCRIPTION_TIMEOUT_SECONDS=600

#   Minimum silence to end speech segment in ms
# VAD_MIN_SILENCE_DURATION_MS=500

#   Minimum speech segment length in ms (100 so short clinical confirmations survive)
# VAD_MIN_SPEECH_DURATION_MS=100

#   Path to Silero VAD ONNX model (auto-downloaded if None)
# VAD_MODEL_PATH=

#   Padding applied to both segment ends in ms (200 per production ASR guidance)
# VAD_SPEECH_PAD_MS=200

#   Silero VAD speech detection threshold (0.0–1.0)
# VAD_THRESHOLD=0.5

#   Speaker-embedding dimension — must match the deployed UserVoiceProfile.embedding vector(N) column. 256 =
#   wespeaker (current); 192 = ECAPA-TDNN (cutover requires applying the vector(192) migration and re-enrolling)
# VOICE_PROFILE_EMBEDDING_DIM=256

#   Minimum acceptable pairwise cosine similarity between per-sample embeddings during enrollment. Below this, the
#   enrollment is rejected as inconsistent. Lower this (~0.3) for dev with consumer-grade microphones; keep >=0.6 in
#   production.
# VOICE_PROFILE_MIN_SIMILARITY=0.6

#   Whether the whisper.cpp adapter prepends its language-derived clinical-consultation initial_prompt (exemplar
#   prior-context, not an instruction). Default OFF — measured to inject spurious tokens and break grapheme clusters
#   on the ml-en code-switch fine-tune. Toggle on only if an eval shows it helps. env
#   WHISPER_CPP_CONSULTATION_PROMPT_ENABLED
# WHISPER_CPP_CONSULTATION_PROMPT_ENABLED=false

#   Max audio length (s) fed to whisper.cpp in one decode. The ml-en code-switch fine-tune is accurate up to ~6-7s
#   but truncates/garbles on longer audio (VAD does not segment continuous clinical speech), so longer utterances
#   are split into <=this-many-second chunks at silence troughs, decoded independently, and stitched. 0 disables
#   chunking. env WHISPER_CPP_MAX_AUDIO_SECONDS
# WHISPER_CPP_MAX_AUDIO_SECONDS=7

#   CPU threads for whisper.cpp inference
# WHISPER_CPP_NUM_THREADS=8

#   Maximum job retry attempts
# WORKER_MAX_RETRIES=3

#   Dramatiq consumer poll interval max-backoff in milliseconds
# WORKER_POLL_TIMEOUT_MS=1000

#   Number of Dramatiq worker threads per process
# WORKER_THREADS=4
