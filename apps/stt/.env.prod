# =============================================================================
# STT Service — Production Environment Variables
# =============================================================================

# Application
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8861
DEBUG=false
CORS_ORIGINS=[]

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
# In-transit TLS: production MinIO serves HTTPS (self-signed
# CA, see deploy-vm402-minio.md §14). Keep TLS on; the client host must trust the
# MinIO CA. Object-storage PHI is also covered by MinIO SSE at rest (Phase 1).
MINIO_SECURE=true

# Azure Speech Service — shared with apps/tts (same Azure Speech resource
# serves both ASR and TTS). Set once; both services read the same keys.
# Relocated from the monorepo-root `.env.production`.
AZURE_SPEECH_KEY=

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://10.10.1.100:4317
OTEL_SERVICE_NAME=stt

# Prometheus Metrics
METRICS_ENABLED=true

# Workers

# APP_NAME/APP_VERSION are build identity (build-info.json), and
# AZURE_SPEECH_REGION / WORKER_THREADS now resolve from the config control plane
# (stt.azureSpeech.region, stt.workers.*). Setting them here would do nothing.
