# STT Service Dockerfile - Apple Silicon (ARM64)
# Optimized for Apple Silicon with MPS support
#
# Note: MPS (Metal Performance Shaders) is NOT available inside Docker containers.
# This Dockerfile is for running CPU tests on ARM64 architecture.
# For actual MPS acceleration, run tests natively on macOS.
#
# Build:
#   docker build --platform linux/arm64 -f docker/Dockerfile.apple -t stt:apple .

# =============================================================================
# Stage 1: Builder (ARM64)
# =============================================================================
FROM --platform=linux/arm64 python:3.11-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /uvx /bin/

# Local-only pytest image (per-app context). Resolves fresh via `uv pip install`
# (it does not consume a lockfile); the authoritative lock is the root workspace
# uv.lock used by the CI Dockerfiles.
COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /usr/local/bin/python3.11 \
        --no-cache-dir \
        ".[test]" \
    && find /usr/local/lib/python3.11/site-packages \( \
        -name "*.pyc" -o -name "*.pyo" -o -name "__pycache__" \
        -o -name "*.egg-info" \
    \) -exec rm -rf {} + 2>/dev/null || true

# =============================================================================
# Stage 2: Runtime (ARM64)
# =============================================================================
FROM --platform=linux/arm64 python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash app

COPY --from=builder --chown=app:app /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder --chown=app:app /usr/local/bin /usr/local/bin
COPY --chown=app:app src/ ./src/
COPY --chown=app:app tests/ ./tests/
COPY --chown=app:app pyproject.toml ./

USER app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    TEST_PLATFORM=cpu

CMD ["pytest", "tests/unit/", "-v", "--tb=short"]

# =============================================================================
# Stage 3: ML Runtime (ARM64 with PyTorch for CPU)
# Note: MPS acceleration requires native macOS execution
# =============================================================================
FROM --platform=linux/arm64 python:3.11-slim AS ml-builder-apple

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /uvx /bin/

COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /usr/local/bin/python3.11 \
        --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        ".[ml]" \
    && find /usr/local/lib/python3.11/site-packages \( \
        -name "*.pyc" -o -name "*.pyo" -o -name "__pycache__" \
        -o -name "*.egg-info" \
    \) -exec rm -rf {} + 2>/dev/null || true

FROM --platform=linux/arm64 python:3.11-slim AS ml-runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash app

COPY --from=ml-builder-apple --chown=app:app /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=ml-builder-apple --chown=app:app /usr/local/bin /usr/local/bin
COPY --chown=app:app src/ ./src/
COPY --chown=app:app tests/ ./tests/
COPY --chown=app:app pyproject.toml ./

USER app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    TEST_PLATFORM=cpu

CMD ["pytest", "tests/", "-v", "--tb=short", "-m", "not cuda"]
