# STT Service Dockerfile - Apple Silicon (ARM64)
# Optimized for Apple Silicon with MPS support
#
# Note: MPS (Metal Performance Shaders) is NOT available inside Docker containers.
# This Dockerfile is for running CPU tests on ARM64 architecture.
# For actual MPS acceleration, run tests natively on macOS.
#
# Build (from the REPO ROOT — root context, like every other HOPE Dockerfile):
#   docker build --platform linux/arm64 -f apps/stt/docker/Dockerfile.apple -t stt:apple .

# =============================================================================
# Stage 1: Builder (ARM64)
# =============================================================================
FROM --platform=linux/arm64 python:3.11-slim-trixie AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /uvx /bin/

# Local-only pytest image, built from the repo root. Deps resolve FRESH via
# `uv pip install` (no lockfile — the authoritative lock is the root workspace
# uv.lock consumed by the CI Dockerfiles). The root pyproject.toml is copied so
# uv discovers the workspace and resolves the two `workspace = true` path deps
# (`hope-env`, `hope-runtime-models`) from the local packages/ tree; everything
# else comes from PyPI. Other workspace members need not be present.
COPY pyproject.toml ./
COPY packages/py-env ./packages/py-env
COPY packages/py-runtime-models ./packages/py-runtime-models
COPY apps/stt/pyproject.toml apps/stt/README.md ./apps/stt/
COPY apps/stt/src ./apps/stt/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /usr/local/bin/python3.11 \
        --no-cache-dir \
        "./apps/stt[test]" \
    && find /usr/local/lib/python3.11/site-packages \( \
        -name "*.pyc" -o -name "*.pyo" -o -name "__pycache__" \
        -o -name "*.egg-info" \
    \) -exec rm -rf {} + 2>/dev/null || true

# hope-runtime-models / hope-env resolve as EDITABLE under `uv pip install`
# (tool.uv.sources workspace=true) — a .pth pointing at /build/packages/*/src,
# which the runtime stage (site-packages copy only) does not carry. Re-install
# both as plain baked-in wheels so they survive the copy. See apps/stt/docker/
# Dockerfile for the full rationale.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /usr/local/bin/python3.11 --no-cache-dir \
        --no-deps --no-sources \
        --reinstall-package hope-runtime-models \
        --reinstall-package hope-env \
        ./packages/py-runtime-models ./packages/py-env

# =============================================================================
# Stage 2: Runtime (ARM64)
# =============================================================================
FROM --platform=linux/arm64 python:3.11-slim-trixie AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash app

COPY --from=builder --chown=app:app /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder --chown=app:app /usr/local/bin /usr/local/bin
COPY --chown=app:app apps/stt/src ./src/
COPY --chown=app:app apps/stt/tests ./tests/
COPY --chown=app:app apps/stt/pyproject.toml ./

USER app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    TEST_PLATFORM=cpu

CMD ["pytest", "tests/unit/", "-v", "--tb=short"]

# =============================================================================
# Stage 3: ML Runtime (ARM64 with PyTorch for CPU)
# Note: MPS acceleration requires native macOS execution
# =============================================================================
FROM --platform=linux/arm64 python:3.11-slim-trixie AS ml-builder-apple

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /uvx /bin/

# Same root-context workspace setup as the builder stage above (see its comment).
COPY pyproject.toml ./
COPY packages/py-env ./packages/py-env
COPY packages/py-runtime-models ./packages/py-runtime-models
COPY apps/stt/pyproject.toml apps/stt/README.md ./apps/stt/
COPY apps/stt/src ./apps/stt/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /usr/local/bin/python3.11 \
        --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        "./apps/stt[ml]" \
    && find /usr/local/lib/python3.11/site-packages \( \
        -name "*.pyc" -o -name "*.pyo" -o -name "__pycache__" \
        -o -name "*.egg-info" \
    \) -exec rm -rf {} + 2>/dev/null || true

# hope-runtime-models / hope-env resolve as EDITABLE under `uv pip install`
# (tool.uv.sources workspace=true) — a .pth pointing at /build/packages/*/src,
# which the ml-runtime stage (site-packages copy only) does not carry. Re-install
# both as plain baked-in wheels so they survive the copy. See apps/stt/docker/
# Dockerfile for the full rationale.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /usr/local/bin/python3.11 --no-cache-dir \
        --no-deps --no-sources \
        --reinstall-package hope-runtime-models \
        --reinstall-package hope-env \
        ./packages/py-runtime-models ./packages/py-env

FROM --platform=linux/arm64 python:3.11-slim-trixie AS ml-runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash app

COPY --from=ml-builder-apple --chown=app:app /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=ml-builder-apple --chown=app:app /usr/local/bin /usr/local/bin
COPY --chown=app:app apps/stt/src ./src/
COPY --chown=app:app apps/stt/tests ./tests/
COPY --chown=app:app apps/stt/pyproject.toml ./

USER app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    TEST_PLATFORM=cpu

CMD ["pytest", "tests/", "-v", "--tb=short", "-m", "not cuda"]
