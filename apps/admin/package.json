{
  "name": "@arcaai/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HOPE Admin Console — operator surface built on @arcaai/ui (TASK-374)",
  "scripts": {
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx --ignore-path .gitignore",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:e2e:list": "playwright test --config playwright.config.ts --list"
  },
  "dependencies": {
    "@arcaai/ui": "workspace:*",
    "@arcaai/vox": "workspace:*",
    "@tanstack/react-router": "^1.168.3",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-cli": "^1.166.18",
    "@tanstack/router-plugin": "^1.167.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.1"
  }
}
