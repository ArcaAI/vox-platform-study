# TTS Service Environment Configuration
# TASK-582: this file did not exist before — apps/tts was the only Python
# service missing one; ~40+ real config vars previously lived only in a
# developer's local, gitignored .env.dev. Kept right-sized (not exhaustive):
# app/runtime + auth + synthesis limits + one local engine + BYO cloud
# placeholders. Deep provider tunables (timeouts, concurrency, sample rates
# per provider) all have safe code defaults in core/config.py and are left
# undocumented here by design.

# Application Settings
TTS_HOST=0.0.0.0
TTS_PORT=8865
TTS_DEBUG=false
TTS_LOG_LEVEL=info
TTS_CORS_ENABLED=false
TTS_CORS_ORIGINS=[]
TTS_METRICS_ENABLED=true

# Inter-service Authentication (empty = auth disabled for local dev)
TTS_SERVICE_TOKEN=""

# Where the control plane lives.
TTS_GATEWAY_URL=http://localhost:8868/api/v1

# Synthesis limits / defaults
TTS_MAX_INPUT_CHARS=4096
TTS_DEFAULT_FORMAT=pcm
TTS_SAMPLE_RATE=24000

# ──────────────────────────────────────────────────────────────────────────────
# Provider SELECTION is DB-sourced (TASK-577), NOT env. There is no
# TTS_ROUTING_EN / TTS_ROUTING_ML — the SYSTEM TenantTtsConfig default is
# resolved by the gateway and injected per request; the router fails CLOSED
# (503) when no chain is injected. Enabling an engine below only makes it
# AVAILABLE for the DB-driven router to pick — it never selects a default.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Local engines (self-hosted, no cloud egress). Kokoro (English) enabled by
# default — built-in-first per OD-2 of the provider-plane program.
# ──────────────────────────────────────────────────────────────────────────────
TTS_KOKORO_ENABLED=true
TTS_KOKORO_VOICE=af_heart
TTS_KOKORO_DEVICE=cpu

# Indic Parler-TTS (Malayalam) — off by default; enable if the model weights
# are staged locally.
# TTS_PARLER_ENABLED=false
# TTS_PARLER_DEVICE=cpu

# ──────────────────────────────────────────────────────────────────────────────
# BYO cloud engines (OPTIONAL — tenant-configured, never a platform default).
# ──────────────────────────────────────────────────────────────────────────────
# Azure AI Speech. Falls back to the shared AZURE_SPEECH_KEY/AZURE_SPEECH_REGION
# already used by stt for ASR (same Azure Speech resource serves TTS).
# TTS_AZURE_ENABLED=false
# TTS_AZURE_API_KEY=
# TTS_AZURE_REGION=eastus

# Sarvam AI Bulbul TTS (best code-switched Malayalam). Public API is NOT
# PHI-safe (no HIPAA/BAA) — point base_url at an enterprise/on-prem host
# before enabling for real patient data.
# TTS_SARVAM_ENABLED=false
# TTS_SARVAM_API_KEY=
