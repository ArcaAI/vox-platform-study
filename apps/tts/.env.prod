# =============================================================================
# TTS Service — Production Environment Reference
# =============================================================================
# Reference template — fill in for your deployment. Not loaded by the app
# itself; production is configured by whichever mechanism your deployment
# uses (K8s ConfigMap/Secret, systemd EnvironmentFile=) to populate the host
# environment. Relocated from the monorepo-root `.env.production` (TASK-584).
#
# Provider SELECTION is DB-sourced (TenantTtsConfig, TASK-577) — there is no
# env routing knob. The keys below are connection identity for the BYO cloud
# engine only; the SYSTEM default chain is built-in-first (kokoro/indic_parler,
# self-hosted, no credentials needed).
# =============================================================================

# Azure Speech Service — shared with apps/stt (same Azure Speech resource
# serves both ASR and TTS). Set once; both services read the same keys.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
