# ── Admin Console ───────────────────────────────────────────────────────

# Gateway origin (server side)
#   Origin the BFF proxy (`src/app/api/hope/[...path]/route.ts`) forwards to. Server-side only — never reaches the
#   client bundle.
#   tier: env · read by: apps/admin-console
API_URL=http://localhost:8868

# Session cookie secret (REQUIRED — boot fails without it)
#   Secret the encrypted session cookie (jose JWE, dir + A256GCM) is keyed from; the 32-byte AES key is derived via
#   SHA-256 in `src/server/session.ts`. Minimum 32 characters — the console refuses to start without it.
#   tier: env · read by: apps/admin-console
ADMIN_SESSION_SECRET=CHANGE_ME

# Gateway origin (browser side)
#   Origin the BROWSER connects to directly for SSE/WS streams (authenticated with single-use stream tickets).
#   Inlined into the client bundle by Next.js, so it must be non-secret (`src/config/public-env.ts`).
#   tier: env · read by: apps/admin-console
NEXT_PUBLIC_API_HOST=http://localhost:8868

# ── Tooling ─────────────────────────────────────────────────────────────

# Dev/test server port
#   Port the dev (5176) or test (5276) console binds — read by `scripts/dev-stack.sh` and
#   `scripts/start-test-app.sh`, not by application code.
#   tier: env · read by: apps/admin-console
ADMIN_PORT=5176
