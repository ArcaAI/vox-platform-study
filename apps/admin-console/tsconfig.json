{
    "extends": "@arcaai/config-ts/nextjs.json",
    "compilerOptions": {
        // TS 6: `types` defaults to [] (no @types auto-discovery); server code
        // relies on Node globals (process.env). React types resolve via imports.
        "types": ["node"],
        "paths": {
            // Fallback chain: app files first, then the transpiled @arcaai/ui
            // sources — Turbopack applies THIS tsconfig to packages/ui/src too
            // (transpilePackages), so the package's internal `@/` imports
            // (components/lib/hooks, none of which exist in our src) must
            // resolve through the second entry.
            "@/*": ["./src/*", "../../packages/ui/src/*"]
        }
    },
    "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules", ".next"]
}
