# =============================================================================
# STT-v2 Service — Production Environment Variables
# =============================================================================

# Application
APP_NAME=stt-v2
APP_VERSION=2.0.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8861
DEBUG=false
CORS_ORIGINS=[]

# Database
DATABASE_URL=postgresql+asyncpg://stt_reader:password@localhost:5432/hope
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# OpenTelemetry (TASK-255)
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://10.10.1.100:4317
OTEL_SERVICE_NAME=stt-v2

# Prometheus Metrics
METRICS_ENABLED=true

# Workers
WORKER_THREADS=4
