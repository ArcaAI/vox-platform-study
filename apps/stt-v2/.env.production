# =============================================================================
# STT-v2 Service — Production Environment Variables
# =============================================================================

# Application
APP_NAME=stt-v2
APP_VERSION=2.0.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8861
DEBUG=false
CORS_ORIGINS=[]

# Database
# In-transit TLS (TASK-369 Phase 2). NOTE: this URL is consumed by SQLAlchemy +
# asyncpg, which does NOT understand libpq's `sslmode` (it raises
# "TypeError: connect() got an unexpected keyword argument 'sslmode'"). asyncpg's
# query parameter is `ssl` — `ssl=require` encrypts the connection. Full
# verification (verify-full: validate the server cert + hostname against the CA)
# requires an ssl.SSLContext built from the CA passed via connect_args in the
# engine factory (app-side wiring) — track that as the hardened follow-up.
# Server-side TLS must be enabled on Patroni/PgBouncer first (operator step).
DATABASE_URL=postgresql+asyncpg://stt_reader:password@localhost:5432/hope?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
# In-transit TLS (TASK-369 Phase 2): production MinIO serves HTTPS (self-signed
# CA, see deploy-vm402-minio.md §14). Keep TLS on; the client host must trust the
# MinIO CA. Object-storage PHI is also covered by MinIO SSE at rest (Phase 1).
MINIO_SECURE=true

# OpenTelemetry (TASK-255)
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://10.10.1.100:4317
OTEL_SERVICE_NAME=stt-v2

# Prometheus Metrics
METRICS_ENABLED=true

# Workers
WORKER_THREADS=4
