# =============================================================================
# STT Service V2 — Environment Configuration
# =============================================================================
#
# Copy this file to .env and update values for your environment:
#   cp .env.example .env
#
# LEGEND:
#   [REQUIRED]  — Must be set before running (no safe default)
#   [SECRET]    — Contains credentials; never commit real values
#   [OPTIONAL]  — Has a sensible default; override only if needed
#   [DEV-ONLY]  — Default is for local development; MUST change in production
#   [PROD]      — Production-recommended value shown in comment
#
# All variables map to the Settings class in:
#   src/stt_v2/core/config/settings.py
#
# Pydantic-settings loads these automatically (case-insensitive).
# Priority: env vars > .env file > default in Settings class.
# =============================================================================


# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=stt-v2
APP_VERSION=2.0.0
LOG_LEVEL=INFO                                # [OPTIONAL] DEBUG | INFO | WARNING | ERROR
                                              # [PROD] INFO or WARNING
HOST=0.0.0.0                                  # [OPTIONAL] Bind address
PORT=8861                                     # [OPTIONAL] HTTP port
DEBUG=false                                   # [OPTIONAL] Enable debug mode
                                              # [PROD] MUST be false

# CORS — JSON array of allowed origins
CORS_ORIGINS=["*"]                            # [DEV-ONLY]
                                              # [PROD] ["https://your-domain.com"]


# =============================================================================
# Database (Read-only access to shared HOPE database)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope
                                              # [DEV-ONLY] [SECRET]
                                              # [PROD] postgresql+asyncpg://stt_reader:<password>@<db-host>:5432/hope
DATABASE_POOL_SIZE=5                          # [OPTIONAL] Connection pool size
                                              # [PROD] 10–20 depending on load
DATABASE_MAX_OVERFLOW=10                      # [OPTIONAL] Max connections beyond pool
                                              # [PROD] 20


# =============================================================================
# Redis (Dramatiq Broker for async job queue)
# =============================================================================
REDIS_URL=redis://localhost:6379/0            # [DEV-ONLY]
                                              # [PROD] redis://<redis-host>:6379/0


# =============================================================================
# MinIO (S3-compatible Object Storage)
# =============================================================================
MINIO_ENDPOINT=localhost:9000                 # [DEV-ONLY]
                                              # [PROD] minio.internal:9000 or S3 endpoint
MINIO_ACCESS_KEY=minioadmin                   # [DEV-ONLY] [SECRET]
                                              # [PROD] Use a dedicated service account key
MINIO_SECRET_KEY=minioadmin                   # [DEV-ONLY] [SECRET]
                                              # [PROD] Use a dedicated service account secret
MINIO_SECURE=false                            # [DEV-ONLY]
                                              # [PROD] true (TLS required)
MINIO_AUDIO_BUCKET=hope-audio                 # [OPTIONAL] Bucket for audio files & transcripts
MINIO_CHUNK_BUCKET=hope-audio-chunks          # [OPTIONAL] Bucket for streaming audio chunks


# =============================================================================
# API Gateway (Internal service-to-service communication)
# =============================================================================
API_GATEWAY_URL=http://localhost:8868/api/v1   # [DEV-ONLY] NestJS API Gateway URL
                                               # [PROD] http://api-gateway.internal:8868/api/v1
API_GATEWAY_KEY=                               # [REQUIRED in PROD] [SECRET]
                                               # Internal service authentication key
API_GATEWAY_TIMEOUT=30                         # [OPTIONAL] Request timeout in seconds


# =============================================================================
# Model Cache (LRU cache for loaded ML models)
# =============================================================================
MODEL_CACHE_MAX_MODELS=5                      # [OPTIONAL] Max models in memory
                                              # [PROD] Tune based on available RAM
MODEL_CACHE_TTL_SECONDS=3600                  # [OPTIONAL] Cache TTL (1 hour)


# =============================================================================
# HuggingFace (Model downloads and caching)
# =============================================================================
HUGGINGFACE_CACHE_DIR=/models/hf-cache        # [OPTIONAL] Local model cache directory
                                              # [DEV macOS] e.g. /Volumes/external/huggingface
                                              # NOTE: In Docker, HF_HOME and TRANSFORMERS_CACHE
                                              #   are also set to this path in the Dockerfile.
                                              #   Keep them aligned if overriding.
# HUGGINGFACE_TOKEN=hf_xxx                    # [OPTIONAL] [SECRET] Required for private/gated models


# =============================================================================
# ONNX Quantization (Pipeline YAML — inline model configuration)
# =============================================================================
# When using inline ONNX models in pipeline YAML, you can select a quantized
# variant to reduce memory usage and improve inference speed.
#
# Example pipeline YAML:
#   models:
#     asr:
#       hf_model_id: "onnx-community/whisper-large-v3-turbo_timestamped"
#       engine: "onnx"
#       quantization: "q4"        # Select a quantized variant
#       subfolder: "onnx"         # Auto-detected for onnx-community repos
#
# Available quantization values:
#   (none)      — Default fp32, largest but highest quality
#   "fp16"      — Float16: ~50% size, minimal quality loss
#   "int8"      — INT8 dynamic quantization: ~35% size
#   "uint8"     — UINT8 dynamic quantization: same as int8
#   "q4"        — 4-bit quantization: ~25% size
#   "q4f16"     — 4-bit weights + fp16 activations: smallest (~18%)
#   "bnb4"      — bitsandbytes 4-bit
#   "quantized" — Default quantized (typically int8)
#
# Approximate sizes for whisper-large-v3-turbo_timestamped (encoder + decoder):
#   fp32:     ~3.2 GB  |  fp16:  ~1.6 GB  |  int8:  ~1.1 GB
#   q4:       ~760 MB  |  q4f16: ~564 MB   |  bnb4:  ~713 MB
#
# NOTE: Models must be pre-downloaded to the HuggingFace cache.
#       The subfolder is auto-detected as "onnx" for onnx-community repos.


# =============================================================================
# Azure Speech (Cloud ASR Engine — optional)
# =============================================================================
# Uncomment and set both to enable Azure Speech as a transcription engine.
# AZURE_SPEECH_KEY=                            # [SECRET] Azure Cognitive Services subscription key
# AZURE_SPEECH_REGION=eastus                   # Azure region (eastus, westeurope, etc.)


# =============================================================================
# VAD — Silero VAD v6 ONNX (Voice Activity Detection)
# =============================================================================
# VAD_MODEL_PATH=                             # [OPTIONAL] Path to local ONNX model file
                                              #   If unset, model is auto-downloaded from HuggingFace
                                              #   Source: onnx-community/silero-vad
                                              #   GitHub: https://github.com/snakers4/silero-vad
VAD_THRESHOLD=0.5                             # [OPTIONAL] Speech detection threshold (0.0–1.0)
                                              #   Lower = more sensitive, higher = fewer false positives
VAD_MIN_SPEECH_DURATION_MS=250                # [OPTIONAL] Min speech segment length in ms
VAD_MIN_SILENCE_DURATION_MS=500               # [OPTIONAL] Min silence to end a speech segment in ms
VAD_SPEECH_PAD_MS=30                          # [OPTIONAL] Padding before speech onset in ms
VAD_SAMPLE_RATE=16000                         # [OPTIONAL] Input sample rate (16000 or 8000)


# =============================================================================
# Diarization — Speaker Embeddings
# =============================================================================
DIARIZATION_HF_MODEL_ID=pyannote/wespeaker-voxceleb-resnet34-LM  # [OPTIONAL] HuggingFace model ID for embeddings
                                              #   Default: pyannote/wespeaker-voxceleb-resnet34-LM (CC-BY-4.0, no token needed)
                                              #   ONNX alternative: deepghs/pyannote-embedding-onnx (no token needed)
                                              #   The ONNX variant is configured per-pipeline in YAML, not here.
DIARIZATION_SIMILARITY_THRESHOLD=0.7          # [OPTIONAL] Cosine similarity for speaker matching (0.0–1.0)
                                              #   Lower = more aggressive merging, higher = more speakers
DIARIZATION_DEVICE=auto                       # [OPTIONAL] Inference device: auto | cuda | cpu
                                              # [PROD GPU] cuda


# =============================================================================
# Voice Profile Enrollment
# =============================================================================
VOICE_PROFILE_MIN_SIMILARITY=0.6              # [OPTIONAL] Minimum pairwise cosine similarity required
                                              # between voice profile samples during enrollment (0.0–1.0).
                                              # Lower (~0.3) for dev with consumer-grade microphones.
                                              # Production default is 0.6. Single-sample enrollment
                                              # skips this check entirely.
                                              # Note: the embedding dimension is NOT configurable here;
                                              # it MUST match the DB column ``vector(N)`` and is hardcoded
                                              # to 256 in extraction_service.py + voiceProfile.service.ts.


# =============================================================================
# Worker Settings (Dramatiq task workers)
# =============================================================================
WORKER_THREADS=4                              # [OPTIONAL] Dramatiq worker threads per process
WORKER_CONCURRENCY=4                          # [OPTIONAL] Alias for WORKER_THREADS
WORKER_POLL_TIMEOUT_MS=1000                  # [OPTIONAL] Dramatiq consumer poll max-backoff in ms
                                              # Controls how often idle workers check for new messages
WORKER_MAX_RETRIES=3                          # [OPTIONAL] Max retry attempts on failure
INFERENCE_POOL_SIZE=0                         # [OPTIONAL] ProcessPoolExecutor size for ML inference
                                              #   0 = auto (uses CPU core count)
                                              # [PROD GPU] Set to number of available GPU devices
ONNX_NUM_THREADS=0                            # [OPTIONAL] ONNX Runtime intra_op_num_threads
                                              #   0 = auto (recommended): ONNX Runtime auto-sizes to
                                              #     physical CPU core count with proper thread affinity.
                                              #     This is the official ONNX Runtime best practice.
                                              # [DEV Apple Silicon] 0 works best (adapts to P/E cores)
                                              # [PROD GPU] Keep at 0 or low (2-4), GPU handles heavy ops
                                              # [ADVANCED] Set explicitly only if profiling shows benefit


# =============================================================================
# Transcription Settings
# =============================================================================
TRANSCRIPTION_TIMEOUT_SECONDS=600             # [OPTIONAL] Max transcription job timeout (10 min)
                                              # [PROD] 600 for long consultations
TRANSCRIPTION_CHUNK_LENGTH_S=15               # [OPTIONAL] Whisper audio chunk length (seconds)
                                              #   Audio longer than this is split into overlapping
                                              #   chunks with configurable stride.
                                              #   15 = recommended (good accuracy, low TTFW latency)
                                              #   30 = maximum accuracy (full Whisper context window)
                                              #   10 = ultra-low latency (minimal quality loss)
TRANSCRIPTION_STRIDE_LENGTH_S=4,2             # [OPTIONAL] Left,right overlap between chunks (seconds)
                                              #   Default "4,2" means 4s left overlap, 2s right overlap.
                                              #   Prevents cutting words at chunk boundaries.


# =============================================================================
# Observability (OpenTelemetry + Prometheus)
# =============================================================================
OTEL_ENABLED=false                           # [OPTIONAL] Enable OpenTelemetry distributed tracing
                                              # [PROD] true
OTEL_EXPORTER_ENDPOINT=http://localhost:4317  # [DEV-ONLY] OTLP gRPC collector endpoint
                                              # [PROD] http://10.10.1.100:4317
OTEL_SERVICE_NAME=stt-v2                     # [OPTIONAL] Service name in traces
METRICS_ENABLED=true                         # [OPTIONAL] Enable Prometheus /metrics endpoint


# =============================================================================
# MLFlow (Reserved — not yet implemented)
# =============================================================================
# MLFLOW_TRACKING_URI=http://localhost:5000   # [OPTIONAL] MLFlow tracking server
# MLFLOW_MODEL_REGISTRY=http://localhost:5000 # [OPTIONAL] MLFlow model registry
