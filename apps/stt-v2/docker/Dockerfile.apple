# STT Service V2 Dockerfile - Apple Silicon (ARM64)
# Optimized for Apple Silicon with MPS support
#
# Note: MPS (Metal Performance Shaders) is NOT available inside Docker containers.
# This Dockerfile is for running CPU tests on ARM64 architecture.
# For actual MPS acceleration, run tests natively on macOS.
#
# Build:
#   docker build --platform linux/arm64 -f docker/Dockerfile.apple -t stt-v2:apple .

# =============================================================================
# Stage 1: Builder (ARM64)
# =============================================================================
FROM --platform=linux/arm64 python:3.11-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY pyproject.toml ./
COPY README.md ./

# Install dependencies (without ML extras - MPS not available in Docker)
RUN pip install --no-cache-dir ".[test]"

# =============================================================================
# Stage 2: Runtime (ARM64)
# =============================================================================
FROM --platform=linux/arm64 python:3.11-slim as runtime

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY src/ ./src/
COPY tests/ ./tests/
COPY pyproject.toml ./

# Create non-root user
RUN useradd --create-home --shell /bin/bash app
RUN chown -R app:app /app
USER app

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app/src
ENV TEST_PLATFORM=cpu

# Default command (run tests)
CMD ["pytest", "tests/unit/", "-v", "--tb=short"]

# =============================================================================
# Stage 3: ML Runtime (ARM64 with PyTorch for CPU)
# Note: MPS acceleration requires native macOS execution
# =============================================================================
FROM runtime as ml-runtime

USER root

# Install ML dependencies from pyproject.toml extras (CPU only in Docker)
# This includes: torch, transformers, optimum[onnxruntime], onnxruntime,
# soundfile, librosa, pyannote.audio, etc.
RUN pip install --no-cache-dir ".[ml]"

USER app

# Override platform for ML tests (CPU in Docker, MPS native)
ENV TEST_PLATFORM=cpu

CMD ["pytest", "tests/", "-v", "--tb=short", "-m", "not cuda"]
