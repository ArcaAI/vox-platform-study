# ============================================================================
# GENERATED FILE — DO NOT EDIT BY HAND.
#
# Produced by `pnpm env:sync` from apps/vllm's pydantic-settings classes, via scripts/generated/python-env-surface.json
# (regenerate the manifest with `pnpm env:python-surface`, then `pnpm env:sync`).
# `pnpm env:sync --check` fails the build (CI job `env-drift-check`) when this
# file and the schema disagree. To change a variable, change its DECLARATION
# and regenerate — editing this file is reverted by the next sync.
#
# Committed example files carry PLACEHOLDERS ONLY, never secrets.
# ============================================================================
#
# Inference shell on vLLM — apps/vllm, port 8867.
#
# A line is LIVE only when it must be set: a secret, a field pydantic has no
# default for, or one of the few local-dev values that legitimately differ
# from the code default (PYTHON_LOCAL_DEV_VALUES in scripts/env-sync.mts).
# Every other knob is listed COMMENTED OUT at its code default — the default
# lives in the Python source, and an env file that restates it only creates
# something to drift. Uncomment a line to override it.
#
# `# also:` lists the other names pydantic accepts for the same field, in
# precedence order after the canonical one.

# ── Settings ────────────────────────────────────────────────────────────

#   HuggingFace's own offline switch. A cluster pod runs with HF_HUB_OFFLINE=1: weights come from the published
#   models bucket only, and a model absent from it is a NAMED refusal (MODEL_NOT_PUBLISHED), never an attempted
#   pull.
# HF_HUB_OFFLINE=false

#   Inbound AND outbound credential (owner decision D-D): the ONE shared internal token. Accepted inbound as
#   `X-Service-Token`, presented as `X-Service-Token` on the gateway's `/internal/*` routes. Unprefixed on purpose —
#   it belongs to no single service. Empty ⇒ inbound auth bypassed, but only when running locally.
INTERNAL_ACCESS_TOKEN=CHANGE_ME

#   The Redis that carries `arca:config:invalidate`. Shared infrastructure, so the bare name every service reads.
#   Blank ⇒ no push invalidation; the effective-config TTL (60 s ± 10 %) is then the only propagation path.
# REDIS_URL=

#   Where the control plane lives (env `VLLM_API_GATEWAY_URL`). BOOTSTRAP TRANSPORT — the address of the config
#   source, not config. Blank ⇒ no control plane: platform knobs stay at their defaults and HuggingFace pulls fail
#   closed (no registry credential can be resolved).
# VLLM_API_GATEWAY_URL=http://localhost:8868/api/v1

#   Which pool this process IS (C-4): a key of `vllm.pools`. Pod identity, so env — a Deployment per pool sets it. A
#   name the map does not declare refuses to start.
# VLLM_POOL=default

#   Pools — CONTROL PLANE (`vllm.pools`), read at every admission. The raw map; see `pool_config()` for this
#   process's entry.
# VLLM_POOLS__MOVED_TO_CONTROL_PLANE={"default": {"acceptedKinds": ["asr"], "pins": [], "vramBudgetGiB": 6, "maxResidentEngines": 1, "inflightFactor": 2}, "asr": {"acceptedKinds": ["asr"], "pins": [], "vramBudgetGiB": 6, "maxResidentEngines": 1, "inflightFactor": 2}}

#   Truncation heuristic (vllm#53144 hook) — CONTROL PLANE (`vllm.truncation.*`), read per request.
# VLLM_TRUNCATION_MIN_CHARS_PER_VOICED_SECOND__MOVED_TO_CONTROL_PLANE=3

# VLLM_TRUNCATION_VOICED_DBFS__MOVED_TO_CONTROL_PLANE=-40

#   Where a `sourceUri` (HuggingFace) pull lands on this pod — a PVC mount, pod topology. Unset ⇒ huggingface_hub's
#   own cache (`$HF_HOME/hub`; the image sets HF_HOME). Published weights (`localPath`) are read in place and never
#   copied here.
# VLLM_WEIGHTS_CACHE_DIR=
