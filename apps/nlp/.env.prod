# =============================================================================
# NLP Service — Production Environment Variables
# =============================================================================
# Reference template — fill in for your deployment (Docker --env-file /
# systemd EnvironmentFile=). Not auto-loaded from apps/nlp/.env.example;
# NODE_ENV=production means hope_env's loader reads no file at all, so this
# must carry every value production needs, not just the diff from dev.

# App
PORT=8864
LOG_LEVEL=info
# Gates /docs and /redoc exposure (utils.py is_production()) — without it set
# to "production", API docs stay reachable. Also tags exported telemetry's
# deployment.environment resource attribute.
NLP_ENVIRONMENT=production

# Inter-service Authentication — must match the value provisioned for the
# gateway. Empty disables auth enforcement; never leave unset in production.
NLP_SERVICE_TOKEN=<CHANGE_ME>

# Logging
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=1000
LOG_FILE_SEPARATE_ERROR=false
LOG_CONSOLE_JSON_FORMAT=true

# OpenTelemetry (TASK-253)
# Master switch (TASK-411): without this, traces/metrics/logs export stays OFF
# even with the toggles below set — this key was missing here previously.
NLP_OTEL_ENABLED=true
OTEL_SERVICE_NAME=hope-nlp
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.10.1.100:4317
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_RESOURCE_ATTRIBUTES=service.name=hope-nlp,service.namespace=hope,deployment.environment=production
