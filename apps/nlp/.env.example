# App
PORT=8864
LOG_LEVEL=info
SERVICE_NAME=hope-nlp
SERVICE_VERSION=1.0.0

# Document-type text classifier (/classify/text)
# OPEN DECISION (TASK-330 §3.4): the intended clinical doc-type model + label taxonomy is
# undecided, so the default is a non-functional placeholder and the endpoint returns HTTP 503
# until configured. Set this to a real model to enable it. (The old default
# `michellejieli/emotion_text_classifier` was an emotion model used only as a placeholder.)
# TEXT_CLASSIFIER_MODEL_NAME=

# Log file
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=1000
LOG_FILE_SEPARATE_ERROR=false
LOG_CONSOLE_JSON_FORMAT=false

# OpenTelemetry
# Master switch (new in TASK-411): gates traces + metrics + logs. OTel export
# stays fully OFF unless this is true AND the endpoint below is set.
NLP_OTEL_ENABLED=false
OTEL_SERVICE_NAME=hope-nlp
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=hope
# Telemetry export is OPT-IN: leave empty unless an OTLP collector is running
# (dev has none by default — see infrastructure/docker/README.md,
# "Observability" section). Example: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false
OTEL_RESOURCE_ATTRIBUTES=service.name=hope-nlp,service.namespace=hope,deployment.environment=development