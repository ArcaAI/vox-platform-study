# =============================================================================
# NLP Service — Production Environment Variables
# =============================================================================

# App
PORT=8864
LOG_LEVEL=info
SERVICE_NAME=hope-nlp
SERVICE_VERSION=1.0.0

# Logging
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=1000
LOG_FILE_SEPARATE_ERROR=false
LOG_CONSOLE_JSON_FORMAT=true

# OpenTelemetry (TASK-253)
OTEL_SERVICE_NAME=hope-nlp
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=hope
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.10.1.100:4317
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_RESOURCE_ATTRIBUTES=service.name=hope-nlp,service.namespace=hope,deployment.environment=production
