# App
# HOST/PORT/WORKERS are bare (not NLP_-prefixed) — read directly via
# os.getenv() in NLPServiceConfig.__init__, not through the NLP_ env_prefix.
HOST=0.0.0.0
PORT=8864
WORKERS=1
LOG_LEVEL=info
# Gates /docs and /redoc exposure (utils.py is_production()) and the
# deployment.environment resource attribute on exported telemetry.
NLP_ENVIRONMENT=development  # development, staging, production

# Inter-service Authentication (TASK-465): the gateway sends X-Service-Token on
# every hop; the NLP middleware enforces it on non-exempt HTTP + WS surfaces.
# Empty = auth disabled (local dev / hermetic CI). Must match the value
# provisioned for the gateway (same secret both sides).
NLP_SERVICE_TOKEN=""

# --- CANONICAL internal service credential (owner decision D-D, TASK-737/738) --
# INTERNAL_ACCESS_TOKEN is THE one shared internal access token: identical across
# every HOPE service, set by the DevOps engineer, internal use only. It is what
# this service ACCEPTS as X-Service-Token inbound and what it PRESENTS as
# X-Service-Token on every outbound peer call. Unprefixed on purpose — it belongs
# to no single service.
# The per-service / per-pair *_SERVICE_TOKEN vars below are retained ONLY as a
# zero-cost backward-compatibility fallback (inbound accepts EITHER; outbound
# prefers this one and falls back). Set this and the legacy family can be dropped.
# Empty everywhere = auth disabled (local dev / hermetic CI), unchanged.
INTERNAL_ACCESS_TOKEN=

# Model selection (which model to run) is NOT configured via env.
# The classify/diagnosis endpoints require a `model_name` injected by the gateway
# from the DB AiModel registry, and fail closed with HTTP 503 when it is missing
# or the model cannot be loaded. `*_MODEL_NAME` / `*_TOKENIZER_NAME` env vars are
# ignored for selection; only tuning env (thresholds, GPU flags, tokenizer
# behavior, dictionary paths) below still applies.
#
# Document-type text classifier (/classify/text): OPEN DECISION (TASK-330 §3.4) —
# the intended clinical doc-type model + label taxonomy is undecided, so the
# capability stays fail-closed (HTTP 503) until a real doc-type model is configured
# in the DB and injected as `model_name`.

# Clinical ontology linker (TASK-476 C1). Token classification links recognized
# spans to UMLS/SNOMED/RxNorm/ICD-10/LOINC via a bundled self-hosted vocabulary
# (no cloud PHI). Both optional — defaults baked in.
NLP_LINKER_ENABLED=true
NLP_LINKER_CONFIDENCE_FLOOR=0.0

# Log file
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=1000
LOG_FILE_SEPARATE_ERROR=false
LOG_CONSOLE_JSON_FORMAT=false

# Prometheus /metrics endpoint (pull, not push — independent of OTel export).
# Fleet convention: each service owns its own switch, matching
# TEXT_METRICS_ENABLED / TTS_METRICS_ENABLED / GUARDRAIL_V2_METRICS_ENABLED /
# HARNESS_METRICS_ENABLED / METRICS_ENABLED (STT). NLP previously inherited the
# gateway-scoped OTEL_METRICS_ENABLED below, which is false — so its /metrics
# endpoint returned 404 in every environment (TASK-636 OBS-02).
NLP_METRICS_ENABLED=true

# OpenTelemetry
# Master switch (new in TASK-411): gates traces + metrics + logs. OTel export
# stays fully OFF unless this is true AND the endpoint below is set.
NLP_OTEL_ENABLED=false
OTEL_SERVICE_NAME=hope-nlp
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=hope
# Telemetry export is OPT-IN: leave empty unless an OTLP collector is running
# (dev has none by default — see infrastructure/docker/README.md,
# "Observability" section). Example: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false
OTEL_RESOURCE_ATTRIBUTES=service.name=hope-nlp,service.namespace=hope,deployment.environment=development
# --- Model weight cache root (TASK-778) --------------------------------------
# WHERE weights are cached, never WHICH checkpoint runs — selection stays in
# `AiTaskDefault` x `AiModel` and arrives per request. Read by huggingface_hub /
# gliner2 out of os.environ, which `hope_env.load_env()` populates from this file.
#
# It MUST be declared here rather than inherited from an operator's login shell:
# a `~/.zshrc` export does NOT reach the non-interactive shells that services,
# CI and coding agents run in, so an undeclared value silently redirects every
# download to ~/.cache/huggingface. That is exactly how TASK-778's first
# "validated against real weights" claim came to be unsubstantiated.
#
# Unset = the huggingface default (~/.cache/huggingface).
HF_HOME=/Volumes/aillusion/huggingface

# --- Guard-plane inference placement + service classes (TASK-782) ------------
# WHERE the guard tensors execute. Transport/topology, never model identity —
# selection stays `AiTaskDefault` x `AiModel` and arrives per request.
#   cpu   safe on every host, and the only correct value on a Linux/k3s node
#         without a GPU (MPS is Apple-silicon only, so it is a developer-machine
#         placement, not a deployment one)
#   auto  the best device actually present; the ONLY form allowed to land on CPU
#         silently
#   mps / cuda  explicit — RAISES at load when absent, because a latency SLO
#         built on an accelerator that is not there is a false promise
NLP_INFERENCE_DEVICE=cpu
# Submodules kept on CPU when the device is an accelerator. A runtime-COMPAT
# fact about the installed gliner2/torch build, not policy: `count_embed.gru`
# trips an MPSNDArray assertion that ABORTS the process (SIGABRT, not an
# exception), so on MPS the relocation is mandatory rather than an optimisation.
# A torch release that fixes it is answered by emptying this list.
NLP_INFERENCE_DEVICE_CPU_ONLY_MODULES=count_embed.gru
# The INTERACTIVE lane — a synchronous inline gate on a clinician's turn. It has
# its own queue geometry because it has its own latency budget; the bulk
# (per-utterance redaction) lane keeps NLP_INFERENCE_BATCH_* above.
# The wait ceiling IS the declared gate SLO: past it the verdict is too late to
# gate anything, so a 503 the caller fails closed on beats a stale 200.
NLP_INFERENCE_INTERACTIVE_BATCH_MAX_SIZE=2
NLP_INFERENCE_INTERACTIVE_BATCH_LINGER_MS=2
NLP_INFERENCE_INTERACTIVE_QUEUE_MAX_DEPTH=64
NLP_INFERENCE_INTERACTIVE_QUEUE_MAX_WAIT_SECONDS=2
