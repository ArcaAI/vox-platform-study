# App
# HOST/PORT/WORKERS are bare (not NLP_-prefixed) — read directly via
# os.getenv() in NLPServiceConfig.__init__, not through the NLP_ env_prefix.
HOST=0.0.0.0
PORT=8864
WORKERS=1
LOG_LEVEL=info
# Gates /docs and /redoc exposure (utils.py is_production()) and the
# deployment.environment resource attribute on exported telemetry.
NLP_ENVIRONMENT=development  # development, staging, production

# Inter-service Authentication (TASK-465): the gateway sends X-Service-Token on
# every hop; the NLP middleware enforces it on non-exempt HTTP + WS surfaces.
# Empty = auth disabled (local dev / hermetic CI). Must match the value
# provisioned for the gateway (same secret both sides).
NLP_SERVICE_TOKEN=""

# Model selection (which model to run) is NOT configured via env.
# The classify/diagnosis endpoints require a `model_name` injected by the gateway
# from the DB AiModel registry, and fail closed with HTTP 503 when it is missing
# or the model cannot be loaded. `*_MODEL_NAME` / `*_TOKENIZER_NAME` env vars are
# ignored for selection; only tuning env (thresholds, GPU flags, tokenizer
# behavior, dictionary paths) below still applies.
#
# Document-type text classifier (/classify/text): OPEN DECISION (TASK-330 §3.4) —
# the intended clinical doc-type model + label taxonomy is undecided, so the
# capability stays fail-closed (HTTP 503) until a real doc-type model is configured
# in the DB and injected as `model_name`.

# Clinical ontology linker (TASK-476 C1). Token classification links recognized
# spans to UMLS/SNOMED/RxNorm/ICD-10/LOINC via a bundled self-hosted vocabulary
# (no cloud PHI). Both optional — defaults baked in.
NLP_LINKER_ENABLED=true
NLP_LINKER_CONFIDENCE_FLOOR=0.0

# Log file
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=1000
LOG_FILE_SEPARATE_ERROR=false
LOG_CONSOLE_JSON_FORMAT=false

# OpenTelemetry
# Master switch (new in TASK-411): gates traces + metrics + logs. OTel export
# stays fully OFF unless this is true AND the endpoint below is set.
NLP_OTEL_ENABLED=false
OTEL_SERVICE_NAME=hope-nlp
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=hope
# Telemetry export is OPT-IN: leave empty unless an OTLP collector is running
# (dev has none by default — see infrastructure/docker/README.md,
# "Observability" section). Example: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false
OTEL_RESOURCE_ATTRIBUTES=service.name=hope-nlp,service.namespace=hope,deployment.environment=development