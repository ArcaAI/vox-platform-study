# Base URL for the live transcription API (exposed via Cloudflared)
# Example: https://stt-api.your-domain.com
VITE_API_BASE_URL=https://api.your-public-domain.com

# Optional pipeline identifier to request from /v1/transcription/pipeline
# If your API does not require this, you can leave it empty or remove the var.
VITE_PIPELINE_ID=live-transcription-pipeline

# JWT bearer token used by the API for session create/delete requests.
VITE_AUTH_TOKEN=

# Tenant ID required by the API gateway for streaming session requests.
VITE_TENANT_ID=50000000-0000-0000-0000-000000000000
