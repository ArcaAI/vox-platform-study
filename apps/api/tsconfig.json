{
  "extends": "@arcaai/config-ts/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // TS 6 no longer auto-discovers @types/*, and these two AUGMENT GLOBALS rather
    // than being imported: @types/express declares the `Express` namespace and
    // @types/multer adds `Express.Multer.File` to it (20x TS2694 without them).
    // Packages imported by name need no entry here.
    "types": ["node", "express", "multer"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
