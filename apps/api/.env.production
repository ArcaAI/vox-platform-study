NODE_ENV=production
SERVICE_NAME=api-gateway
SERVICE_VERSION=1.0.0

# Apps
PORT=8868
URL=
STT_URL=http://localhost:8861
GUARDRAIL_URL=http://localhost:8863
HARNESS_URL=http://localhost:8866

# =============================================================================
# SECRETS — HashiCorp Vault (TASK-312)
# =============================================================================
# This file carries NO secret material. Every secret (JWT_SECRET_KEY,
# SESSION_SECRET_KEY, REDIS_PASS, MQTT_PASS, API_KEY_PEPPER, OIDC_CLIENT_SECRET,
# SMR_SERVICE_TOKEN, S3_*) is resolved from Vault at boot (warmup keys); the
# database password is minted per-connection by Vault's database engine.
SECRETS_PROVIDER=vault
VAULT_ADDR=https://vault.internal:8200
VAULT_NAMESPACE=

# AppRole: role_id + a one-shot RESPONSE-WRAPPED secret_id are delivered as
# FILES by the platform (systemd-creds / k8s Secret mount), never inlined here.
# The wrapped secret_id is unwrapped exactly once during boot(); the app then
# self-renews its token at 50% TTL until token_max_ttl, after which the pod is
# recycled and re-boots with a freshly-injected wrapped secret_id (Phase C/D
# vault-agent-injector automates the injection).
VAULT_ROLE_ID_FILE=/run/secrets/vault_role_id
VAULT_WRAPPED_SECRET_ID_FILE=/run/secrets/vault_wrapped_secret_id

# kv-v2 / transit layout — override only if your mounts differ from the defaults.
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=hope
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=hope-globalsetting
VAULT_REQUEST_TIMEOUT_MS=5000

# Rotation worker tails this audit sink to invalidate caches fleet-wide.
VAULT_AUDIT_LOG_PATH=/var/log/vault/audit.log

# =============================================================================
# DATABASE — Vault dynamic credentials (no password in this file)
# =============================================================================
# PG_DYNAMIC_CREDS=true makes CoreDatabaseService mint a short-lived PG user via
# the Vault database engine (role PG_VAULT_ROLE) per connection; the lease is
# auto-renewed by VaultLeaseRenewer. Only non-secret coordinates live here.
# Schema migrations run as a SEPARATE ops step with their own admin credentials
# (not from this runtime env).
PG_DYNAMIC_CREDS=true
PG_VAULT_ROLE=hope-app-role
# BUG-006 follow-up — must match the Vault role's max_ttl (720h = 30d; the
# prod `vault write database/roles/hope-app-role ...` bootstrap command is
# documented in docs/operations/vault/README.md "Dynamic DB credentials" —
# there is no in-repo script that provisions it, unlike dev). If unset, the
# app falls back to a conservative 24h and force-swaps the pool daily
# instead of monthly.
PG_VAULT_MAX_TTL_SEC=2592000
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hope_main
VAULT_DB_NAME=hope_main

# MQTT  (MQTT_PASS resolved from Vault)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=

# REDIS (REDIS_PASS resolved from Vault)
REDIS_HOST=localhost
REDIS_PORT=6379

# Graceful Shutdown
SHUTDOWN_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_DELAY_MS=5000

# Logging
LOG_LEVEL=info
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_JSON=true
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=1000
LOG_FILE_SEPARATE_ERROR=false

# Disable legacy transports — SDK pipeline handles log export
LOKI_ENABLED=false

# OpenTelemetry (TASK-252, TASK-256)
OTEL_SERVICE_NAME=api-gateway
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.10.1.100:4317
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_LOGS_ENABLED=true
OTEL_LOG_BRIDGE=true

# API Key Security (API_KEY_PEPPER resolved from Vault)
API_KEY_ALLOW_QUERY_PARAM=false    # NEVER enable in production
API_KEY_MAX_LIFETIME_DAYS=365
