# ── Process ─────────────────────────────────────────────────────────────

# Service name
#   Logical service name stamped on logs and metrics.
#   tier: env · read by: apps/api
SERVICE_NAME=hope-api

# Debug mode
#   Enables verbose config/service debug logging.
#   tier: env · read by: apps/api
DEBUG=false

# Nest debug mode
#   Enables NestJS-internal debug logging.
#   tier: env · read by: apps/api
NEST_DEBUG=false

# Explicit env-file path
#   Overrides the NODE_ENV→file map used by `loadEnv()`. Unset in every normal deployment.
#   tier: env · read by: apps/api
ENV_FILE_PATH=

# Enable Prisma Studio module
#   Development-only: mounts the Prisma Studio module (`app.module.ts`).
#   tier: env · read by: apps/api
ENABLE_PRISMA_STUDIO=false

# AppSettings boot-invariant mode
#   Set to `skip` (development only) to bypass the AppSettings boot invariant (`appSettings.service.ts`).
#   tier: env · read by: apps/api
APP_SETTINGS_BOOT_INVARIANT=

# ── Logging ─────────────────────────────────────────────────────────────

# File logging enabled
#   Writes rotating log files in addition to stdout.
#   tier: env · read by: apps/api
LOG_FILE_ENABLED=false

# Log directory
#   Directory rotating log files are written to.
#   tier: env · read by: apps/api
LOG_FILE_PATH=./logs

# Log rotation size
#   Rotate after this much data (winston-daily-rotate-file syntax).
#   tier: env · read by: apps/api
LOG_FILE_MAX_SIZE=10m

# Log files retained
#   Number of rotated log files kept.
#   tier: env · read by: apps/api
LOG_FILE_MAX_FILES=1000

# Log rotation date pattern
#   Date pattern in rotated log file names.
#   tier: env · read by: apps/api
LOG_FILE_DATE_PATTERN=yyyy-MM-dd

# Separate error log
#   Writes errors to their own file in addition to the combined log.
#   tier: env · read by: apps/api
LOG_FILE_SEPARATE_ERROR=false

# ── Observability ───────────────────────────────────────────────────────

# Disable the OTel SDK
#   Skips OpenTelemetry SDK start-up entirely.
#   tier: env · read by: apps/api
OTEL_SDK_DISABLED=false

# OTel diagnostic logging
#   Enables the OpenTelemetry diagnostic logger.
#   tier: env · read by: apps/api
OTEL_DEBUG=false

# OTLP endpoint
#   gRPC OTLP collector endpoint. Unset disables the exporters.
#   tier: env · read by: apps/api
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTel service name
#   Value of the `service.name` resource attribute.
#   tier: env · read by: apps/api
OTEL_SERVICE_NAME=api-gateway

# OTel service version
#   Value of the `service.version` resource attribute.
#   tier: env · read by: apps/api
OTEL_SERVICE_VERSION=1.0.0

# OTel metrics enabled
#   Turns on the OpenTelemetry metrics pipeline.
#   tier: env · read by: apps/api
OTEL_METRICS_ENABLED=false

# OTel traces enabled
#   Turns on the OpenTelemetry tracing pipeline.
#   tier: env · read by: apps/api
OTEL_TRACES_ENABLED=false

# Metrics name prefix
#   Prefix for Prometheus metric names; defaults to the sanitized service name.
#   tier: env · read by: apps/api
METRICS_PREFIX=

# Metrics collection interval (ms)
#   Interval of the simplified monitoring collector.
#   tier: env · read by: apps/api
METRICS_COLLECT_INTERVAL=15000

# ── Secrets ─────────────────────────────────────────────────────────────

# Vault namespace
#   Vault Enterprise namespace. Unset on OSS Vault.
#   tier: env · read by: apps/api
VAULT_NAMESPACE=

# Vault Transit mount
#   Mount path of the Transit engine used for envelope encryption.
#   tier: env · read by: apps/api
VAULT_TRANSIT_MOUNT=transit

# Transit key (GlobalSetting)
#   Transit key that wraps `GlobalSetting.encryptedValue`.
#   tier: env · read by: apps/api
VAULT_TRANSIT_KEY=hope-globalsetting

# Transit key (PHI)
#   Transit key that wraps PHI columns.
#   tier: env · read by: apps/api
VAULT_TRANSIT_KEY_PHI=hope-phi

# Vault request timeout (ms)
#   Per-request timeout of the Vault HTTP client.
#   tier: env · read by: apps/api
VAULT_REQUEST_TIMEOUT_MS=5000

# Vault audit-log path
#   File the rotation worker tails for Vault audit events. Unset disables the worker.
#   tier: env · read by: apps/api
VAULT_AUDIT_LOG_PATH=

# Vault token
#   Direct Vault token. Operator/CLI path only — services authenticate with AppRole.
#   tier: env · read by: apps/api
VAULT_TOKEN=

# Vault dev root token
#   Root token of the LOCAL dev Vault; used by seeds. Never set in a deployed environment.
#   tier: env · read by: apps/api
VAULT_DEV_ROOT_TOKEN=

# Secret cache TTL (s)
#   Per-entry TTL of the SecretsService LRU cache.
#   tier: env · read by: apps/api
SECRETS_TTL_SEC=300

# Secret cache size
#   Maximum entries in the SecretsService LRU cache.
#   tier: env · read by: apps/api
SECRETS_LRU_MAX=200

# ── Database ────────────────────────────────────────────────────────────

# Vault dynamic DB credentials
#   Opt in to Vault-issued, short-lived PostgreSQL credentials (plan §4 B6).
#   tier: env · read by: apps/api
PG_DYNAMIC_CREDS=false

# Vault database role
#   Vault database-engine role that mints the dynamic credentials.
#   tier: env · read by: apps/api
PG_VAULT_ROLE=hope-app-role

# Dynamic credential max TTL (s)
#   Upper bound applied to a Vault-issued credential lease.
#   tier: env · read by: apps/api
PG_VAULT_MAX_TTL_SEC=

# PostgreSQL host
#   Host used when assembling a dynamic-credential connection (`vault-client.ts`).
#   tier: env · read by: apps/api
PG_HOST=localhost

# PostgreSQL port
#   Port used when assembling a dynamic-credential connection.
#   tier: env · read by: apps/api
PG_PORT=5432

# PostgreSQL database
#   Database used when assembling a dynamic-credential connection.
#   tier: env · read by: apps/api
PG_DATABASE=hope_main

# ── Storage ─────────────────────────────────────────────────────────────

# MinIO/S3 TLS
#   Whether the object-storage endpoint is reached over TLS.
#   tier: env · read by: apps/api
MINIO_USE_SSL=false

# MinIO/S3 region
#   Region passed to the S3-compatible client.
#   tier: env · read by: apps/api
MINIO_REGION=us-east-1

# MINIO_ENDPOINT (bootstrap fallback)
#   Deploy-time fallback used ONLY before the SYSTEM storage row exists (first boot / pre-seed). Scheduled for
#   removal one release after the SYSTEM row ships; a WARN is logged whenever it is the tier that supplied the
#   value.
#   tier: env · read by: apps/api
MINIO_ENDPOINT=

# ── Messaging ───────────────────────────────────────────────────────────

# MQTT host
#   MQTT broker host.
#   tier: env · read by: apps/api
MQTT_HOST=localhost

# MQTT port
#   MQTT broker port.
#   tier: env · read by: apps/api
MQTT_PORT=1883

# MQTT user
#   MQTT broker username. The password is a `vault-kv` secret (`MQTT_PASS`).
#   tier: env · read by: apps/api
MQTT_USER=

# ── Streaming ───────────────────────────────────────────────────────────

# STT WS egress high-water mark (bytes)
#   Buffered-amount threshold above which partial transcripts are dropped.
#   tier: env · read by: apps/stt
STT_WS_EGRESS_HIGH_WATERMARK_BYTES=524288

# STT WS resume grace (ms)
#   Window a disconnected STT session is held open for reconnect.
#   tier: env · read by: apps/stt
STT_WS_RESUME_GRACE_MS=15000

# TTS WS egress high-water mark (bytes)
#   Buffered-amount threshold above which TTS audio frames are dropped.
#   tier: env · read by: apps/tts
TTS_WS_EGRESS_HIGH_WATERMARK_BYTES=524288

# ── Credentials ─────────────────────────────────────────────────────────

# Platform storage credentials (Vault kv-v2) (REQUIRED — boot fails without it)
#   Operator-set JSON `{ accessKeyId, secretAccessKey }` at the Vault path recorded in the SYSTEM row's
#   `credentialsRef` (default `platform/storage/minio`). Never stored in the database and never returned by any API.
#   tier: vault-kv · read by: apps/api
STORAGE_PLATFORM_DEFAULT_CREDENTIALS=<CHANGE_ME>

# ── Service Tokens ──────────────────────────────────────────────────────

# SMR service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔SMR hop. SMR reads it as `settings.service_token` under its `SMR_` pydantic prefix;
#   the gateway resolves the same name for outbound proxying and for `InternalServiceTokenGuard`'s inbound check.
#   tier: vault-kv · read by: apps/api
SMR_SERVICE_TOKEN=<CHANGE_ME>

# NLP service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔NLP hop (`X-Service-Token`).
#   tier: vault-kv · read by: apps/api
NLP_SERVICE_TOKEN=<CHANGE_ME>

# Guardrail service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔guardrail hop (`X-Service-Token`).
#   tier: vault-kv · read by: apps/api
GUARDRAIL_SERVICE_TOKEN=<CHANGE_ME>

# Harness service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔harness hop. Fetched on demand (not a warmup key) by `HarnessOpsClient` /
#   `HarnessGatewayService` / `HarnessServiceTokenGuard`. It MUST equal the harness process’s own
#   `HARNESS_SERVICE_TOKEN`, or every `/api/v1/internal/harness/*` call 401s.
#   tier: vault-kv · read by: apps/api
HARNESS_SERVICE_TOKEN=<CHANGE_ME>

# TTS service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔TTS hop (`X-Service-Token`).
#   tier: vault-kv · read by: apps/api
TTS_SERVICE_TOKEN=<CHANGE_ME>

# STT gateway key (REQUIRED — boot fails without it)
#   The credential STT presents to the gateway. STT is the one service that authenticates with
#   `X-Internal-Service-Key` rather than `X-Service-Token`, reusing this key instead of minting a second STT
#   credential (`InternalServiceTokenGuard.SERVICE_SECRETS.stt`). There is no `STT_SERVICE_TOKEN`.
#   tier: vault-kv · read by: apps/api
API_GATEWAY_KEY=<CHANGE_ME>

# ── Data Plane ──────────────────────────────────────────────────────────

# Redis password (REQUIRED — boot fails without it)
#   Redis AUTH password. Resolved through SecretsService and layered over the env value by
#   `ConfigService.applySecretOverrides`.
#   tier: vault-kv · read by: apps/api
REDIS_PASS=<CHANGE_ME>

# MQTT password (REQUIRED — boot fails without it)
#   MQTT broker password, consumed by `MqttService` via `ConfigService`.
#   tier: vault-kv · read by: apps/api
MQTT_PASS=<CHANGE_ME>

# MinIO access key (REQUIRED — boot fails without it)
#   MinIO/S3 access key for platform object storage. NOTE: the per-tenant / platform-default STORAGE CONFIG
#   (endpoint, region, path style, prefix) is a separate concern owned by `TenantStorageConfig`; only the credential
#   lives here, referenced by `credentialsRef`.
#   tier: vault-kv · read by: apps/api
MINIO_ACCESS_KEY=<CHANGE_ME>

# MinIO secret key (REQUIRED — boot fails without it)
#   MinIO/S3 secret key for platform object storage.
#   tier: vault-kv · read by: apps/api
MINIO_SECRET_KEY=<CHANGE_ME>

# S3 access key (REQUIRED — boot fails without it)
#   S3-protocol access key read by `S3Service`. In local dev this aliases the MinIO credential (HOPE speaks S3 to
#   MinIO); in a deployed environment it may name a distinct S3 principal.
#   tier: vault-kv · read by: apps/api
S3_ACCESS_KEY=<CHANGE_ME>

# S3 secret key (REQUIRED — boot fails without it)
#   S3-protocol secret key read by `S3Service`.
#   tier: vault-kv · read by: apps/api
S3_SECRET_KEY=<CHANGE_ME>

# Claim-check store access key (REQUIRED — boot fails without it)
#   S3/MinIO access key for the harness claim-check blob store. The offloaded payloads are clinical content, so the
#   store is SELF-HOSTED by contract — this credential must never address a cloud bucket.
#   tier: vault-kv · read by: apps/harness
HARNESS_CLAIM_CHECK_ACCESS_KEY=<CHANGE_ME>

# Claim-check store secret key (REQUIRED — boot fails without it)
#   S3/MinIO secret key for the harness claim-check blob store (self-hosted only; PHI must not egress).
#   tier: vault-kv · read by: apps/harness
HARNESS_CLAIM_CHECK_SECRET_KEY=<CHANGE_ME>

# ── AI Providers ────────────────────────────────────────────────────────

# Azure Speech key (REQUIRED — boot fails without it)
#   Azure Cognitive Services Speech credential. Shared by STT (`azure_speech_loader`) and TTS, which accepts it as
#   the fallback alias for `TTS_AZURE_API_KEY`.
#   tier: vault-kv · read by: apps/api
AZURE_SPEECH_KEY=<CHANGE_ME>

# Azure AI Foundry key (REQUIRED — boot fails without it)
#   Azure AI Foundry credential used by the STT Foundry model loader.
#   tier: vault-kv · read by: apps/api
AZURE_FOUNDRY_API_KEY=<CHANGE_ME>

# SMR Azure OpenAI key (REQUIRED — boot fails without it)
#   SMR's Azure OpenAI credential (`SMR_AZURE_` pydantic prefix, typed `SecretStr`).
#   tier: vault-kv · read by: apps/smr
SMR_AZURE_API_KEY=<CHANGE_ME>

# Sarvam TTS key (platform) (REQUIRED — boot fails without it)
#   PLATFORM-level Sarvam credential (`TTS_SARVAM_` prefix). A TENANT-supplied Sarvam key is a different data class
#   entirely — `tts.credential.sarvam`, tier `db-secret` — and must never be stored here.
#   tier: vault-kv · read by: apps/tts
TTS_SARVAM_API_KEY=<CHANGE_ME>

# Guardrail vLLM key (REQUIRED — boot fails without it)
#   Bearer credential for guardrail's vLLM OpenAI-compatible endpoint (`GUARDRAIL_VLLM_` prefix). Self-hosted
#   endpoints commonly accept a placeholder, but it is still a credential and is classified as one.
#   tier: vault-kv · read by: apps/guardrail
GUARDRAIL_VLLM_API_KEY=<CHANGE_ME>

# Harness judge endpoint key (REQUIRED — boot fails without it)
#   Bearer credential for the harness LLM-as-judge OpenAI-compatible endpoint (`HARNESS_JUDGE_OPENAI_COMPAT_`
#   prefix). Connection config only — WHICH judge model runs is `models.harness.judge`, a fail-closed db-config
#   selection.
#   tier: vault-kv · read by: apps/harness
HARNESS_JUDGE_OPENAI_COMPAT_API_KEY=<CHANGE_ME>
