NODE_ENV=development

# Apps
PORT=8868
URL=
STT_V2_URL=http://localhost:8861
GUARDRAIL_URL=http://localhost:8863

# Clinical Documentation Harness (TASK-330 Lane G — apps/api <-> apps/harness gate adapter)
# HARNESS_URL: base URL HarnessGatewayService POSTs to (start / approve-signal).
# HARNESS_SERVICE_TOKEN: shared service token. Outbound calls send it as the
# `X-Service-Token` header; inbound /internal/harness/* calls are validated against
# it by HarnessServiceTokenGuard (fail-closed when unset).
HARNESS_URL=http://localhost:8866
HARNESS_SERVICE_TOKEN=dev-harness-service-token-change-me

# ── Database (TASK-302 Stream C Phase 2A — PgBouncer transaction mode) ──
# Local dev (direct PG): leave DIRECT_URL unset. Production must split:
#   DATABASE_URL → pgbouncer (port 6432, transaction mode)
#   DIRECT_URL   → un-pooled (port 5432 direct, or 5000 HAProxy R/W)
# Prisma Migrate's advisory locks break under transaction-mode pooling,
# so migrations route through DIRECT_URL via prisma.config.ts.
#
# In-transit TLS (TASK-369 Phase 2): local dev runs without TLS (loopback PG).
# Production/staging MUST append sslmode — verify-full is the target (encrypt +
# verify the server cert/hostname against a trusted CA via sslrootcert), with
# sslmode=require as the interim minimum. This applies to BOTH DATABASE_URL and
# DIRECT_URL. Enable server TLS on Patroni/PgBouncer first (operator step) — see
# infrastructure/SECURITY_DEPLOYMENT_GUIDE.md.
DATABASE_URL=postgres://prisma.arcaai:prisma@localhost:5432/postgres
# DIRECT_URL=postgresql://hope_app:<password>@10.10.1.250:5000/hope?sslmode=verify-full&sslrootcert=/etc/ssl/certs/hope-ca.crt
# (require-only interim:  DIRECT_URL=postgresql://hope_app:<password>@10.10.1.250:5000/hope?sslmode=require)

# Per-pod Prisma adapter pool size. Default 5.
# Budget rule: pods * PRISMA_PG_MAX <= 0.7 * PG max_connections
PRISMA_PG_MAX=5

# Legacy (deprecated; kept for back-compat with older deployment scripts):
DB_CONNECTION_STRING=postgres://prisma.arcaai:prisma@localhost:5432/postgres
DB_CONNECTION_STRING_DIRECT=postgres://prisma.arcaai:prisma@localhost:5432/postgres

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=redis-password

# DEBUG & LOGS
LOG_LEVEL=debug
SESSION_SECRET_KEY=hope-session-secret

# Graceful Shutdown Configuration
# Total time allowed for graceful shutdown in milliseconds (default: 30000)
# Should match Kubernetes terminationGracePeriodSeconds
SHUTDOWN_TIMEOUT_MS=30000
# Time to wait for load balancer to stop routing traffic in milliseconds (default: 5000)
SHUTDOWN_DRAIN_DELAY_MS=5000
# Log file
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=1000
LOG_FILE_SEPARATE_ERROR=false

# OpenTelemetry
OTEL_SERVICE_NAME=api-gateway
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_LOGS_ENABLED=true
OTEL_LOG_BRIDGE=true

# API Key Security
API_KEY_PEPPER=
API_KEY_ALLOW_QUERY_PARAM=true
API_KEY_MAX_LIFETIME_DAYS=
