# =============================================================================
# apps/api — Production Environment Reference
# =============================================================================
# TWO deployment postures are documented here (TASK-584: relocated from the
# monorepo-root `.env.production` and merged with this file's prior content).
# Neither is loaded by the app itself — NODE_ENV=production means the app's
# own env-file resolution reads no file at all; production is configured by
# whichever mechanism your deployment uses (K8s ConfigMap/Secret injection,
# or a systemd `EnvironmentFile=`) to populate the HOST environment.
#
#   SECTION 1 — K8s ConfigMap/Secret posture (§1 below, ACTIVE key values):
#     plain Docker/K8s environment injection, secrets set directly.
#   SECTION 2 — systemd + Vault AppRole posture (§2 below): dynamic DB
#     credentials, Vault-resolved secrets, single-host localhost topology.
#     Keys already declared active in §1 are NOT re-declared here — see the
#     cross-reference comments — because a flat env file can only carry one
#     active value per key (the "duplicate keys / silent last-wins" defect
#     TASK-558 already found and fixed once). Pick ONE posture per
#     deployment; if you're using §2, override the §1-only keys it needs
#     with your systemd-topology values (localhost instead of hostnames).
# =============================================================================

# =============================================================================
# §1 — K8s ConfigMap/Secret posture
# =============================================================================

NODE_ENV=production
DEBUG=false

# Entitlements enforcement (TASK-392) — seed-time default for the
# `entitlements.enabled` kill-switch on a FRESH database (read only by
# seed/15-entitlements.ts). Ratified 2026-07-02: enable in DEV + STAGING.
#   • STAGING: set ENTITLEMENTS_ENABLED_DEFAULT=true in the staging host env /
#     K8s ConfigMap — it takes effect on the NEXT deploy that runs the seed.
#   • PRODUCTION: leave UNSET (defaults to OFF); production enablement is a
#     separate decision and is intentionally NOT turned on by this template.
# After seeding, the live value is a GlobalSetting toggled at runtime via
# PUT /api/v1/admin/entitlements/enabled (a re-seed never clobbers it).
# ENTITLEMENTS_ENABLED_DEFAULT=true   # ← STAGING host env only (not committed on for prod)

# Database
# In-transit TLS is REQUIRED in production (TASK-369 Phase 2). The connection
# string MUST carry an sslmode: verify-full is the target (encrypt + verify the
# server certificate and hostname against a trusted CA), with sslmode=require as
# the interim minimum until the CA is distributed to every client host.
#   verify-full: postgresql://hope_app:****@10.10.1.250:6432/hope?schema=core&sslmode=verify-full&sslrootcert=/etc/ssl/certs/hope-ca.crt
#   require:     postgresql://hope_app:****@10.10.1.250:6432/hope?schema=core&sslmode=require
# Server-side TLS must be enabled on Patroni/PgBouncer first (operator step) —
# see research/deployments/encryption-at-rest-luks-minio-sse-runbook.md and
# infrastructure/SECURITY_DEPLOYMENT_GUIDE.md.
DATABASE_URL=                      # PostgreSQL connection string (required) — MUST include sslmode=require|verify-full

# Redis
REDIS_HOST=                        # Redis host (required)
REDIS_PORT=6379                    # Redis port
REDIS_PASS=                        # Redis password (if authentication enabled)

# Security
# JWT signing uses JWT_SECRET_KEY (resolved via Vault/SecretsService, not this
# file — see the settings registry). JWT_SECRET / JWT_EXPIRES_IN are read by
# nothing (JWT_EXPIRES_IN is a DB-backed AppSettingsService value, default '1h').
SESSION_SECRET_KEY=                # Strong random secret for session encryption

# API Key Security
API_KEY_PEPPER=                    # HMAC-SHA256 pepper for key hashing (required, generate with: openssl rand -hex 32)
API_KEY_ALLOW_QUERY_PARAM=false    # NEVER enable in production — keys in URLs leak via logs/history
API_KEY_MAX_LIFETIME_DAYS=365      # Maximum key lifetime; adjust per compliance requirements

# Service URLs — internal, hostname-based (K8s Service DNS); adjust for your
# infrastructure.
PORT=8868                          # API Gateway port
API_URL=http://api:8868            # Internal API URL
GUARDRAIL_URL=http://guardrail:8863  # Guardrail service URL
SMR_PORT=8862
SMR_URL=http://smr:8862            # SMR service URL
NLP_PORT=8864
NLP_URL=http://nlp:8864            # NLP service URL
HARNESS_URL=http://harness:8866    # Clinical Documentation Harness URL

# Observability
LOG_LEVEL=info
LOG_FILE_ENABLED=false             # Use container logging instead of file logging

# OpenTelemetry
OTEL_SERVICE_VERSION=              # Set from CI/CD build version
# REQUIRED to enable telemetry export: when empty the API exports NOTHING —
# there is no implicit localhost:4317 fallback as of TASK-411.
OTEL_EXPORTER_OTLP_ENDPOINT=       # Your OTLP collector endpoint (required for export)
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true

# Object storage (MinIO/S3)
MINIO_ENDPOINT=                    # S3-compatible endpoint
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true                 # Always use SSL in production

# CORS
CORS_ALLOWED_ORIGINS=              # Comma-separated list of allowed origins
                                   # e.g., https://app.example.com,https://admin.example.com

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=30000          # Max time to wait for graceful shutdown
SHUTDOWN_DRAIN_DELAY_MS=5000       # Time to wait for load balancer to drain

# =============================================================================
# §2 — systemd + Vault AppRole posture (Vault-AppRole secret delivery +
# dynamic DB credentials; see apps/api/docs/04-deployment-guide.md)
# =============================================================================
# NODE_ENV, PORT, service URLs, REDIS_HOST/PORT, LOG_LEVEL, OTEL_*,
# API_KEY_ALLOW_QUERY_PARAM/MAX_LIFETIME_DAYS, SHUTDOWN_* are already declared
# active in §1 above — this posture's topology is single-host (localhost),
# not per-hostname, so if you're deploying this way, override those §1 keys
# to point at localhost instead of re-declaring them here.

SERVICE_NAME=api-gateway
SERVICE_VERSION=1.0.0

# =============================================================================
# SECRETS — HashiCorp Vault (TASK-312)
# =============================================================================
# This file carries NO secret material. Every secret (JWT_SECRET_KEY,
# SESSION_SECRET_KEY, REDIS_PASS, MQTT_PASS, API_KEY_PEPPER, OIDC_CLIENT_SECRET,
# SMR_SERVICE_TOKEN, S3_*) is resolved from Vault at boot (warmup keys); the
# database password is minted per-connection by Vault's database engine.
SECRETS_PROVIDER=vault
VAULT_ADDR=https://vault.internal:8200
VAULT_NAMESPACE=

# AppRole: role_id + a one-shot RESPONSE-WRAPPED secret_id are delivered as
# FILES by the platform (systemd-creds / k8s Secret mount), never inlined here.
# The wrapped secret_id is unwrapped exactly once during boot(); the app then
# self-renews its token at 50% TTL until token_max_ttl, after which the pod is
# recycled and re-boots with a freshly-injected wrapped secret_id (Phase C/D
# vault-agent-injector automates the injection).
VAULT_ROLE_ID_FILE=/run/secrets/vault_role_id
VAULT_WRAPPED_SECRET_ID_FILE=/run/secrets/vault_wrapped_secret_id

# kv-v2 / transit layout — override only if your mounts differ from the defaults.
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=hope
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=hope-globalsetting
VAULT_REQUEST_TIMEOUT_MS=5000

# Rotation worker tails this audit sink to invalidate caches fleet-wide.
VAULT_AUDIT_LOG_PATH=/var/log/vault/audit.log

# =============================================================================
# DATABASE — Vault dynamic credentials (no password in this file)
# =============================================================================
# PG_DYNAMIC_CREDS=true makes CoreDatabaseService mint a short-lived PG user via
# the Vault database engine (role PG_VAULT_ROLE) per connection; the lease is
# auto-renewed by VaultLeaseRenewer. Only non-secret coordinates live here.
# Schema migrations run as a SEPARATE ops step with their own admin credentials
# (not from this runtime env).
PG_DYNAMIC_CREDS=true
PG_VAULT_ROLE=hope-app-role
# BUG-006 follow-up — must match the Vault role's max_ttl (720h = 30d; the
# prod `vault write database/roles/hope-app-role ...` bootstrap command is
# documented in docs/operations/vault/README.md "Dynamic DB credentials" —
# there is no in-repo script that provisions it, unlike dev). If unset, the
# app falls back to a conservative 24h and force-swaps the pool daily
# instead of monthly.
PG_VAULT_MAX_TTL_SEC=2592000
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hope_main
VAULT_DB_NAME=hope_main

# MQTT (MQTT_PASS resolved from Vault)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=

# Logging (systemd-posture specifics beyond LOG_LEVEL/LOG_FILE_ENABLED in §1)
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_JSON=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=1000
LOG_FILE_SEPARATE_ERROR=false

# Disable legacy transports — SDK pipeline handles log export
LOKI_ENABLED=false

# OpenTelemetry (systemd-posture specifics beyond ENDPOINT/TRACES/METRICS in §1)
OTEL_SERVICE_NAME=api-gateway
OTEL_LOGS_ENABLED=true
OTEL_LOG_BRIDGE=true
