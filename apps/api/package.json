{
  "name": "@arcaai/api",
  "version": "0.1.0",
  "description": "API server for daydream",
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf dist tsconfig.build.tsbuildinfo && nest build && tsc-alias",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "dev": "rimraf dist *.tsbuildinfo && nest start --debug --watch",
    "dev:watch": "rimraf dist *.tsbuildinfo && nodemon",
    "start:debug": "rimraf dist *.tsbuildinfo && nest start --debug --watch",
    "start:prod": "node --import ./dist/instrumentation.js dist/main.js",
    "clean": "rimraf dist *.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo *.tsbuildinfo",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "dotenv -e ../../.env.test -- playwright test --config ../../playwright.config.ts"
  },
  "dependencies": {
    "@arcaai/applications": "workspace:*",
    "@arcaai/database": "workspace:*",
    "@arcaai/domains": "workspace:*",
    "@arcaai/exceptions": "workspace:*",
    "@arcaai/logger": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.27",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/platform-ws": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.27",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/instrumentation": "^7.8.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "0.15.1",
    "compression": "^1.8.1",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "http-proxy-middleware": "^4.1.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nestjs-cls": "^6.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
