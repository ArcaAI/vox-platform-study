{
  "name": "@arcaai/api",
  "version": "0.1.0",
  "description": "API server for daydream",
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf dist && nest build && tsc-alias",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "dev": "rimraf dist *.tsbuildinfo && nest start --debug --watch",
    "dev:watch": "rimraf dist *.tsbuildinfo && nodemon",
    "start:debug": "rimraf dist *.tsbuildinfo && nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "clean": "rimraf dist *.tsbuildinfo",
    "nuke": "rimraf dist node_modules .turbo *.tsbuildinfo",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@arcaai/applications": "workspace:*",
    "@arcaai/database": "workspace:*",
    "@arcaai/domains": "workspace:*",
    "@arcaai/exceptions": "workspace:*",
    "@arcaai/logger": "workspace:*",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.14",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/platform-socket.io": "^11.1.14",
    "@nestjs/platform-ws": "^11.1.14",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.14",
    "@sentry/node": "^9.18.0",
    "@sentry/profiling-node": "^9.18.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-cls": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^3.1.0",
    "prometheus-api-metrics": "^3.2.2",
    "qrcode": "^1.5.4",
    "real-require": "^0.2.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "speakeasy": "^2.0.0",
    "uuidv7": "^1.0.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@arcaai/config-eslint": "workspace:*",
    "@arcaai/config-ts": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-oauth2": "^1.4.15",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.0",
    "@vercel/ncc": "^0.38.3",
    "@vitejs/plugin-react": "^4.5.2",
    "nodemon": "^3.1.14",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3"
  }
}
