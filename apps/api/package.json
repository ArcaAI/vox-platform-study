    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vercel/ncc": "^0.38.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint-plugin-arcaai-internal": "workspace:*",
    "nodemon": "^3.1.14",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
