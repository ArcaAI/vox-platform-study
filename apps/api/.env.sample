# ============================================================================
# GENERATED FILE — DO NOT EDIT BY HAND.
#
# Produced by `pnpm env:sync` from the settings registry + apps/api/src/config/env.descriptors.ts.
# `pnpm env:sync --check` fails the build (CI job `env-drift-check`) when this
# file and the schema disagree. To change a variable, change its DECLARATION
# and regenerate — editing this file is reverted by the next sync.
#
# Committed example files carry PLACEHOLDERS ONLY, never secrets.
# ============================================================================
#
# THE PLATFORM CONTRACT BEYOND THE BOOTSTRAP FLOOR.
#
# The floor itself (DATABASE_URL, REDIS_*, VAULT_*, …) is the first section
# of the consolidated `.env.sample` at the repo root; this file carries
# everything else the platform declares.
#
# Since lane C there is ONE env file per environment, shared by the gateway and
# all six Python services, so this is one shared contract: the `read by:` note
# on each variable records which deployable actually consumes it.
#
# Every variable here is also validated at gateway boot by
# `apps/api/src/config/env.schema.ts`, before `NestFactory.create()`.

# ── Platform Operations ─────────────────────────────────────────────────

# Log level
#   Gateway log level, applied live by `PlatformKnobsBinder` through `ILoggingService.setLevel` whenever the
#   settings cache refreshes — so an operator can raise verbosity during an incident with no redeploy. `LOG_LEVEL`
#   remains the BOOTSTRAP value: it is read pre-bootstrap in `apps/api/src/main.ts` (before the Nest module graph,
#   therefore before any DB) to seed the Nest logger.
#   tier: global-kv · read by: apps/api
LOG_LEVEL=info

# Graceful shutdown timeout (ms)
#   Upper bound on graceful shutdown before the process is forced down. `GracefulShutdownService` resolves it at
#   SHUTDOWN time, not construction time, so a change applies to the next drain without a restart.
#   `SHUTDOWN_TIMEOUT_MS` remains the bootstrap fallback.
#   tier: global-kv · read by: apps/api
SHUTDOWN_TIMEOUT_MS=30000

# Shutdown drain delay (ms)
#   Delay between failing readiness and closing the server, so a load balancer stops routing before connections
#   drop. Resolved at drain time (see `shutdown.timeoutMs`). `SHUTDOWN_DRAIN_DELAY_MS` remains the bootstrap
#   fallback.
#   tier: global-kv · read by: apps/api
SHUTDOWN_DRAIN_DELAY_MS=5000

# Rate limiting enabled
#   Whether throttling is enforced. A tenant may only move this towards the STRICT end (`tenant-clamp.ts`:
#   true-is-stricter), so a tenant admin can switch throttling ON for itself but can never switch off a protection
#   the platform has enabled. `RATE_LIMIT_ENABLED` remains the module-bootstrap baseline read by
#   `RateLimitConfigService` (`!== "false"`), which only decides whether the throttler is WIRED at boot.
#   tier: global-kv · read by: apps/api
RATE_LIMIT_ENABLED=true

# Default tier request limit
#   Requests per window for the always-on `default` throttler tier, resolved PER TENANT on the hot path by
#   `TieredThrottlerGuard`. A tenant may only LOWER it, and never above its plan entitlement (the entitlement
#   ceiling). `RATE_LIMIT_MAX_REQUESTS` remains the module-bootstrap baseline.
#   tier: global-kv · read by: apps/api
RATE_LIMIT_MAX_REQUESTS=100

# Default tier window (ms)
#   Window length for the always-on `default` throttler tier, resolved per tenant with `rateLimit.maxRequests`. A
#   LONGER window over the same limit is a TIGHTER budget, so this is the one knob where a tenant may only raise the
#   number (`tenant-clamp.ts`: higher-is-stricter) — otherwise a tenant could set a 1 ms window and make its limit
#   meaningless. `RATE_LIMIT_WINDOW_MS` remains the module-bootstrap baseline.
#   tier: global-kv · read by: apps/api
RATE_LIMIT_WINDOW_MS=60000

# Metering reconcile seed default
#   SEED-TIME ONLY, and not itself a runtime gate: `seed/15-entitlements.ts` reads it to decide the value of the
#   `metering.reconcile.enabled` GlobalSetting row on a FRESH database. POLICY (TASK-638): reconcile is ON in every
#   DEPLOYED environment (hope-v2-dev, staging, production) — each sets METERING_RECONCILE_ENABLED_DEFAULT=true in
#   its host env / deploy overlay — and OFF only in LOCAL development (this committed default) and test/CI (never
#   set). Keep this LOCAL default false so a developer laptop never runs the sweep; flip live via the admin control
#   plane. The live control plane is `metering.reconcile.enabled` (already cataloged above, tier `global-kv`,
#   kill-switch). Mirrors `entitlements.enabledDefault` exactly; its migration is DELETION, once seeding takes its
#   default from the descriptor instead of the environment.
#   tier: env · read by: apps/api
METERING_RECONCILE_ENABLED_DEFAULT=false

# ── Authentication ──────────────────────────────────────────────────────

# API key maximum lifetime (days)
#   Ceiling on a requested API-key expiry, resolved for the KEY'S TENANT at issue time. UNSET MEANS UNLIMITED —
#   `apikey.service.ts` skips the clamp when no value resolves. A tenant may SHORTEN its own ceiling (or set one
#   where the platform has none) but never lengthen it past the platform value (`tenant-clamp.ts`:
#   lower-is-stricter). `API_KEY_MAX_LIFETIME_DAYS` remains the bootstrap fallback.
#   tier: global-kv · read by: apps/api
API_KEY_MAX_LIFETIME_DAYS=

# Allow API key in query parameter
#   When true, an API key may be presented as a query parameter. PLATFORM-ONLY by construction: the only reader is
#   the ANONYMOUS credential-extraction step, which runs before the caller — and therefore the tenant — is known, so
#   there is no tenant scope to resolve it at. Query strings land in access logs and referrers: keep OFF unless a
#   specific integration forces it. `API_KEY_ALLOW_QUERY_PARAM` remains the bootstrap fallback.
#   tier: global-kv · read by: apps/api
API_KEY_ALLOW_QUERY_PARAM=false

# Refresh token TTL (seconds)
#   Refresh-token lifetime, resolved for the ISSUING tenant on every `issue()` — previously read once in the
#   `RefreshTokenService` constructor, so a change needed a restart. A tenant may only SHORTEN it
#   (`tenant-clamp.ts`: lower-is-stricter). A non-finite or non-positive resolved value falls back to the 7-day
#   default. `REFRESH_TOKEN_TTL_SECONDS` remains the bootstrap fallback.
#   tier: global-kv · read by: apps/api
REFRESH_TOKEN_TTL_SECONDS=604800

# JWT signing secret (REQUIRED — boot fails without it)
#   HS256 signing secret for gateway-issued access tokens. Warmed at boot; `apps/api/src/main.ts` refuses to start
#   when it is still a placeholder. Rotating it invalidates every outstanding access token immediately (they are
#   short-lived, so the blast radius is one token TTL).
#   tier: vault-kv · read by: apps/api
JWT_SECRET_KEY=CHANGE_ME

# Session signing secret (REQUIRED — boot fails without it)
#   Signing/encryption secret for server-side session material. Rotating it invalidates existing sessions; users
#   re-authenticate.
#   tier: vault-kv · read by: apps/api
SESSION_SECRET_KEY=CHANGE_ME

# API key pepper (REQUIRED — boot fails without it)
#   Server-side pepper mixed into every API-key hash. CHANGING IT INVALIDATES EVERY ISSUED API KEY AT THE INSTANT IT
#   CHANGES — a stored hash computed under pepper vN can never be verified under vN+1. ROTATION IS THEREFORE STAGED,
#   NEVER SWAPPED, and is keyVersion-aware in exactly the way `GlobalSetting` already models secret material
#   (`encryptedValue` + `keyVersion`): (1) write the NEW pepper as a new Vault kv-v2 version — kv-v2 keeps prior
#   versions, so vN stays readable; (2) verification reads the keyVersion recorded on the ApiKey row and verifies
#   under THAT pepper, so vN and vN+1 keys are both valid during the overlap; (3) newly issued and re-hashed keys
#   are stamped with the new keyVersion; (4) once no row still references vN — or the announced overlap window
#   closes — retire vN. Skipping the overlap is an outage for every integration at once. Vault kv-v2 versioning is
#   the mechanism; the keyVersion column is what makes it staged rather than a coin flip. STATUS (lane J): step
#   (2)’s READ PATH now exists — `SecretFetchOptions.version` addresses a specific kv-v2 version through
#   `SecretsService.getSecret(key, { version })`, cached per (key, version) and evicted together by
#   `invalidate(key)`. What is still MISSING is the per-row half: `ApiKey` has no pepper-version column, so nothing
#   records which pepper produced a stored hash, and `ApiKeyService.verify` has nothing to pass. Until that column,
#   its migration, its domain trio and the issue/verify stamping land, a pepper change remains a cliff — the read
#   path alone does not make the rotation staged.
#   tier: vault-kv · read by: apps/api
API_KEY_PEPPER=CHANGE_ME

# OIDC client secret (REQUIRED — boot fails without it)
#   Client secret for the platform OIDC relying-party registration. Absent ⇒ OIDC authentication is disabled (a
#   logged WARN, not a crash) — see `auth.service.module.ts`.
#   tier: vault-kv · read by: apps/api
OIDC_CLIENT_SECRET=CHANGE_ME

# Storage access-key pepper (REQUIRED — boot fails without it)
#   HMAC pepper for hashing tenant STORAGE access-key secrets (`StorageAccessKeyService.hashSecretForStorage`).
#   Falls back to the shared `API_KEY_PEPPER` when unset, then to un-peppered SHA-256 — so it inherits
#   `API_KEY_PEPPER`’s rotation cliff: changing it invalidates every stored storage access key. Stage a rotation the
#   same way (see `api.keyPepper`).
#   tier: vault-kv · read by: apps/api
STORAGE_ACCESS_KEY_PEPPER=CHANGE_ME

# Webhook signing-secret encryption key (REQUIRED — boot fails without it)
#   Key-derivation material for the REVERSIBLE AES-256-GCM encryption `WebhookService` applies to every
#   server-generated webhook signing secret before storage (`WebhookService.encryptSecretForStorage`). NOT an HMAC
#   pepper like `api.keyPepper` — webhook signing requires the platform to recover the RAW secret at delivery time
#   (to compute an HMAC the receiver, who only ever saw the raw secret once, can independently verify), so the
#   stored form must be decryptable, not a one-way hash. See `WebhookService`'s class doc for the full rationale.
#   DELIBERATELY A SEPARATE VAULT SECRET FROM `API_KEY_PEPPER` — reusing the API-key pepper would couple two
#   independent rotation lifecycles: rotating one to respond to an API-key compromise would silently invalidate
#   every webhook signature (and vice versa), and a caller with no legitimate reason to hold both credentials would
#   need only one to attack both surfaces. Unset ⇒ falls back to a fixed local key-derivation string (no
#   cross-credential fallback chain), matching `ApiKeyService`’s own legacy/no-SecretsService fallback — NOT a
#   security posture to rely on in a Vault-backed deployment. Rotation is a bigger event than `api.keyPepper`'s
#   stage-and-overlap pattern: changing this key makes every EXISTING stored ciphertext undecryptable (there is no
#   keyVersion column here either), so a rotation must re-encrypt every `Webhook.hashedSecret` row under the new key
#   in the same operation — a re-encryption migration, not a Vault kv-v2 version bump alone.
#   tier: vault-kv · read by: apps/api
WEBHOOK_SECRET_PEPPER=CHANGE_ME

# ── Feature Flags ───────────────────────────────────────────────────────

# Self-service registration
#   Gates the public self-signup routes: `RegisterController` returns 404 (not 403) when off, so the endpoint's
#   existence is not disclosed. Read via `ConfigService.getConfigValue`, which parses it as `=== "true"` — anything
#   else is off. The admin-console proxy allowlist mirrors this gate.
#   tier: env · read by: apps/api
REGISTRATION_SELF_SIGNUP_ENABLED=false

# Workflow exposure plane (public invoke)
#   R-1 kill-switch for the whole `/api/v1/workflows/:slug/…` public-invoke surface (TASK-722). Design.md's
#   precondition: TASK-708's API-key scope enforcement must be verified end-to-end before this ships enabled;
#   Temporal is also not yet production-ready (R-2). Read via
#   `ConfigService.getConfigValue('WORKFLOW_EXPOSURE_ENABLED')`, `=== "true"` — a 404 (existence not disclosed)
#   while off, same posture as `registration.selfSignupEnabled`.
#   tier: env · read by: apps/api
WORKFLOW_EXPOSURE_ENABLED=false

# Workflow exposure — cloud LLM providers
#   Decision #6 (R-8): may a workflow invoked through the PUBLIC exposure plane route to a cloud LLM provider
#   (azure/bedrock/openai/anthropic/vertex — `isCloudByoProvider('llm', …)`)? OFF by default — public exposure
#   inherits the strictest egress posture; a tenant opts in explicitly, never by default. Platform-wide today, not
#   yet per-tenant: no node type in the code-owned registry selects a provider yet (`WORKFLOW_NODE_REGISTRY` ships
#   only `noop`/`passthrough`), so there is nothing to differentiate BY tenant until TASK-720/731 add one — see the
#   TASK-722 ticket README §7 for the reasoning.
#   tier: env · read by: apps/api
WORKFLOW_EXPOSURE_ALLOW_CLOUD_PROVIDERS=false

# Entitlements enforcement seed default
#   SEED-TIME ONLY, and the only key in this file that is not a runtime gate: `seed/15-entitlements.ts` reads it to
#   decide the value of the `entitlements.enabled` GlobalSetting row on a FRESH database. POLICY (TASK-638): quota
#   enforcement is ON in every DEPLOYED environment (hope-v2-dev, staging, production) — each sets
#   ENTITLEMENTS_ENABLED_DEFAULT=true in its host env / deploy overlay — and OFF only in LOCAL development (this
#   committed default) and test/CI (never set), so a developer never fights quota locally and the shared E2E
#   baseline stays deterministic. Keep this LOCAL default false; an operator flips it live via `PUT
#   /admin/entitlements/enabled`. The live control plane is `entitlements.enabled` (already cataloged, tier
#   `global-kv`, kill-switch). Its migration is therefore NOT to redis-flag but DELETION, once seeding takes its
#   default from the descriptor instead of the environment.
#   tier: env · read by: apps/api
ENTITLEMENTS_ENABLED_DEFAULT=false

# Harness warm start
#   Env FALLBACK for harness warm-start; `HarnessInternalService` treats the DB/policy value as the authority and
#   consults this only when that is absent. Being a fallback for a policy value is itself an argument for moving it
#   out of env.
#   tier: env · read by: apps/harness
HARNESS_WARM_START_ENABLED=false

# Live-doc groundedness gate
#   Gates the output-side groundedness check on the live-documentation path. Read once in the
#   `LiveDocumentationService` constructor as `=== "true"`, so a change needs a restart — the clearest
#   instant-fan-out candidate in this file.
#   tier: env · read by: apps/api
LIVE_DOC_GROUNDEDNESS_ENABLED=false

# Guardrail groundedness gate
#   Gates the guardrail NLI groundedness gate (`GUARDRAIL_V2_GROUNDEDNESS_` prefix). OFF is the dev/hermetic-CI
#   bypass: the gate answers honestly with `unverified` and never loads a model. Fail posture is FAIL-CLOSED
#   throughout — a disabled gate, an un-staged model and a scoring error all degrade to `unverified`, and no path
#   yields `grounded` without the model actually entailing the segment. Turning it ON requires the self-hosted
#   MiniCheck-class model staged on the host (no cloud PHI).
#   tier: env · read by: apps/guardrail
GUARDRAIL_V2_GROUNDEDNESS_ENABLED=false

# SMR input moderation
#   Gates input moderation on SMR `/generate` (`TEXT_EXTERNAL_GUARDRAIL_` prefix). OFF is the dev/CI bypass so local
#   runs need no guardrail service. When ON the posture is fail-CLOSED by construction: a transient error is
#   absorbed by a bounded retry, a sustained outage rejects, and an errored guardrail NEVER allows — there is
#   deliberately no `fail_open` option.
#   tier: env · read by: apps/text
TEXT_EXTERNAL_GUARDRAIL_ENABLED=false

# Harness NER priors reuse
#   Gates reuse of already-persisted CODED NER priors inside harness activities. A workflow-policy value may
#   override it per run; this is the fallback when the policy says nothing.
#   tier: env · read by: apps/harness
HARNESS_NER_PRIORS_ENABLED=false

# Harness atomic-fact sensors
#   Gates the `run_inferential_sensors` atomic-fact path. Same policy-overrides-env shape as the NER-priors flag.
#   tier: env · read by: apps/harness
HARNESS_ATOMIC_FACT_ENABLED=false

# STT semantic endpointing
#   Gates content-driven semantic end-of-utterance detection on the STT streaming hot path. NOTE the naming
#   exception: the STT `Settings` class carries NO `env_prefix`, so this is the BARE `SEMANTIC_ENDPOINT_ENABLED`,
#   not `STT_SEMANTIC_ENDPOINT_ENABLED` — one of the plan §3.3 rule-1 violations (prefix must equal the service
#   prefix) that a later rename has to fix. Default OFF until measured against the accuracy/latency scorecard.
#   tier: env · read by: apps/api
SEMANTIC_ENDPOINT_ENABLED=false

# Harness claim-check offload
#   Moves large clinical blobs OUT of Temporal workflow history into a self-hosted content-addressed store,
#   protecting the ~50 MB history budget. DEFAULTS **ON**, and is therefore NOT marked `killSwitch` — it is a
#   PROTECTION, so turning it off REMOVES a safeguard (unbounded history growth) rather than disabling an
#   enforcement path. Marking it a kill-switch would violate the defaults-OFF invariant and fail registry assembly.
#   Same polarity as `rate-limit.enabled`. Turning it off is a deliberate acceptance of unbounded Temporal history,
#   exactly as the harness startup validator states.
#   tier: env · read by: apps/harness
HARNESS_CLAIM_CHECK_ENABLED=true

# ── Topology ────────────────────────────────────────────────────────────

# Gateway base URL
#   Public base URL the gateway advertises for itself.
#   tier: env · read by: apps/api
URL=http://localhost

# STT service URL
#   Speech-to-text service base URL (apps/stt, port 8861).
#   tier: env · read by: apps/api
STT_URL=http://localhost:8861

# Text service URL
#   Summarization service base URL (apps/text, port 8862).
#   tier: env · read by: apps/api
TEXT_URL=http://localhost:8862

# Text port
#   Port apps/text binds; the gateway keeps it only to build health-probe URLs.
#   tier: env · read by: apps/text
TEXT_PORT=8862

# Guardrail service URL
#   Safety-engine base URL (apps/guardrail, port 8863).
#   tier: env · read by: apps/api
GUARDRAIL_URL=http://localhost:8863

# NLP service URL
#   Medical-NLP base URL (apps/nlp, port 8864).
#   tier: env · read by: apps/api
NLP_URL=http://localhost:8864

# NLP port
#   Port apps/nlp binds.
#   tier: env · read by: apps/nlp
NLP_PORT=8864

# TTS service URL
#   Text-to-speech base URL (apps/tts, port 8865).
#   tier: env · read by: apps/api
TTS_URL=http://localhost:8865

# TTS port
#   Port apps/tts binds.
#   tier: env · read by: apps/tts
TTS_PORT=8865

# Harness service URL
#   Clinical Documentation Harness base URL (apps/harness, port 8866).
#   tier: env · read by: apps/api
HARNESS_URL=http://localhost:8866

# Admin console URL
#   Origin of the Next.js admin console; used by the gateway e2e harness and CORS guidance.
#   tier: env · read by: apps/api
ADMIN_CONSOLE_URL=http://localhost:5176

# Password-reset link base URL
#   Base URL embedded in password-reset emails (`IPasswordResetMailer.DEFAULT_PASSWORD_RESET_BASE_URL`).
#   tier: env · read by: apps/api
PASSWORD_RESET_BASE_URL=http://localhost:5176

# Prometheus base URL
#   Prometheus query endpoint for the platform-metrics service (`prometheus-query.service.ts`).
#   tier: env · read by: apps/api
PROMETHEUS_URL=http://localhost:9090

# ── Ports ───────────────────────────────────────────────────────────────

# API gateway port (supervisor)
#   Port the dev/test supervisor expects the gateway on; the gateway itself binds `PORT`.
#   tier: env · read by: apps/api
API_PORT=8868

# STT port
#   Port apps/stt binds (test: 8961).
#   tier: env · read by: apps/stt
STT_PORT=8861

# Guardrail port
#   Port apps/guardrail binds (test: 8963).
#   tier: env · read by: apps/guardrail
GUARDRAIL_PORT=8863

# Harness port
#   Port apps/harness binds (test: 8966).
#   tier: env · read by: apps/harness
HARNESS_PORT=8866

# Node inspector host:port
#   Inspector endpoint for `nest start --debug`, so a test gateway can be debugged alongside a dev one (test:
#   127.0.0.1:9329).
#   tier: env · read by: apps/api
API_INSPECT_HOSTPORT=127.0.0.1:9229

# ── Process ─────────────────────────────────────────────────────────────

# Service name
#   Logical service name stamped on logs and metrics.
#   tier: env · read by: apps/api
SERVICE_NAME=hope-api

# Debug mode
#   Enables verbose config/service debug logging.
#   tier: env · read by: apps/api
DEBUG=false

# Nest debug mode
#   Enables NestJS-internal debug logging.
#   tier: env · read by: apps/api
NEST_DEBUG=false

# Explicit env-file path
#   Overrides the NODE_ENV→file map used by `loadEnv()`. Unset in every normal deployment.
#   tier: env · read by: apps/api
ENV_FILE_PATH=

# Enable Prisma Studio module
#   Development-only: mounts the Prisma Studio module (`app.module.ts`).
#   tier: env · read by: apps/api
ENABLE_PRISMA_STUDIO=false

# AppSettings boot-invariant mode
#   Set to `skip` (development only) to bypass the AppSettings boot invariant (`appSettings.service.ts`).
#   tier: env · read by: apps/api
APP_SETTINGS_BOOT_INVARIANT=

# ── Logging ─────────────────────────────────────────────────────────────

# File logging enabled
#   Writes rotating log files in addition to stdout.
#   tier: env · read by: apps/api
LOG_FILE_ENABLED=false

# Log directory
#   Directory rotating log files are written to.
#   tier: env · read by: apps/api
LOG_FILE_PATH=./logs

# Log rotation size
#   Rotate after this much data (winston-daily-rotate-file syntax).
#   tier: env · read by: apps/api
LOG_FILE_MAX_SIZE=10m

# Log files retained
#   Number of rotated log files kept.
#   tier: env · read by: apps/api
LOG_FILE_MAX_FILES=1000

# Log rotation date pattern
#   Date pattern in rotated log file names.
#   tier: env · read by: apps/api
LOG_FILE_DATE_PATTERN=yyyy-MM-dd

# Separate error log
#   Writes errors to their own file in addition to the combined log.
#   tier: env · read by: apps/api
LOG_FILE_SEPARATE_ERROR=false

# Extra PHI fields to redact
#   Comma-separated field names redacted from every log entry, on top of the built-in PHI key list. Matching is
#   case-insensitive and ignores _ and -.
#   tier: env · read by: apps/api
LOG_REDACT_FIELDS=

# Loki transport enabled
#   Pushes logs to Loki in addition to stdout. Requires `LOKI_HOST`.
#   tier: env · read by: apps/api
LOKI_ENABLED=false

# Loki base URL
#   Loki base URL; the transport appends `/loki/api/v1/push`. Unset disables the transport.
#   tier: env · read by: apps/api
LOKI_HOST=

# Loki extra labels
#   Comma-separated `key=value` pairs merged into every stream label set. Keep LOW-cardinality — never a tenant,
#   user, or request id.
#   tier: env · read by: apps/api
LOKI_LABELS=

# ── Observability ───────────────────────────────────────────────────────

# Disable the OTel SDK
#   Skips OpenTelemetry SDK start-up entirely.
#   tier: env · read by: apps/api
OTEL_SDK_DISABLED=false

# OTel diagnostic logging
#   Enables the OpenTelemetry diagnostic logger.
#   tier: env · read by: apps/api
OTEL_DEBUG=false

# OTLP endpoint
#   gRPC OTLP collector endpoint. Unset disables the exporters.
#   tier: env · read by: apps/api
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTel service name
#   Value of the `service.name` resource attribute.
#   tier: env · read by: apps/api
OTEL_SERVICE_NAME=api-gateway

# OTel service version
#   Value of the `service.version` resource attribute.
#   tier: env · read by: apps/api
OTEL_SERVICE_VERSION=1.0.0

# OTel metrics enabled
#   Turns on the OpenTelemetry metrics pipeline.
#   tier: env · read by: apps/api
OTEL_METRICS_ENABLED=false

# OTel traces enabled
#   Turns on the OpenTelemetry tracing pipeline.
#   tier: env · read by: apps/api
OTEL_TRACES_ENABLED=false

# Metrics name prefix
#   Prefix for Prometheus metric names; defaults to the sanitized service name.
#   tier: env · read by: apps/api
METRICS_PREFIX=

# Metrics collection interval (ms)
#   Interval of the simplified monitoring collector.
#   tier: env · read by: apps/api
METRICS_COLLECT_INTERVAL=15000

# GenAI content-capture switch
#   Pins the OTel GenAI instrumentation-library content-capture switch off, so prompt/completion text (PHI) is never
#   stamped onto spans. Boot-time audit refuses to start in production unless this is exactly NO_CONTENT.
#   tier: env · read by: apps/api
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# ── Secrets ─────────────────────────────────────────────────────────────

# Vault namespace
#   Vault Enterprise namespace. Unset on OSS Vault.
#   tier: env · read by: apps/api
VAULT_NAMESPACE=

# Vault Transit mount
#   Mount path of the Transit engine used for envelope encryption.
#   tier: env · read by: apps/api
VAULT_TRANSIT_MOUNT=transit

# Transit key (GlobalSetting)
#   Transit key that wraps `GlobalSetting.encryptedValue`.
#   tier: env · read by: apps/api
VAULT_TRANSIT_KEY=hope-globalsetting

# Transit key (PHI)
#   Transit key that wraps PHI columns.
#   tier: env · read by: apps/api
VAULT_TRANSIT_KEY_PHI=hope-phi

# Vault request timeout (ms)
#   Per-request timeout of the Vault HTTP client.
#   tier: env · read by: apps/api
VAULT_REQUEST_TIMEOUT_MS=5000

# Vault audit-log path
#   File the rotation worker tails for Vault audit events. Unset disables the worker.
#   tier: env · read by: apps/api
VAULT_AUDIT_LOG_PATH=./temp/vault.log

# Vault token
#   Direct Vault token. Operator/CLI path only — services authenticate with AppRole.
#   tier: env · read by: apps/api
VAULT_TOKEN=

# Vault dev root token
#   Root token of the LOCAL dev Vault; used by seeds. Never set in a deployed environment.
#   tier: env · read by: apps/api
VAULT_DEV_ROOT_TOKEN=root

# Secret cache TTL (s)
#   Per-entry TTL of the SecretsService LRU cache.
#   tier: env · read by: apps/api
SECRETS_TTL_SEC=300

# Secret cache size
#   Maximum entries in the SecretsService LRU cache.
#   tier: env · read by: apps/api
SECRETS_LRU_MAX=200

# Secret warmup re-warm interval (s)
#   How often the SecretsService re-warms its boot warmup set so the cache-only getSecretSync path (SMR/TTS
#   X-Service-Token) never expires cold. Unset/<=0 derives max(30, TTL/2).
#   tier: env · read by: apps/api
SECRETS_REWARM_INTERVAL_SEC=0

# ── Database ────────────────────────────────────────────────────────────

# Vault dynamic DB credentials
#   Opt in to Vault-issued, short-lived PostgreSQL credentials (plan §4 B6).
#   tier: env · read by: apps/api
PG_DYNAMIC_CREDS=false

# Vault database role
#   Vault database-engine role that mints the dynamic credentials.
#   tier: env · read by: apps/api
PG_VAULT_ROLE=hope-app-role

# Dynamic credential max TTL (s)
#   Upper bound applied to a Vault-issued credential lease.
#   tier: env · read by: apps/api
PG_VAULT_MAX_TTL_SEC=

# PostgreSQL host
#   Host used when assembling a dynamic-credential connection (`vault-client.ts`).
#   tier: env · read by: apps/api
PG_HOST=localhost

# PostgreSQL port
#   Port used when assembling a dynamic-credential connection.
#   tier: env · read by: apps/api
PG_PORT=5432

# PostgreSQL database
#   Database used when assembling a dynamic-credential connection.
#   tier: env · read by: apps/api
PG_DATABASE=hope_main

# ── Storage ─────────────────────────────────────────────────────────────

# MinIO/S3 TLS
#   Whether the object-storage endpoint is reached over TLS.
#   tier: env · read by: apps/api
MINIO_USE_SSL=false

# MinIO/S3 region
#   Region passed to the S3-compatible client.
#   tier: env · read by: apps/api
MINIO_REGION=us-east-1

# MINIO_ENDPOINT (bootstrap fallback)
#   Deploy-time fallback used ONLY before the SYSTEM storage row exists (first boot / pre-seed). Scheduled for
#   removal one release after the SYSTEM row ships; a WARN is logged whenever it is the tier that supplied the
#   value.
#   tier: env · read by: apps/api
MINIO_ENDPOINT=

# ── Messaging ───────────────────────────────────────────────────────────

# MQTT host
#   MQTT broker host.
#   tier: env · read by: apps/api
MQTT_HOST=localhost

# MQTT port
#   MQTT broker port.
#   tier: env · read by: apps/api
MQTT_PORT=1883

# MQTT user
#   MQTT broker username. The password is a `vault-kv` secret (`MQTT_PASS`).
#   tier: env · read by: apps/api
MQTT_USER=

# ── Streaming ───────────────────────────────────────────────────────────

# STT WS egress high-water mark (bytes)
#   Buffered-amount threshold above which partial transcripts are dropped.
#   tier: env · read by: apps/stt
STT_WS_EGRESS_HIGH_WATERMARK_BYTES=524288

# STT WS resume grace (ms)
#   Window a disconnected STT session is held open for reconnect.
#   tier: env · read by: apps/stt
STT_WS_RESUME_GRACE_MS=15000

# TTS WS egress high-water mark (bytes)
#   Buffered-amount threshold above which TTS audio frames are dropped.
#   tier: env · read by: apps/tts
TTS_WS_EGRESS_HIGH_WATERMARK_BYTES=524288

# ── Credentials ─────────────────────────────────────────────────────────

# Platform storage credentials (Vault kv-v2) (REQUIRED — boot fails without it)
#   Operator-set JSON `{ accessKeyId, secretAccessKey }` at the Vault path recorded in the SYSTEM row's
#   `credentialsRef` (default `platform/storage/minio`). Never stored in the database and never returned by any API.
#   tier: vault-kv · read by: apps/api
STORAGE_PLATFORM_DEFAULT_CREDENTIALS=CHANGE_ME

# ── AI Providers ────────────────────────────────────────────────────────

# SMR OpenAI base URL
#   OpenAI API base URL for SMR’s platform-fallback OpenAI client (`OpenAIConfig.base_url`). Override for an
#   OpenAI-compatible gateway; a tenant BYO connection may override it per request.
#   tier: env · read by: apps/api
TEXT_OPENAI_BASE_URL=https://api.openai.com/v1

# SMR OpenAI organization
#   Optional OpenAI organization id sent by SMR’s platform-fallback client (`OpenAIConfig.organization`). Unset ⇒
#   the account default organization.
#   tier: env · read by: apps/text
TEXT_OPENAI_ORGANIZATION=

# SMR OpenAI default model
#   Empty by design (TASK-579): provider/model SELECTION is fail-closed — `OpenAIConfig.default_model` has no
#   compiled-in vendor value, and an unresolved model raises (`require_model()`) rather than being substituted.
#   Informational only (providers listing).
#   tier: env · read by: apps/text
TEXT_OPENAI_DEFAULT_MODEL=

# SMR Anthropic base URL
#   Anthropic API base URL for SMR’s platform-fallback client (`AnthropicConfig.base_url`). Empty ⇒ the SDK default
#   (`https://api.anthropic.com`); a tenant BYO connection may override it per request.
#   tier: env · read by: apps/api
TEXT_ANTHROPIC_BASE_URL=

# SMR Anthropic default model
#   Empty by design (TASK-579): provider/model SELECTION is fail-closed — `AnthropicConfig.default_model` has no
#   compiled-in vendor value, and an unresolved model raises (`require_model()`) rather than being substituted.
#   Informational only (providers listing).
#   tier: env · read by: apps/text
TEXT_ANTHROPIC_DEFAULT_MODEL=

# SMR Vertex project
#   GCP project id for SMR’s platform-fallback Vertex client (`VertexConfig.project`). Empty ⇒ no platform fallback
#   (Vertex is then usable only via a tenant BYO service-account connection). A Vertex client is bound to a
#   `(project, location)`; a tenant override supplies its own.
#   tier: env · read by: apps/text
TEXT_VERTEX_PROJECT=

# SMR Vertex location
#   GCP location/region for SMR’s platform-fallback Vertex client (`VertexConfig.location`), e.g. `us-central1`.
#   tier: env · read by: apps/text
TEXT_VERTEX_LOCATION=us-central1

# SMR Vertex default model
#   Empty by design (TASK-579): provider/model SELECTION is fail-closed — `VertexConfig.default_model` has no
#   compiled-in vendor value, and an unresolved model raises (`require_model()`) rather than being substituted.
#   Informational only (providers listing).
#   tier: env · read by: apps/text
TEXT_VERTEX_DEFAULT_MODEL=

# Azure AI Foundry key (REQUIRED — boot fails without it)
#   Azure AI Foundry credential used by the STT Foundry model loader.
#   tier: vault-kv · read by: apps/api
AZURE_FOUNDRY_API_KEY=CHANGE_ME

# Guardrail vLLM key (REQUIRED — boot fails without it)
#   Bearer credential for guardrail's vLLM OpenAI-compatible endpoint (`GUARDRAIL_VLLM_` prefix). Self-hosted
#   endpoints commonly accept a placeholder, but it is still a credential and is classified as one.
#   tier: vault-kv · read by: apps/guardrail
GUARDRAIL_VLLM_API_KEY=CHANGE_ME

# Harness judge endpoint key (REQUIRED — boot fails without it)
#   Bearer credential for the harness LLM-as-judge OpenAI-compatible endpoint (`HARNESS_JUDGE_OPENAI_COMPAT_`
#   prefix). Connection config only — WHICH judge model runs is `models.harness.judge`, a fail-closed db-config
#   selection.
#   tier: vault-kv · read by: apps/harness
HARNESS_JUDGE_OPENAI_COMPAT_API_KEY=CHANGE_ME

# ── Service Tokens ──────────────────────────────────────────────────────

# Internal access token (REQUIRED — boot fails without it)
#   THE canonical internal service-to-service credential (owner decision D-D, 2026-08-17): **one** shared access
#   token, identical across every service, set by the DevOps engineer, internal use only. It is presented and
#   accepted as `X-Service-Token` on every internal hop — gateway↔text/nlp/guardrail/harness/tts and every
#   peer-to-peer hop (harness→text/nlp/guardrail, text→guardrail, nlp→text). There is deliberately NO per-service
#   and NO per-pair token in the target state: the `*_SERVICE_TOKEN` family below (`TEXT_`, `NLP_`, `GUARDRAIL_`,
#   `HARNESS_`, `TTS_`, and harness’s outbound `HARNESS_TEXT_`/`HARNESS_NLP_`) is retained ONLY as a zero-cost
#   backward-compatibility fallback — every inbound middleware accepts EITHER this token or its own legacy secret,
#   and every outbound client PREFERS this token and falls back to its legacy per-target secret when unset. Set this
#   one variable and the legacy family can all be dropped. This is the sanctioned env-var exception to D-B
#   (configuration lives in the DB) — it is bootstrap-floor auth material, delivered from Vault in deployed
#   environments. NOT the same thing as `HARNESS_INTERNAL_SERVICE_TOKEN`, which gates the harness knowledge-ingest
#   endpoint only, nor `API_GATEWAY_KEY`, which must be a real ApiKey row (see below).
#   tier: vault-kv · read by: apps/api
INTERNAL_ACCESS_TOKEN=CHANGE_ME

# Text service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔SMR hop. SMR reads it as `settings.service_token` under its `TEXT_` pydantic
#   prefix; the gateway resolves the same name for outbound proxying and for `InternalServiceTokenGuard`'s inbound
#   check.
#   tier: vault-kv · read by: apps/api
TEXT_SERVICE_TOKEN=CHANGE_ME

# NLP service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔NLP hop (`X-Service-Token`).
#   tier: vault-kv · read by: apps/api
NLP_SERVICE_TOKEN=CHANGE_ME

# Guardrail service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔guardrail hop (`X-Service-Token`).
#   tier: vault-kv · read by: apps/api
GUARDRAIL_SERVICE_TOKEN=CHANGE_ME

# Harness service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔harness hop. Fetched on demand (not a warmup key) by `HarnessOpsClient` /
#   `HarnessGatewayService` / `HarnessServiceTokenGuard`. It MUST equal the harness process’s own
#   `HARNESS_SERVICE_TOKEN`, or every `/api/v1/internal/harness/*` call 401s.
#   tier: vault-kv · read by: apps/api
HARNESS_SERVICE_TOKEN=CHANGE_ME

# TTS service token (REQUIRED — boot fails without it)
#   Shared secret on the gateway↔TTS hop (`X-Service-Token`).
#   tier: vault-kv · read by: apps/api
TTS_SERVICE_TOKEN=CHANGE_ME

# Harness knowledge-ingest token (REQUIRED — boot fails without it)
#   SECOND, SEPARATE harness credential — NOT an alias of `HARNESS_SERVICE_TOKEN`. It gates the knowledge-ingest
#   endpoint only (`apps/harness/.../api/endpoints/knowledge.py`, pydantic field `internal_service_token` under the
#   `HARNESS_` prefix) and is resolved by `KnowledgeIngestClient` for the outbound `X-Service-Token`. Added by lane
#   J: it was read through SecretsService but had no descriptor, so `vault-seed-secrets.sh` never seeded it and
#   every ingest call would 401 on a Vault-backed deployment.
#   tier: vault-kv · read by: apps/api
HARNESS_INTERNAL_SERVICE_TOKEN=CHANGE_ME

# STT gateway key (REQUIRED — boot fails without it)
#   The credential STT presents to the gateway. STT is the one service that authenticates with
#   `X-Internal-Service-Key` rather than `X-Service-Token`, reusing this key instead of minting a second STT
#   credential (`InternalServiceTokenGuard.SERVICE_SECRETS.stt`). There is no `STT_SERVICE_TOKEN`. NOT a free-form
#   shared secret like the `*_SERVICE_TOKEN` values: `X-Internal-Service-Key` is also read by the GLOBAL
#   `UnifiedAuthGuard` (`ApiKeyService.extractApiKeyFromRequest`), so this MUST be the RAW value of a registered
#   ACTIVE SERVICE_ACCOUNT ApiKey row — a random secret with no matching row 401s every `/internal/stt/*` callback
#   (BUG-013). Dev uses the seeded fixture; provision one with `pnpm gen:api-key`.
#   tier: vault-kv · read by: apps/api
API_GATEWAY_KEY=CHANGE_ME

# ── Data Plane ──────────────────────────────────────────────────────────

# Redis password (REQUIRED — boot fails without it)
#   Redis AUTH password. Resolved through SecretsService and layered over the env value by
#   `ConfigService.applySecretOverrides`.
#   tier: vault-kv · read by: apps/api
REDIS_PASS=CHANGE_ME

# MQTT password (REQUIRED — boot fails without it)
#   MQTT broker password, consumed by `MqttService` via `ConfigService`.
#   tier: vault-kv · read by: apps/api
MQTT_PASS=CHANGE_ME

# MinIO access key (REQUIRED — boot fails without it)
#   MinIO/S3 access key for platform object storage. NOTE: the per-tenant / platform-default STORAGE CONFIG
#   (endpoint, region, path style, prefix) is a separate concern owned by `TenantStorageConfig`; only the credential
#   lives here, referenced by `credentialsRef`.
#   tier: vault-kv · read by: apps/api
MINIO_ACCESS_KEY=CHANGE_ME

# MinIO secret key (REQUIRED — boot fails without it)
#   MinIO/S3 secret key for platform object storage.
#   tier: vault-kv · read by: apps/api
MINIO_SECRET_KEY=CHANGE_ME

# S3 access key (REQUIRED — boot fails without it)
#   S3-protocol access key read by `S3Service`. In local dev this aliases the MinIO credential (HOPE speaks S3 to
#   MinIO); in a deployed environment it may name a distinct S3 principal.
#   tier: vault-kv · read by: apps/api
S3_ACCESS_KEY=CHANGE_ME

# S3 secret key (REQUIRED — boot fails without it)
#   S3-protocol secret key read by `S3Service`.
#   tier: vault-kv · read by: apps/api
S3_SECRET_KEY=CHANGE_ME

# Azure Blob connection string (REQUIRED — boot fails without it)
#   Full Azure Storage connection string (carries the account key) for the AZURE storage provider. Read by
#   `BlobStorageProviderFactory.buildAzureProvider` AFTER the SYSTEM row’s `credentialsRef`, i.e. it is the env/kv
#   fallback of the same two-step order as `S3_ACCESS_KEY`. Preferred over `AZURE_STORAGE_ACCOUNT_KEY`.
#   tier: vault-kv · read by: apps/api
AZURE_STORAGE_CONNECTION_STRING=CHANGE_ME

# Azure Blob shared account key (REQUIRED — boot fails without it)
#   Azure Storage shared account key — the alternative to `AZURE_STORAGE_CONNECTION_STRING` when the endpoint is
#   composed from `accountName` + `endpointSuffix` on the storage config row.
#   tier: vault-kv · read by: apps/api
AZURE_STORAGE_ACCOUNT_KEY=CHANGE_ME

# Claim-check store access key (REQUIRED — boot fails without it)
#   S3/MinIO access key for the harness claim-check blob store. The offloaded payloads are clinical content, so the
#   store is SELF-HOSTED by contract — this credential must never address a cloud bucket.
#   tier: vault-kv · read by: apps/harness
HARNESS_CLAIM_CHECK_ACCESS_KEY=CHANGE_ME

# Claim-check store secret key (REQUIRED — boot fails without it)
#   S3/MinIO secret key for the harness claim-check blob store (self-hosted only; PHI must not egress).
#   tier: vault-kv · read by: apps/harness
HARNESS_CLAIM_CHECK_SECRET_KEY=CHANGE_ME
