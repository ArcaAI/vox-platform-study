# Guardrail Service Environment Configuration

# Application Settings
GUARDRAIL_HOST=0.0.0.0
GUARDRAIL_PORT=8863
GUARDRAIL_DEBUG=false
GUARDRAIL_LOG_LEVEL=info
GUARDRAIL_CORS_ENABLED=false
GUARDRAIL_CORS_ORIGINS="[]"

# Inter-service Authentication (empty = auth disabled for local dev)
GUARDRAIL_SERVICE_TOKEN=""

# Connection Pooling
GUARDRAIL_HTTPX_MAX_CONNECTIONS=100
GUARDRAIL_HTTPX_MAX_KEEPALIVE=50

# Observability
GUARDRAIL_OTEL_ENABLED=false
GUARDRAIL_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
GUARDRAIL_OTEL_SERVICE_NAME=guardrail
GUARDRAIL_METRICS_ENABLED=true

# GLiNER ONNX Configuration (content safety, adversarial detection, PII)
# Model downloads from HuggingFace on first boot and is cached locally.
GUARDRAIL_GLINER_ENABLED=true
GUARDRAIL_GLINER_MODEL_ID=hivetrace/gliner-guard-uniencoder-onnx
GUARDRAIL_GLINER_PRECISION=fp32
GUARDRAIL_GLINER_PROVIDERS=["CPUExecutionProvider"]
GUARDRAIL_GLINER_CLASSIFICATION_THRESHOLD=0.4
GUARDRAIL_GLINER_PII_THRESHOLD=0.5
GUARDRAIL_GLINER_MAX_WORKERS=2

# ──────────────────────────────────────────────────────────────────────────────
# LLM Engine selector: lm-studio (default) | ollama | azure | bedrock
# ──────────────────────────────────────────────────────────────────────────────
GUARDRAIL_V2_PROVIDER=lm-studio

# OpenAI-compatible engine (LM Studio default).
# Drives the IBM Granite Guardian <guardian>/<score> protocol over /v1/chat/completions.
# Load the matching GGUF in LM Studio so its model id resolves to the values below
# (e.g. lmstudio-community/granite-guardian-4.1-8b-GGUF).
GUARDRAIL_OPENAI_COMPAT_ENABLED=true
GUARDRAIL_OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
GUARDRAIL_OPENAI_COMPAT_API_KEY=lm-studio

# Task models (all default to granite-guardian-4.1-8b)
GUARDRAIL_OPENAI_COMPAT_GUARDRAIL_MODEL=granite-guardian-4.1-8b
GUARDRAIL_OPENAI_COMPAT_CONTENT_SAFETY_MODEL=granite-guardian-4.1-8b
GUARDRAIL_OPENAI_COMPAT_PII_DETECTION_MODEL=granite-guardian-4.1-8b
GUARDRAIL_OPENAI_COMPAT_PROMPT_INJECTION_MODEL=granite-guardian-4.1-8b
GUARDRAIL_OPENAI_COMPAT_COMPREHENSIVE_MODEL=granite-guardian-4.1-8b

# Guardian model for medical context validation (JSON path)
GUARDRAIL_OPENAI_COMPAT_GUARDIAN_MODEL=granite-guardian-4.1-8b
GUARDRAIL_OPENAI_COMPAT_GUARDIAN_ENABLED=true
GUARDRAIL_OPENAI_COMPAT_GUARDIAN_TEMPERATURE=0.05
GUARDRAIL_OPENAI_COMPAT_GUARDIAN_MAX_TOKENS=300
GUARDRAIL_OPENAI_COMPAT_GUARDIAN_MIN_CONFIDENCE=0.75

# General settings
GUARDRAIL_OPENAI_COMPAT_TIMEOUT_S=60
GUARDRAIL_OPENAI_COMPAT_MAX_CONCURRENT=4
GUARDRAIL_OPENAI_COMPAT_QUEUE_BACKOFF_S=2.0
GUARDRAIL_OPENAI_COMPAT_TEMPERATURE=0.1
GUARDRAIL_OPENAI_COMPAT_MAX_TOKENS=500

# ──────────────────────────────────────────────────────────────────────────────
# Ollama engine (OPTIONAL — set GUARDRAIL_V2_PROVIDER=ollama to use).
# Serves generic chat models (e.g. gemma3) via generic SAFE/UNSAFE prompts.
# ──────────────────────────────────────────────────────────────────────────────
GUARDRAIL_OLLAMA_ENABLED=true
GUARDRAIL_OLLAMA_BASE_URL=http://localhost:11434

GUARDRAIL_OLLAMA_GUARDRAIL_MODEL=gemma3:latest
GUARDRAIL_OLLAMA_CONTENT_SAFETY_MODEL=gemma3:latest
GUARDRAIL_OLLAMA_PII_DETECTION_MODEL=gemma3:latest
GUARDRAIL_OLLAMA_PROMPT_INJECTION_MODEL=gemma3:latest
GUARDRAIL_OLLAMA_COMPREHENSIVE_MODEL=gemma3:latest

GUARDRAIL_OLLAMA_GUARDIAN_MODEL=gemma3:latest
GUARDRAIL_OLLAMA_GUARDIAN_ENABLED=true
GUARDRAIL_OLLAMA_GUARDIAN_TEMPERATURE=0.05
GUARDRAIL_OLLAMA_GUARDIAN_MAX_TOKENS=300
GUARDRAIL_OLLAMA_GUARDIAN_MIN_CONFIDENCE=0.75

GUARDRAIL_OLLAMA_TIMEOUT_S=60
GUARDRAIL_OLLAMA_MAX_CONCURRENT=4
GUARDRAIL_OLLAMA_QUEUE_BACKOFF_S=2.0
GUARDRAIL_OLLAMA_TEMPERATURE=0.1
GUARDRAIL_OLLAMA_MAX_TOKENS=500

# ──────────────────────────────────────────────────────────────────────────────
# Azure OpenAI / AWS Bedrock engines (OPTIONAL — REQUIRE a guardian-capable model).
# Neither hosts Granite Guardian, so they use the generic SAFE/UNSAFE prompt fallback.
# Point base_url/api_key at an OpenAI-compatible deployment/gateway and override models.
# ──────────────────────────────────────────────────────────────────────────────
# GUARDRAIL_AZURE_ENABLED=false
# GUARDRAIL_AZURE_BASE_URL=
# GUARDRAIL_AZURE_API_KEY=
# GUARDRAIL_BEDROCK_ENABLED=false
# GUARDRAIL_BEDROCK_BASE_URL=
# GUARDRAIL_BEDROCK_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Per-tenant engine config from DB (TASK-338, OPT-IN).
# When disabled (default) the engine/model are env-only (the GUARDRAIL_V2_PROVIDER
# + GUARDRAIL_*_* vars above). When enabled, the guardian provider/model are
# resolved per tenant at request time from core."GlobalSetting" via the
# X-Tenant-Id header, with a short TTL cache and env fallback.
# ──────────────────────────────────────────────────────────────────────────────
GUARDRAIL_DB_CONFIG_ENABLED=false
# Read-only connection to the shared HOPE core DB (postgres:// auto-normalized to asyncpg).
GUARDRAIL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hope
# Fallback tenant used when X-Tenant-Id is absent or the request tenant has no rows
# (the seeded GLOBAL tenant where default guardrail config lives).
GUARDRAIL_DEFAULT_TENANT_ID=50000000-0000-0000-0000-000000000000
# Resolved per-tenant config cache TTL (seconds).
GUARDRAIL_CONFIG_CACHE_TTL_S=60

# Redis Configuration
GUARDRAIL_REDIS_URL=redis://localhost:6379/0
GUARDRAIL_REDIS_TASK_TTL_SECONDS=3600
GUARDRAIL_REDIS_STREAM_MAX_LEN=10000
GUARDRAIL_REDIS_CACHE_TTL_SECONDS=1800

# Job Queue Configuration
GUARDRAIL_QUEUE_MAX_WAIT_S=60.0
GUARDRAIL_QUEUE_MAX_RETRIES=3
GUARDRAIL_QUEUE_RETRY_BACKOFF_S=1.0
GUARDRAIL_QUEUE_BATCH_SIZE=10
