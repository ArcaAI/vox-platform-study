# =============================================================================
# Guardrail Service — Production Environment Reference
# =============================================================================
# Reference template — fill in for your deployment. Not loaded by the app
# itself; production is configured by whichever mechanism your deployment
# uses (K8s ConfigMap/Secret, systemd EnvironmentFile=) to populate the host
# environment. Relocated from the monorepo-root `.env.production` (TASK-584).
#
# Provider/model SELECTION for guardrail is DB-resolved per tenant
# (`AiTaskDefault` ⋈ `AiModel`), fail-closed (503) if unresolved — see
# docs/architecture/environment-configuration-reference.md §3. The keys below
# are connection identity for the OPTIONAL production self-host engines
# (AD-4), not a provider default.
# =============================================================================

# Guardian engines — production self-host tiers.
# OpenAI-compatible `/v1`; select via GUARDRAIL_V2_PROVIDER=vllm|llama-cpp
# (dev-only escape hatch, consumed only when GUARDRAIL_DB_CONFIG_ENABLED=false).
GUARDRAIL_VLLM_ENABLED=false
GUARDRAIL_VLLM_BASE_URL=http://hope-vllm:8000/v1
GUARDRAIL_VLLM_GUARDIAN_MODEL=granite-guardian-4.1-8b
GUARDRAIL_LLAMA_CPP_ENABLED=false
GUARDRAIL_LLAMA_CPP_BASE_URL=http://hope-llama-cpp:8080/v1
GUARDRAIL_LLAMA_CPP_GUARDIAN_MODEL=granite-guardian-4.1-8b
