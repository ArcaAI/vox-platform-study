# =============================================================================
# Harness — Clinical Documentation Harness (TASK-330) — Environment Variables
# =============================================================================
# Copy this file to .env and adjust as needed. Application variables use the
# HARNESS_ prefix; the Temporal substrate uses the shared TEMPORAL_ prefix.

# -----------------------------------------------------------------------------
# Application (HARNESS_)
# -----------------------------------------------------------------------------

# Bind host (default: 0.0.0.0)
HARNESS_HOST=0.0.0.0

# Service port (default: 8866)
HARNESS_PORT=8866

# Enable debug mode (default: false)
HARNESS_DEBUG=false

# Deployment environment: development (default) | test | staging | prod | production.
# NOT a duplicate of HARNESS_DEBUG — that defaults false, so it cannot tell a real
# deploy from unconfigured local dev. Setting this to a deployed value activates the
# claim-check guard (TASK-533 D-28): HARNESS_CLAIM_CHECK_STORE=memory then refuses to
# boot, because the in-memory store is per-process and loses blobs on cross-worker retry.
HARNESS_ENVIRONMENT=development

# Log level: debug, info, warning, error (default: info)
HARNESS_LOG_LEVEL=info

# CORS allowed origins as JSON array, e.g. ["http://localhost:8868/api/v1"]
HARNESS_CORS_ORIGINS=[]

# Enable CORS middleware (default: false)
HARNESS_CORS_ENABLED=false

# Service token for inter-service auth. Empty = auth disabled (local dev)
HARNESS_SERVICE_TOKEN=

# Dedicated token for the Phase-3 institutional-knowledge ingest endpoint
# (POST /api/v1/internal/knowledge/ingest). The ingest guard accepts an
# X-Service-Token matching THIS secret OR the shared HARNESS_SERVICE_TOKEN;
# empty (with an empty shared token) disables the guard for local dev.
HARNESS_INTERNAL_SERVICE_TOKEN=

# HTTP client pool sizing (used by the loop's httpx tool clients)
HARNESS_HTTPX_MAX_CONNECTIONS=200
HARNESS_HTTPX_MAX_KEEPALIVE=100

# -----------------------------------------------------------------------------
# Durable loop / gate-adapter (TASK-330 Phase 1, Lane I)
# -----------------------------------------------------------------------------

# Tool-service base URLs the durable loop calls out to.
HARNESS_TEXT_BASE_URL=http://localhost:8862
HARNESS_NLP_BASE_URL=http://localhost:8864
HARNESS_API_BASE_URL=http://localhost:8868

# SMR generation provider/model. Empty/unset => the SMR service's own default;
# set e.g. provider=ollama + a local model id to force on-box generation in dev.
HARNESS_TEXT_PROVIDER=
HARNESS_TEXT_MODEL=

# apps/api internal-harness mount. Lane G's controller sits under the global
# `/api/v1` prefix, so the live default is `/api/v1/internal/harness`.
HARNESS_API_INTERNAL_PREFIX=/api/v1/internal/harness

# Bounded-regen budget + clinician-gate timing (durable, deterministic).
HARNESS_MAX_REGEN=2
HARNESS_GATE_SLA_SECONDS=86400
HARNESS_GATE_ESCALATION_SECONDS=43200

# -----------------------------------------------------------------------------
# Claim-check payload store (TASK-483) — protect the Temporal history budget
# -----------------------------------------------------------------------------
# Large clinical blobs (transcript / assembled prompt / generated note / RAG chunks) are
# moved OUT of the workflow history and replaced with a small content-addressed reference.
# SELF-HOSTED store only (MinIO, S3-compatible) — never a cloud bucket. ENABLED on with the
# byte threshold set (small payloads stay inline). STORE=memory is the process-local fake
# for single-worker dev/test; a MULTI-worker deploy MUST set STORE=s3 + endpoint/creds (a
# cross-worker retry against the in-memory fake fails LOUD). Creds are secrets — real values
# via host env, not this file.
HARNESS_CLAIM_CHECK_ENABLED=true
HARNESS_CLAIM_CHECK_STORE=memory
HARNESS_CLAIM_CHECK_MIN_BYTES=65536
HARNESS_CLAIM_CHECK_BUCKET=harness-claim-check
HARNESS_CLAIM_CHECK_ENDPOINT_URL=http://localhost:9000
HARNESS_CLAIM_CHECK_ACCESS_KEY=
HARNESS_CLAIM_CHECK_SECRET_KEY=
HARNESS_CLAIM_CHECK_REGION=us-east-1
HARNESS_CLAIM_CHECK_SECURE=false
HARNESS_CLAIM_CHECK_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# Eval LLM-as-judge (HARNESS_JUDGE_) — offline PDSQI-9 release-gate judge
# -----------------------------------------------------------------------------
# Model-agnostic judge. provider: openai_compat (LM Studio/vLLM, default) | azure | bedrock.
# Default is a small (<=20B) local model on LM Studio's OpenAI-compatible endpoint.
HARNESS_JUDGE_PROVIDER=openai_compat
# NOTE: this is the LM Studio model id put on the wire as `model` — it must be
# an id the endpoint actually serves. It read `google/gemma-4-e4b` until
# 2026-08-10, which LM Studio has never served (the instance serves the `-qat`
# build), so every offline judge run 404d.
HARNESS_JUDGE_MODEL=google/gemma-4-e4b-qat
HARNESS_JUDGE_OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
HARNESS_JUDGE_OPENAI_COMPAT_API_KEY=lm-studio
# Response-format control for the OpenAI-compatible endpoint. Some LM Studio builds
# reject response_format={"type":"json_object"} (400: must be 'json_schema' or 'text');
# set "text" so the judge OMITS the constraint and relies on the "Return ONLY JSON"
# prompt + tolerant parsing (harness.eval.jsonio). Default: json_object. Required as
# "text" for the citation_verify judge on those LM Studio builds.
HARNESS_JUDGE_OPENAI_COMPAT_JSON_RESPONSE_FORMAT=text
# Deterministic judge. max_tokens must be large: reasoning models emit many
# "thinking" tokens before the JSON, and too small a budget truncates mid-reasoning.
HARNESS_JUDGE_TEMPERATURE=0.0
HARNESS_JUDGE_MAX_TOKENS=8192
# reasoning_mode: auto (neutral, default) | think (elicit reasoning) | none (forbid).
HARNESS_JUDGE_REASONING_MODE=auto
# Optional OpenAI-compatible passthrough as a JSON string (e.g. vLLM/Azure knobs):
# HARNESS_JUDGE_EXTRA_BODY={"reasoning_effort":"low"}

# -----------------------------------------------------------------------------
# LLM provider concurrency governor + rate-limit retry (HARNESS_LLM_)
# -----------------------------------------------------------------------------
# Cross-cutting guard shared by EVERY harness LLM client (the runtime judge —
# groundedness/citation_verify — the safety guardian, the embeddings client, the
# reranker, and SMR generation). A bounded semaphore is kept PER provider endpoint
# (keyed by scheme://host:port, so a base_url with or without /v1 collapses to one
# limiter): all callers hitting the same box collectively respect one cap, so the
# inferential pass's asyncio.gather can fan out without bursting a small local
# server (LM Studio terminates/unloads the model engine under a burst -> 400
# 'terminated'/5xx -> DEGRADED citation_verify/safety). Retries are rate-limit-aware
# (exponential backoff + jitter, honors HTTP 429 Retry-After, retries 5xx /
# connection / 'terminated'); only after the bounded budget is spent does the
# caller's existing fail-safe degrade take over.

# Max in-flight requests PER provider endpoint. Applies independently to each
# endpoint (LM Studio, reranker, SMR), so distinct boxes still run in parallel.
# TASK-355 tuned this to 6: Phase A (R-2) first raised it 1 -> 2, then Phase B
# (R-4 + per-claim asyncio.gather) made the inferential pass issue REAL concurrent
# work — groundedness fans its claim batches out and Granite fires its 7 criteria
# at once — so 6 is the tuned optimum against LM Studio >=0.4.0 (Max Concurrent
# Predictions = 10 leaves headroom for the embeddings/STT clients on the same box).
# Lower to 1-2 only for a provider that cannot serve parallel slots.
HARNESS_LLM_MAX_CONCURRENCY=6
# Total attempts per call (1 initial + retries) before the caller degrades.
HARNESS_LLM_MAX_ATTEMPTS=5
# Exponential backoff base / ceiling (seconds) and added uniform jitter.
HARNESS_LLM_BACKOFF_BASE_S=0.5
HARNESS_LLM_BACKOFF_MAX_S=20.0
HARNESS_LLM_BACKOFF_JITTER_S=0.25
# Per-CALL wall-clock timeout in seconds (TASK-354 Defect A). Bounds EACH individual
# model call (judge / citation_verify / Granite Guardian) so one hung LM Studio request
# can't burn the whole 900s run_inferential_sensors budget before Temporal retries. A
# timed-out call is transient -> retried within HARNESS_LLM_MAX_ATTEMPTS, then the owning
# sensor self-degrades (reduced assurance, never a silent auto-PASS). <=0 disables it.
# This is the safety net that makes HARNESS_LLM_MAX_CONCURRENCY>1 safe (a hung call now
# ties up a real slot). Default 120 sits well under a healthy ~344s pass (per-call, not
# per-pass), so healthy runs are unaffected.
HARNESS_LLM_REQUEST_TIMEOUT_S=120.0

# -----------------------------------------------------------------------------
# TASK-355 Phase C/D feature flags (default OFF)
# -----------------------------------------------------------------------------
# HARNESS_WARM_START_ENABLED (Phase C, R-6 warm-start) is documented here for
# discoverability, but is NOT read by THIS Python service's Settings — setting it in this
# file has no effect. It is read by the apps/api layer (@arcaai/applications
# HarnessInternalService + PromptAssemblyService via NestJS ConfigService); set it in the
# apps/api environment (root .env.dev / host env), NOT here. Flag OFF restores exact
# pre-Phase-C behavior.
#
# HARNESS_OPTIMISTIC_DELIVERY_ENABLED (Phase D, R-7 optimistic delivery) IS read by this
# service's Settings and snapshotted into the Temporal workflow's HarnessGateConfig
# (temporal/models.py) at workflow start — document:start, then carried over the policy
# merge — so it stays deterministic across replay (never read from env inside the
# workflow). FIRST key of a two-key gate: the optimistic path ALSO requires the durable
# task-355-optimistic-delivery patch marker (permanent in code). Default OFF ⇒ the legacy
# single-phase path, byte-identical to pre-Phase-D history.
HARNESS_OPTIMISTIC_DELIVERY_ENABLED=false

# HARNESS_NER_PRIORS_ENABLED (TASK-480 Half-B, NER-priors reuse) IS read by THIS Python
# service's Settings. When ON, the transcript extract_entities activity reuses
# already-persisted CODED NamedEntity rows (TASK-476) as the NER priors instead of
# re-running the cold NLP pass — killing the redundant second transcript-NER pass. Read at
# runtime inside the (non-deterministic) activity, so it needs no snapshot/patch marker;
# when OFF (or when no persisted prior carries an ontology code) the activity falls back to
# the cold extraction, so it is inert until TASK-476 populates the codes. Default OFF ⇒
# enabling it is an explicit ops rollout, never a silent default flip.
HARNESS_NER_PRIORS_ENABLED=false

# HARNESS_ATOMIC_FACT_ENABLED (TASK-481 E2, reference-free atomic-fact verifier) IS read by
# THIS Python service's Settings. When ON, the run_inferential_sensors activity runs a
# DETERMINISTIC self-hosted-NLI atomic-fact groundedness verifier ALONGSIDE the LLM-judge
# groundedness sensor (defense-in-depth; a second, model-cheap gate — NEVER the LLM judge,
# no cloud egress). Read at runtime inside the (non-deterministic) activity, so it adds no
# workflow command / patch marker (the sensor result flows through the activity output; the
# workflow command sequence is byte-identical, replay-safe). A degraded NLI backend degrades
# (never auto-PASS). Default OFF ⇒ an explicit ops rollout once a self-hosted NLI model
# (MiniCheck / AlignScore / HHEM-class) is provisioned; the hermetic default overlap entailer
# needs no model. Pass threshold: HARNESS_SENSOR_ATOMIC_FACT_THRESHOLD (default 0.8).
HARNESS_ATOMIC_FACT_ENABLED=false

# -----------------------------------------------------------------------------
# Phase-2 inferential sensors + guardrails (TASK-330 Phase 2)
# -----------------------------------------------------------------------------
# Runtime groundedness/reasoning judge: REUSED from the eval judge above — the
# same HARNESS_JUDGE_* config drives both the offline gate and the runtime loop
# (no separate prefix). Tune the judge via the HARNESS_JUDGE_* block.

# Groundedness sensor threshold: fraction of provenance claims that must be
# entailed by the transcript/evidence (graded, not exact-match). Default: 0.8.
HARNESS_SENSOR_GROUNDEDNESS_THRESHOLD=0.8

# Groundedness claim-batching size (TASK-355 Phase B R-5; uses the HARNESS_JUDGE_ prefix).
# DEFAULT 1 (per-claim, SAFE): the per-claim path is now CONCURRENT (asyncio.gather), so it
# gets the latency win WITHOUT changing the judge's framing. Batching (>=2) states the
# transcript once + labels N claims per call (faster) BUT a live verdict-parity gate showed
# batch >=2 LOOSENED a borderline verdict (an LLM judge's verdict is framing-dependent) —
# keep at 1 unless you re-run that parity gate on YOUR judge model and prove zero loosening.
HARNESS_JUDGE_ENTAILMENT_BATCH_SIZE=1

# -- Safety: IBM Granite Guardian over LM Studio (HARNESS_SAFETY_) -------------
# Enable the safety sensor (default: true).
HARNESS_SAFETY_ENABLED=true
# Engine: lm-studio (default, OpenAI-compatible) | ollama | azure | bedrock.
# azure/bedrock require a guardian-capable model hosted on that engine.
HARNESS_SAFETY_PROVIDER=lm-studio
# LM Studio OpenAI-compatible root (already includes /v1; the client posts to
# {base_url}/chat/completions). For provider=ollama, set the native root instead,
# e.g. HARNESS_SAFETY_BASE_URL=http://localhost:11434
HARNESS_SAFETY_BASE_URL=http://localhost:1234/v1
# Model id the engine exposes for the loaded Granite Guardian 4.1 8B build (e.g.
# lmstudio-community/granite-guardian-4.1-8b-GGUF resolving to this id).
HARNESS_SAFETY_MODEL=granite-guardian-4.1-8b
# No-think mode: fast, deterministic yes/no per criterion (default: true).
HARNESS_SAFETY_NO_THINK=true
# Per-call timeout in seconds (default: 60).
HARNESS_SAFETY_TIMEOUT_S=60
# BYOC risk dimensions screened on the generated note (JSON array).
HARNESS_SAFETY_HARM_CRITERIA=["harm","social_bias","jailbreak","violence","profanity","sexual_content","unethical_behavior"]

# -- PHI: fail-closed pre-cloud-egress redaction (HARNESS_PHI_) ----------------
# Enable PHI redaction guard (default: true).
HARNESS_PHI_ENABLED=true
# Fail CLOSED: block cloud egress when PHI removal cannot be confirmed (default: true).
HARNESS_PHI_FAIL_CLOSED=true
# Provider identifiers treated as LOCAL (non-egress, no redaction). Everything
# else — including a provider not listed here — defaults to cloud egress and
# must pass redaction first (default-deny; see PhiConfig in core/config.py).
HARNESS_PHI_LOCAL_PROVIDERS=["lm-studio","openai_compat","ollama","vllm","llama-cpp"]

# -----------------------------------------------------------------------------
# Phase-3 institutional RAG — hybrid JIT retriever (HARNESS_RETRIEVAL_)
# -----------------------------------------------------------------------------
# Flag-gated OFF by default: the whole retrieval feature is additive and
# degrade-safe, so Phase 1/2 behaviour is unchanged until you opt in here.
HARNESS_RETRIEVAL_ENABLED=false
# Qdrant base URL (the dedicated knowledge_chunks collection lives here).
HARNESS_RETRIEVAL_QDRANT_URL=http://localhost:6333
# Qdrant API key for authentication (optional; may be empty for local dev).
HARNESS_RETRIEVAL_QDRANT_API_KEY=
# Dedicated collection (NOT the consultation-scoped context_items).
HARNESS_RETRIEVAL_COLLECTION=knowledge_chunks
# Qdrant request timeout in seconds.
HARNESS_RETRIEVAL_QDRANT_TIMEOUT_S=10
# Dense embeddings stay self-hosted (the query can contain PHI). LM Studio
# OpenAI-compatible root (already includes /v1); the client posts to
# {base_url}/embeddings. The model id must match the loaded embedding build
# (plan reference: BAAI/bge-m3, 1024-dim).
HARNESS_RETRIEVAL_EMBEDDINGS_BASE_URL=http://localhost:1234/v1
HARNESS_RETRIEVAL_EMBEDDINGS_MODEL=text-embedding-bge-m3
# Dense vector dim — MUST match the loaded model AND the Qdrant collection
# (1024 for BAAI/bge-m3; set 1536 + recreate the collection for a 1536-dim model).
HARNESS_RETRIEVAL_EMBEDDINGS_DIM=1024
# HF Text-Embeddings-Inference reranker (cross-encoder /rerank). In dev this is
# the hope-reranker container serving BAAI/bge-reranker-v2-m3.
HARNESS_RETRIEVAL_RERANKER_BASE_URL=http://localhost:8870
# Hybrid knobs: dense+sparse prefetch limit -> RRF(rrf_k) fusion -> rerank to top-k.
HARNESS_RETRIEVAL_TOP_K_RETRIEVAL=20
HARNESS_RETRIEVAL_TOP_K_RERANK=5
HARNESS_RETRIEVAL_RRF_K=60

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# TASK-582: no HARNESS_OTEL_* prefix exists anywhere on this service's Settings —
# this app has no OpenTelemetry integration (unlike stt/smr, which read bare
# OTEL_* vars). A previously-declared HARNESS_OTEL_* block here configured
# nothing; removed rather than left as dead documentation.

# Enable Prometheus metrics endpoint (default: true)
HARNESS_METRICS_ENABLED=true

# OpenTelemetry tracing (TASK-636 OBS-14) — FastAPI app AND the Temporal
# client/worker (via the SDK's TracingInterceptor). Default OFF and requires
# BOTH the flag and an endpoint (TASK-411 invariant).
HARNESS_OTEL_ENABLED=false
HARNESS_OTEL_EXPORTER_ENDPOINT=
HARNESS_OTEL_SERVICE_NAME=harness
HARNESS_OTEL_SERVICE_NAMESPACE=hope
# Resolved from DEPLOYMENT_ENVIRONMENT -> NODE_ENV -> development when unset.
# NEVER default this to "production" (TASK-636 OBS-18).
HARNESS_OTEL_DEPLOYMENT_ENVIRONMENT=
HARNESS_OTEL_INSECURE=true

# TASK-636 OBS-06 — Temporal SDK metrics in the WORKER process.
# The worker (`pnpm worker:dev`) is separate from the FastAPI app, so :8866
# /metrics says nothing about task-queue latency, workflow-task timeouts or
# activity failures. Loopback by default (PHI posture); containers set 0.0.0.0.
HARNESS_TEMPORAL_METRICS_HOST=127.0.0.1
HARNESS_TEMPORAL_METRICS_PORT=9464

# -----------------------------------------------------------------------------
# Temporal durable-workflow substrate (TEMPORAL_)
# -----------------------------------------------------------------------------
# The Temporal dev stack is opt-in via the docker compose `temporal` profile:
#   docker compose -f infrastructure/docker/docker-compose.yml \
#                  -f infrastructure/docker/docker-compose.dev.yml \
#                  --profile temporal up -d
# Web UI: http://localhost:8233   gRPC frontend: localhost:7233
#
# Image pins live in docker-compose.dev.yml (server/admin-tools 1.31.2, UI 2.53.1).
# If hope-temporal fails on a leftover auto-setup 1.29.x DB, hop — do not wipe:
#   TEMPORAL_VERSION=1.30.4 TEMPORAL_ADMINTOOLS_VERSION=1.30.4 pnpm infra:dev:up
#   # wait healthy, then  pnpm infra:dev:up
# admin-tools:1.29.7 does not exist; last auto-setup is 1.29.7.
# Print-only helper: pnpm infra:dev:temporal-hop
# Runbook: docs/implementation/TASK-702-Dependency-Blocker-Resolutions

# Temporal frontend (gRPC) address. Local dev: localhost:7233; in-container: temporal:7233
TEMPORAL_ADDRESS=localhost:7233

# Temporal namespace (compose create-namespace job creates "default")
TEMPORAL_NAMESPACE=default

# Task queue the worker polls and workflows are dispatched to
TEMPORAL_TASK_QUEUE=harness-task-queue

# Client connect timeout in seconds (FastAPI lifespan best-effort connect)
TEMPORAL_CONNECT_TIMEOUT_S=5.0
